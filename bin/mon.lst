                        	  1542:  .include "lib/vtext.asm"

Source: "lib\vtext.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   VTEXT.ASM  -  40 x 24 text screen on the TMS9918A          ;
                        	     4: ;                                                              ;
                        	     5: ;   BIOS text mode (VDP interrupt off, so the main loop can    ;
                        	     6: ;   write the VRAM at any time). VT_INIT also builds the       ;
                        	     7: ;   inverse font: codes $80-$FF = codes $00-$7F inverted,      ;
                        	     8: ;   used for the cursor, the status bar and the marked block.  ;
                        	     9: ;   Long loops call KB_POLL (lib/keys.asm).                    ;
                        	    10: ;   Uses: zp $A2-$A4, RAM $0800-$0BFF only inside VT_INIT      ;
                        	    11: ;                                                              ;
                        	    12: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    13: 
                        	    14: VT_P        = $A2      ; 2 bytes: string pointer
                        	    15: VT_INV      = $A4      ; ORed to every character of VT_STR ($80 = inverse)
                        	    16: VT_FONTTMP  = $0800    ; RAM copy of the font (1 KB, only during VT_INIT)
                        	    17: 
                        	    18: ; VT_INIT: text mode of the BIOS, inverse font, empty screen
                        	    19: VT_INIT:
01:1E7B 2009FD          	    20:   JSR JT_INIT_CRT
01:1E7E A900            	    21:   LDA #<VRAM_FONT        ; read patterns 0-127 (1 KB)
01:1E80 A200            	    22:   LDX #>VRAM_FONT
01:1E82 20EF1E          	    23:   JSR VT_RADDR
01:1E85 A200            	    24:   LDX #0                 ; (the VRAM address increases by itself)
                        	    25: .vi_r0:
01:1E87 AD00B0          	    26:   LDA VDP_DATA
01:1E8A 9D0008          	    27:   STA VT_FONTTMP,X
01:1E8D E8              	    28:   INX
01:1E8E D0F7            	    29:   BNE .vi_r0
                        	    30: .vi_r1:
01:1E90 AD00B0          	    31:   LDA VDP_DATA
01:1E93 9D0009          	    32:   STA VT_FONTTMP+$100,X
01:1E96 E8              	    33:   INX
01:1E97 D0F7            	    34:   BNE .vi_r1
                        	    35: .vi_r2:
01:1E99 AD00B0          	    36:   LDA VDP_DATA
01:1E9C 9D000A          	    37:   STA VT_FONTTMP+$200,X
01:1E9F E8              	    38:   INX
01:1EA0 D0F7            	    39:   BNE .vi_r2
                        	    40: .vi_r3:
01:1EA2 AD00B0          	    41:   LDA VDP_DATA
01:1EA5 9D000B          	    42:   STA VT_FONTTMP+$300,X
01:1EA8 E8              	    43:   INX
01:1EA9 D0F7            	    44:   BNE .vi_r3
01:1EAB A900            	    45:   LDA #<(VRAM_FONT+$400) ; inverted copy at pattern 128
01:1EAD A204            	    46:   LDX #>(VRAM_FONT+$400)
01:1EAF 20E51E          	    47:   JSR VT_WADDR
01:1EB2 A200            	    48:   LDX #0
                        	    49: .vi_w0:
01:1EB4 BD0008          	    50:   LDA VT_FONTTMP,X
01:1EB7 49FF            	    51:   EOR #$FF
01:1EB9 8D00B0          	    52:   STA VDP_DATA
01:1EBC E8              	    53:   INX
01:1EBD D0F5            	    54:   BNE .vi_w0
                        	    55: .vi_w1:
01:1EBF BD0009          	    56:   LDA VT_FONTTMP+$100,X
01:1EC2 49FF            	    57:   EOR #$FF
01:1EC4 8D00B0          	    58:   STA VDP_DATA
01:1EC7 E8              	    59:   INX
01:1EC8 D0F5            	    60:   BNE .vi_w1
                        	    61: .vi_w2:
01:1ECA BD000A          	    62:   LDA VT_FONTTMP+$200,X
01:1ECD 49FF            	    63:   EOR #$FF
01:1ECF 8D00B0          	    64:   STA VDP_DATA
01:1ED2 E8              	    65:   INX
01:1ED3 D0F5            	    66:   BNE .vi_w2
                        	    67: .vi_w3:
01:1ED5 BD000B          	    68:   LDA VT_FONTTMP+$300,X
01:1ED8 49FF            	    69:   EOR #$FF
01:1EDA 8D00B0          	    70:   STA VDP_DATA
01:1EDD E8              	    71:   INX
01:1EDE D0F5            	    72:   BNE .vi_w3
01:1EE0 64A4            	    73:   STZ VT_INV
01:1EE2 4C651F          	    74:   JMP VT_CLS
                        	    75: 
                        	    76: ; VT_WADDR: VRAM write address A (lo) / X (hi)
                        	    77: VT_WADDR:
01:1EE5 8D01B0          	    78:   STA VDP_REG
01:1EE8 8A              	    79:   TXA
01:1EE9 0940            	    80:   ORA #$40
01:1EEB 8D01B0          	    81:   STA VDP_REG
01:1EEE 60              	    82:   RTS
                        	    83: 
                        	    84: ; VT_RADDR: VRAM read address A (lo) / X (hi)
                        	    85: VT_RADDR:
01:1EEF 8D01B0          	    86:   STA VDP_REG
01:1EF2 8E01B0          	    87:   STX VDP_REG
01:1EF5 60              	    88:   RTS
                        	    89: 
                        	    90: ; VT_ROW: write address at column 0 of row A (0-23). Keeps Y
                        	    91: VT_ROW:
01:1EF6 AA              	    92:   TAX
01:1EF7 BD791F          	    93:   LDA VT_ROWLO,X
01:1EFA 48              	    94:   PHA
01:1EFB BD911F          	    95:   LDA VT_ROWHI,X
01:1EFE AA              	    96:   TAX
01:1EFF 68              	    97:   PLA
01:1F00 4CE51E          	    98:   JMP VT_WADDR
                        	    99: 
                        	   100: ; VT_AT: write address at row A, column X. Keeps Y
                        	   101: VT_AT:
01:1F03 DA              	   102:   PHX
01:1F04 AA              	   103:   TAX
01:1F05 68              	   104:   PLA
01:1F06 18              	   105:   CLC
01:1F07 7D791F          	   106:   ADC VT_ROWLO,X
01:1F0A 48              	   107:   PHA
01:1F0B BD911F          	   108:   LDA VT_ROWHI,X
01:1F0E 6900            	   109:   ADC #0
01:1F10 AA              	   110:   TAX
01:1F11 68              	   111:   PLA
01:1F12 4CE51E          	   112:   JMP VT_WADDR
                        	   113: 
                        	   114: ; VT_REP: writes X times the character A
                        	   115: VT_REP:
01:1F15 E000            	   116:   CPX #0
01:1F17 F010            	   117:   BEQ .vr_x
                        	   118: .vr_l:
01:1F19 8D00B0          	   119:   STA VDP_DATA
01:1F1C 48              	   120:   PHA
01:1F1D 8A              	   121:   TXA
01:1F1E 290F            	   122:   AND #$0F
01:1F20 D003            	   123:   BNE .vr_n
01:1F22 202C1E          	   124:   JSR KB_POLL
                        	   125: .vr_n:
01:1F25 68              	   126:   PLA
01:1F26 CA              	   127:   DEX
01:1F27 D0F0            	   128:   BNE .vr_l
                        	   129: .vr_x:
01:1F29 60              	   130:   RTS
                        	   131: 
                        	   132: ; VT_STR: writes the $00-terminated string at VT_P (ORA VT_INV). Y = characters written
                        	   133: VT_STR:
01:1F2A A000            	   134:   LDY #0
                        	   135: .vs_l:
01:1F2C B1A2            	   136:   LDA (VT_P),Y
01:1F2E F010            	   137:   BEQ .vs_x
01:1F30 05A4            	   138:   ORA VT_INV
01:1F32 8D00B0          	   139:   STA VDP_DATA
01:1F35 C8              	   140:   INY
01:1F36 98              	   141:   TYA
01:1F37 290F            	   142:   AND #$0F
01:1F39 D0F1            	   143:   BNE .vs_l
01:1F3B 202C1E          	   144:   JSR KB_POLL
01:1F3E 80EC            	   145:   BRA .vs_l
                        	   146: .vs_x:
01:1F40 60              	   147:   RTS
                        	   148: 
                        	   149: ; VT_LINE: string A/X (lo/hi) at the current address, then spaces (ORA VT_INV) up to
                        	   150: ; column 40 of the row. Y = start column on entry
                        	   151: VT_LINE:
01:1F41 85A2            	   152:   STA VT_P
01:1F43 86A3            	   153:   STX VT_P+1
01:1F45 8C641F          	   154:   STY .vl_c
01:1F48 202A1F          	   155:   JSR VT_STR
01:1F4B 98              	   156:   TYA
01:1F4C 18              	   157:   CLC
01:1F4D 6D641F          	   158:   ADC .vl_c
01:1F50 8D641F          	   159:   STA .vl_c
01:1F53 A928            	   160:   LDA #40
01:1F55 38              	   161:   SEC
01:1F56 ED641F          	   162:   SBC .vl_c
01:1F59 9008            	   163:   BCC .vl_x
01:1F5B AA              	   164:   TAX
01:1F5C A920            	   165:   LDA #' '
01:1F5E 05A4            	   166:   ORA VT_INV
01:1F60 4C151F          	   167:   JMP VT_REP
                        	   168: .vl_x:
01:1F63 60              	   169:   RTS
                        	   170: .vl_c:
01:1F64 00              	   171:   .byte 0
                        	   172: 
                        	   173: ; VT_CLS: whole screen blank
                        	   174: VT_CLS:
01:1F65 A900            	   175:   LDA #<VRAM_NAME
01:1F67 A208            	   176:   LDX #>VRAM_NAME
01:1F69 20E51E          	   177:   JSR VT_WADDR
01:1F6C A004            	   178:   LDY #4                 ; 4 x 240 = 960
                        	   179: .vc_l:
01:1F6E A920            	   180:   LDA #' '
01:1F70 A2F0            	   181:   LDX #240
01:1F72 20151F          	   182:   JSR VT_REP
01:1F75 88              	   183:   DEY
01:1F76 D0F6            	   184:   BNE .vc_l
01:1F78 60              	   185:   RTS
                        	   186: 
                        	   187: VT_ROWLO:
01:1F79 00              	   188:   .byte <(VRAM_NAME+0*40),<(VRAM_NAME+1*40),<(VRAM_NAME+2*40),<(VRAM_NAME+3*40)
01:1F7A 28
01:1F7B 50
01:1F7C 78
01:1F7D A0              	   189:   .byte <(VRAM_NAME+4*40),<(VRAM_NAME+5*40),<(VRAM_NAME+6*40),<(VRAM_NAME+7*40)
01:1F7E C8
01:1F7F F0
01:1F80 18
01:1F81 40              	   190:   .byte <(VRAM_NAME+8*40),<(VRAM_NAME+9*40),<(VRAM_NAME+10*40),<(VRAM_NAME+11*40)
01:1F82 68
01:1F83 90
01:1F84 B8
01:1F85 E0              	   191:   .byte <(VRAM_NAME+12*40),<(VRAM_NAME+13*40),<(VRAM_NAME+14*40),<(VRAM_NAME+15*40)
01:1F86 08
01:1F87 30
01:1F88 58
01:1F89 80              	   192:   .byte <(VRAM_NAME+16*40),<(VRAM_NAME+17*40),<(VRAM_NAME+18*40),<(VRAM_NAME+19*40)
01:1F8A A8
01:1F8B D0
01:1F8C F8
01:1F8D 20              	   193:   .byte <(VRAM_NAME+20*40),<(VRAM_NAME+21*40),<(VRAM_NAME+22*40),<(VRAM_NAME+23*40)
01:1F8E 48
01:1F8F 70
01:1F90 98
                        	   194: VT_ROWHI:
01:1F91 08              	   195:   .byte >(VRAM_NAME+0*40),>(VRAM_NAME+1*40),>(VRAM_NAME+2*40),>(VRAM_NAME+3*40)
01:1F92 08
01:1F93 08
01:1F94 08
01:1F95 08              	   196:   .byte >(VRAM_NAME+4*40),>(VRAM_NAME+5*40),>(VRAM_NAME+6*40),>(VRAM_NAME+7*40)
01:1F96 08
01:1F97 08
01:1F98 09
01:1F99 09              	   197:   .byte >(VRAM_NAME+8*40),>(VRAM_NAME+9*40),>(VRAM_NAME+10*40),>(VRAM_NAME+11*40)
01:1F9A 09
01:1F9B 09
01:1F9C 09
01:1F9D 09              	   198:   .byte >(VRAM_NAME+12*40),>(VRAM_NAME+13*40),>(VRAM_NAME+14*40),>(VRAM_NAME+15*40)
01:1F9E 0A
01:1F9F 0A
01:1FA0 0A
01:1FA1 0A              	   199:   .byte >(VRAM_NAME+16*40),>(VRAM_NAME+17*40),>(VRAM_NAME+18*40),>(VRAM_NAME+19*40)
01:1FA2 0A
01:1FA3 0A
01:1FA4 0A
01:1FA5 0B              	   200:   .byte >(VRAM_NAME+20*40),>(VRAM_NAME+21*40),>(VRAM_NAME+22*40),>(VRAM_NAME+23*40)
01:1FA6 0B
01:1FA7 0B
01:1FA8 0B
                        	   201: 

Source: "apps\mon.asm"
                        	  1543:  .include "lib/console.asm"

Source: "lib\console.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   CONSOLE.ASM  -  a scrolling 40 x 24 text console           ;
                        	     4: ;                                                              ;
                        	     5: ;   Writes at the cursor, CR goes to the next row, the screen  ;
                        	     6: ;   scrolls up at the bottom (rows copied in VRAM, no RAM      ;
                        	     7: ;   copy of the screen). CON_GETS reads a typed line.          ;
                        	     8: ;   Needs lib/keys, lib/vtext.                                 ;
                        	     9: ;   Uses: zp $EC-$EF, RAM $0560-$0587 (row), $0590-$05B7 (line);
                        	    10: ;                                                              ;
                        	    11: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    12: 
                        	    13: CON_ROW     = $EC
                        	    14: CON_COL     = $ED
                        	    15: CON_LEN     = $EE      ; length of the typed line
                        	    16: CON_MAX     = $EF      ; longest line CON_GETS accepts
                        	    17: CON_ROWB    = $0560    ; one row while scrolling
                        	    18: CON_LINE    = $0590    ; the typed line, $00 at the end
                        	    19: 
                        	    20: ; CON_CLS: blank screen, cursor at the top left
                        	    21: CON_CLS:
01:1FA9 64EC            	    22:   STZ CON_ROW
01:1FAB 64ED            	    23:   STZ CON_COL
01:1FAD 4C651F          	    24:   JMP VT_CLS
                        	    25: 
                        	    26: ; CON_PUT: A at the cursor (CR = new row). Keeps A, X, Y
                        	    27: CON_PUT:
01:1FB0 48              	    28:   PHA
01:1FB1 DA              	    29:   PHX
01:1FB2 5A              	    30:   PHY
01:1FB3 C90D            	    31:   CMP #K_CR
01:1FB5 F014            	    32:   BEQ .cp_nl
01:1FB7 48              	    33:   PHA
01:1FB8 A5EC            	    34:   LDA CON_ROW
01:1FBA A6ED            	    35:   LDX CON_COL
01:1FBC 20031F          	    36:   JSR VT_AT
01:1FBF 68              	    37:   PLA
01:1FC0 8D00B0          	    38:   STA VDP_DATA
01:1FC3 E6ED            	    39:   INC CON_COL
01:1FC5 A5ED            	    40:   LDA CON_COL
01:1FC7 C928            	    41:   CMP #40
01:1FC9 9003            	    42:   BCC .cp_x
                        	    43: .cp_nl:
01:1FCB 20D21F          	    44:   JSR CON_NL
                        	    45: .cp_x:
01:1FCE 7A              	    46:   PLY
01:1FCF FA              	    47:   PLX
01:1FD0 68              	    48:   PLA
01:1FD1 60              	    49:   RTS
                        	    50: 
                        	    51: ; CON_NL: cursor to the start of the next row, scrolling at the bottom
                        	    52: CON_NL:
01:1FD2 64ED            	    53:   STZ CON_COL
01:1FD4 A5EC            	    54:   LDA CON_ROW
01:1FD6 C917            	    55:   CMP #23
01:1FD8 B003            	    56:   BCS CON_SCROLL
01:1FDA E6EC            	    57:   INC CON_ROW
01:1FDC 60              	    58:   RTS
                        	    59: 
                        	    60: ; CON_SCROLL: rows 1-23 up by one, row 23 blank
                        	    61: CON_SCROLL:
01:1FDD A001            	    62:   LDY #1
                        	    63: .cs_r:
01:1FDF 98              	    64:   TYA
01:1FE0 201920          	    65:   JSR VT_ROWAD
01:1FE3 20EF1E          	    66:   JSR VT_RADDR
01:1FE6 A200            	    67:   LDX #0
                        	    68: .cs_rd:
01:1FE8 AD00B0          	    69:   LDA VDP_DATA
01:1FEB 9D6005          	    70:   STA CON_ROWB,X
01:1FEE E8              	    71:   INX
01:1FEF E028            	    72:   CPX #40
01:1FF1 D0F5            	    73:   BNE .cs_rd
01:1FF3 98              	    74:   TYA
01:1FF4 3A              	    75:   DEC A
01:1FF5 20F61E          	    76:   JSR VT_ROW
01:1FF8 A200            	    77:   LDX #0
                        	    78: .cs_wr:
01:1FFA BD6005          	    79:   LDA CON_ROWB,X
01:1FFD 8D00B0          	    80:   STA VDP_DATA
01:2000 E8              	    81:   INX
01:2001 E028            	    82:   CPX #40
01:2003 D0F5            	    83:   BNE .cs_wr
01:2005 202C1E          	    84:   JSR KB_POLL
01:2008 C8              	    85:   INY
01:2009 C018            	    86:   CPY #24
01:200B D0D2            	    87:   BNE .cs_r
01:200D A917            	    88:   LDA #23
01:200F 20F61E          	    89:   JSR VT_ROW
01:2012 A920            	    90:   LDA #' '
01:2014 A228            	    91:   LDX #40
01:2016 4C151F          	    92:   JMP VT_REP
                        	    93: 
                        	    94: ; VT_ROWAD: A = row -> A/X = VRAM address of its column 0. Keeps Y
                        	    95: VT_ROWAD:
01:2019 AA              	    96:   TAX
01:201A BD791F          	    97:   LDA VT_ROWLO,X
01:201D 48              	    98:   PHA
01:201E BD911F          	    99:   LDA VT_ROWHI,X
01:2021 AA              	   100:   TAX
01:2022 68              	   101:   PLA
01:2023 60              	   102:   RTS
                        	   103: 
                        	   104: ; CON_STR: the $00-terminated string A/X
                        	   105: CON_STR:
01:2024 85A2            	   106:   STA VT_P
01:2026 86A3            	   107:   STX VT_P+1
01:2028 A000            	   108:   LDY #0
                        	   109: .ct_l:
01:202A B1A2            	   110:   LDA (VT_P),Y
01:202C F006            	   111:   BEQ .ct_x
01:202E 20B01F          	   112:   JSR CON_PUT
01:2031 C8              	   113:   INY
01:2032 D0F6            	   114:   BNE .ct_l
                        	   115: .ct_x:
01:2034 60              	   116:   RTS
                        	   117: 
                        	   118: CON_SP:
01:2035 A920            	   119:   LDA #' '
01:2037 4CB01F          	   120:   JMP CON_PUT
                        	   121: 
                        	   122: CON_CR:
01:203A A90D            	   123:   LDA #K_CR
01:203C 4CB01F          	   124:   JMP CON_PUT
                        	   125: 
                        	   126: ; CON_HEX: A as 2 hex digits. Keeps X, Y
                        	   127: CON_HEX:
01:203F 48              	   128:   PHA
01:2040 4A              	   129:   LSR
01:2041 4A              	   130:   LSR
01:2042 4A              	   131:   LSR
01:2043 4A              	   132:   LSR
01:2044 205020          	   133:   JSR .ch_d
01:2047 68              	   134:   PLA
01:2048 48              	   135:   PHA
01:2049 290F            	   136:   AND #$0F
01:204B 205020          	   137:   JSR .ch_d
01:204E 68              	   138:   PLA
01:204F 60              	   139:   RTS
                        	   140: .ch_d:
01:2050 C90A            	   141:   CMP #10
01:2052 9002            	   142:   BCC .ch_n
01:2054 6906            	   143:   ADC #'A'-10-1-'0'      ; (C=1)
                        	   144: .ch_n:
01:2056 6930            	   145:   ADC #'0'
01:2058 4CB01F          	   146:   JMP CON_PUT
                        	   147: 
                        	   148: ; CON_GETS: reads a line at the cursor into CON_LINE. CON_LINE may hold a start text of
                        	   149: ; CON_LEN characters (printed first). Letters become upper case. A = length (Enter)
                        	   150: CON_GETS:
01:205B A200            	   151:   LDX #0
                        	   152: .cg_p:
01:205D E4EE            	   153:   CPX CON_LEN
01:205F F009            	   154:   BEQ .cg_c
01:2061 BD9005          	   155:   LDA CON_LINE,X
01:2064 20B01F          	   156:   JSR CON_PUT
01:2067 E8              	   157:   INX
01:2068 80F3            	   158:   BRA .cg_p
                        	   159: .cg_c:
01:206A A5EC            	   160:   LDA CON_ROW            ; cursor
01:206C A6ED            	   161:   LDX CON_COL
01:206E 20031F          	   162:   JSR VT_AT
01:2071 A9A0            	   163:   LDA #' '+$80
01:2073 8D00B0          	   164:   STA VDP_DATA
01:2076 20691E          	   165:   JSR WAITKEY
01:2079 C90D            	   166:   CMP #K_CR
01:207B F03F            	   167:   BEQ .cg_ok
01:207D C908            	   168:   CMP #K_BS
01:207F F021            	   169:   BEQ .cg_bs
01:2081 C920            	   170:   CMP #' '
01:2083 90E5            	   171:   BCC .cg_c
01:2085 C97F            	   172:   CMP #$7F
01:2087 B0E1            	   173:   BCS .cg_c
01:2089 A6EE            	   174:   LDX CON_LEN
01:208B E4EF            	   175:   CPX CON_MAX
01:208D B0DB            	   176:   BCS .cg_c
01:208F 20A023          	   177:   JSR UI_UPC
01:2092 9D9005          	   178:   STA CON_LINE,X
01:2095 E6EE            	   179:   INC CON_LEN
01:2097 A6ED            	   180:   LDX CON_COL            ; (the last column is kept for the cursor)
01:2099 E027            	   181:   CPX #39
01:209B B0CD            	   182:   BCS .cg_c
01:209D 20B01F          	   183:   JSR CON_PUT
01:20A0 80C8            	   184:   BRA .cg_c
                        	   185: .cg_bs:
01:20A2 A5EE            	   186:   LDA CON_LEN
01:20A4 F0C4            	   187:   BEQ .cg_c
01:20A6 C6EE            	   188:   DEC CON_LEN
01:20A8 A5ED            	   189:   LDA CON_COL
01:20AA F0BE            	   190:   BEQ .cg_c
01:20AC A5EC            	   191:   LDA CON_ROW
01:20AE A6ED            	   192:   LDX CON_COL
01:20B0 20031F          	   193:   JSR VT_AT
01:20B3 A920            	   194:   LDA #' '
01:20B5 8D00B0          	   195:   STA VDP_DATA
01:20B8 C6ED            	   196:   DEC CON_COL
01:20BA 80AE            	   197:   BRA .cg_c
                        	   198: .cg_ok:
01:20BC A5EC            	   199:   LDA CON_ROW            ; no cursor left behind
01:20BE A6ED            	   200:   LDX CON_COL
01:20C0 20031F          	   201:   JSR VT_AT
01:20C3 A920            	   202:   LDA #' '
01:20C5 8D00B0          	   203:   STA VDP_DATA
01:20C8 A6EE            	   204:   LDX CON_LEN
01:20CA 9E9005          	   205:   STZ CON_LINE,X
01:20CD 203A20          	   206:   JSR CON_CR
01:20D0 A5EE            	   207:   LDA CON_LEN
01:20D2 60              	   208:   RTS
                        	   209: 

Source: "apps\mon.asm"
                        	  1544:  .include "lib/docs.asm"

Source: "lib\docs.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   DOCS.ASM  -  documents in the SD document area             ;
                        	     4: ;                                                              ;
                        	     5: ;   Sector 16384 ($00800000, after the 255 program blocks)     ;
                        	     6: ;   is the index: +0 "DOCS", +4 version 1, +5 slots (15);      ;
                        	     7: ;   entry k (1-15) at k*32: +0 type (0 free, 1 text,           ;
                        	     8: ;   2 sheet, 3 card file),                                     ;
                        	     9: ;   +1/+2 length, +4..+15 name (12 chars, $00 padded).         ;
                        	    10: ;   Document k = 40 sectors (20 KB) from sector 16384 + k*40.  ;
                        	    11: ;   Sectors go through the BIOS (JT_SD_READ / JT_SD_WRITE).    ;
                        	    12: ;   Uses: zp $AA-$AF, $B8-$BA, RAM $0600-$07FF (index sector)  ;
                        	    13: ;                                                              ;
                        	    14: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    15: 
                        	    16: DOC_IDX     = $0600    ; index sector (512 bytes)
                        	    17: DOC_BASE    = $4000    ; sector 16384
                        	    18: DOC_SLOTS   = 15
                        	    19: DOC_SECTS   = 40       ; sectors per document
                        	    20: DOC_NAMELEN = 12
                        	    21: DOC_E       = $AA      ; 2 bytes: pointer to the index entry
                        	    22: DOC_K       = $AC      ; slot
                        	    23: DOC_I       = $AD      ; sector inside the document
                        	    24: DOC_N       = $AE      ; sectors to transfer
                        	    25: DOC_PG      = $AF      ; RAM page of the transfer
                        	    26: DOC_T       = $B8      ; document type of the application (1 text, 2 sheet, 3 card file)
                        	    27: DOC_LEN     = $B9      ; 2 bytes: length for DOC_SETENT
                        	    28: 
                        	    29: ; DOC_RDIDX: reads the index; a sector without "DOCS" becomes an empty index. C=1 SD error
                        	    30: DOC_RDIDX:
01:20D3 20EB21          	    31:   JSR DOC_LBA0
01:20D6 A200            	    32:   LDX #<DOC_IDX
01:20D8 A006            	    33:   LDY #>DOC_IDX
01:20DA 2018FD          	    34:   JSR JT_SD_READ
01:20DD B00E            	    35:   BCS .dr_x
01:20DF A203            	    36:   LDX #3
                        	    37: .dr_m:
01:20E1 BD0006          	    38:   LDA DOC_IDX,X
01:20E4 DD4522          	    39:   CMP DOC_MAGIC,X
01:20E7 D005            	    40:   BNE .dr_new
01:20E9 CA              	    41:   DEX
01:20EA 10F5            	    42:   BPL .dr_m
01:20EC 18              	    43:   CLC
                        	    44: .dr_x:
01:20ED 60              	    45:   RTS
                        	    46: .dr_new:
01:20EE A200            	    47:   LDX #0
                        	    48: .dr_z:
01:20F0 9E0006          	    49:   STZ DOC_IDX,X
01:20F3 9E0007          	    50:   STZ DOC_IDX+$100,X
01:20F6 E8              	    51:   INX
01:20F7 D0F7            	    52:   BNE .dr_z
01:20F9 A205            	    53:   LDX #5
                        	    54: .dr_h:
01:20FB BD4522          	    55:   LDA DOC_MAGIC,X
01:20FE 9D0006          	    56:   STA DOC_IDX,X
01:2101 CA              	    57:   DEX
01:2102 10F7            	    58:   BPL .dr_h
01:2104 18              	    59:   CLC
01:2105 60              	    60:   RTS
                        	    61: 
                        	    62: ; DOC_WRIDX: writes the index. C=1 SD error
                        	    63: DOC_WRIDX:
01:2106 20EB21          	    64:   JSR DOC_LBA0
01:2109 A200            	    65:   LDX #<DOC_IDX
01:210B A006            	    66:   LDY #>DOC_IDX
01:210D 4C1BFD          	    67:   JMP JT_SD_WRITE
                        	    68: 
                        	    69: ; DOC_ENTRY: A = slot (1-15) -> DOC_E = its index entry. Keeps X, Y
                        	    70: DOC_ENTRY:
01:2110 85AC            	    71:   STA DOC_K
01:2112 4A              	    72:   LSR
01:2113 4A              	    73:   LSR
01:2114 4A              	    74:   LSR
01:2115 18              	    75:   CLC
01:2116 6906            	    76:   ADC #>DOC_IDX
01:2118 85AB            	    77:   STA DOC_E+1
01:211A A5AC            	    78:   LDA DOC_K
01:211C 0A              	    79:   ASL
01:211D 0A              	    80:   ASL
01:211E 0A              	    81:   ASL
01:211F 0A              	    82:   ASL
01:2120 0A              	    83:   ASL
01:2121 85AA            	    84:   STA DOC_E              ; (DOC_IDX is page aligned)
01:2123 60              	    85:   RTS
                        	    86: 
                        	    87: ; DOC_FIND: name of 12 bytes at (DOC_P) and type DOC_T -> C=0 and A = slot, C=1 not found
                        	    88: DOC_P       = VT_P     ; (shares the string pointer)
                        	    89: DOC_FIND:
01:2124 A901            	    90:   LDA #1
                        	    91: .df_k:
01:2126 48              	    92:   PHA
01:2127 201021          	    93:   JSR DOC_ENTRY
01:212A A000            	    94:   LDY #0
01:212C B1AA            	    95:   LDA (DOC_E),Y
01:212E C5B8            	    96:   CMP DOC_T
01:2130 D01A            	    97:   BNE .df_n              ; free or another type
01:2132 A00B            	    98:   LDY #DOC_NAMELEN-1
                        	    99: .df_c:
01:2134 B1A2            	   100:   LDA (DOC_P),Y
01:2136 85AD            	   101:   STA DOC_I              ; (temporary)
01:2138 C8              	   102:   INY                    ; name in the entry at +4
01:2139 C8              	   103:   INY
01:213A C8              	   104:   INY
01:213B C8              	   105:   INY
01:213C B1AA            	   106:   LDA (DOC_E),Y
01:213E C5AD            	   107:   CMP DOC_I
01:2140 D00A            	   108:   BNE .df_n
01:2142 88              	   109:   DEY                    ; back to the previous character
01:2143 88              	   110:   DEY
01:2144 88              	   111:   DEY
01:2145 88              	   112:   DEY
01:2146 88              	   113:   DEY
01:2147 10EB            	   114:   BPL .df_c
01:2149 68              	   115:   PLA
01:214A 18              	   116:   CLC
01:214B 60              	   117:   RTS
                        	   118: .df_n:
01:214C 68              	   119:   PLA
01:214D 1A              	   120:   INC A
01:214E C910            	   121:   CMP #DOC_SLOTS+1
01:2150 D0D4            	   122:   BNE .df_k
01:2152 38              	   123:   SEC
01:2153 60              	   124:   RTS
                        	   125: 
                        	   126: ; DOC_FREE: C=0 and A = first free slot, C=1 index full
                        	   127: DOC_FREE:
01:2154 A901            	   128:   LDA #1
                        	   129: .dfr_k:
01:2156 201021          	   130:   JSR DOC_ENTRY
01:2159 A000            	   131:   LDY #0
01:215B B1AA            	   132:   LDA (DOC_E),Y
01:215D F009            	   133:   BEQ .dfr_y
01:215F A5AC            	   134:   LDA DOC_K
01:2161 1A              	   135:   INC A
01:2162 C910            	   136:   CMP #DOC_SLOTS+1
01:2164 D0F0            	   137:   BNE .dfr_k
01:2166 38              	   138:   SEC
01:2167 60              	   139:   RTS
                        	   140: .dfr_y:
01:2168 A5AC            	   141:   LDA DOC_K
01:216A 18              	   142:   CLC
01:216B 60              	   143:   RTS
                        	   144: 
                        	   145: ; DOC_SETENT: entry of slot A = type DOC_T, length DOC_LEN, name (DOC_P) (12 bytes)
                        	   146: DOC_SETENT:
01:216C 201021          	   147:   JSR DOC_ENTRY
01:216F A000            	   148:   LDY #0
01:2171 A5B8            	   149:   LDA DOC_T
01:2173 91AA            	   150:   STA (DOC_E),Y
01:2175 C8              	   151:   INY
01:2176 A5B9            	   152:   LDA DOC_LEN
01:2178 91AA            	   153:   STA (DOC_E),Y
01:217A C8              	   154:   INY
01:217B A5BA            	   155:   LDA DOC_LEN+1
01:217D 91AA            	   156:   STA (DOC_E),Y
01:217F C8              	   157:   INY
01:2180 A900            	   158:   LDA #0
01:2182 91AA            	   159:   STA (DOC_E),Y
01:2184 A000            	   160:   LDY #0                 ; name: (DOC_P)+0..11 -> entry +4..15
                        	   161: .dse_n:
01:2186 B1A2            	   162:   LDA (DOC_P),Y
01:2188 C8              	   163:   INY
01:2189 C8              	   164:   INY
01:218A C8              	   165:   INY
01:218B C8              	   166:   INY
01:218C 91AA            	   167:   STA (DOC_E),Y
01:218E 88              	   168:   DEY
01:218F 88              	   169:   DEY
01:2190 88              	   170:   DEY
01:2191 C00C            	   171:   CPY #DOC_NAMELEN
01:2193 D0F1            	   172:   BNE .dse_n
01:2195 60              	   173:   RTS
                        	   174: 
                        	   175: ; DOC_SECT: SD_LBA = DOC_BASE + DOC_K*40 + DOC_I
                        	   176: DOC_SECT:
01:2196 9C1803          	   177:   STZ SD_LBA+2
01:2199 9C1903          	   178:   STZ SD_LBA+3
01:219C A5AC            	   179:   LDA DOC_K
01:219E 8D1603          	   180:   STA SD_LBA
01:21A1 9C1703          	   181:   STZ SD_LBA+1
01:21A4 0E1603          	   182:   ASL SD_LBA             ; k*8
01:21A7 2E1703          	   183:   ROL SD_LBA+1
01:21AA 0E1603          	   184:   ASL SD_LBA
01:21AD 2E1703          	   185:   ROL SD_LBA+1
01:21B0 0E1603          	   186:   ASL SD_LBA
01:21B3 2E1703          	   187:   ROL SD_LBA+1
01:21B6 AD1703          	   188:   LDA SD_LBA+1           ; + k*32 = 4 * (k*8)
01:21B9 48              	   189:   PHA
01:21BA AD1603          	   190:   LDA SD_LBA
01:21BD 48              	   191:   PHA
01:21BE 0E1603          	   192:   ASL SD_LBA
01:21C1 2E1703          	   193:   ROL SD_LBA+1
01:21C4 0E1603          	   194:   ASL SD_LBA
01:21C7 2E1703          	   195:   ROL SD_LBA+1
01:21CA 18              	   196:   CLC
01:21CB 68              	   197:   PLA
01:21CC 6D1603          	   198:   ADC SD_LBA
01:21CF 8D1603          	   199:   STA SD_LBA
01:21D2 68              	   200:   PLA
01:21D3 6D1703          	   201:   ADC SD_LBA+1
01:21D6 8D1703          	   202:   STA SD_LBA+1
01:21D9 18              	   203:   CLC
01:21DA AD1603          	   204:   LDA SD_LBA
01:21DD 65AD            	   205:   ADC DOC_I
01:21DF 8D1603          	   206:   STA SD_LBA
01:21E2 AD1703          	   207:   LDA SD_LBA+1
01:21E5 6940            	   208:   ADC #>DOC_BASE
01:21E7 8D1703          	   209:   STA SD_LBA+1
01:21EA 60              	   210:   RTS
                        	   211: 
                        	   212: DOC_LBA0:
01:21EB 9C1603          	   213:   STZ SD_LBA
01:21EE A940            	   214:   LDA #>DOC_BASE
01:21F0 8D1703          	   215:   STA SD_LBA+1
01:21F3 9C1803          	   216:   STZ SD_LBA+2
01:21F6 9C1903          	   217:   STZ SD_LBA+3
01:21F9 60              	   218:   RTS
                        	   219: 
                        	   220: ; DOC_XFER: DOC_K = slot, A = RAM page of the data, X/Y = length (lo/hi), C=0 read, C=1 write
                        	   221: ; Transfers ceil(length / 512) sectors. C=1 SD error
                        	   222: DOC_XFER:
01:21FA 85AF            	   223:   STA DOC_PG
01:21FC 08              	   224:   PHP
01:21FD 8A              	   225:   TXA                    ; sectors = (length + 511) / 512
01:21FE 18              	   226:   CLC
01:21FF 69FF            	   227:   ADC #$FF
01:2201 98              	   228:   TYA
01:2202 6901            	   229:   ADC #$01
01:2204 4A              	   230:   LSR
01:2205 85AE            	   231:   STA DOC_N
01:2207 64AD            	   232:   STZ DOC_I
01:2209 28              	   233:   PLP
01:220A B017            	   234:   BCS .dx_w
                        	   235: .dx_r:
01:220C A5AD            	   236:   LDA DOC_I
01:220E C5AE            	   237:   CMP DOC_N
01:2210 B028            	   238:   BCS .dx_ok
01:2212 209621          	   239:   JSR DOC_SECT
01:2215 A200            	   240:   LDX #0
01:2217 A4AF            	   241:   LDY DOC_PG
01:2219 2018FD          	   242:   JSR JT_SD_READ
01:221C B01D            	   243:   BCS .dx_x
01:221E 203C22          	   244:   JSR .dx_next
01:2221 80E9            	   245:   BRA .dx_r
                        	   246: .dx_w:
01:2223 A5AD            	   247:   LDA DOC_I
01:2225 C5AE            	   248:   CMP DOC_N
01:2227 B011            	   249:   BCS .dx_ok
01:2229 209621          	   250:   JSR DOC_SECT
01:222C A200            	   251:   LDX #0
01:222E A4AF            	   252:   LDY DOC_PG
01:2230 201BFD          	   253:   JSR JT_SD_WRITE
01:2233 B006            	   254:   BCS .dx_x
01:2235 203C22          	   255:   JSR .dx_next
01:2238 80E9            	   256:   BRA .dx_w
                        	   257: .dx_ok:
01:223A 18              	   258:   CLC
                        	   259: .dx_x:
01:223B 60              	   260:   RTS
                        	   261: .dx_next:
01:223C E6AD            	   262:   INC DOC_I
01:223E E6AF            	   263:   INC DOC_PG
01:2240 E6AF            	   264:   INC DOC_PG
01:2242 4C2C1E          	   265:   JMP KB_POLL
                        	   266: 
                        	   267: DOC_MAGIC:
01:2245 444F4353        	   268:   .byte "DOCS",1,DOC_SLOTS
01:2249 01
01:224A 0F
                        	   269: 

Source: "apps\mon.asm"
                        	  1545:  .include "lib/stream.asm"

Source: "lib\stream.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   STREAM.ASM  -  a document written / read byte by byte      ;
                        	     4: ;                                                              ;
                        	     5: ;   Through a 512-byte sector buffer, one sector at a time,    ;
                        	     6: ;   in the slot DOC_K of the document area (lib/docs.asm).     ;
                        	     7: ;   Uses: zp $E4-$EB, RAM $0800-$09FF (ST_BUF)                 ;
                        	     8: ;                                                              ;
                        	     9: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    10: 
                        	    11: ST_BUF      = $0800    ; sector buffer (page aligned)
                        	    12: ST_POS      = $E4      ; 2 bytes: position in ST_BUF
                        	    13: ST_SEC      = $E6      ; sector of the document
                        	    14: ST_LEFT     = $E7      ; 2 bytes: bytes still to read
                        	    15: ST_ERR      = $E9      ; 1 = SD error or too big
                        	    16: ST_P        = $EA      ; 2 bytes
                        	    17: 
                        	    18: ; ST_WOPEN: start writing the document DOC_K
                        	    19: ST_WOPEN:
01:224B 64E4            	    20:   STZ ST_POS
01:224D 64E5            	    21:   STZ ST_POS+1
01:224F 64E6            	    22:   STZ ST_SEC
01:2251 64E9            	    23:   STZ ST_ERR
01:2253 60              	    24:   RTS
                        	    25: 
                        	    26: ; ST_PUT: A to the document. Keeps A, X, Y
                        	    27: ST_PUT:
01:2254 48              	    28:   PHA
01:2255 DA              	    29:   PHX
01:2256 5A              	    30:   PHY
01:2257 48              	    31:   PHA
01:2258 A5E4            	    32:   LDA ST_POS
01:225A 85EA            	    33:   STA ST_P
01:225C A5E5            	    34:   LDA ST_POS+1
01:225E 18              	    35:   CLC
01:225F 6908            	    36:   ADC #>ST_BUF
01:2261 85EB            	    37:   STA ST_P+1
01:2263 68              	    38:   PLA
01:2264 92EA            	    39:   STA (ST_P)
01:2266 E6E4            	    40:   INC ST_POS
01:2268 D00B            	    41:   BNE .sp_x
01:226A E6E5            	    42:   INC ST_POS+1
01:226C A5E5            	    43:   LDA ST_POS+1
01:226E C902            	    44:   CMP #2
01:2270 D003            	    45:   BNE .sp_x
01:2272 207922          	    46:   JSR ST_FLUSH
                        	    47: .sp_x:
01:2275 7A              	    48:   PLY
01:2276 FA              	    49:   PLX
01:2277 68              	    50:   PLA
01:2278 60              	    51:   RTS
                        	    52: 
                        	    53: ; ST_FLUSH: the buffer (ST_POS bytes) to sector ST_SEC, then an empty buffer
                        	    54: ST_FLUSH:
01:2279 A5E4            	    55:   LDA ST_POS
01:227B 05E5            	    56:   ORA ST_POS+1
01:227D F01E            	    57:   BEQ .sf_x
01:227F A5E6            	    58:   LDA ST_SEC
01:2281 C928            	    59:   CMP #DOC_SECTS
01:2283 B00E            	    60:   BCS .sf_big
01:2285 85AD            	    61:   STA DOC_I
01:2287 209621          	    62:   JSR DOC_SECT
01:228A A200            	    63:   LDX #<ST_BUF
01:228C A008            	    64:   LDY #>ST_BUF
