                        	  1541:  .include "lib/keys.asm"

Source: "lib\keys.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   KEYS.ASM  -  key queue on top of the BIOS                  ;
                        	     4: ;                                                              ;
                        	     5: ;   The PS/2 board keeps one byte: a byte not read within      ;
                        	     6: ;   ~1 ms is lost (a lost $F0 turns a release into a second    ;
                        	     7: ;   press). Two ways in, both on: the CA1 interrupt of the     ;
                        	     8: ;   keyboard VIA (IRQ -> BIOS -> JMP KB_IRQ at $0FA0) reads    ;
                        	     9: ;   every byte at once; KB_POLL, called by the long loops,     ;
                        	    10: ;   does the same if the IRQ line is not there. Assembled      ;
                        	    11: ;   with -DKB_NOIRQ=1 only the polling is left.                ;
                        	    12: ;   The keys decoded by the BIOS go into a 32-key queue,       ;
                        	    13: ;   GETKEY takes them out. KB_EXIT before leaving the app.     ;
                        	    14: ;   An app that uses the serial line itself defines KB_SERBUF  ;
                        	    15: ;   (256-byte ring): the received bytes go there, not among    ;
                        	    16: ;   the keys (JT_CHRIN reads the serial line first: a byte it  ;
                        	    17: ;   returns while CA1 is still set came from the serial line). ;
                        	    18: ;   Uses: zp $A0-$A1 ($F0-$F1 with KB_SERBUF), RAM $05C0-$05DF ;
                        	    19: ;                                                              ;
                        	    20: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    21: 
                        	    22: KQ          = $05C0    ; 32-key ring
                        	    23: KQ_MASK     = $1F
                        	    24: KQR         = $A0      ; read index
                        	    25: KQW         = $A1      ; write index
                        	    26: KB_IFR      = $D18D    ; keyboard VIA: interrupt flags (bit 1 = CA1)
                        	    27: KB_IER      = $D18E    ;               interrupt enable
                        	    28: KB_SRR      = $F0      ; serial ring (KB_SERBUF): read index
                        	    29: KB_SRW      = $F1      ;                          write index
                        	    30: 
                        	    31: ; KB_INIT: extended keyboard, empty queue, CA1 interrupt on
                        	    32: KB_INIT:
01:1DF1 78              	    33:   SEI
01:1DF2 A901            	    34:   LDA #1
01:1DF4 2021FD          	    35:   JSR JT_KB_MODE
01:1DF7 64A0            	    36:   STZ KQR
01:1DF9 64A1            	    37:   STZ KQW
01:1DFB 64F0            	    38:   STZ KB_SRR
01:1DFD 64F1            	    39:   STZ KB_SRW
                        	    40:  .ifndef KB_NOIRQ
01:1DFF A94C            	    41:   LDA #$4C               ; JMP KB_IRQ in the RAM vector of the BIOS
01:1E01 8DA00F          	    42:   STA IRQ_VEC
01:1E04 A921            	    43:   LDA #<KB_IRQ
01:1E06 8DA10F          	    44:   STA IRQ_VEC+1
01:1E09 A91E            	    45:   LDA #>KB_IRQ
01:1E0B 8DA20F          	    46:   STA IRQ_VEC+2
01:1E0E A982            	    47:   LDA #$82               ; CA1 interrupt enabled
01:1E10 8D8ED1          	    48:   STA KB_IER
01:1E13 58              	    49:   CLI
                        	    50:  .endif
01:1E14 60              	    51:   RTS
                        	    52: 
                        	    53: ; KB_EXIT: interrupt off again (the BIOS menu works by polling)
                        	    54: KB_EXIT:
01:1E15 78              	    55:   SEI
01:1E16 A902            	    56:   LDA #$02
01:1E18 8D8ED1          	    57:   STA KB_IER
01:1E1B A960            	    58:   LDA #$60               ; RTS
01:1E1D 8DA00F          	    59:   STA IRQ_VEC
01:1E20 60              	    60:   RTS
                        	    61: 
                        	    62: ; KB_IRQ: called by the BIOS IRQ handler (A, X, Y already saved)
                        	    63: KB_IRQ:
                        	    64:  .ifdef KB_SERBUF
                        	    65:   JMP KB_TAKE            ; the keyboard or the serial line
                        	    66:  .else
01:1E21 AD8DD1          	    67:   LDA KB_IFR
01:1E24 2902            	    68:   AND #$02
01:1E26 F003            	    69:   BEQ .ki_x
01:1E28 20391E          	    70:   JSR KB_TAKE
                        	    71: .ki_x:
01:1E2B 60              	    72:   RTS
                        	    73:  .endif
                        	    74: 
                        	    75: ; KB_POLL: one BIOS poll with the interrupt held off. Keeps A, X, Y and the I flag
                        	    76: KB_POLL:
01:1E2C 08              	    77:   PHP
01:1E2D 78              	    78:   SEI
01:1E2E 48              	    79:   PHA
01:1E2F DA              	    80:   PHX
01:1E30 5A              	    81:   PHY
01:1E31 20391E          	    82:   JSR KB_TAKE
01:1E34 7A              	    83:   PLY
01:1E35 FA              	    84:   PLX
01:1E36 68              	    85:   PLA
01:1E37 28              	    86:   PLP
01:1E38 60              	    87:   RTS
                        	    88: 
                        	    89: ; KB_TAKE: a key from the BIOS goes into the queue (full queue: dropped)
                        	    90: KB_TAKE:
                        	    91:  .ifdef KB_SERBUF
                        	    92: .kt_rx:
                        	    93:   LDA ACIA_STATUS        ; received bytes first, into their ring
                        	    94:   AND #$08
                        	    95:   BEQ .kt_kb
                        	    96:   LDA ACIA_DATA
                        	    97:   JSR KB_SERPUT
                        	    98:   BRA .kt_rx
                        	    99: .kt_kb:
                        	   100:   LDA KB_IFR
                        	   101:   AND #$02
                        	   102:   BEQ .kt_x
                        	   103:   JSR JT_CHRIN
                        	   104:   BCC .kt_x
                        	   105:   PHA
                        	   106:   LDA KB_IFR             ; CA1 still set: the BIOS took a serial byte, not the key
                        	   107:   AND #$02
                        	   108:   BEQ .kt_key
                        	   109:   PLA
                        	   110:   JSR KB_SERPUT
                        	   111:   BRA .kt_rx
                        	   112: .kt_key:
                        	   113:   PLA
                        	   114:  .else
01:1E39 2003FD          	   115:   JSR JT_CHRIN
01:1E3C 900F            	   116:   BCC .kt_x
                        	   117:  .endif
01:1E3E A6A1            	   118:   LDX KQW
01:1E40 9DC005          	   119:   STA KQ,X
01:1E43 8A              	   120:   TXA
01:1E44 1A              	   121:   INC A
01:1E45 291F            	   122:   AND #KQ_MASK
01:1E47 C5A0            	   123:   CMP KQR
01:1E49 F002            	   124:   BEQ .kt_x              ; full
01:1E4B 85A1            	   125:   STA KQW
                        	   126: .kt_x:
01:1E4D 60              	   127:   RTS
                        	   128: 
                        	   129:  .ifdef KB_SERBUF
                        	   130: ; KB_SERPUT: A into the serial ring (full: dropped)
                        	   131: KB_SERPUT:
                        	   132:   LDX KB_SRW
                        	   133:   STA KB_SERBUF,X
                        	   134:   INX
                        	   135:   CPX KB_SRR
                        	   136:   BEQ .ks_x
                        	   137:   STX KB_SRW
                        	   138: .ks_x:
                        	   139:   RTS
                        	   140: 
                        	   141: ; SERGET: C=1 and A = next received byte, C=0 none
                        	   142: SERGET:
                        	   143:   JSR KB_POLL
                        	   144:   LDX KB_SRR
                        	   145:   CPX KB_SRW
                        	   146:   BEQ .sg_n
                        	   147:   LDA KB_SERBUF,X
                        	   148:   INC KB_SRR
                        	   149:   SEC
                        	   150:   RTS
                        	   151: .sg_n:
                        	   152:   CLC
                        	   153:   RTS
                        	   154:  .endif
                        	   155: 
                        	   156: ; GETKEY: C=1 and A = key, C=0 queue empty (after one poll). Keeps X, Y
                        	   157: GETKEY:
01:1E4E 202C1E          	   158:   JSR KB_POLL
01:1E51 A5A0            	   159:   LDA KQR
01:1E53 C5A1            	   160:   CMP KQW
01:1E55 F010            	   161:   BEQ .gk_n
01:1E57 DA              	   162:   PHX
01:1E58 AA              	   163:   TAX
01:1E59 BDC005          	   164:   LDA KQ,X
01:1E5C 48              	   165:   PHA
01:1E5D 8A              	   166:   TXA
01:1E5E 1A              	   167:   INC A
01:1E5F 291F            	   168:   AND #KQ_MASK
01:1E61 85A0            	   169:   STA KQR
01:1E63 68              	   170:   PLA
01:1E64 FA              	   171:   PLX
01:1E65 38              	   172:   SEC
01:1E66 60              	   173:   RTS
                        	   174: .gk_n:
01:1E67 18              	   175:   CLC
01:1E68 60              	   176:   RTS
                        	   177: 
                        	   178: ; WAITKEY: A = next key
                        	   179: WAITKEY:
01:1E69 204E1E          	   180:   JSR GETKEY
01:1E6C 90FB            	   181:   BCC WAITKEY
01:1E6E 60              	   182:   RTS
                        	   183: 
                        	   184: ; KEYREADY: C=1 if a key is waiting in the queue
                        	   185: KEYREADY:
01:1E6F 202C1E          	   186:   JSR KB_POLL
01:1E72 A5A0            	   187:   LDA KQR
01:1E74 C5A1            	   188:   CMP KQW
01:1E76 18              	   189:   CLC
01:1E77 F001            	   190:   BEQ .kr_x
01:1E79 38              	   191:   SEC
                        	   192: .kr_x:
01:1E7A 60              	   193:   RTS
                        	   194: 

