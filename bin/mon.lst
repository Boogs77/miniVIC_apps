Sections:
00: "segfd0" (FD0-FD1)
01: "seg1000" (1000-260E)


Source: "apps\mon.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   MON  -  miniVIC MON, machine language monitor              ;
                        	     4: ;   (Supermon / VICMON style), 65C02 assembly                  ;
                        	     5: ;   Needs the BIOS 27.10.26 KEYB/SD                            ;
                        	     6: ;                                                              ;
                        	     7: ;   Commands (numbers in hex, $ optional):                     ;
                        	     8: ;     M [a [b]]   memory dump, 8 bytes and their text per row  ;
                        	     9: ;     : a bb ..   writes bytes from a                          ;
                        	    10: ;     D [a [b]]   disassembles (W65C02S, also RMB SMB BBR BBS) ;
                        	    11: ;     A a instr   assembles one instruction, then offers the   ;
                        	    12: ;                 next address (an empty line ends)            ;
                        	    13: ;     G a         JSR a; registers shown when it returns       ;
                        	    14: ;     R           registers of the last G                      ;
                        	    15: ;     F a b v     fills a..b with v                            ;
                        	    16: ;     T a b c     copies a..b to c (overlap safe)              ;
                        	    17: ;     H a b bb .. finds the bytes in a..b                      ;
                        	    18: ;     S name a b  saves a..b on the SD (document type 4)       ;
                        	    19: ;     L name [a]  loads it back (at its address, or at a)      ;
                        	    20: ;     X           back to the BIOS menu      ?  help           ;
                        	    21: ;   Esc stops a long listing.                                  ;
                        	    22: ;                                                              ;
                        	    23: ;   MEMORY                                                     ;
                        	    24: ;   $0050-$007F  zero page (lib $A0-$EF)                       ;
                        	    25: ;   $0210-$028F  output row, hunt bytes, name                  ;
                        	    26: ;   $0560-$05DF  console row and line, key queue (lib)         ;
                        	    27: ;   $0600-$09FF  SD index and sector buffer (S / L only)       ;
                        	    28: ;   $1000-...    the monitor; free for programs: $3000-$7FFF   ;
                        	    29: ;                                                              ;
                        	    30: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    31: 
                        	    32:  .include "lib/system.inc"

Source: "lib\system.inc"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   SYSTEM.INC  -  miniVIC / BO6502 addresses for the apps     ;
                        	     4: ;   BIOS 27.10.26 KEYB/SD jump table, VDP, key codes           ;
                        	     5: ;                                                              ;
                        	     6: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     7: 
                        	     8: ; ---------------- BIOS jump table ($FD00) ----------------
                        	     9: JT_CHROUT       = $FD00    ; A = char to screen AND serial (not used by the apps)
                        	    10: JT_CHRIN        = $FD03    ; C=1 and A = key, C=0 no key (serial first, then keyboard)
                        	    11: JT_INIT_CRT     = $FD09    ; text mode, VRAM and font of the BIOS
                        	    12: JT_SHOW_MENU    = $FD0F    ; back to the BIOS menu (never returns)
                        	    13: JT_SD_READ      = $FD18    ; sector SD_LBA -> buffer X/Y (lo/hi, 512 bytes), C=1 error
                        	    14: JT_SD_WRITE     = $FD1B    ; buffer X/Y -> sector SD_LBA, C=1 error
                        	    15: JT_SD_INIT      = $FD1E    ; C=0 and A = card type, C=1 no card
                        	    16: JT_KB_MODE      = $FD21    ; A<>0 extended keyboard, A=0 classic
                        	    17: SD_LBA          = $0316    ; 4 bytes, sector number, little endian
                        	    18: 
                        	    19: ; ---------------- RAM vectors (everything is polled) ----------------
                        	    20: IRQ_VEC         = $0FA0    ; JSR $0FA0 from the BIOS IRQ handler
                        	    21: NMI_VEC         = $0FD0    ; JSR $0FD0 from the BIOS NMI handler
                        	    22: 
                        	    23: ; ---------------- VDP TMS9918A ----------------
                        	    24: VDP_DATA        = $B000
                        	    25: VDP_REG         = $B001
                        	    26: VRAM_NAME       = $0800    ; name table of the BIOS text mode (40 x 24)
                        	    27: VRAM_FONT       = $0000    ; patterns 0-127 (BIOS font), 128-255 = inverse (made by VT_INIT)
                        	    28: 
                        	    29: ; ---------------- serial W65C51 ----------------
                        	    30: ACIA_DATA   = $C000
                        	    31: ACIA_STATUS = $C001    ; bit 3 = byte received
                        	    32: ACIA_CMD    = $C002    ; BIOS: $8B (no parity, receive IRQ off, DTR on)
                        	    33: ACIA_CTRL   = $C003    ; BIOS: $1F (19200, 8 bits, 1 stop)
                        	    34: 
                        	    35: ; ---------------- key codes (extended mode) ----------------
                        	    36: K_CR            = $0D
                        	    37: K_BS            = $08
                        	    38: K_TAB           = $09
                        	    39: K_ESC           = $1B
                        	    40: K_UP            = $80
                        	    41: K_DOWN          = $81
                        	    42: K_LEFT          = $82
                        	    43: K_RIGHT         = $83
                        	    44: K_HOME          = $84
                        	    45: K_END           = $85
                        	    46: K_PGUP          = $86
                        	    47: K_PGDN          = $87
                        	    48: K_INS           = $88
                        	    49: K_DEL           = $89
                        	    50: K_F1            = $90      ; F1-F12 = $90-$9B
                        	    51: 

Source: "apps\mon.asm"
                        	    33: 
                        	    34: ; ---------------- zero page ----------------
                        	    35: LP          = $50      ; position in the typed line
                        	    36: VAL         = $51      ; 2 bytes: last hex number read
                        	    37: A1          = $53      ; 2 bytes: arguments
                        	    38: A2          = $55
                        	    39: A3          = $57
                        	    40: DPC         = $59      ; 2 bytes: disassembly / assembly address
                        	    41: OPC         = $5B      ; opcode
                        	    42: MD          = $5C      ; addressing mode
                        	    43: MN          = $5D      ; mnemonic number
                        	    44: ILEN        = $5E      ; instruction length
                        	    45: OLEN        = $5F      ; length of OUTB
                        	    46: NEXTM       = $60      ; 2 bytes: where M goes on
                        	    47: NEXTD       = $62      ; 2 bytes: where D goes on
                        	    48: T0          = $64
                        	    49: T1          = $65
                        	    50: T2          = $66
                        	    51: NDIG        = $67      ; digits of the last number
                        	    52: GOVEC       = $68      ; 2 bytes
                        	    53: RA          = $6A      ; registers after G
                        	    54: RX          = $6B
                        	    55: RY          = $6C
                        	    56: RPS         = $6D
                        	    57: CNT         = $6E      ; 2 bytes
                        	    58: HN          = $70      ; hunt: bytes to find
                        	    59: BITN        = $71      ; RMB/SMB/BBR/BBS bit number
                        	    60: AMODE       = $72      ; assembler: mode wanted
                        	    61: AVAL        = $73      ; 2 bytes: operand
                        	    62: AVAL2       = $75      ; 2 bytes: second operand (BBR/BBS target)
                        	    63: DOCSLOT     = $77
                        	    64: 
                        	    65: ; ---------------- RAM ----------------
                        	    66: OUTB        = $0210    ; row being built (40)
                        	    67: HBYTES      = $0240    ; bytes to find (16)
                        	    68: NAMEB       = $0250    ; document name (12 + $00)
                        	    69: 
                        	    70:  .org $0FD0
00:0FD0 60              	    71:   RTS                    ; NMI trampoline (the VDP interrupt is off)
                        	    72:  .org $1000
                        	    73: 
                        	    74: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; start and command loop
                        	    75: 
                        	    76: RESET:
01:1000 78              	    77:   SEI
01:1001 D8              	    78:   CLD
01:1002 A2FF            	    79:   LDX #$FF
01:1004 9A              	    80:   TXS
01:1005 A960            	    81:   LDA #$60
01:1007 8DA00F          	    82:   STA IRQ_VEC
01:100A 207B1E          	    83:   JSR VT_INIT
01:100D 20F11D          	    84:   JSR KB_INIT
01:1010 A904            	    85:   LDA #4                 ; type 4 = memory (code)
01:1012 85B8            	    86:   STA DOC_T
01:1014 A900            	    87:   LDA #$00
01:1016 8560            	    88:   STA NEXTM
01:1018 8562            	    89:   STA NEXTD
01:101A A930            	    90:   LDA #$30
01:101C 8561            	    91:   STA NEXTM+1
01:101E 8563            	    92:   STA NEXTD+1
01:1020 20A91F          	    93:   JSR CON_CLS
01:1023 A9A5            	    94:   LDA #<M_HELLO
01:1025 A219            	    95:   LDX #>M_HELLO
01:1027 202420          	    96:   JSR CON_STR
01:102A 64EE            	    97:   STZ CON_LEN
                        	    98: LOOP:
01:102C A2FF            	    99:   LDX #$FF               ; (a G that did not come back cleanly cannot fill the stack)
01:102E 9A              	   100:   TXS
01:102F A926            	   101:   LDA #38
01:1031 85EF            	   102:   STA CON_MAX
01:1033 A92E            	   103:   LDA #'.'
01:1035 20B01F          	   104:   JSR CON_PUT
01:1038 205B20          	   105:   JSR CON_GETS           ; (CON_LEN > 0: a start text from the last command, see A)
01:103B 64EE            	   106:   STZ CON_LEN
01:103D 6450            	   107:   STZ LP
01:103F 209F10          	   108:   JSR SKIPSP
01:1042 F0E8            	   109:   BEQ LOOP
01:1044 E650            	   110:   INC LP
01:1046 A200            	   111:   LDX #0
                        	   112: .cl_t:
01:1048 BC7710          	   113:   LDY CMDTAB,X
01:104B F01D            	   114:   BEQ .cl_bad
01:104D DD7710          	   115:   CMP CMDTAB,X
01:1050 F005            	   116:   BEQ .cl_go
01:1052 E8              	   117:   INX
01:1053 E8              	   118:   INX
01:1054 E8              	   119:   INX
01:1055 80F1            	   120:   BRA .cl_t
                        	   121: .cl_go:
01:1057 BD7810          	   122:   LDA CMDTAB+1,X
01:105A 8568            	   123:   STA GOVEC
01:105C BD7910          	   124:   LDA CMDTAB+2,X
01:105F 8569            	   125:   STA GOVEC+1
01:1061 206710          	   126:   JSR .cl_jmp
01:1064 4C2C10          	   127:   JMP LOOP
                        	   128: .cl_jmp:
01:1067 6C6800          	   129:   JMP (GOVEC)
                        	   130: .cl_bad:
01:106A 4C6D10          	   131:   JMP ERROR
                        	   132: 
                        	   133: ; ERROR: "?" under the line
                        	   134: ERROR:
01:106D A9C4            	   135:   LDA #<M_ERR
01:106F A219            	   136:   LDX #>M_ERR
01:1071 202420          	   137:   JSR CON_STR
01:1074 4C2C10          	   138:   JMP LOOP
                        	   139: 
                        	   140: CMDTAB:
01:1077 4D              	   141:   .byte 'M'
01:1078 5911            	   142:   .word CMD_M
01:107A 3A              	   143:   .byte ':'
01:107B F211            	   144:   .word CMD_POKE
01:107D 44              	   145:   .byte 'D'
01:107E 6313            	   146:   .word CMD_D
01:1080 41              	   147:   .byte 'A'
01:1081 B215            	   148:   .word CMD_A
01:1083 47              	   149:   .byte 'G'
01:1084 1013            	   150:   .word CMD_G
01:1086 52              	   151:   .byte 'R'
01:1087 2F13            	   152:   .word CMD_R
01:1089 46              	   153:   .byte 'F'
01:108A 0412            	   154:   .word CMD_F
01:108C 54              	   155:   .byte 'T'
01:108D 2612            	   156:   .word CMD_T
01:108F 48              	   157:   .byte 'H'
01:1090 A612            	   158:   .word CMD_H
01:1092 53              	   159:   .byte 'S'
01:1093 9518            	   160:   .word CMD_S
01:1095 4C              	   161:   .byte 'L'
01:1096 1319            	   162:   .word CMD_L
01:1098 58              	   163:   .byte 'X'
01:1099 5D13            	   164:   .word CMD_X
01:109B 3F              	   165:   .byte '?'
01:109C 9E19            	   166:   .word CMD_HELP
01:109E 00              	   167:   .byte 0
                        	   168: 
                        	   169: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; reading the line
                        	   170: 
                        	   171: ; SKIPSP: A = next character that is not a space (Z=1 end of the line)
                        	   172: SKIPSP:
01:109F A450            	   173:   LDY LP
                        	   174: .sk_l:
01:10A1 B99005          	   175:   LDA CON_LINE,Y
01:10A4 C920            	   176:   CMP #' '
01:10A6 D005            	   177:   BNE .sk_x
01:10A8 C8              	   178:   INY
01:10A9 8450            	   179:   STY LP
01:10AB 80F4            	   180:   BRA .sk_l
                        	   181: .sk_x:
01:10AD C900            	   182:   CMP #0
01:10AF 60              	   183:   RTS
                        	   184: 
                        	   185: ; GETHEX: VAL = hex number at LP ($ allowed before it), NDIG = digits. C=1 none
                        	   186: GETHEX:
01:10B0 209F10          	   187:   JSR SKIPSP
01:10B3 C924            	   188:   CMP #'$'
01:10B5 D002            	   189:   BNE .gh_s
01:10B7 E650            	   190:   INC LP
                        	   191: .gh_s:
01:10B9 6451            	   192:   STZ VAL
01:10BB 6452            	   193:   STZ VAL+1
01:10BD 6467            	   194:   STZ NDIG
                        	   195: .gh_l:
01:10BF A450            	   196:   LDY LP
01:10C1 B99005          	   197:   LDA CON_LINE,Y
01:10C4 20E410          	   198:   JSR HEXDIG
01:10C7 B013            	   199:   BCS .gh_e
01:10C9 A204            	   200:   LDX #4
                        	   201: .gh_sh:
01:10CB 0651            	   202:   ASL VAL
01:10CD 2652            	   203:   ROL VAL+1
01:10CF CA              	   204:   DEX
01:10D0 D0F9            	   205:   BNE .gh_sh
01:10D2 0551            	   206:   ORA VAL
01:10D4 8551            	   207:   STA VAL
01:10D6 E650            	   208:   INC LP
01:10D8 E667            	   209:   INC NDIG
01:10DA 80E3            	   210:   BRA .gh_l
                        	   211: .gh_e:
01:10DC A567            	   212:   LDA NDIG
01:10DE F002            	   213:   BEQ .gh_no
01:10E0 18              	   214:   CLC
01:10E1 60              	   215:   RTS
                        	   216: .gh_no:
01:10E2 38              	   217:   SEC
01:10E3 60              	   218:   RTS
                        	   219: 
                        	   220: ; HEXDIG: A = value of the hex digit A, C=1 not a digit
                        	   221: HEXDIG:
01:10E4 C930            	   222:   CMP #'0'
01:10E6 9014            	   223:   BCC .hd_n
01:10E8 C93A            	   224:   CMP #'9'+1
01:10EA 900C            	   225:   BCC .hd_d
01:10EC C941            	   226:   CMP #'A'
01:10EE 900C            	   227:   BCC .hd_n
01:10F0 C947            	   228:   CMP #'F'+1
01:10F2 B008            	   229:   BCS .hd_n
01:10F4 E936            	   230:   SBC #'A'-10-1
01:10F6 18              	   231:   CLC
01:10F7 60              	   232:   RTS
                        	   233: .hd_d:
01:10F8 290F            	   234:   AND #$0F
01:10FA 18              	   235:   CLC
01:10FB 60              	   236:   RTS
                        	   237: .hd_n:
01:10FC 38              	   238:   SEC
01:10FD 60              	   239:   RTS
                        	   240: 
                        	   241: ; NEEDHEX: VAL = a hex number, or ERROR
                        	   242: NEEDHEX:
01:10FE 20B010          	   243:   JSR GETHEX
01:1101 B001            	   244:   BCS .nh_e
01:1103 60              	   245:   RTS
                        	   246: .nh_e:
01:1104 68              	   247:   PLA                    ; (drop the return address)
01:1105 68              	   248:   PLA
01:1106 4C6D10          	   249:   JMP ERROR
                        	   250: 
                        	   251: ; ARGS1-3: A1 [A2 [A3]] needed
                        	   252: ARG1:
01:1109 20FE10          	   253:   JSR NEEDHEX
01:110C A551            	   254:   LDA VAL
01:110E 8553            	   255:   STA A1
01:1110 A552            	   256:   LDA VAL+1
01:1112 8554            	   257:   STA A1+1
01:1114 60              	   258:   RTS
                        	   259: ARG2:
01:1115 200911          	   260:   JSR ARG1
01:1118 20B010          	   261:   JSR GETHEX
01:111B B009            	   262:   BCS ARG_ERR
01:111D A551            	   263:   LDA VAL
01:111F 8555            	   264:   STA A2
01:1121 A552            	   265:   LDA VAL+1
01:1123 8556            	   266:   STA A2+1
01:1125 60              	   267:   RTS
                        	   268: ARG_ERR:
01:1126 68              	   269:   PLA
01:1127 68              	   270:   PLA
01:1128 4C6D10          	   271:   JMP ERROR
                        	   272: ARG3:
01:112B 201511          	   273:   JSR ARG2
01:112E 20B010          	   274:   JSR GETHEX
01:1131 B0F3            	   275:   BCS ARG_ERR
01:1133 A551            	   276:   LDA VAL
01:1135 8557            	   277:   STA A3
01:1137 A552            	   278:   LDA VAL+1
01:1139 8558            	   279:   STA A3+1
01:113B 60              	   280:   RTS
                        	   281: 
                        	   282: ; A1LEA2: C=1 if A1 <= A2
                        	   283: A1LEA2:
01:113C A555            	   284:   LDA A2
01:113E C553            	   285:   CMP A1
01:1140 A556            	   286:   LDA A2+1
01:1142 E554            	   287:   SBC A1+1
01:1144 60              	   288:   RTS
                        	   289: 
                        	   290: INCA1:
01:1145 E653            	   291:   INC A1
01:1147 D002            	   292:   BNE .ia_x
01:1149 E654            	   293:   INC A1+1
                        	   294: .ia_x:
01:114B 60              	   295:   RTS
                        	   296: 
                        	   297: ; STOPKEY: C=1 if Esc was pressed (other keys are dropped)
                        	   298: STOPKEY:
01:114C 204E1E          	   299:   JSR GETKEY
01:114F 9006            	   300:   BCC .sk_n
01:1151 C91B            	   301:   CMP #K_ESC
01:1153 D0F7            	   302:   BNE STOPKEY
01:1155 38              	   303:   SEC
01:1156 60              	   304:   RTS
                        	   305: .sk_n:
01:1157 18              	   306:   CLC
01:1158 60              	   307:   RTS
                        	   308: 
                        	   309: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; M  :  F  T  H
                        	   310: 
                        	   311: CMD_M:
01:1159 20B010          	   312:   JSR GETHEX
01:115C B01C            	   313:   BCS .m_def
01:115E A551            	   314:   LDA VAL
01:1160 8553            	   315:   STA A1
01:1162 A552            	   316:   LDA VAL+1
01:1164 8554            	   317:   STA A1+1
01:1166 20B010          	   318:   JSR GETHEX
01:1169 9019            	   319:   BCC .m_b
                        	   320: .m_8:
01:116B 18              	   321:   CLC                    ; 8 rows
01:116C A553            	   322:   LDA A1
01:116E 693F            	   323:   ADC #$3F
01:1170 8555            	   324:   STA A2
01:1172 A554            	   325:   LDA A1+1
01:1174 6900            	   326:   ADC #0
01:1176 8556            	   327:   STA A2+1
01:1178 8012            	   328:   BRA .m_go
                        	   329: .m_def:
01:117A A560            	   330:   LDA NEXTM
01:117C 8553            	   331:   STA A1
01:117E A561            	   332:   LDA NEXTM+1
01:1180 8554            	   333:   STA A1+1
01:1182 80E7            	   334:   BRA .m_8
                        	   335: .m_b:
01:1184 A551            	   336:   LDA VAL
01:1186 8555            	   337:   STA A2
01:1188 A552            	   338:   LDA VAL+1
01:118A 8556            	   339:   STA A2+1
                        	   340: .m_go:
01:118C 20A811          	   341:   JSR MROW
01:118F 204C11          	   342:   JSR STOPKEY
01:1192 B00B            	   343:   BCS .m_x
01:1194 A553            	   344:   LDA A1                 ; past A2 (or wrapped)?
01:1196 0554            	   345:   ORA A1+1
01:1198 F005            	   346:   BEQ .m_x
01:119A 203C11          	   347:   JSR A1LEA2
01:119D B0ED            	   348:   BCS .m_go
                        	   349: .m_x:
01:119F A553            	   350:   LDA A1
01:11A1 8560            	   351:   STA NEXTM
01:11A3 A554            	   352:   LDA A1+1
01:11A5 8561            	   353:   STA NEXTM+1
01:11A7 60              	   354:   RTS
                        	   355: 
                        	   356: ; MROW: ":aaaa bb bb bb bb bb bb bb bb ........" for A1, A1 moves on by 8
                        	   357: MROW:
01:11A8 A93A            	   358:   LDA #':'
01:11AA 20B01F          	   359:   JSR CON_PUT
01:11AD A554            	   360:   LDA A1+1
01:11AF 203F20          	   361:   JSR CON_HEX
01:11B2 A553            	   362:   LDA A1
01:11B4 203F20          	   363:   JSR CON_HEX
01:11B7 A000            	   364:   LDY #0
                        	   365: .mr_b:
01:11B9 203520          	   366:   JSR CON_SP
01:11BC B153            	   367:   LDA (A1),Y
01:11BE 203F20          	   368:   JSR CON_HEX
01:11C1 C8              	   369:   INY
01:11C2 C008            	   370:   CPY #8
01:11C4 D0F3            	   371:   BNE .mr_b
01:11C6 203520          	   372:   JSR CON_SP
01:11C9 A000            	   373:   LDY #0
                        	   374: .mr_t:
01:11CB B153            	   375:   LDA (A1),Y
01:11CD 297F            	   376:   AND #$7F
01:11CF C920            	   377:   CMP #' '
01:11D1 B002            	   378:   BCS .mr_p
01:11D3 A92E            	   379:   LDA #'.'
                        	   380: .mr_p:
01:11D5 C97F            	   381:   CMP #$7F
01:11D7 D002            	   382:   BNE .mr_q
01:11D9 A92E            	   383:   LDA #'.'
                        	   384: .mr_q:
01:11DB 20B01F          	   385:   JSR CON_PUT
01:11DE C8              	   386:   INY
01:11DF C008            	   387:   CPY #8
