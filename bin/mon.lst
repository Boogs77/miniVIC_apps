Source: "lib\num.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   NUM.ASM  -  16-bit numbers to decimal text                 ;
                        	     4: ;   Uses: zp $A5-$A9                                           ;
                        	     5: ;                                                              ;
                        	     6: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     7: 
                        	     8: NUM         = $A5      ; 2 bytes: number to convert (destroyed)
                        	     9: BCD         = $A7      ; 3 bytes: BCD result, $A7 = lowest 2 digits
                        	    10: 
                        	    11: ; BIN2BCD: NUM -> BCD (double dabble with decimal mode)
                        	    12: BIN2BCD:
01:25AB 202C1E          	    13:   JSR KB_POLL
01:25AE 64A7            	    14:   STZ BCD
01:25B0 64A8            	    15:   STZ BCD+1
01:25B2 64A9            	    16:   STZ BCD+2
01:25B4 A210            	    17:   LDX #16
01:25B6 F8              	    18:   SED
                        	    19: .bb_l:
01:25B7 06A5            	    20:   ASL NUM
01:25B9 26A6            	    21:   ROL NUM+1
01:25BB A5A7            	    22:   LDA BCD
01:25BD 65A7            	    23:   ADC BCD
01:25BF 85A7            	    24:   STA BCD
01:25C1 A5A8            	    25:   LDA BCD+1
01:25C3 65A8            	    26:   ADC BCD+1
01:25C5 85A8            	    27:   STA BCD+1
01:25C7 A5A9            	    28:   LDA BCD+2
01:25C9 65A9            	    29:   ADC BCD+2
01:25CB 85A9            	    30:   STA BCD+2
01:25CD CA              	    31:   DEX
01:25CE D0E7            	    32:   BNE .bb_l
01:25D0 D8              	    33:   CLD
01:25D1 60              	    34:   RTS
                        	    35: 
                        	    36: ; NUMSTR: NUM -> 5 characters at (VT_P),Y.. with leading spaces (last digit always shown)
                        	    37: ; Y = first position; on exit Y = position after the number
                        	    38: NUMSTR:
01:25D2 20AB25          	    39:   JSR BIN2BCD
01:25D5 202C1E          	    40:   JSR KB_POLL            ; (BIN2BCD takes ~600 cycles)
01:25D8 A200            	    41:   LDX #0                 ; X = 1 once a digit is not zero
01:25DA A5A9            	    42:   LDA BCD+2
01:25DC 20FA25          	    43:   JSR .ns_dig            ; ten thousands
01:25DF A5A8            	    44:   LDA BCD+1
01:25E1 4A              	    45:   LSR
01:25E2 4A              	    46:   LSR
01:25E3 4A              	    47:   LSR
01:25E4 4A              	    48:   LSR
01:25E5 20FA25          	    49:   JSR .ns_dig
01:25E8 A5A8            	    50:   LDA BCD+1
01:25EA 20FA25          	    51:   JSR .ns_dig
01:25ED A5A7            	    52:   LDA BCD
01:25EF 4A              	    53:   LSR
01:25F0 4A              	    54:   LSR
01:25F1 4A              	    55:   LSR
01:25F2 4A              	    56:   LSR
01:25F3 20FA25          	    57:   JSR .ns_dig
01:25F6 A5A7            	    58:   LDA BCD
01:25F8 A201            	    59:   LDX #1                 ; the last digit is always written
                        	    60: .ns_dig:
01:25FA 290F            	    61:   AND #$0F
01:25FC D008            	    62:   BNE .ns_nz
01:25FE E000            	    63:   CPX #0
01:2600 D004            	    64:   BNE .ns_nz
01:2602 A920            	    65:   LDA #' '
01:2604 8004            	    66:   BRA .ns_put
                        	    67: .ns_nz:
01:2606 A201            	    68:   LDX #1
01:2608 0930            	    69:   ORA #'0'
                        	    70: .ns_put:
01:260A 91A2            	    71:   STA (VT_P),Y
01:260C C8              	    72:   INY
01:260D 60              	    73:   RTS
                        	    74: 

