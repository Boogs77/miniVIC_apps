01:233E 8096            	    91:   BRA .pr_draw
                        	    92: .pr_bs:
01:2340 A6B4            	    93:   LDX UI_PLEN
01:2342 F0CD            	    94:   BEQ .pr_k
01:2344 CA              	    95:   DEX
