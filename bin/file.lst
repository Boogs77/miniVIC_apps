Sections:
00: "segfd0" (FD0-FD1)
01: "seg1000" (1000-2626)


Source: "apps\file.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   FILE  -  miniVIC FILE, card file (PFS:File style)          ;
                        	     4: ;   65C02 assembly, TMS9918A text mode 40 x 24                 ;
                        	     5: ;   Needs the BIOS 27.10.26 KEYB/SD                            ;
                        	     6: ;                                                              ;
                        	     7: ;   - a form of up to 8 fields (name 10 chars, width 1-28);    ;
                        	     8: ;     at the start an address book form, ^KN designs another   ;
                        	     9: ;   - one card on the screen: arrows / Tab change field,       ;
                        	    10: ;     typing overwrites, PgUp PgDn change card, F3 new card,   ;
                        	    11: ;     F8 deletes it; F2 the list (one card per row)            ;
                        	    12: ;   - F4 find (any field, any case), F5 find again, F6 sort    ;
                        	    13: ;     by the field under the cursor (Shell sort of the order   ;
                        	    14: ;     table, the cards themselves do not move)                 ;
                        	    15: ;   - ^KS save, ^KA save as, ^KO open, ^KN new file, ^KX save  ;
                        	    16: ;     and exit, ^KQ quit: SD document of type 3                ;
                        	    17: ;                                                              ;
                        	    18: ;   MEMORY                                                     ;
                        	    19: ;   $0050-$009F  zero page (lib $A0-$EB)                       ;
                        	    20: ;   $0210-$029F  form: names, widths, offsets; name; find      ;
                        	    21: ;   $0600-$07FF  SD document index                             ;
                        	    22: ;   $0800-$09FF  sector buffer (lib/stream)                    ;
                        	    23: ;   $1000-...    code                                          ;
                        	    24: ;   $3000-$30FF  order of the cards (slot numbers)             ;
                        	    25: ;   $3100-$7FFF  cards: slot * record size (20224 bytes)       ;
                        	    26: ;                                                              ;
                        	    27: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    28: 
                        	    29:  .include "lib/system.inc"

Source: "lib\system.inc"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   SYSTEM.INC  -  miniVIC / BO6502 addresses for the apps     ;
                        	     4: ;   BIOS 27.10.26 KEYB/SD jump table, VDP, key codes           ;
                        	     5: ;                                                              ;
                        	     6: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     7: 
                        	     8: ; ---------------- BIOS jump table ($FD00) ----------------
                        	     9: JT_CHROUT       = $FD00    ; A = char to screen AND serial (not used by the apps)
                        	    10: JT_CHRIN        = $FD03    ; C=1 and A = key, C=0 no key (serial first, then keyboard)
                        	    11: JT_INIT_CRT     = $FD09    ; text mode, VRAM and font of the BIOS
                        	    12: JT_SHOW_MENU    = $FD0F    ; back to the BIOS menu (never returns)
                        	    13: JT_SD_READ      = $FD18    ; sector SD_LBA -> buffer X/Y (lo/hi, 512 bytes), C=1 error
                        	    14: JT_SD_WRITE     = $FD1B    ; buffer X/Y -> sector SD_LBA, C=1 error
                        	    15: JT_SD_INIT      = $FD1E    ; C=0 and A = card type, C=1 no card
                        	    16: JT_KB_MODE      = $FD21    ; A<>0 extended keyboard, A=0 classic
                        	    17: SD_LBA          = $0316    ; 4 bytes, sector number, little endian
                        	    18: 
                        	    19: ; ---------------- RAM vectors (everything is polled) ----------------
                        	    20: IRQ_VEC         = $0FA0    ; JSR $0FA0 from the BIOS IRQ handler
                        	    21: NMI_VEC         = $0FD0    ; JSR $0FD0 from the BIOS NMI handler
                        	    22: 
                        	    23: ; ---------------- VDP TMS9918A ----------------
                        	    24: VDP_DATA        = $B000
                        	    25: VDP_REG         = $B001
                        	    26: VRAM_NAME       = $0800    ; name table of the BIOS text mode (40 x 24)
                        	    27: VRAM_FONT       = $0000    ; patterns 0-127 (BIOS font), 128-255 = inverse (made by VT_INIT)
                        	    28: 
                        	    29: ; ---------------- serial W65C51 ----------------
                        	    30: ACIA_DATA   = $C000
                        	    31: ACIA_STATUS = $C001    ; bit 3 = byte received
                        	    32: ACIA_CMD    = $C002    ; BIOS: $8B (no parity, receive IRQ off, DTR on)
                        	    33: ACIA_CTRL   = $C003    ; BIOS: $1F (19200, 8 bits, 1 stop)
                        	    34: 
                        	    35: ; ---------------- key codes (extended mode) ----------------
                        	    36: K_CR            = $0D
                        	    37: K_BS            = $08
                        	    38: K_TAB           = $09
                        	    39: K_ESC           = $1B
                        	    40: K_UP            = $80
                        	    41: K_DOWN          = $81
                        	    42: K_LEFT          = $82
                        	    43: K_RIGHT         = $83
                        	    44: K_HOME          = $84
                        	    45: K_END           = $85
                        	    46: K_PGUP          = $86
                        	    47: K_PGDN          = $87
                        	    48: K_INS           = $88
                        	    49: K_DEL           = $89
                        	    50: K_F1            = $90      ; F1-F12 = $90-$9B
                        	    51: 

Source: "apps\file.asm"
                        	    30: 
                        	    31: ; ---------------- parameters ----------------
                        	    32: MAXF        = 8        ; fields
                        	    33: NAMEW       = 10       ; field name
                        	    34: MAXW        = 28       ; field width
                        	    35: ORDER       = $3000
                        	    36: DATA        = $3100
                        	    37: DATA_END    = $8000
                        	    38: MAXSLOTS    = 250
                        	    39: NAMELEN     = 12
                        	    40: FINDMAX     = 20
                        	    41: LROWS       = 20       ; list rows (screen rows 2-21)
                        	    42: 
                        	    43: ; ---------------- zero page ----------------
                        	    44: NF          = $50      ; fields
                        	    45: RS          = $51      ; record size
                        	    46: NREC        = $52      ; cards
                        	    47: CUR         = $53      ; card shown (position in ORDER)
                        	    48: FLD         = $54      ; field under the cursor
                        	    49: FPOS        = $55      ; cursor in the field
                        	    50: MODF        = $56
                        	    51: MAXREC      = $57
                        	    52: MSGP        = $58      ; 2 bytes
                        	    53: PREFIX      = $5A
                        	    54: RP          = $5B      ; 2 bytes: card
                        	    55: T0          = $5D
                        	    56: T1          = $5E
                        	    57: T2          = $5F
                        	    58: T3          = $60
                        	    59: P0          = $61      ; 2 bytes
                        	    60: P1          = $63      ; 2 bytes
                        	    61: FLEN        = $65
                        	    62: DOCSLOT     = $66
                        	    63: ROWI        = $67
                        	    64: LTOP        = $68      ; list: first row, selected card
                        	    65: LSEL        = $69
                        	    66: GAP         = $6A      ; sort
                        	    67: SI          = $6B
                        	    68: SJ          = $6C
                        	    69: STMP        = $6D
                        	    70: GI          = $6E
                        	    71: SFLD        = $6F
                        	    72: COLS        = $70      ; list: columns left in the row
                        	    73: SPT         = $71      ; SLOTPTR
                        	    74: 
                        	    75: ; ---------------- RAM ----------------
                        	    76: FNAME       = $0210    ; 8 x 10: field names
                        	    77: FWID        = $0260    ; 8 widths
                        	    78: FOFF        = $0268    ; 8 offsets in the card
                        	    79: DOCNAME     = $0270    ; 12 + $00
                        	    80: FINDBUF     = $0280    ; find string (upper case, 20 + $00)
                        	    81: FORMBAK     = $0900    ; copy of the form while a new one is typed (in the sector buffer)
                        	    82: 
                        	    83:  .org $0FD0
00:0FD0 60              	    84:   RTS                    ; NMI trampoline (the VDP interrupt is off)
                        	    85:  .org $1000
                        	    86: 
                        	    87: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; start and main loop
                        	    88: 
                        	    89: RESET:
01:1000 78              	    90:   SEI
01:1001 D8              	    91:   CLD
01:1002 A2FF            	    92:   LDX #$FF
01:1004 9A              	    93:   TXS
01:1005 A960            	    94:   LDA #$60
01:1007 8DA00F          	    95:   STA IRQ_VEC
01:100A 20BD1F          	    96:   JSR VT_INIT
01:100D 20331F          	    97:   JSR KB_INIT
01:1010 A903            	    98:   LDA #3                 ; type 3 = card file
01:1012 85B8            	    99:   STA DOC_T
01:1014 6465            	   100:   STZ FLEN
01:1016 645A            	   101:   STZ PREFIX
01:1018 A257            	   102:   LDX #DEFFORM_L-1       ; the address book form
                        	   103: .rs_f:
01:101A BDD21A          	   104:   LDA DEFFORM,X
01:101D 9D1002          	   105:   STA FNAME,X
01:1020 CA              	   106:   DEX
01:1021 10F7            	   107:   BPL .rs_f
01:1023 A907            	   108:   LDA #DEFNF
01:1025 8550            	   109:   STA NF
01:1027 20A210          	   110:   JSR FORMSET
01:102A 20D510          	   111:   JSR FILENEW
01:102D A92F            	   112:   LDA #<M_HELLO
01:102F A21B            	   113:   LDX #>M_HELLO
01:1031 205C13          	   114:   JSR SETMSG
                        	   115: MAIN:
01:1034 20CB11          	   116:   JSR DRAWCARD
01:1037 203C13          	   117:   JSR MSGLINE
                        	   118: IDLE:
01:103A 20901F          	   119:   JSR GETKEY
01:103D 90FB            	   120:   BCC IDLE
                        	   121: .mn_k:
01:103F 204C10          	   122:   JSR DOKEY
01:1042 20B11F          	   123:   JSR KEYREADY
01:1045 90ED            	   124:   BCC MAIN
01:1047 20901F          	   125:   JSR GETKEY
01:104A 80F3            	   126:   BRA .mn_k
                        	   127: 
                        	   128: ; DOKEY: key A
                        	   129: DOKEY:
01:104C 6459            	   130:   STZ MSGP+1
01:104E A65A            	   131:   LDX PREFIX
01:1050 F029            	   132:   BEQ .dk_n
01:1052 645A            	   133:   STZ PREFIX
01:1054 205223          	   134:   JSR UI_UPC
01:1057 C91B            	   135:   CMP #$1B               ; (Ctrl+letter as the letter)
01:1059 B002            	   136:   BCS .dk_kl
01:105B 0940            	   137:   ORA #$40
                        	   138: .dk_kl:
01:105D A200            	   139:   LDX #0
                        	   140: .dk_kt:
01:105F BCBC1A          	   141:   LDY KTAB,X
01:1062 F037            	   142:   BEQ .dk_x
01:1064 DDBC1A          	   143:   CMP KTAB,X
01:1067 F005            	   144:   BEQ .dk_kg
01:1069 E8              	   145:   INX
01:106A E8              	   146:   INX
01:106B E8              	   147:   INX
01:106C 80F1            	   148:   BRA .dk_kt
                        	   149: .dk_kg:
01:106E BDBD1A          	   150:   LDA KTAB+1,X
01:1071 8561            	   151:   STA P0
01:1073 BDBE1A          	   152:   LDA KTAB+2,X
01:1076 8562            	   153:   STA P0+1
01:1078 6C6100          	   154:   JMP (P0)
                        	   155: .dk_n:
01:107B C920            	   156:   CMP #' '
01:107D 9007            	   157:   BCC .dk_c
01:107F C97F            	   158:   CMP #$7F
01:1081 B008            	   159:   BCS .dk_e
01:1083 4C7A13          	   160:   JMP TYPECH
                        	   161: .dk_c:
01:1086 0A              	   162:   ASL
01:1087 AA              	   163:   TAX
01:1088 7C441A          	   164:   JMP (CTRLTAB,X)
                        	   165: .dk_e:
01:108B C980            	   166:   CMP #K_UP
01:108D 900C            	   167:   BCC .dk_x
01:108F C99C            	   168:   CMP #K_F1+12
01:1091 B008            	   169:   BCS .dk_x
01:1093 38              	   170:   SEC
01:1094 E980            	   171:   SBC #K_UP
01:1096 0A              	   172:   ASL
01:1097 AA              	   173:   TAX
01:1098 7C841A          	   174:   JMP (EXTTAB,X)
                        	   175: .dk_x:
01:109B 60              	   176:   RTS
                        	   177: 
                        	   178: NOP_CMD:
01:109C 60              	   179:   RTS
                        	   180: 
                        	   181: CMD_PFXK:
01:109D A94B            	   182:   LDA #'K'
01:109F 855A            	   183:   STA PREFIX
01:10A1 60              	   184:   RTS
                        	   185: 
                        	   186: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; form and cards
                        	   187: 
                        	   188: ; FORMSET: offsets, record size, how many cards fit
                        	   189: FORMSET:
01:10A2 A200            	   190:   LDX #0
01:10A4 A900            	   191:   LDA #0
                        	   192: .fs_l:
01:10A6 9D6802          	   193:   STA FOFF,X
01:10A9 18              	   194:   CLC
01:10AA 7D6002          	   195:   ADC FWID,X
01:10AD E8              	   196:   INX
01:10AE E450            	   197:   CPX NF
01:10B0 D0F4            	   198:   BNE .fs_l
01:10B2 8551            	   199:   STA RS
01:10B4 A900            	   200:   LDA #<(DATA_END-DATA)  ; MAXREC = space / RS (250 at most)
01:10B6 8561            	   201:   STA P0
01:10B8 A94F            	   202:   LDA #>(DATA_END-DATA)
01:10BA 8562            	   203:   STA P0+1
01:10BC A200            	   204:   LDX #0
                        	   205: .fs_m:
01:10BE 38              	   206:   SEC
01:10BF A561            	   207:   LDA P0
01:10C1 E551            	   208:   SBC RS
01:10C3 8561            	   209:   STA P0
01:10C5 A562            	   210:   LDA P0+1
01:10C7 E900            	   211:   SBC #0
01:10C9 8562            	   212:   STA P0+1
01:10CB 9005            	   213:   BCC .fs_x
01:10CD E8              	   214:   INX
01:10CE E0FA            	   215:   CPX #MAXSLOTS
01:10D0 D0EC            	   216:   BNE .fs_m
                        	   217: .fs_x:
01:10D2 8657            	   218:   STX MAXREC
01:10D4 60              	   219:   RTS
                        	   220: 
                        	   221: ; FILENEW: no cards but one blank, no name
                        	   222: FILENEW:
01:10D5 6452            	   223:   STZ NREC
01:10D7 6453            	   224:   STZ CUR
01:10D9 6454            	   225:   STZ FLD
01:10DB 6455            	   226:   STZ FPOS
01:10DD 6466            	   227:   STZ DOCSLOT
01:10DF A20C            	   228:   LDX #NAMELEN
                        	   229: .fn_n:
01:10E1 9E7002          	   230:   STZ DOCNAME,X
01:10E4 CA              	   231:   DEX
01:10E5 10FA            	   232:   BPL .fn_n
01:10E7 202111          	   233:   JSR ADDREC
01:10EA 6456            	   234:   STZ MODF
01:10EC 60              	   235:   RTS
                        	   236: 
                        	   237: ; SLOTPTR: RP = DATA + A * RS
                        	   238: SLOTPTR:
01:10ED 8571            	   239:   STA SPT
01:10EF 645B            	   240:   STZ RP
01:10F1 645C            	   241:   STZ RP+1
01:10F3 A208            	   242:   LDX #8
                        	   243: .sp_l:
01:10F5 065B            	   244:   ASL RP
01:10F7 265C            	   245:   ROL RP+1
01:10F9 0671            	   246:   ASL SPT
01:10FB 900B            	   247:   BCC .sp_n
01:10FD 18              	   248:   CLC
01:10FE A55B            	   249:   LDA RP
01:1100 6551            	   250:   ADC RS
01:1102 855B            	   251:   STA RP
01:1104 9002            	   252:   BCC .sp_n
01:1106 E65C            	   253:   INC RP+1
                        	   254: .sp_n:
01:1108 CA              	   255:   DEX
01:1109 D0EA            	   256:   BNE .sp_l
01:110B 18              	   257:   CLC
01:110C A55B            	   258:   LDA RP
01:110E 6900            	   259:   ADC #<DATA
01:1110 855B            	   260:   STA RP
01:1112 A55C            	   261:   LDA RP+1
01:1114 6931            	   262:   ADC #>DATA
01:1116 855C            	   263:   STA RP+1
01:1118 60              	   264:   RTS
                        	   265: 
                        	   266: ; CURPTR: RP = card shown
                        	   267: CURPTR:
01:1119 A653            	   268:   LDX CUR
01:111B BD0030          	   269:   LDA ORDER,X
01:111E 4CED10          	   270:   JMP SLOTPTR
                        	   271: 
                        	   272: ; ADDREC: a blank card after the one shown (or the first). C=1 full
                        	   273: ADDREC:
01:1121 A552            	   274:   LDA NREC
01:1123 C557            	   275:   CMP MAXREC
01:1125 9009            	   276:   BCC .ar_ok
01:1127 A91A            	   277:   LDA #<M_FULL
01:1129 A21C            	   278:   LDX #>M_FULL
01:112B 205C13          	   279:   JSR SETMSG
01:112E 38              	   280:   SEC
01:112F 60              	   281:   RTS
                        	   282: .ar_ok:
01:1130 A552            	   283:   LDA NREC               ; where it goes in the order
01:1132 F003            	   284:   BEQ .ar_p
01:1134 A553            	   285:   LDA CUR
01:1136 1A              	   286:   INC A
                        	   287: .ar_p:
01:1137 855E            	   288:   STA T1
01:1139 A652            	   289:   LDX NREC               ; move the order up from there
                        	   290: .ar_m:
01:113B E45E            	   291:   CPX T1
01:113D F009            	   292:   BEQ .ar_s
01:113F BDFF2F          	   293:   LDA ORDER-1,X
01:1142 9D0030          	   294:   STA ORDER,X
01:1145 CA              	   295:   DEX
01:1146 80F3            	   296:   BRA .ar_m
                        	   297: .ar_s:
01:1148 A552            	   298:   LDA NREC               ; its slot is the first free one: NREC
01:114A 9D0030          	   299:   STA ORDER,X
01:114D 20ED10          	   300:   JSR SLOTPTR
01:1150 A451            	   301:   LDY RS
01:1152 A920            	   302:   LDA #' '
                        	   303: .ar_b:
01:1154 88              	   304:   DEY
01:1155 915B            	   305:   STA (RP),Y
01:1157 D0FB            	   306:   BNE .ar_b
01:1159 E652            	   307:   INC NREC
01:115B A55E            	   308:   LDA T1
01:115D 8553            	   309:   STA CUR
01:115F 6454            	   310:   STZ FLD
01:1161 6455            	   311:   STZ FPOS
01:1163 A901            	   312:   LDA #1
01:1165 8556            	   313:   STA MODF
01:1167 18              	   314:   CLC
01:1168 60              	   315:   RTS
                        	   316: 
                        	   317: ; DELREC: deletes the card shown; the last slot moves into its place
                        	   318: DELREC:
01:1169 A653            	   319:   LDX CUR
01:116B BD0030          	   320:   LDA ORDER,X
01:116E 855F            	   321:   STA T2                 ; its slot
                        	   322: .dr_m:
01:1170 BD0130          	   323:   LDA ORDER+1,X          ; order down from CUR
01:1173 9D0030          	   324:   STA ORDER,X
01:1176 E8              	   325:   INX
01:1177 E452            	   326:   CPX NREC
01:1179 90F5            	   327:   BCC .dr_m
01:117B C652            	   328:   DEC NREC
01:117D A55F            	   329:   LDA T2
01:117F C552            	   330:   CMP NREC
01:1181 F02E            	   331:   BEQ .dr_d              ; it was the last slot
01:1183 A552            	   332:   LDA NREC               ; card of the last slot -> slot T2
01:1185 20ED10          	   333:   JSR SLOTPTR
01:1188 A55B            	   334:   LDA RP
01:118A 8561            	   335:   STA P0
01:118C A55C            	   336:   LDA RP+1
01:118E 8562            	   337:   STA P0+1
01:1190 A55F            	   338:   LDA T2
01:1192 20ED10          	   339:   JSR SLOTPTR
01:1195 A000            	   340:   LDY #0
                        	   341: .dr_c:
01:1197 B161            	   342:   LDA (P0),Y
01:1199 915B            	   343:   STA (RP),Y
01:119B C8              	   344:   INY
01:119C C451            	   345:   CPY RS
01:119E D0F7            	   346:   BNE .dr_c
01:11A0 A200            	   347:   LDX #0                 ; and the order points to its new slot
                        	   348: .dr_f:
01:11A2 BD0030          	   349:   LDA ORDER,X
01:11A5 C552            	   350:   CMP NREC
01:11A7 F003            	   351:   BEQ .dr_o
01:11A9 E8              	   352:   INX
01:11AA 80F6            	   353:   BRA .dr_f
                        	   354: .dr_o:
01:11AC A55F            	   355:   LDA T2
01:11AE 9D0030          	   356:   STA ORDER,X
                        	   357: .dr_d:
01:11B1 A901            	   358:   LDA #1
01:11B3 8556            	   359:   STA MODF
01:11B5 A552            	   360:   LDA NREC
01:11B7 D004            	   361:   BNE .dr_c2
01:11B9 202111          	   362:   JSR ADDREC             ; never without a card
01:11BC 60              	   363:   RTS
                        	   364: .dr_c2:
01:11BD A553            	   365:   LDA CUR
01:11BF C552            	   366:   CMP NREC
01:11C1 9005            	   367:   BCC .dr_x
01:11C3 A552            	   368:   LDA NREC
01:11C5 3A              	   369:   DEC A
01:11C6 8553            	   370:   STA CUR
                        	   371: .dr_x:
01:11C8 6455            	   372:   STZ FPOS
01:11CA 60              	   373:   RTS
                        	   374: 
                        	   375: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; card screen
                        	   376: 
                        	   377: ; DRAWCARD: status, the fields of the card, the hint
                        	   378: DRAWCARD:
01:11CB 209112          	   379:   JSR STATUS
01:11CE A901            	   380:   LDA #1
01:11D0 203820          	   381:   JSR VT_ROW
01:11D3 A920            	   382:   LDA #' '
01:11D5 A228            	   383:   LDX #40
01:11D7 205720          	   384:   JSR VT_REP
01:11DA 201911          	   385:   JSR CURPTR
01:11DD 6467            	   386:   STZ ROWI
                        	   387: .dc_r:
01:11DF A567            	   388:   LDA ROWI               ; screen rows 2, 4, 6 ...: field ROWI
01:11E1 0A              	   389:   ASL
01:11E2 18              	   390:   CLC
01:11E3 6902            	   391:   ADC #2
01:11E5 203820          	   392:   JSR VT_ROW
