01:22E8 84B6            	    46:   STY UI_ROW             ; (column)
01:22EA A200            	    47:   LDX #0
                        	    48: .pr_c:
01:22EC E4B4            	    49:   CPX UI_PLEN
01:22EE F00B            	    50:   BEQ .pr_cur
01:22F0 BDD802          	    51:   LDA UI_BUF,X
01:22F3 8D00B0          	    52:   STA VDP_DATA
01:22F6 E8              	    53:   INX
01:22F7 E6B6            	    54:   INC UI_ROW
01:22F9 80F1            	    55:   BRA .pr_c
                        	    56: .pr_cur:
