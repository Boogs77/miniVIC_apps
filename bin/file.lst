Source: "lib\keys.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   KEYS.ASM  -  key queue on top of the BIOS                  ;
                        	     4: ;                                                              ;
                        	     5: ;   The PS/2 board keeps one byte: a byte not read within      ;
                        	     6: ;   ~1 ms is lost (a lost $F0 turns a release into a second    ;
                        	     7: ;   press). Two ways in, both on: the CA1 interrupt of the     ;
                        	     8: ;   keyboard VIA (IRQ -> BIOS -> JMP KB_IRQ at $0FA0) reads    ;
                        	     9: ;   every byte at once; KB_POLL, called by the long loops,     ;
                        	    10: ;   does the same if the IRQ line is not there. Assembled      ;
                        	    11: ;   with -DKB_NOIRQ=1 only the polling is left.                ;
                        	    12: ;   The keys decoded by the BIOS go into a 32-key queue,       ;
                        	    13: ;   GETKEY takes them out. KB_EXIT before leaving the app.     ;
                        	    14: ;   An app that uses the serial line itself defines KB_SERBUF  ;
                        	    15: ;   (256-byte ring): the received bytes go there, not among    ;
                        	    16: ;   the keys (JT_CHRIN reads the serial line first: a byte it  ;
                        	    17: ;   returns while CA1 is still set came from the serial line). ;
                        	    18: ;   Uses: zp $A0-$A1 ($F0-$F1 with KB_SERBUF), RAM $05C0-$05DF ;
                        	    19: ;                                                              ;
                        	    20: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    21: 
                        	    22: KQ          = $05C0    ; 32-key ring
                        	    23: KQ_MASK     = $1F
                        	    24: KQR         = $A0      ; read index
                        	    25: KQW         = $A1      ; write index
                        	    26: KB_IFR      = $D18D    ; keyboard VIA: interrupt flags (bit 1 = CA1)
                        	    27: KB_IER      = $D18E    ;               interrupt enable
                        	    28: KB_SRR      = $F0      ; serial ring (KB_SERBUF): read index
                        	    29: KB_SRW      = $F1      ;                          write index
                        	    30: 
                        	    31: ; KB_INIT: extended keyboard, empty queue, CA1 interrupt on
                        	    32: KB_INIT:
01:1F33 78              	    33:   SEI
01:1F34 A901            	    34:   LDA #1
01:1F36 2021FD          	    35:   JSR JT_KB_MODE
01:1F39 64A0            	    36:   STZ KQR
01:1F3B 64A1            	    37:   STZ KQW
01:1F3D 64F0            	    38:   STZ KB_SRR
01:1F3F 64F1            	    39:   STZ KB_SRW
                        	    40:  .ifndef KB_NOIRQ
01:1F41 A94C            	    41:   LDA #$4C               ; JMP KB_IRQ in the RAM vector of the BIOS
01:1F43 8DA00F          	    42:   STA IRQ_VEC
01:1F46 A963            	    43:   LDA #<KB_IRQ
01:1F48 8DA10F          	    44:   STA IRQ_VEC+1
01:1F4B A91F            	    45:   LDA #>KB_IRQ
01:1F4D 8DA20F          	    46:   STA IRQ_VEC+2
01:1F50 A982            	    47:   LDA #$82               ; CA1 interrupt enabled
01:1F52 8D8ED1          	    48:   STA KB_IER
01:1F55 58              	    49:   CLI
                        	    50:  .endif
01:1F56 60              	    51:   RTS
                        	    52: 
                        	    53: ; KB_EXIT: interrupt off again (the BIOS menu works by polling)
                        	    54: KB_EXIT:
01:1F57 78              	    55:   SEI
01:1F58 A902            	    56:   LDA #$02
01:1F5A 8D8ED1          	    57:   STA KB_IER
01:1F5D A960            	    58:   LDA #$60               ; RTS
01:1F5F 8DA00F          	    59:   STA IRQ_VEC
01:1F62 60              	    60:   RTS
                        	    61: 
                        	    62: ; KB_IRQ: called by the BIOS IRQ handler (A, X, Y already saved)
                        	    63: KB_IRQ:
                        	    64:  .ifdef KB_SERBUF
                        	    65:   JMP KB_TAKE            ; the keyboard or the serial line
                        	    66:  .else
01:1F63 AD8DD1          	    67:   LDA KB_IFR
01:1F66 2902            	    68:   AND #$02
01:1F68 F003            	    69:   BEQ .ki_x
01:1F6A 207B1F          	    70:   JSR KB_TAKE
                        	    71: .ki_x:
01:1F6D 60              	    72:   RTS
                        	    73:  .endif
                        	    74: 
                        	    75: ; KB_POLL: one BIOS poll with the interrupt held off. Keeps A, X, Y and the I flag
                        	    76: KB_POLL:
01:1F6E 08              	    77:   PHP
01:1F6F 78              	    78:   SEI
01:1F70 48              	    79:   PHA
01:1F71 DA              	    80:   PHX
01:1F72 5A              	    81:   PHY
01:1F73 207B1F          	    82:   JSR KB_TAKE
01:1F76 7A              	    83:   PLY
01:1F77 FA              	    84:   PLX
01:1F78 68              	    85:   PLA
01:1F79 28              	    86:   PLP
01:1F7A 60              	    87:   RTS
                        	    88: 
                        	    89: ; KB_TAKE: a key from the BIOS goes into the queue (full queue: dropped)
                        	    90: KB_TAKE:
                        	    91:  .ifdef KB_SERBUF
                        	    92: .kt_rx:
                        	    93:   LDA ACIA_STATUS        ; received bytes first, into their ring
                        	    94:   AND #$08
                        	    95:   BEQ .kt_kb
                        	    96:   LDA ACIA_DATA
                        	    97:   JSR KB_SERPUT
                        	    98:   BRA .kt_rx
                        	    99: .kt_kb:
                        	   100:   LDA KB_IFR
                        	   101:   AND #$02
                        	   102:   BEQ .kt_x
                        	   103:   JSR JT_CHRIN
                        	   104:   BCC .kt_x
                        	   105:   PHA
                        	   106:   LDA KB_IFR             ; CA1 still set: the BIOS took a serial byte, not the key
                        	   107:   AND #$02
                        	   108:   BEQ .kt_key
                        	   109:   PLA
                        	   110:   JSR KB_SERPUT
                        	   111:   BRA .kt_rx
                        	   112: .kt_key:
                        	   113:   PLA
                        	   114:  .else
01:1F7B 2003FD          	   115:   JSR JT_CHRIN
01:1F7E 900F            	   116:   BCC .kt_x
                        	   117:  .endif
01:1F80 A6A1            	   118:   LDX KQW
01:1F82 9DC005          	   119:   STA KQ,X
01:1F85 8A              	   120:   TXA
01:1F86 1A              	   121:   INC A
01:1F87 291F            	   122:   AND #KQ_MASK
01:1F89 C5A0            	   123:   CMP KQR
01:1F8B F002            	   124:   BEQ .kt_x              ; full
01:1F8D 85A1            	   125:   STA KQW
                        	   126: .kt_x:
01:1F8F 60              	   127:   RTS
                        	   128: 
                        	   129:  .ifdef KB_SERBUF
                        	   130: ; KB_SERPUT: A into the serial ring (full: dropped)
                        	   131: KB_SERPUT:
                        	   132:   LDX KB_SRW
                        	   133:   STA KB_SERBUF,X
                        	   134:   INX
                        	   135:   CPX KB_SRR
                        	   136:   BEQ .ks_x
                        	   137:   STX KB_SRW
                        	   138: .ks_x:
                        	   139:   RTS
                        	   140: 
                        	   141: ; SERGET: C=1 and A = next received byte, C=0 none
                        	   142: SERGET:
                        	   143:   JSR KB_POLL
                        	   144:   LDX KB_SRR
                        	   145:   CPX KB_SRW
                        	   146:   BEQ .sg_n
                        	   147:   LDA KB_SERBUF,X
                        	   148:   INC KB_SRR
                        	   149:   SEC
                        	   150:   RTS
                        	   151: .sg_n:
                        	   152:   CLC
                        	   153:   RTS
                        	   154:  .endif
                        	   155: 
                        	   156: ; GETKEY: C=1 and A = key, C=0 queue empty (after one poll). Keeps X, Y
                        	   157: GETKEY:
01:1F90 206E1F          	   158:   JSR KB_POLL
01:1F93 A5A0            	   159:   LDA KQR
01:1F95 C5A1            	   160:   CMP KQW
01:1F97 F010            	   161:   BEQ .gk_n
01:1F99 DA              	   162:   PHX
01:1F9A AA              	   163:   TAX
01:1F9B BDC005          	   164:   LDA KQ,X
01:1F9E 48              	   165:   PHA
01:1F9F 8A              	   166:   TXA
01:1FA0 1A              	   167:   INC A
01:1FA1 291F            	   168:   AND #KQ_MASK
01:1FA3 85A0            	   169:   STA KQR
01:1FA5 68              	   170:   PLA
01:1FA6 FA              	   171:   PLX
01:1FA7 38              	   172:   SEC
01:1FA8 60              	   173:   RTS
                        	   174: .gk_n:
01:1FA9 18              	   175:   CLC
01:1FAA 60              	   176:   RTS
                        	   177: 
                        	   178: ; WAITKEY: A = next key
                        	   179: WAITKEY:
01:1FAB 20901F          	   180:   JSR GETKEY
01:1FAE 90FB            	   181:   BCC WAITKEY
01:1FB0 60              	   182:   RTS
                        	   183: 
                        	   184: ; KEYREADY: C=1 if a key is waiting in the queue
                        	   185: KEYREADY:
01:1FB1 206E1F          	   186:   JSR KB_POLL
01:1FB4 A5A0            	   187:   LDA KQR
01:1FB6 C5A1            	   188:   CMP KQW
01:1FB8 18              	   189:   CLC
01:1FB9 F001            	   190:   BEQ .kr_x
01:1FBB 38              	   191:   SEC
                        	   192: .kr_x:
01:1FBC 60              	   193:   RTS
                        	   194: 

Source: "apps\file.asm"
                        	  1760:  .include "lib/vtext.asm"

Source: "lib\vtext.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   VTEXT.ASM  -  40 x 24 text screen on the TMS9918A          ;
                        	     4: ;                                                              ;
                        	     5: ;   BIOS text mode (VDP interrupt off, so the main loop can    ;
                        	     6: ;   write the VRAM at any time). VT_INIT also builds the       ;
                        	     7: ;   inverse font: codes $80-$FF = codes $00-$7F inverted,      ;
                        	     8: ;   used for the cursor, the status bar and the marked block.  ;
                        	     9: ;   Long loops call KB_POLL (lib/keys.asm).                    ;
                        	    10: ;   Uses: zp $A2-$A4, RAM $0800-$0BFF only inside VT_INIT      ;
                        	    11: ;                                                              ;
                        	    12: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    13: 
                        	    14: VT_P        = $A2      ; 2 bytes: string pointer
                        	    15: VT_INV      = $A4      ; ORed to every character of VT_STR ($80 = inverse)
                        	    16: VT_FONTTMP  = $0800    ; RAM copy of the font (1 KB, only during VT_INIT)
                        	    17: 
                        	    18: ; VT_INIT: text mode of the BIOS, inverse font, empty screen
                        	    19: VT_INIT:
01:1FBD 2009FD          	    20:   JSR JT_INIT_CRT
01:1FC0 A900            	    21:   LDA #<VRAM_FONT        ; read patterns 0-127 (1 KB)
01:1FC2 A200            	    22:   LDX #>VRAM_FONT
01:1FC4 203120          	    23:   JSR VT_RADDR
01:1FC7 A200            	    24:   LDX #0                 ; (the VRAM address increases by itself)
                        	    25: .vi_r0:
01:1FC9 AD00B0          	    26:   LDA VDP_DATA
01:1FCC 9D0008          	    27:   STA VT_FONTTMP,X
01:1FCF E8              	    28:   INX
01:1FD0 D0F7            	    29:   BNE .vi_r0
                        	    30: .vi_r1:
01:1FD2 AD00B0          	    31:   LDA VDP_DATA
01:1FD5 9D0009          	    32:   STA VT_FONTTMP+$100,X
01:1FD8 E8              	    33:   INX
01:1FD9 D0F7            	    34:   BNE .vi_r1
                        	    35: .vi_r2:
01:1FDB AD00B0          	    36:   LDA VDP_DATA
01:1FDE 9D000A          	    37:   STA VT_FONTTMP+$200,X
01:1FE1 E8              	    38:   INX
01:1FE2 D0F7            	    39:   BNE .vi_r2
                        	    40: .vi_r3:
01:1FE4 AD00B0          	    41:   LDA VDP_DATA
01:1FE7 9D000B          	    42:   STA VT_FONTTMP+$300,X
01:1FEA E8              	    43:   INX
01:1FEB D0F7            	    44:   BNE .vi_r3
01:1FED A900            	    45:   LDA #<(VRAM_FONT+$400) ; inverted copy at pattern 128
01:1FEF A204            	    46:   LDX #>(VRAM_FONT+$400)
01:1FF1 202720          	    47:   JSR VT_WADDR
01:1FF4 A200            	    48:   LDX #0
                        	    49: .vi_w0:
01:1FF6 BD0008          	    50:   LDA VT_FONTTMP,X
01:1FF9 49FF            	    51:   EOR #$FF
01:1FFB 8D00B0          	    52:   STA VDP_DATA
01:1FFE E8              	    53:   INX
01:1FFF D0F5            	    54:   BNE .vi_w0
                        	    55: .vi_w1:
01:2001 BD0009          	    56:   LDA VT_FONTTMP+$100,X
01:2004 49FF            	    57:   EOR #$FF
01:2006 8D00B0          	    58:   STA VDP_DATA
01:2009 E8              	    59:   INX
01:200A D0F5            	    60:   BNE .vi_w1
                        	    61: .vi_w2:
01:200C BD000A          	    62:   LDA VT_FONTTMP+$200,X
01:200F 49FF            	    63:   EOR #$FF
01:2011 8D00B0          	    64:   STA VDP_DATA
01:2014 E8              	    65:   INX
01:2015 D0F5            	    66:   BNE .vi_w2
                        	    67: .vi_w3:
01:2017 BD000B          	    68:   LDA VT_FONTTMP+$300,X
01:201A 49FF            	    69:   EOR #$FF
01:201C 8D00B0          	    70:   STA VDP_DATA
01:201F E8              	    71:   INX
01:2020 D0F5            	    72:   BNE .vi_w3
01:2022 64A4            	    73:   STZ VT_INV
01:2024 4CA720          	    74:   JMP VT_CLS
                        	    75: 
                        	    76: ; VT_WADDR: VRAM write address A (lo) / X (hi)
                        	    77: VT_WADDR:
01:2027 8D01B0          	    78:   STA VDP_REG
01:202A 8A              	    79:   TXA
01:202B 0940            	    80:   ORA #$40
01:202D 8D01B0          	    81:   STA VDP_REG
01:2030 60              	    82:   RTS
                        	    83: 
                        	    84: ; VT_RADDR: VRAM read address A (lo) / X (hi)
                        	    85: VT_RADDR:
01:2031 8D01B0          	    86:   STA VDP_REG
01:2034 8E01B0          	    87:   STX VDP_REG
01:2037 60              	    88:   RTS
                        	    89: 
                        	    90: ; VT_ROW: write address at column 0 of row A (0-23). Keeps Y
                        	    91: VT_ROW:
01:2038 AA              	    92:   TAX
01:2039 BDBB20          	    93:   LDA VT_ROWLO,X
01:203C 48              	    94:   PHA
01:203D BDD320          	    95:   LDA VT_ROWHI,X
01:2040 AA              	    96:   TAX
01:2041 68              	    97:   PLA
01:2042 4C2720          	    98:   JMP VT_WADDR
                        	    99: 
                        	   100: ; VT_AT: write address at row A, column X. Keeps Y
                        	   101: VT_AT:
01:2045 DA              	   102:   PHX
01:2046 AA              	   103:   TAX
01:2047 68              	   104:   PLA
01:2048 18              	   105:   CLC
01:2049 7DBB20          	   106:   ADC VT_ROWLO,X
01:204C 48              	   107:   PHA
01:204D BDD320          	   108:   LDA VT_ROWHI,X
01:2050 6900            	   109:   ADC #0
01:2052 AA              	   110:   TAX
01:2053 68              	   111:   PLA
01:2054 4C2720          	   112:   JMP VT_WADDR
                        	   113: 
                        	   114: ; VT_REP: writes X times the character A
                        	   115: VT_REP:
01:2057 E000            	   116:   CPX #0
01:2059 F010            	   117:   BEQ .vr_x
                        	   118: .vr_l:
01:205B 8D00B0          	   119:   STA VDP_DATA
01:205E 48              	   120:   PHA
01:205F 8A              	   121:   TXA
01:2060 290F            	   122:   AND #$0F
01:2062 D003            	   123:   BNE .vr_n
01:2064 206E1F          	   124:   JSR KB_POLL
                        	   125: .vr_n:
01:2067 68              	   126:   PLA
01:2068 CA              	   127:   DEX
01:2069 D0F0            	   128:   BNE .vr_l
                        	   129: .vr_x:
01:206B 60              	   130:   RTS
                        	   131: 
                        	   132: ; VT_STR: writes the $00-terminated string at VT_P (ORA VT_INV). Y = characters written
                        	   133: VT_STR:
01:206C A000            	   134:   LDY #0
                        	   135: .vs_l:
01:206E B1A2            	   136:   LDA (VT_P),Y
01:2070 F010            	   137:   BEQ .vs_x
01:2072 05A4            	   138:   ORA VT_INV
01:2074 8D00B0          	   139:   STA VDP_DATA
01:2077 C8              	   140:   INY
01:2078 98              	   141:   TYA
01:2079 290F            	   142:   AND #$0F
01:207B D0F1            	   143:   BNE .vs_l
01:207D 206E1F          	   144:   JSR KB_POLL
01:2080 80EC            	   145:   BRA .vs_l
                        	   146: .vs_x:
01:2082 60              	   147:   RTS
                        	   148: 
                        	   149: ; VT_LINE: string A/X (lo/hi) at the current address, then spaces (ORA VT_INV) up to
                        	   150: ; column 40 of the row. Y = start column on entry
                        	   151: VT_LINE:
01:2083 85A2            	   152:   STA VT_P
01:2085 86A3            	   153:   STX VT_P+1
01:2087 8CA620          	   154:   STY .vl_c
01:208A 206C20          	   155:   JSR VT_STR
01:208D 98              	   156:   TYA
01:208E 18              	   157:   CLC
01:208F 6DA620          	   158:   ADC .vl_c
01:2092 8DA620          	   159:   STA .vl_c
01:2095 A928            	   160:   LDA #40
01:2097 38              	   161:   SEC
01:2098 EDA620          	   162:   SBC .vl_c
01:209B 9008            	   163:   BCC .vl_x
01:209D AA              	   164:   TAX
01:209E A920            	   165:   LDA #' '
01:20A0 05A4            	   166:   ORA VT_INV
01:20A2 4C5720          	   167:   JMP VT_REP
                        	   168: .vl_x:
01:20A5 60              	   169:   RTS
                        	   170: .vl_c:
01:20A6 00              	   171:   .byte 0
                        	   172: 
                        	   173: ; VT_CLS: whole screen blank
                        	   174: VT_CLS:
01:20A7 A900            	   175:   LDA #<VRAM_NAME
01:20A9 A208            	   176:   LDX #>VRAM_NAME
01:20AB 202720          	   177:   JSR VT_WADDR
01:20AE A004            	   178:   LDY #4                 ; 4 x 240 = 960
                        	   179: .vc_l:
01:20B0 A920            	   180:   LDA #' '
01:20B2 A2F0            	   181:   LDX #240
01:20B4 205720          	   182:   JSR VT_REP
01:20B7 88              	   183:   DEY
01:20B8 D0F6            	   184:   BNE .vc_l
01:20BA 60              	   185:   RTS
                        	   186: 
                        	   187: VT_ROWLO:
01:20BB 00              	   188:   .byte <(VRAM_NAME+0*40),<(VRAM_NAME+1*40),<(VRAM_NAME+2*40),<(VRAM_NAME+3*40)
01:20BC 28
01:20BD 50
01:20BE 78
01:20BF A0              	   189:   .byte <(VRAM_NAME+4*40),<(VRAM_NAME+5*40),<(VRAM_NAME+6*40),<(VRAM_NAME+7*40)
01:20C0 C8
01:20C1 F0
01:20C2 18
01:20C3 40              	   190:   .byte <(VRAM_NAME+8*40),<(VRAM_NAME+9*40),<(VRAM_NAME+10*40),<(VRAM_NAME+11*40)
01:20C4 68
01:20C5 90
01:20C6 B8
01:20C7 E0              	   191:   .byte <(VRAM_NAME+12*40),<(VRAM_NAME+13*40),<(VRAM_NAME+14*40),<(VRAM_NAME+15*40)
01:20C8 08
01:20C9 30
01:20CA 58
01:20CB 80              	   192:   .byte <(VRAM_NAME+16*40),<(VRAM_NAME+17*40),<(VRAM_NAME+18*40),<(VRAM_NAME+19*40)
01:20CC A8
01:20CD D0
01:20CE F8
01:20CF 20              	   193:   .byte <(VRAM_NAME+20*40),<(VRAM_NAME+21*40),<(VRAM_NAME+22*40),<(VRAM_NAME+23*40)
01:20D0 48
01:20D1 70
01:20D2 98
                        	   194: VT_ROWHI:
01:20D3 08              	   195:   .byte >(VRAM_NAME+0*40),>(VRAM_NAME+1*40),>(VRAM_NAME+2*40),>(VRAM_NAME+3*40)
01:20D4 08
01:20D5 08
01:20D6 08
01:20D7 08              	   196:   .byte >(VRAM_NAME+4*40),>(VRAM_NAME+5*40),>(VRAM_NAME+6*40),>(VRAM_NAME+7*40)
01:20D8 08
01:20D9 08
01:20DA 09
01:20DB 09              	   197:   .byte >(VRAM_NAME+8*40),>(VRAM_NAME+9*40),>(VRAM_NAME+10*40),>(VRAM_NAME+11*40)
01:20DC 09
01:20DD 09
01:20DE 09
01:20DF 09              	   198:   .byte >(VRAM_NAME+12*40),>(VRAM_NAME+13*40),>(VRAM_NAME+14*40),>(VRAM_NAME+15*40)
01:20E0 0A
01:20E1 0A
01:20E2 0A
01:20E3 0A              	   199:   .byte >(VRAM_NAME+16*40),>(VRAM_NAME+17*40),>(VRAM_NAME+18*40),>(VRAM_NAME+19*40)
01:20E4 0A
01:20E5 0A
01:20E6 0A
01:20E7 0B              	   200:   .byte >(VRAM_NAME+20*40),>(VRAM_NAME+21*40),>(VRAM_NAME+22*40),>(VRAM_NAME+23*40)
01:20E8 0B
01:20E9 0B
01:20EA 0B
                        	   201: 

Source: "apps\file.asm"
                        	  1761:  .include "lib/num.asm"

Source: "lib\num.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   NUM.ASM  -  16-bit numbers to decimal text                 ;
                        	     4: ;   Uses: zp $A5-$A9                                           ;
                        	     5: ;                                                              ;
                        	     6: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     7: 
                        	     8: NUM         = $A5      ; 2 bytes: number to convert (destroyed)
                        	     9: BCD         = $A7      ; 3 bytes: BCD result, $A7 = lowest 2 digits
                        	    10: 
                        	    11: ; BIN2BCD: NUM -> BCD (double dabble with decimal mode)
                        	    12: BIN2BCD:
01:20EB 206E1F          	    13:   JSR KB_POLL
01:20EE 64A7            	    14:   STZ BCD
01:20F0 64A8            	    15:   STZ BCD+1
01:20F2 64A9            	    16:   STZ BCD+2
01:20F4 A210            	    17:   LDX #16
01:20F6 F8              	    18:   SED
                        	    19: .bb_l:
01:20F7 06A5            	    20:   ASL NUM
01:20F9 26A6            	    21:   ROL NUM+1
01:20FB A5A7            	    22:   LDA BCD
01:20FD 65A7            	    23:   ADC BCD
01:20FF 85A7            	    24:   STA BCD
01:2101 A5A8            	    25:   LDA BCD+1
01:2103 65A8            	    26:   ADC BCD+1
01:2105 85A8            	    27:   STA BCD+1
01:2107 A5A9            	    28:   LDA BCD+2
01:2109 65A9            	    29:   ADC BCD+2
01:210B 85A9            	    30:   STA BCD+2
01:210D CA              	    31:   DEX
01:210E D0E7            	    32:   BNE .bb_l
01:2110 D8              	    33:   CLD
01:2111 60              	    34:   RTS
                        	    35: 
                        	    36: ; NUMSTR: NUM -> 5 characters at (VT_P),Y.. with leading spaces (last digit always shown)
                        	    37: ; Y = first position; on exit Y = position after the number
                        	    38: NUMSTR:
01:2112 20EB20          	    39:   JSR BIN2BCD
01:2115 206E1F          	    40:   JSR KB_POLL            ; (BIN2BCD takes ~600 cycles)
01:2118 A200            	    41:   LDX #0                 ; X = 1 once a digit is not zero
01:211A A5A9            	    42:   LDA BCD+2
01:211C 203A21          	    43:   JSR .ns_dig            ; ten thousands
01:211F A5A8            	    44:   LDA BCD+1
01:2121 4A              	    45:   LSR
01:2122 4A              	    46:   LSR
01:2123 4A              	    47:   LSR
01:2124 4A              	    48:   LSR
01:2125 203A21          	    49:   JSR .ns_dig
01:2128 A5A8            	    50:   LDA BCD+1
01:212A 203A21          	    51:   JSR .ns_dig
01:212D A5A7            	    52:   LDA BCD
01:212F 4A              	    53:   LSR
01:2130 4A              	    54:   LSR
01:2131 4A              	    55:   LSR
01:2132 4A              	    56:   LSR
01:2133 203A21          	    57:   JSR .ns_dig
01:2136 A5A7            	    58:   LDA BCD
01:2138 A201            	    59:   LDX #1                 ; the last digit is always written
                        	    60: .ns_dig:
01:213A 290F            	    61:   AND #$0F
01:213C D008            	    62:   BNE .ns_nz
01:213E E000            	    63:   CPX #0
01:2140 D004            	    64:   BNE .ns_nz
01:2142 A920            	    65:   LDA #' '
01:2144 8004            	    66:   BRA .ns_put
                        	    67: .ns_nz:
01:2146 A201            	    68:   LDX #1
01:2148 0930            	    69:   ORA #'0'
                        	    70: .ns_put:
01:214A 91A2            	    71:   STA (VT_P),Y
01:214C C8              	    72:   INY
01:214D 60              	    73:   RTS
                        	    74: 

Source: "apps\file.asm"
                        	  1762:  .include "lib/docs.asm"

Source: "lib\docs.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   DOCS.ASM  -  documents in the SD document area             ;
                        	     4: ;                                                              ;
                        	     5: ;   Sector 16384 ($00800000, after the 255 program blocks)     ;
                        	     6: ;   is the index: +0 "DOCS", +4 version 1, +5 slots (15);      ;
                        	     7: ;   entry k (1-15) at k*32: +0 type (0 free, 1 text,           ;
                        	     8: ;   2 sheet, 3 card file),                                     ;
                        	     9: ;   +1/+2 length, +4..+15 name (12 chars, $00 padded).         ;
                        	    10: ;   Document k = 40 sectors (20 KB) from sector 16384 + k*40.  ;
                        	    11: ;   Sectors go through the BIOS (JT_SD_READ / JT_SD_WRITE).    ;
                        	    12: ;   Uses: zp $AA-$AF, $B8-$BA, RAM $0600-$07FF (index sector)  ;
                        	    13: ;                                                              ;
                        	    14: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    15: 
                        	    16: DOC_IDX     = $0600    ; index sector (512 bytes)
                        	    17: DOC_BASE    = $4000    ; sector 16384
                        	    18: DOC_SLOTS   = 15
                        	    19: DOC_SECTS   = 40       ; sectors per document
                        	    20: DOC_NAMELEN = 12
                        	    21: DOC_E       = $AA      ; 2 bytes: pointer to the index entry
                        	    22: DOC_K       = $AC      ; slot
                        	    23: DOC_I       = $AD      ; sector inside the document
                        	    24: DOC_N       = $AE      ; sectors to transfer
                        	    25: DOC_PG      = $AF      ; RAM page of the transfer
                        	    26: DOC_T       = $B8      ; document type of the application (1 text, 2 sheet, 3 card file)
                        	    27: DOC_LEN     = $B9      ; 2 bytes: length for DOC_SETENT
                        	    28: 
                        	    29: ; DOC_RDIDX: reads the index; a sector without "DOCS" becomes an empty index. C=1 SD error
                        	    30: DOC_RDIDX:
01:214E 206622          	    31:   JSR DOC_LBA0
01:2151 A200            	    32:   LDX #<DOC_IDX
01:2153 A006            	    33:   LDY #>DOC_IDX
01:2155 2018FD          	    34:   JSR JT_SD_READ
01:2158 B00E            	    35:   BCS .dr_x
01:215A A203            	    36:   LDX #3
                        	    37: .dr_m:
01:215C BD0006          	    38:   LDA DOC_IDX,X
01:215F DDC022          	    39:   CMP DOC_MAGIC,X
01:2162 D005            	    40:   BNE .dr_new
01:2164 CA              	    41:   DEX
01:2165 10F5            	    42:   BPL .dr_m
01:2167 18              	    43:   CLC
                        	    44: .dr_x:
01:2168 60              	    45:   RTS
                        	    46: .dr_new:
01:2169 A200            	    47:   LDX #0
                        	    48: .dr_z:
01:216B 9E0006          	    49:   STZ DOC_IDX,X
01:216E 9E0007          	    50:   STZ DOC_IDX+$100,X
01:2171 E8              	    51:   INX
01:2172 D0F7            	    52:   BNE .dr_z
01:2174 A205            	    53:   LDX #5
                        	    54: .dr_h:
01:2176 BDC022          	    55:   LDA DOC_MAGIC,X
01:2179 9D0006          	    56:   STA DOC_IDX,X
01:217C CA              	    57:   DEX
01:217D 10F7            	    58:   BPL .dr_h
01:217F 18              	    59:   CLC
01:2180 60              	    60:   RTS
                        	    61: 
                        	    62: ; DOC_WRIDX: writes the index. C=1 SD error
                        	    63: DOC_WRIDX:
01:2181 206622          	    64:   JSR DOC_LBA0
01:2184 A200            	    65:   LDX #<DOC_IDX
01:2186 A006            	    66:   LDY #>DOC_IDX
01:2188 4C1BFD          	    67:   JMP JT_SD_WRITE
                        	    68: 
                        	    69: ; DOC_ENTRY: A = slot (1-15) -> DOC_E = its index entry. Keeps X, Y
                        	    70: DOC_ENTRY:
01:218B 85AC            	    71:   STA DOC_K
01:218D 4A              	    72:   LSR
01:218E 4A              	    73:   LSR
01:218F 4A              	    74:   LSR
01:2190 18              	    75:   CLC
01:2191 6906            	    76:   ADC #>DOC_IDX
01:2193 85AB            	    77:   STA DOC_E+1
01:2195 A5AC            	    78:   LDA DOC_K
01:2197 0A              	    79:   ASL
01:2198 0A              	    80:   ASL
01:2199 0A              	    81:   ASL
01:219A 0A              	    82:   ASL
01:219B 0A              	    83:   ASL
01:219C 85AA            	    84:   STA DOC_E              ; (DOC_IDX is page aligned)
01:219E 60              	    85:   RTS
                        	    86: 
                        	    87: ; DOC_FIND: name of 12 bytes at (DOC_P) and type DOC_T -> C=0 and A = slot, C=1 not found
                        	    88: DOC_P       = VT_P     ; (shares the string pointer)
                        	    89: DOC_FIND:
01:219F A901            	    90:   LDA #1
                        	    91: .df_k:
01:21A1 48              	    92:   PHA
01:21A2 208B21          	    93:   JSR DOC_ENTRY
01:21A5 A000            	    94:   LDY #0
01:21A7 B1AA            	    95:   LDA (DOC_E),Y
01:21A9 C5B8            	    96:   CMP DOC_T
01:21AB D01A            	    97:   BNE .df_n              ; free or another type
01:21AD A00B            	    98:   LDY #DOC_NAMELEN-1
                        	    99: .df_c:
01:21AF B1A2            	   100:   LDA (DOC_P),Y
01:21B1 85AD            	   101:   STA DOC_I              ; (temporary)
