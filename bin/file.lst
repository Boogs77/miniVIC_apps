                        	  1764:  .include "lib/stream.asm"

Source: "lib\stream.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   STREAM.ASM  -  a document written / read byte by byte      ;
                        	     4: ;                                                              ;
                        	     5: ;   Through a 512-byte sector buffer, one sector at a time,    ;
                        	     6: ;   in the slot DOC_K of the document area (lib/docs.asm).     ;
                        	     7: ;   Uses: zp $E4-$EB, RAM $0800-$09FF (ST_BUF)                 ;
                        	     8: ;                                                              ;
                        	     9: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    10: 
                        	    11: ST_BUF      = $0800    ; sector buffer (page aligned)
                        	    12: ST_POS      = $E4      ; 2 bytes: position in ST_BUF
                        	    13: ST_SEC      = $E6      ; sector of the document
                        	    14: ST_LEFT     = $E7      ; 2 bytes: bytes still to read
                        	    15: ST_ERR      = $E9      ; 1 = SD error or too big
                        	    16: ST_P        = $EA      ; 2 bytes
                        	    17: 
                        	    18: ; ST_WOPEN: start writing the document DOC_K
                        	    19: ST_WOPEN:
01:255D 64E4            	    20:   STZ ST_POS
01:255F 64E5            	    21:   STZ ST_POS+1
01:2561 64E6            	    22:   STZ ST_SEC
01:2563 64E9            	    23:   STZ ST_ERR
01:2565 60              	    24:   RTS
                        	    25: 
                        	    26: ; ST_PUT: A to the document. Keeps A, X, Y
                        	    27: ST_PUT:
01:2566 48              	    28:   PHA
01:2567 DA              	    29:   PHX
01:2568 5A              	    30:   PHY
01:2569 48              	    31:   PHA
01:256A A5E4            	    32:   LDA ST_POS
01:256C 85EA            	    33:   STA ST_P
01:256E A5E5            	    34:   LDA ST_POS+1
01:2570 18              	    35:   CLC
01:2571 6908            	    36:   ADC #>ST_BUF
01:2573 85EB            	    37:   STA ST_P+1
01:2575 68              	    38:   PLA
01:2576 92EA            	    39:   STA (ST_P)
01:2578 E6E4            	    40:   INC ST_POS
01:257A D00B            	    41:   BNE .sp_x
01:257C E6E5            	    42:   INC ST_POS+1
01:257E A5E5            	    43:   LDA ST_POS+1
01:2580 C902            	    44:   CMP #2
01:2582 D003            	    45:   BNE .sp_x
01:2584 208B25          	    46:   JSR ST_FLUSH
                        	    47: .sp_x:
01:2587 7A              	    48:   PLY
01:2588 FA              	    49:   PLX
01:2589 68              	    50:   PLA
01:258A 60              	    51:   RTS
                        	    52: 
                        	    53: ; ST_FLUSH: the buffer (ST_POS bytes) to sector ST_SEC, then an empty buffer
                        	    54: ST_FLUSH:
01:258B A5E4            	    55:   LDA ST_POS
01:258D 05E5            	    56:   ORA ST_POS+1
01:258F F01E            	    57:   BEQ .sf_x
01:2591 A5E6            	    58:   LDA ST_SEC
01:2593 C928            	    59:   CMP #DOC_SECTS
01:2595 B00E            	    60:   BCS .sf_big
01:2597 85AD            	    61:   STA DOC_I
01:2599 201122          	    62:   JSR DOC_SECT
01:259C A200            	    63:   LDX #<ST_BUF
01:259E A008            	    64:   LDY #>ST_BUF
01:25A0 201BFD          	    65:   JSR JT_SD_WRITE
01:25A3 9004            	    66:   BCC .sf_n
                        	    67: .sf_big:
01:25A5 A901            	    68:   LDA #1
01:25A7 85E9            	    69:   STA ST_ERR
                        	    70: .sf_n:
01:25A9 E6E6            	    71:   INC ST_SEC
01:25AB 64E4            	    72:   STZ ST_POS
01:25AD 64E5            	    73:   STZ ST_POS+1
                        	    74: .sf_x:
01:25AF 60              	    75:   RTS
                        	    76: 
                        	    77: ; ST_WCLOSE: the last part; DOC_LEN = length. C=1 SD error or more than 20 KB
                        	    78: ST_WCLOSE:
01:25B0 A5E6            	    79:   LDA ST_SEC             ; length = sectors * 512 + position
01:25B2 0A              	    80:   ASL
01:25B3 18              	    81:   CLC
01:25B4 65E5            	    82:   ADC ST_POS+1
01:25B6 85BA            	    83:   STA DOC_LEN+1
01:25B8 A5E4            	    84:   LDA ST_POS
01:25BA 85B9            	    85:   STA DOC_LEN
01:25BC 208B25          	    86:   JSR ST_FLUSH
01:25BF A5E9            	    87:   LDA ST_ERR
01:25C1 C901            	    88:   CMP #1                 ; C=1 if ST_ERR
01:25C3 60              	    89:   RTS
                        	    90: 
                        	    91: ; ST_ROPEN: start reading the document DOC_K of DOC_LEN bytes
                        	    92: ST_ROPEN:
01:25C4 A5B9            	    93:   LDA DOC_LEN
01:25C6 85E7            	    94:   STA ST_LEFT
01:25C8 A5BA            	    95:   LDA DOC_LEN+1
01:25CA 85E8            	    96:   STA ST_LEFT+1
01:25CC 64E6            	    97:   STZ ST_SEC
01:25CE 64E9            	    98:   STZ ST_ERR
01:25D0 A902            	    99:   LDA #2                 ; (buffer empty: the first ST_GET reads a sector)
01:25D2 85E5            	   100:   STA ST_POS+1
01:25D4 64E4            	   101:   STZ ST_POS
01:25D6 60              	   102:   RTS
                        	   103: 
                        	   104: ; ST_GET: A = next byte, C=1 at the end (ST_ERR = 1 if the SD failed). Keeps X, Y
                        	   105: ST_GET:
01:25D7 A5E7            	   106:   LDA ST_LEFT
01:25D9 05E8            	   107:   ORA ST_LEFT+1
01:25DB F047            	   108:   BEQ .sg_end
01:25DD DA              	   109:   PHX
01:25DE 5A              	   110:   PHY
01:25DF A5E5            	   111:   LDA ST_POS+1
01:25E1 C902            	   112:   CMP #2
01:25E3 9016            	   113:   BCC .sg_b
01:25E5 A5E6            	   114:   LDA ST_SEC             ; next sector
01:25E7 85AD            	   115:   STA DOC_I
01:25E9 201122          	   116:   JSR DOC_SECT
01:25EC A200            	   117:   LDX #<ST_BUF
01:25EE A008            	   118:   LDY #>ST_BUF
01:25F0 2018FD          	   119:   JSR JT_SD_READ
01:25F3 B025            	   120:   BCS .sg_err
01:25F5 E6E6            	   121:   INC ST_SEC
01:25F7 64E4            	   122:   STZ ST_POS
01:25F9 64E5            	   123:   STZ ST_POS+1
                        	   124: .sg_b:
01:25FB A5E4            	   125:   LDA ST_POS
01:25FD 85EA            	   126:   STA ST_P
01:25FF A5E5            	   127:   LDA ST_POS+1
01:2601 18              	   128:   CLC
01:2602 6908            	   129:   ADC #>ST_BUF
01:2604 85EB            	   130:   STA ST_P+1
01:2606 E6E4            	   131:   INC ST_POS
01:2608 D002            	   132:   BNE .sg_d
01:260A E6E5            	   133:   INC ST_POS+1
                        	   134: .sg_d:
01:260C A5E7            	   135:   LDA ST_LEFT
01:260E D002            	   136:   BNE .sg_l
01:2610 C6E8            	   137:   DEC ST_LEFT+1
                        	   138: .sg_l:
01:2612 C6E7            	   139:   DEC ST_LEFT
01:2614 B2EA            	   140:   LDA (ST_P)
01:2616 7A              	   141:   PLY
01:2617 FA              	   142:   PLX
01:2618 18              	   143:   CLC
01:2619 60              	   144:   RTS
                        	   145: .sg_err:
01:261A 7A              	   146:   PLY
01:261B FA              	   147:   PLX
01:261C A901            	   148:   LDA #1
01:261E 85E9            	   149:   STA ST_ERR
01:2620 64E7            	   150:   STZ ST_LEFT
01:2622 64E8            	   151:   STZ ST_LEFT+1
                        	   152: .sg_end:
01:2624 38              	   153:   SEC
01:2625 60              	   154:   RTS
