01:234E 18              	   101:   CLC
01:234F 60              	   102:   RTS
                        	   103: .pr_esc:
01:2350 38              	   104:   SEC
01:2351 60              	   105:   RTS
                        	   106: 
                        	   107: ; UI_UPC: lower case letter -> upper case. Keeps X, Y
                        	   108: UI_UPC:
01:2352 C961            	   109:   CMP #'a'
01:2354 9006            	   110:   BCC .uu_x
01:2356 C97B            	   111:   CMP #'z'+1
01:2358 B002            	   112:   BCS .uu_x
01:235A 29DF            	   113:   AND #$DF
                        	   114: .uu_x:
01:235C 60              	   115:   RTS
                        	   116: 
                        	   117: ; YESNO: question A/X on row 23; C=0 if the answer is Y
                        	   118: YESNO:
01:235D DA              	   119:   PHX
01:235E 48              	   120:   PHA
01:235F A917            	   121:   LDA #23
01:2361 203820          	   122:   JSR VT_ROW
01:2364 64A4            	   123:   STZ VT_INV
01:2366 68              	   124:   PLA
01:2367 FA              	   125:   PLX
01:2368 A000            	   126:   LDY #0
01:236A 208320          	   127:   JSR VT_LINE
01:236D 20AB1F          	   128:   JSR WAITKEY
01:2370 29DF            	   129:   AND #$DF
01:2372 C959            	   130:   CMP #'Y'
01:2374 F002            	   131:   BEQ .yn_y
01:2376 38              	   132:   SEC
01:2377 60              	   133:   RTS
                        	   134: .yn_y:
01:2378 18              	   135:   CLC
01:2379 60              	   136:   RTS
                        	   137: 
                        	   138: ; DOC_PICK: whole-screen list of the documents; arrows (^E ^X) choose, Enter opens,
                        	   139: ; Del (^G) deletes after a question, Esc goes back. A/X = title.
                        	   140: ; Enter on a free slot, or (UI_ANY = 0) on a document of another type, does nothing.
                        	   141: ; C=0 and A = slot to open (index in DOC_IDX), C=1 and A=0 back, C=1 and A=$FF SD error.
                        	   142: ; The caller redraws its screen afterwards.
                        	   143: DOC_PICK:
