01:201E A200            	    77:   LDX #0
                        	    78: .cs_wr:
01:2020 BD6005          	    79:   LDA CON_ROWB,X
01:2023 8D00B0          	    80:   STA VDP_DATA
01:2026 E8              	    81:   INX
01:2027 E028            	    82:   CPX #40
01:2029 D0F5            	    83:   BNE .cs_wr
01:202B 20521E          	    84:   JSR KB_POLL
01:202E C8              	    85:   INY
01:202F C018            	    86:   CPY #24
01:2031 D0D2            	    87:   BNE .cs_r
01:2033 A917            	    88:   LDA #23
01:2035 201C1F          	    89:   JSR VT_ROW
01:2038 A920            	    90:   LDA #' '
01:203A A228            	    91:   LDX #40
01:203C 4C3B1F          	    92:   JMP VT_REP
