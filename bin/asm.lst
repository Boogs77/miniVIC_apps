Source: "apps\asm.asm"
                        	  1587:  .include "lib/keys.asm"

Source: "lib\keys.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   KEYS.ASM  -  key queue on top of the BIOS                  ;
                        	     4: ;                                                              ;
                        	     5: ;   The PS/2 board keeps one byte: a byte not read within      ;
                        	     6: ;   ~1 ms is lost (a lost $F0 turns a release into a second    ;
                        	     7: ;   press). Two ways in, both on: the CA1 interrupt of the     ;
                        	     8: ;   keyboard VIA (IRQ -> BIOS -> JMP KB_IRQ at $0FA0) reads    ;
                        	     9: ;   every byte at once; KB_POLL, called by the long loops,     ;
                        	    10: ;   does the same if the IRQ line is not there. Assembled      ;
                        	    11: ;   with -DKB_NOIRQ=1 only the polling is left.                ;
                        	    12: ;   The keys decoded by the BIOS go into a 32-key queue,       ;
                        	    13: ;   GETKEY takes them out. KB_EXIT before leaving the app.     ;
                        	    14: ;   An app that uses the serial line itself defines KB_SERBUF  ;
                        	    15: ;   (256-byte ring): the received bytes go there, not among    ;
                        	    16: ;   the keys (JT_CHRIN reads the serial line first: a byte it  ;
                        	    17: ;   returns while CA1 is still set came from the serial line). ;
                        	    18: ;   Uses: zp $A0-$A1 ($F0-$F1 with KB_SERBUF), RAM $05C0-$05DF ;
                        	    19: ;                                                              ;
                        	    20: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    21: 
                        	    22: KQ          = $05C0    ; 32-key ring
                        	    23: KQ_MASK     = $1F
                        	    24: KQR         = $A0      ; read index
                        	    25: KQW         = $A1      ; write index
                        	    26: KB_IFR      = $D18D    ; keyboard VIA: interrupt flags (bit 1 = CA1)
                        	    27: KB_IER      = $D18E    ;               interrupt enable
                        	    28: KB_SRR      = $F0      ; serial ring (KB_SERBUF): read index
                        	    29: KB_SRW      = $F1      ;                          write index
                        	    30: 
                        	    31: ; KB_INIT: extended keyboard, empty queue, CA1 interrupt on
                        	    32: KB_INIT:
01:1E17 78              	    33:   SEI
01:1E18 A901            	    34:   LDA #1
01:1E1A 2021FD          	    35:   JSR JT_KB_MODE
01:1E1D 64A0            	    36:   STZ KQR
01:1E1F 64A1            	    37:   STZ KQW
01:1E21 64F0            	    38:   STZ KB_SRR
01:1E23 64F1            	    39:   STZ KB_SRW
                        	    40:  .ifndef KB_NOIRQ
01:1E25 A94C            	    41:   LDA #$4C               ; JMP KB_IRQ in the RAM vector of the BIOS
01:1E27 8DA00F          	    42:   STA IRQ_VEC
01:1E2A A947            	    43:   LDA #<KB_IRQ
01:1E2C 8DA10F          	    44:   STA IRQ_VEC+1
01:1E2F A91E            	    45:   LDA #>KB_IRQ
01:1E31 8DA20F          	    46:   STA IRQ_VEC+2
01:1E34 A982            	    47:   LDA #$82               ; CA1 interrupt enabled
01:1E36 8D8ED1          	    48:   STA KB_IER
01:1E39 58              	    49:   CLI
                        	    50:  .endif
01:1E3A 60              	    51:   RTS
                        	    52: 
                        	    53: ; KB_EXIT: interrupt off again (the BIOS menu works by polling)
                        	    54: KB_EXIT:
01:1E3B 78              	    55:   SEI
01:1E3C A902            	    56:   LDA #$02
01:1E3E 8D8ED1          	    57:   STA KB_IER
01:1E41 A960            	    58:   LDA #$60               ; RTS
01:1E43 8DA00F          	    59:   STA IRQ_VEC
01:1E46 60              	    60:   RTS
                        	    61: 
                        	    62: ; KB_IRQ: called by the BIOS IRQ handler (A, X, Y already saved)
                        	    63: KB_IRQ:
                        	    64:  .ifdef KB_SERBUF
                        	    65:   JMP KB_TAKE            ; the keyboard or the serial line
                        	    66:  .else
01:1E47 AD8DD1          	    67:   LDA KB_IFR
01:1E4A 2902            	    68:   AND #$02
01:1E4C F003            	    69:   BEQ .ki_x
01:1E4E 205F1E          	    70:   JSR KB_TAKE
                        	    71: .ki_x:
01:1E51 60              	    72:   RTS
                        	    73:  .endif
                        	    74: 
                        	    75: ; KB_POLL: one BIOS poll with the interrupt held off. Keeps A, X, Y and the I flag
                        	    76: KB_POLL:
01:1E52 08              	    77:   PHP
01:1E53 78              	    78:   SEI
01:1E54 48              	    79:   PHA
01:1E55 DA              	    80:   PHX
01:1E56 5A              	    81:   PHY
01:1E57 205F1E          	    82:   JSR KB_TAKE
01:1E5A 7A              	    83:   PLY
01:1E5B FA              	    84:   PLX
01:1E5C 68              	    85:   PLA
01:1E5D 28              	    86:   PLP
01:1E5E 60              	    87:   RTS
                        	    88: 
                        	    89: ; KB_TAKE: a key from the BIOS goes into the queue (full queue: dropped)
                        	    90: KB_TAKE:
                        	    91:  .ifdef KB_SERBUF
                        	    92: .kt_rx:
                        	    93:   LDA ACIA_STATUS        ; received bytes first, into their ring
                        	    94:   AND #$08
                        	    95:   BEQ .kt_kb
                        	    96:   LDA ACIA_DATA
                        	    97:   JSR KB_SERPUT
                        	    98:   BRA .kt_rx
                        	    99: .kt_kb:
                        	   100:   LDA KB_IFR
                        	   101:   AND #$02
                        	   102:   BEQ .kt_x
                        	   103:   JSR JT_CHRIN
                        	   104:   BCC .kt_x
                        	   105:   PHA
                        	   106:   LDA KB_IFR             ; CA1 still set: the BIOS took a serial byte, not the key
                        	   107:   AND #$02
                        	   108:   BEQ .kt_key
                        	   109:   PLA
                        	   110:   JSR KB_SERPUT
                        	   111:   BRA .kt_rx
                        	   112: .kt_key:
                        	   113:   PLA
                        	   114:  .else
01:1E5F 2003FD          	   115:   JSR JT_CHRIN
01:1E62 900F            	   116:   BCC .kt_x
                        	   117:  .endif
01:1E64 A6A1            	   118:   LDX KQW
01:1E66 9DC005          	   119:   STA KQ,X
01:1E69 8A              	   120:   TXA
01:1E6A 1A              	   121:   INC A
01:1E6B 291F            	   122:   AND #KQ_MASK
01:1E6D C5A0            	   123:   CMP KQR
01:1E6F F002            	   124:   BEQ .kt_x              ; full
01:1E71 85A1            	   125:   STA KQW
                        	   126: .kt_x:
01:1E73 60              	   127:   RTS
                        	   128: 
                        	   129:  .ifdef KB_SERBUF
                        	   130: ; KB_SERPUT: A into the serial ring (full: dropped)
                        	   131: KB_SERPUT:
                        	   132:   LDX KB_SRW
                        	   133:   STA KB_SERBUF,X
                        	   134:   INX
                        	   135:   CPX KB_SRR
                        	   136:   BEQ .ks_x
                        	   137:   STX KB_SRW
                        	   138: .ks_x:
                        	   139:   RTS
                        	   140: 
                        	   141: ; SERGET: C=1 and A = next received byte, C=0 none
                        	   142: SERGET:
                        	   143:   JSR KB_POLL
                        	   144:   LDX KB_SRR
                        	   145:   CPX KB_SRW
                        	   146:   BEQ .sg_n
                        	   147:   LDA KB_SERBUF,X
                        	   148:   INC KB_SRR
                        	   149:   SEC
                        	   150:   RTS
                        	   151: .sg_n:
                        	   152:   CLC
                        	   153:   RTS
                        	   154:  .endif
                        	   155: 
                        	   156: ; GETKEY: C=1 and A = key, C=0 queue empty (after one poll). Keeps X, Y
                        	   157: GETKEY:
01:1E74 20521E          	   158:   JSR KB_POLL
01:1E77 A5A0            	   159:   LDA KQR
01:1E79 C5A1            	   160:   CMP KQW
01:1E7B F010            	   161:   BEQ .gk_n
01:1E7D DA              	   162:   PHX
01:1E7E AA              	   163:   TAX
01:1E7F BDC005          	   164:   LDA KQ,X
01:1E82 48              	   165:   PHA
01:1E83 8A              	   166:   TXA
01:1E84 1A              	   167:   INC A
01:1E85 291F            	   168:   AND #KQ_MASK
01:1E87 85A0            	   169:   STA KQR
01:1E89 68              	   170:   PLA
01:1E8A FA              	   171:   PLX
01:1E8B 38              	   172:   SEC
01:1E8C 60              	   173:   RTS
                        	   174: .gk_n:
01:1E8D 18              	   175:   CLC
01:1E8E 60              	   176:   RTS
                        	   177: 
                        	   178: ; WAITKEY: A = next key
                        	   179: WAITKEY:
01:1E8F 20741E          	   180:   JSR GETKEY
01:1E92 90FB            	   181:   BCC WAITKEY
01:1E94 60              	   182:   RTS
                        	   183: 
                        	   184: ; KEYREADY: C=1 if a key is waiting in the queue
                        	   185: KEYREADY:
01:1E95 20521E          	   186:   JSR KB_POLL
01:1E98 A5A0            	   187:   LDA KQR
01:1E9A C5A1            	   188:   CMP KQW
01:1E9C 18              	   189:   CLC
01:1E9D F001            	   190:   BEQ .kr_x
01:1E9F 38              	   191:   SEC
                        	   192: .kr_x:
01:1EA0 60              	   193:   RTS
                        	   194: 

Source: "apps\asm.asm"
                        	  1588:  .include "lib/vtext.asm"

Source: "lib\vtext.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   VTEXT.ASM  -  40 x 24 text screen on the TMS9918A          ;
                        	     4: ;                                                              ;
                        	     5: ;   BIOS text mode (VDP interrupt off, so the main loop can    ;
                        	     6: ;   write the VRAM at any time). VT_INIT also builds the       ;
                        	     7: ;   inverse font: codes $80-$FF = codes $00-$7F inverted,      ;
                        	     8: ;   used for the cursor, the status bar and the marked block.  ;
                        	     9: ;   Long loops call KB_POLL (lib/keys.asm).                    ;
                        	    10: ;   Uses: zp $A2-$A4, RAM $0800-$0BFF only inside VT_INIT      ;
                        	    11: ;                                                              ;
                        	    12: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    13: 
                        	    14: VT_P        = $A2      ; 2 bytes: string pointer
                        	    15: VT_INV      = $A4      ; ORed to every character of VT_STR ($80 = inverse)
                        	    16: VT_FONTTMP  = $0800    ; RAM copy of the font (1 KB, only during VT_INIT)
                        	    17: 
                        	    18: ; VT_INIT: text mode of the BIOS, inverse font, empty screen
                        	    19: VT_INIT:
01:1EA1 2009FD          	    20:   JSR JT_INIT_CRT
01:1EA4 A900            	    21:   LDA #<VRAM_FONT        ; read patterns 0-127 (1 KB)
01:1EA6 A200            	    22:   LDX #>VRAM_FONT
01:1EA8 20151F          	    23:   JSR VT_RADDR
01:1EAB A200            	    24:   LDX #0                 ; (the VRAM address increases by itself)
                        	    25: .vi_r0:
01:1EAD AD00B0          	    26:   LDA VDP_DATA
01:1EB0 9D0008          	    27:   STA VT_FONTTMP,X
01:1EB3 E8              	    28:   INX
01:1EB4 D0F7            	    29:   BNE .vi_r0
                        	    30: .vi_r1:
01:1EB6 AD00B0          	    31:   LDA VDP_DATA
01:1EB9 9D0009          	    32:   STA VT_FONTTMP+$100,X
01:1EBC E8              	    33:   INX
01:1EBD D0F7            	    34:   BNE .vi_r1
                        	    35: .vi_r2:
01:1EBF AD00B0          	    36:   LDA VDP_DATA
01:1EC2 9D000A          	    37:   STA VT_FONTTMP+$200,X
01:1EC5 E8              	    38:   INX
01:1EC6 D0F7            	    39:   BNE .vi_r2
                        	    40: .vi_r3:
01:1EC8 AD00B0          	    41:   LDA VDP_DATA
01:1ECB 9D000B          	    42:   STA VT_FONTTMP+$300,X
01:1ECE E8              	    43:   INX
01:1ECF D0F7            	    44:   BNE .vi_r3
01:1ED1 A900            	    45:   LDA #<(VRAM_FONT+$400) ; inverted copy at pattern 128
01:1ED3 A204            	    46:   LDX #>(VRAM_FONT+$400)
01:1ED5 200B1F          	    47:   JSR VT_WADDR
01:1ED8 A200            	    48:   LDX #0
                        	    49: .vi_w0:
01:1EDA BD0008          	    50:   LDA VT_FONTTMP,X
01:1EDD 49FF            	    51:   EOR #$FF
01:1EDF 8D00B0          	    52:   STA VDP_DATA
01:1EE2 E8              	    53:   INX
01:1EE3 D0F5            	    54:   BNE .vi_w0
                        	    55: .vi_w1:
01:1EE5 BD0009          	    56:   LDA VT_FONTTMP+$100,X
01:1EE8 49FF            	    57:   EOR #$FF
01:1EEA 8D00B0          	    58:   STA VDP_DATA
01:1EED E8              	    59:   INX
01:1EEE D0F5            	    60:   BNE .vi_w1
                        	    61: .vi_w2:
01:1EF0 BD000A          	    62:   LDA VT_FONTTMP+$200,X
01:1EF3 49FF            	    63:   EOR #$FF
01:1EF5 8D00B0          	    64:   STA VDP_DATA
01:1EF8 E8              	    65:   INX
01:1EF9 D0F5            	    66:   BNE .vi_w2
                        	    67: .vi_w3:
01:1EFB BD000B          	    68:   LDA VT_FONTTMP+$300,X
01:1EFE 49FF            	    69:   EOR #$FF
01:1F00 8D00B0          	    70:   STA VDP_DATA
01:1F03 E8              	    71:   INX
01:1F04 D0F5            	    72:   BNE .vi_w3
01:1F06 64A4            	    73:   STZ VT_INV
01:1F08 4C8B1F          	    74:   JMP VT_CLS
                        	    75: 
                        	    76: ; VT_WADDR: VRAM write address A (lo) / X (hi)
                        	    77: VT_WADDR:
01:1F0B 8D01B0          	    78:   STA VDP_REG
01:1F0E 8A              	    79:   TXA
01:1F0F 0940            	    80:   ORA #$40
01:1F11 8D01B0          	    81:   STA VDP_REG
01:1F14 60              	    82:   RTS
                        	    83: 
                        	    84: ; VT_RADDR: VRAM read address A (lo) / X (hi)
                        	    85: VT_RADDR:
01:1F15 8D01B0          	    86:   STA VDP_REG
01:1F18 8E01B0          	    87:   STX VDP_REG
01:1F1B 60              	    88:   RTS
                        	    89: 
                        	    90: ; VT_ROW: write address at column 0 of row A (0-23). Keeps Y
                        	    91: VT_ROW:
01:1F1C AA              	    92:   TAX
01:1F1D BD9F1F          	    93:   LDA VT_ROWLO,X
01:1F20 48              	    94:   PHA
01:1F21 BDB71F          	    95:   LDA VT_ROWHI,X
01:1F24 AA              	    96:   TAX
01:1F25 68              	    97:   PLA
01:1F26 4C0B1F          	    98:   JMP VT_WADDR
                        	    99: 
                        	   100: ; VT_AT: write address at row A, column X. Keeps Y
                        	   101: VT_AT:
01:1F29 DA              	   102:   PHX
01:1F2A AA              	   103:   TAX
01:1F2B 68              	   104:   PLA
01:1F2C 18              	   105:   CLC
01:1F2D 7D9F1F          	   106:   ADC VT_ROWLO,X
01:1F30 48              	   107:   PHA
01:1F31 BDB71F          	   108:   LDA VT_ROWHI,X
01:1F34 6900            	   109:   ADC #0
01:1F36 AA              	   110:   TAX
01:1F37 68              	   111:   PLA
01:1F38 4C0B1F          	   112:   JMP VT_WADDR
                        	   113: 
                        	   114: ; VT_REP: writes X times the character A
                        	   115: VT_REP:
01:1F3B E000            	   116:   CPX #0
01:1F3D F010            	   117:   BEQ .vr_x
                        	   118: .vr_l:
01:1F3F 8D00B0          	   119:   STA VDP_DATA
01:1F42 48              	   120:   PHA
01:1F43 8A              	   121:   TXA
01:1F44 290F            	   122:   AND #$0F
01:1F46 D003            	   123:   BNE .vr_n
01:1F48 20521E          	   124:   JSR KB_POLL
                        	   125: .vr_n:
01:1F4B 68              	   126:   PLA
01:1F4C CA              	   127:   DEX
01:1F4D D0F0            	   128:   BNE .vr_l
                        	   129: .vr_x:
01:1F4F 60              	   130:   RTS
                        	   131: 
                        	   132: ; VT_STR: writes the $00-terminated string at VT_P (ORA VT_INV). Y = characters written
                        	   133: VT_STR:
01:1F50 A000            	   134:   LDY #0
                        	   135: .vs_l:
01:1F52 B1A2            	   136:   LDA (VT_P),Y
01:1F54 F010            	   137:   BEQ .vs_x
01:1F56 05A4            	   138:   ORA VT_INV
01:1F58 8D00B0          	   139:   STA VDP_DATA
01:1F5B C8              	   140:   INY
01:1F5C 98              	   141:   TYA
01:1F5D 290F            	   142:   AND #$0F
01:1F5F D0F1            	   143:   BNE .vs_l
01:1F61 20521E          	   144:   JSR KB_POLL
01:1F64 80EC            	   145:   BRA .vs_l
                        	   146: .vs_x:
01:1F66 60              	   147:   RTS
                        	   148: 
                        	   149: ; VT_LINE: string A/X (lo/hi) at the current address, then spaces (ORA VT_INV) up to
                        	   150: ; column 40 of the row. Y = start column on entry
                        	   151: VT_LINE:
01:1F67 85A2            	   152:   STA VT_P
01:1F69 86A3            	   153:   STX VT_P+1
01:1F6B 8C8A1F          	   154:   STY .vl_c
01:1F6E 20501F          	   155:   JSR VT_STR
01:1F71 98              	   156:   TYA
01:1F72 18              	   157:   CLC
01:1F73 6D8A1F          	   158:   ADC .vl_c
01:1F76 8D8A1F          	   159:   STA .vl_c
01:1F79 A928            	   160:   LDA #40
01:1F7B 38              	   161:   SEC
01:1F7C ED8A1F          	   162:   SBC .vl_c
01:1F7F 9008            	   163:   BCC .vl_x
01:1F81 AA              	   164:   TAX
01:1F82 A920            	   165:   LDA #' '
01:1F84 05A4            	   166:   ORA VT_INV
01:1F86 4C3B1F          	   167:   JMP VT_REP
                        	   168: .vl_x:
01:1F89 60              	   169:   RTS
                        	   170: .vl_c:
01:1F8A 00              	   171:   .byte 0
                        	   172: 
                        	   173: ; VT_CLS: whole screen blank
                        	   174: VT_CLS:
01:1F8B A900            	   175:   LDA #<VRAM_NAME
01:1F8D A208            	   176:   LDX #>VRAM_NAME
01:1F8F 200B1F          	   177:   JSR VT_WADDR
01:1F92 A004            	   178:   LDY #4                 ; 4 x 240 = 960
                        	   179: .vc_l:
01:1F94 A920            	   180:   LDA #' '
01:1F96 A2F0            	   181:   LDX #240
01:1F98 203B1F          	   182:   JSR VT_REP
01:1F9B 88              	   183:   DEY
01:1F9C D0F6            	   184:   BNE .vc_l
01:1F9E 60              	   185:   RTS
                        	   186: 
                        	   187: VT_ROWLO:
01:1F9F 00              	   188:   .byte <(VRAM_NAME+0*40),<(VRAM_NAME+1*40),<(VRAM_NAME+2*40),<(VRAM_NAME+3*40)
01:1FA0 28
01:1FA1 50
01:1FA2 78
01:1FA3 A0              	   189:   .byte <(VRAM_NAME+4*40),<(VRAM_NAME+5*40),<(VRAM_NAME+6*40),<(VRAM_NAME+7*40)
01:1FA4 C8
01:1FA5 F0
01:1FA6 18
01:1FA7 40              	   190:   .byte <(VRAM_NAME+8*40),<(VRAM_NAME+9*40),<(VRAM_NAME+10*40),<(VRAM_NAME+11*40)
01:1FA8 68
01:1FA9 90
01:1FAA B8
01:1FAB E0              	   191:   .byte <(VRAM_NAME+12*40),<(VRAM_NAME+13*40),<(VRAM_NAME+14*40),<(VRAM_NAME+15*40)
01:1FAC 08
01:1FAD 30
01:1FAE 58
01:1FAF 80              	   192:   .byte <(VRAM_NAME+16*40),<(VRAM_NAME+17*40),<(VRAM_NAME+18*40),<(VRAM_NAME+19*40)
01:1FB0 A8
01:1FB1 D0
01:1FB2 F8
01:1FB3 20              	   193:   .byte <(VRAM_NAME+20*40),<(VRAM_NAME+21*40),<(VRAM_NAME+22*40),<(VRAM_NAME+23*40)
01:1FB4 48
01:1FB5 70
01:1FB6 98
                        	   194: VT_ROWHI:
01:1FB7 08              	   195:   .byte >(VRAM_NAME+0*40),>(VRAM_NAME+1*40),>(VRAM_NAME+2*40),>(VRAM_NAME+3*40)
01:1FB8 08
01:1FB9 08
01:1FBA 08
01:1FBB 08              	   196:   .byte >(VRAM_NAME+4*40),>(VRAM_NAME+5*40),>(VRAM_NAME+6*40),>(VRAM_NAME+7*40)
01:1FBC 08
01:1FBD 08
01:1FBE 09
01:1FBF 09              	   197:   .byte >(VRAM_NAME+8*40),>(VRAM_NAME+9*40),>(VRAM_NAME+10*40),>(VRAM_NAME+11*40)
01:1FC0 09
01:1FC1 09
01:1FC2 09
01:1FC3 09              	   198:   .byte >(VRAM_NAME+12*40),>(VRAM_NAME+13*40),>(VRAM_NAME+14*40),>(VRAM_NAME+15*40)
01:1FC4 0A
01:1FC5 0A
01:1FC6 0A
01:1FC7 0A              	   199:   .byte >(VRAM_NAME+16*40),>(VRAM_NAME+17*40),>(VRAM_NAME+18*40),>(VRAM_NAME+19*40)
01:1FC8 0A
01:1FC9 0A
01:1FCA 0A
01:1FCB 0B              	   200:   .byte >(VRAM_NAME+20*40),>(VRAM_NAME+21*40),>(VRAM_NAME+22*40),>(VRAM_NAME+23*40)
01:1FCC 0B
01:1FCD 0B
01:1FCE 0B
                        	   201: 

Source: "apps\asm.asm"
                        	  1589:  .include "lib/console.asm"

Source: "lib\console.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   CONSOLE.ASM  -  a scrolling 40 x 24 text console           ;
                        	     4: ;                                                              ;
                        	     5: ;   Writes at the cursor, CR goes to the next row, the screen  ;
                        	     6: ;   scrolls up at the bottom (rows copied in VRAM, no RAM      ;
                        	     7: ;   copy of the screen). CON_GETS reads a typed line.          ;
                        	     8: ;   Needs lib/keys, lib/vtext.                                 ;
                        	     9: ;   Uses: zp $EC-$EF, RAM $0560-$0587 (row), $0590-$05B7 (line);
                        	    10: ;                                                              ;
                        	    11: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    12: 
                        	    13: CON_ROW     = $EC
                        	    14: CON_COL     = $ED
                        	    15: CON_LEN     = $EE      ; length of the typed line
                        	    16: CON_MAX     = $EF      ; longest line CON_GETS accepts
                        	    17: CON_ROWB    = $0560    ; one row while scrolling
                        	    18: CON_LINE    = $0590    ; the typed line, $00 at the end
                        	    19: 
                        	    20: ; CON_CLS: blank screen, cursor at the top left
                        	    21: CON_CLS:
01:1FCF 64EC            	    22:   STZ CON_ROW
01:1FD1 64ED            	    23:   STZ CON_COL
01:1FD3 4C8B1F          	    24:   JMP VT_CLS
                        	    25: 
                        	    26: ; CON_PUT: A at the cursor (CR = new row). Keeps A, X, Y
                        	    27: CON_PUT:
01:1FD6 48              	    28:   PHA
01:1FD7 DA              	    29:   PHX
01:1FD8 5A              	    30:   PHY
01:1FD9 C90D            	    31:   CMP #K_CR
01:1FDB F014            	    32:   BEQ .cp_nl
01:1FDD 48              	    33:   PHA
01:1FDE A5EC            	    34:   LDA CON_ROW
01:1FE0 A6ED            	    35:   LDX CON_COL
01:1FE2 20291F          	    36:   JSR VT_AT
01:1FE5 68              	    37:   PLA
01:1FE6 8D00B0          	    38:   STA VDP_DATA
01:1FE9 E6ED            	    39:   INC CON_COL
01:1FEB A5ED            	    40:   LDA CON_COL
01:1FED C928            	    41:   CMP #40
01:1FEF 9003            	    42:   BCC .cp_x
                        	    43: .cp_nl:
01:1FF1 20F81F          	    44:   JSR CON_NL
                        	    45: .cp_x:
01:1FF4 7A              	    46:   PLY
01:1FF5 FA              	    47:   PLX
01:1FF6 68              	    48:   PLA
01:1FF7 60              	    49:   RTS
                        	    50: 
                        	    51: ; CON_NL: cursor to the start of the next row, scrolling at the bottom
                        	    52: CON_NL:
01:1FF8 64ED            	    53:   STZ CON_COL
01:1FFA A5EC            	    54:   LDA CON_ROW
01:1FFC C917            	    55:   CMP #23
01:1FFE B003            	    56:   BCS CON_SCROLL
01:2000 E6EC            	    57:   INC CON_ROW
01:2002 60              	    58:   RTS
                        	    59: 
                        	    60: ; CON_SCROLL: rows 1-23 up by one, row 23 blank
                        	    61: CON_SCROLL:
01:2003 A001            	    62:   LDY #1
                        	    63: .cs_r:
01:2005 98              	    64:   TYA
01:2006 203F20          	    65:   JSR VT_ROWAD
01:2009 20151F          	    66:   JSR VT_RADDR
01:200C A200            	    67:   LDX #0
                        	    68: .cs_rd:
01:200E AD00B0          	    69:   LDA VDP_DATA
