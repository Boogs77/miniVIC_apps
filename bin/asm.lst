Sections:
00: "segfd0" (FD0-FD1)
01: "seg1000" (1000-2634)


Source: "apps\asm.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   ASM  -  miniVIC ASM, a two-pass 65C02 assembler            ;
                        	     4: ;   65C02 assembly, TMS9918A text mode 40 x 24                 ;
                        	     5: ;   Needs the BIOS 27.10.26 KEYB/SD                            ;
                        	     6: ;                                                              ;
                        	     7: ;   - the source is a text document (written with WRITE),      ;
                        	     8: ;     read twice from the SD (no copy in RAM)                  ;
                        	     9: ;   - a line: [LABEL[:]] [MNEMONIC operand | .DIRECTIVE] [;..] ;
                        	    10: ;     or NAME = expression. A label starts in column 1         ;
                        	    11: ;   - .ORG .BYTE .WORD .TEXT "..." .RES n; numbers $hex,       ;
                        	    12: ;     %binary, decimal, 'c', * = here; + - and < > (low / high);
                        	    13: ;     every W65C02S instruction and addressing mode            ;
                        	    14: ;   - a symbol defined further down makes the absolute mode    ;
                        	    15: ;     (in both passes, so the sizes agree)                     ;
                        	    16: ;   - the code goes to a buffer and is saved as a CODE         ;
                        	    17: ;     document (address + bytes): MON loads it with L, runs    ;
                        	    18: ;     it with G                                                ;
                        	    19: ;                                                              ;
                        	    20: ;   MEMORY                                                     ;
                        	    21: ;   $0050-$007F  zero page (lib $A0-$EF)                       ;
                        	    22: ;   $0210-$02A0  line, name                                    ;
                        	    23: ;   $3000-$3FFF  symbols: 12 bytes each (340)                  ;
                        	    24: ;   $4000-$7FFF  the code assembled (16 KB)                    ;
                        	    25: ;                                                              ;
                        	    26: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    27: 
                        	    28:  .include "lib/system.inc"

Source: "lib\system.inc"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   SYSTEM.INC  -  miniVIC / BO6502 addresses for the apps     ;
                        	     4: ;   BIOS 27.10.26 KEYB/SD jump table, VDP, key codes           ;
                        	     5: ;                                                              ;
                        	     6: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     7: 
                        	     8: ; ---------------- BIOS jump table ($FD00) ----------------
                        	     9: JT_CHROUT       = $FD00    ; A = char to screen AND serial (not used by the apps)
                        	    10: JT_CHRIN        = $FD03    ; C=1 and A = key, C=0 no key (serial first, then keyboard)
                        	    11: JT_INIT_CRT     = $FD09    ; text mode, VRAM and font of the BIOS
                        	    12: JT_LOAD_RUN_SLOT = $FD0C   ; A = SD slot: loads and runs it (never returns; error: BIOS menu)
                        	    13: JT_SHOW_MENU    = $FD0F    ; back to the BIOS menu (never returns)
                        	    14: JT_SD_READ      = $FD18    ; sector SD_LBA -> buffer X/Y (lo/hi, 512 bytes), C=1 error
                        	    15: JT_SD_WRITE     = $FD1B    ; buffer X/Y -> sector SD_LBA, C=1 error
                        	    16: JT_SD_INIT      = $FD1E    ; C=0 and A = card type, C=1 no card
                        	    17: JT_KB_MODE      = $FD21    ; A<>0 extended keyboard, A=0 classic
                        	    18: SD_LBA          = $0316    ; 4 bytes, sector number, little endian
                        	    19: 
                        	    20: ; ---------------- RAM vectors (everything is polled) ----------------
                        	    21: IRQ_VEC         = $0FA0    ; JSR $0FA0 from the BIOS IRQ handler
                        	    22: NMI_VEC         = $0FD0    ; JSR $0FD0 from the BIOS NMI handler
                        	    23: 
                        	    24: ; ---------------- VDP TMS9918A ----------------
                        	    25: VDP_DATA        = $B000
                        	    26: VDP_REG         = $B001
                        	    27: VRAM_NAME       = $0800    ; name table of the BIOS text mode (40 x 24)
                        	    28: VRAM_FONT       = $0000    ; patterns 0-127 (BIOS font), 128-255 = inverse (made by VT_INIT)
                        	    29: 
                        	    30: ; ---------------- serial W65C51 ----------------
                        	    31: ACIA_DATA   = $C000
                        	    32: ACIA_STATUS = $C001    ; bit 3 = byte received
                        	    33: ACIA_CMD    = $C002    ; BIOS: $8B (no parity, receive IRQ off, DTR on)
                        	    34: ACIA_CTRL   = $C003    ; BIOS: $1F (19200, 8 bits, 1 stop)
                        	    35: 
                        	    36: ; ---------------- key codes (extended mode) ----------------
                        	    37: K_CR            = $0D
                        	    38: K_BS            = $08
                        	    39: K_TAB           = $09
                        	    40: K_ESC           = $1B
                        	    41: K_UP            = $80
                        	    42: K_DOWN          = $81
                        	    43: K_LEFT          = $82
                        	    44: K_RIGHT         = $83
                        	    45: K_HOME          = $84
                        	    46: K_END           = $85
                        	    47: K_PGUP          = $86
                        	    48: K_PGDN          = $87
                        	    49: K_INS           = $88
                        	    50: K_DEL           = $89
                        	    51: K_F1            = $90      ; F1-F12 = $90-$9B
                        	    52: 

Source: "apps\asm.asm"
                        	    29: 
                        	    30: SYMTAB      = $3000    ; name (8, space padded), value (2), line of the definition (2)
                        	    31: SYMEND      = $4000
                        	    32: SE          = 12
                        	    33: OUTBUF      = $4000
                        	    34: OUTEND      = $8000
                        	    35: LINEMAX     = 80
                        	    36: NAMELEN     = 12
                        	    37: MAXSHOW     = 15       ; errors shown
                        	    38: 
                        	    39: ; ---------------- zero page ----------------
                        	    40: PASS        = $50
                        	    41: PC          = $51      ; 2 bytes: address of the next byte
                        	    42: BASE        = $53      ; 2 bytes: first .ORG
                        	    43: BASESET     = $55
                        	    44: TOPPC       = $56      ; 2 bytes: highest address written + 1
                        	    45: LNUM        = $58      ; 2 bytes: line number
                        	    46: NERR        = $5A      ; 2 bytes
                        	    47: LP          = $5C      ; position in the line
                        	    48: VAL         = $5D      ; 2 bytes: expression value
                        	    49: FWD         = $5F      ; 1 = the expression uses a symbol not defined above
                        	    50: LONG        = $60      ; 1 = written with more than 2 hex digits (absolute)
                        	    51: NSYM        = $61      ; 2 bytes: symbols
                        	    52: SP0         = $63      ; 2 bytes: symbol pointer
                        	    53: MN          = $65
                        	    54: AMODE       = $66
                        	    55: BITN        = $67
                        	    56: AVAL        = $68      ; 2 bytes: operand
                        	    57: AVAL2       = $6A      ; 2 bytes: BBR / BBS target
                        	    58: AFWD        = $6C
                        	    59: T0          = $6D
                        	    60: T1          = $6E
                        	    61: T2          = $6F
                        	    62: SLOT        = $70      ; source document
                        	    63: ELAST       = $71      ; error code of this line
                        	    64: QUOTE       = $72
                        	    65: 
                        	    66: ; ---------------- RAM ----------------
                        	    67: LINE        = $0210    ; source line (80 + $00)
                        	    68: SNAME       = $0262    ; symbol name being read (8)
                        	    69: DNAME       = $0270    ; document name (12 + $00)
                        	    70: 
                        	    71:  .org $0FD0
00:0FD0 60              	    72:   RTS                    ; NMI trampoline (the VDP interrupt is off)
                        	    73:  .org $1000
