01:203F AA              	    96:   TAX
01:2040 BD9F1F          	    97:   LDA VT_ROWLO,X
01:2043 48              	    98:   PHA
01:2044 BDB71F          	    99:   LDA VT_ROWHI,X
01:2047 AA              	   100:   TAX
01:2048 68              	   101:   PLA
01:2049 60              	   102:   RTS
