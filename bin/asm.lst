Source: "lib\docs.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   DOCS.ASM  -  documents in the SD document area             ;
                        	     4: ;                                                              ;
                        	     5: ;   Sector 16384 ($00800000, after the 255 program blocks)     ;
                        	     6: ;   is the index: +0 "DOCS", +4 version 1, +5 slots (15);      ;
                        	     7: ;   entry k (1-15) at k*32: +0 type (0 free, 1 text,           ;
                        	     8: ;   2 sheet, 3 card file),                                     ;
                        	     9: ;   +1/+2 length, +4..+15 name (12 chars, $00 padded).         ;
                        	    10: ;   Document k = 40 sectors (20 KB) from sector 16384 + k*40.  ;
                        	    11: ;   Sectors go through the BIOS (JT_SD_READ / JT_SD_WRITE).    ;
                        	    12: ;   Uses: zp $AA-$AF, $B8-$BA, RAM $0600-$07FF (index sector)  ;
                        	    13: ;                                                              ;
                        	    14: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    15: 
                        	    16: DOC_IDX     = $0600    ; index sector (512 bytes)
                        	    17: DOC_BASE    = $4000    ; sector 16384
                        	    18: DOC_SLOTS   = 15
                        	    19: DOC_SECTS   = 40       ; sectors per document
                        	    20: DOC_NAMELEN = 12
                        	    21: DOC_E       = $AA      ; 2 bytes: pointer to the index entry
                        	    22: DOC_K       = $AC      ; slot
                        	    23: DOC_I       = $AD      ; sector inside the document
                        	    24: DOC_N       = $AE      ; sectors to transfer
                        	    25: DOC_PG      = $AF      ; RAM page of the transfer
                        	    26: DOC_T       = $B8      ; document type of the application (1 text, 2 sheet, 3 card file)
                        	    27: DOC_LEN     = $B9      ; 2 bytes: length for DOC_SETENT
                        	    28: 
                        	    29: ; DOC_RDIDX: reads the index; a sector without "DOCS" becomes an empty index. C=1 SD error
                        	    30: DOC_RDIDX:
01:215C 207422          	    31:   JSR DOC_LBA0
01:215F A200            	    32:   LDX #<DOC_IDX
01:2161 A006            	    33:   LDY #>DOC_IDX
01:2163 2018FD          	    34:   JSR JT_SD_READ
01:2166 B00E            	    35:   BCS .dr_x
01:2168 A203            	    36:   LDX #3
                        	    37: .dr_m:
01:216A BD0006          	    38:   LDA DOC_IDX,X
01:216D DDCE22          	    39:   CMP DOC_MAGIC,X
01:2170 D005            	    40:   BNE .dr_new
01:2172 CA              	    41:   DEX
01:2173 10F5            	    42:   BPL .dr_m
01:2175 18              	    43:   CLC
                        	    44: .dr_x:
01:2176 60              	    45:   RTS
                        	    46: .dr_new:
01:2177 A200            	    47:   LDX #0
                        	    48: .dr_z:
01:2179 9E0006          	    49:   STZ DOC_IDX,X
01:217C 9E0007          	    50:   STZ DOC_IDX+$100,X
01:217F E8              	    51:   INX
01:2180 D0F7            	    52:   BNE .dr_z
01:2182 A205            	    53:   LDX #5
                        	    54: .dr_h:
01:2184 BDCE22          	    55:   LDA DOC_MAGIC,X
01:2187 9D0006          	    56:   STA DOC_IDX,X
01:218A CA              	    57:   DEX
01:218B 10F7            	    58:   BPL .dr_h
01:218D 18              	    59:   CLC
01:218E 60              	    60:   RTS
                        	    61: 
                        	    62: ; DOC_WRIDX: writes the index. C=1 SD error
                        	    63: DOC_WRIDX:
01:218F 207422          	    64:   JSR DOC_LBA0
01:2192 A200            	    65:   LDX #<DOC_IDX
01:2194 A006            	    66:   LDY #>DOC_IDX
01:2196 4C1BFD          	    67:   JMP JT_SD_WRITE
                        	    68: 
                        	    69: ; DOC_ENTRY: A = slot (1-15) -> DOC_E = its index entry. Keeps X, Y
                        	    70: DOC_ENTRY:
01:2199 85AC            	    71:   STA DOC_K
01:219B 4A              	    72:   LSR
01:219C 4A              	    73:   LSR
01:219D 4A              	    74:   LSR
01:219E 18              	    75:   CLC
01:219F 6906            	    76:   ADC #>DOC_IDX
01:21A1 85AB            	    77:   STA DOC_E+1
01:21A3 A5AC            	    78:   LDA DOC_K
01:21A5 0A              	    79:   ASL
01:21A6 0A              	    80:   ASL
01:21A7 0A              	    81:   ASL
01:21A8 0A              	    82:   ASL
01:21A9 0A              	    83:   ASL
01:21AA 85AA            	    84:   STA DOC_E              ; (DOC_IDX is page aligned)
01:21AC 60              	    85:   RTS
                        	    86: 
                        	    87: ; DOC_FIND: name of 12 bytes at (DOC_P) and type DOC_T -> C=0 and A = slot, C=1 not found
                        	    88: DOC_P       = VT_P     ; (shares the string pointer)
                        	    89: DOC_FIND:
01:21AD A901            	    90:   LDA #1
                        	    91: .df_k:
01:21AF 48              	    92:   PHA
01:21B0 209921          	    93:   JSR DOC_ENTRY
01:21B3 A000            	    94:   LDY #0
01:21B5 B1AA            	    95:   LDA (DOC_E),Y
01:21B7 C5B8            	    96:   CMP DOC_T
01:21B9 D01A            	    97:   BNE .df_n              ; free or another type
01:21BB A00B            	    98:   LDY #DOC_NAMELEN-1
                        	    99: .df_c:
01:21BD B1A2            	   100:   LDA (DOC_P),Y
01:21BF 85AD            	   101:   STA DOC_I              ; (temporary)
01:21C1 C8              	   102:   INY                    ; name in the entry at +4
01:21C2 C8              	   103:   INY
01:21C3 C8              	   104:   INY
01:21C4 C8              	   105:   INY
01:21C5 B1AA            	   106:   LDA (DOC_E),Y
01:21C7 C5AD            	   107:   CMP DOC_I
01:21C9 D00A            	   108:   BNE .df_n
01:21CB 88              	   109:   DEY                    ; back to the previous character
01:21CC 88              	   110:   DEY
01:21CD 88              	   111:   DEY
01:21CE 88              	   112:   DEY
01:21CF 88              	   113:   DEY
01:21D0 10EB            	   114:   BPL .df_c
01:21D2 68              	   115:   PLA
01:21D3 18              	   116:   CLC
01:21D4 60              	   117:   RTS
                        	   118: .df_n:
01:21D5 68              	   119:   PLA
01:21D6 1A              	   120:   INC A
01:21D7 C910            	   121:   CMP #DOC_SLOTS+1
01:21D9 D0D4            	   122:   BNE .df_k
01:21DB 38              	   123:   SEC
01:21DC 60              	   124:   RTS
                        	   125: 
                        	   126: ; DOC_FREE: C=0 and A = first free slot, C=1 index full
                        	   127: DOC_FREE:
01:21DD A901            	   128:   LDA #1
                        	   129: .dfr_k:
01:21DF 209921          	   130:   JSR DOC_ENTRY
01:21E2 A000            	   131:   LDY #0
01:21E4 B1AA            	   132:   LDA (DOC_E),Y
01:21E6 F009            	   133:   BEQ .dfr_y
01:21E8 A5AC            	   134:   LDA DOC_K
01:21EA 1A              	   135:   INC A
01:21EB C910            	   136:   CMP #DOC_SLOTS+1
01:21ED D0F0            	   137:   BNE .dfr_k
01:21EF 38              	   138:   SEC
01:21F0 60              	   139:   RTS
                        	   140: .dfr_y:
01:21F1 A5AC            	   141:   LDA DOC_K
01:21F3 18              	   142:   CLC
01:21F4 60              	   143:   RTS
                        	   144: 
                        	   145: ; DOC_SETENT: entry of slot A = type DOC_T, length DOC_LEN, name (DOC_P) (12 bytes)
                        	   146: DOC_SETENT:
01:21F5 209921          	   147:   JSR DOC_ENTRY
01:21F8 A000            	   148:   LDY #0
01:21FA A5B8            	   149:   LDA DOC_T
01:21FC 91AA            	   150:   STA (DOC_E),Y
01:21FE C8              	   151:   INY
01:21FF A5B9            	   152:   LDA DOC_LEN
01:2201 91AA            	   153:   STA (DOC_E),Y
01:2203 C8              	   154:   INY
01:2204 A5BA            	   155:   LDA DOC_LEN+1
01:2206 91AA            	   156:   STA (DOC_E),Y
01:2208 C8              	   157:   INY
01:2209 A900            	   158:   LDA #0
01:220B 91AA            	   159:   STA (DOC_E),Y
01:220D A000            	   160:   LDY #0                 ; name: (DOC_P)+0..11 -> entry +4..15
                        	   161: .dse_n:
01:220F B1A2            	   162:   LDA (DOC_P),Y
01:2211 C8              	   163:   INY
01:2212 C8              	   164:   INY
01:2213 C8              	   165:   INY
01:2214 C8              	   166:   INY
01:2215 91AA            	   167:   STA (DOC_E),Y
01:2217 88              	   168:   DEY
01:2218 88              	   169:   DEY
01:2219 88              	   170:   DEY
01:221A C00C            	   171:   CPY #DOC_NAMELEN
01:221C D0F1            	   172:   BNE .dse_n
01:221E 60              	   173:   RTS
                        	   174: 
                        	   175: ; DOC_SECT: SD_LBA = DOC_BASE + DOC_K*40 + DOC_I
                        	   176: DOC_SECT:
01:221F 9C1803          	   177:   STZ SD_LBA+2
01:2222 9C1903          	   178:   STZ SD_LBA+3
01:2225 A5AC            	   179:   LDA DOC_K
01:2227 8D1603          	   180:   STA SD_LBA
01:222A 9C1703          	   181:   STZ SD_LBA+1
01:222D 0E1603          	   182:   ASL SD_LBA             ; k*8
01:2230 2E1703          	   183:   ROL SD_LBA+1
01:2233 0E1603          	   184:   ASL SD_LBA
01:2236 2E1703          	   185:   ROL SD_LBA+1
01:2239 0E1603          	   186:   ASL SD_LBA
01:223C 2E1703          	   187:   ROL SD_LBA+1
01:223F AD1703          	   188:   LDA SD_LBA+1           ; + k*32 = 4 * (k*8)
01:2242 48              	   189:   PHA
01:2243 AD1603          	   190:   LDA SD_LBA
01:2246 48              	   191:   PHA
01:2247 0E1603          	   192:   ASL SD_LBA
01:224A 2E1703          	   193:   ROL SD_LBA+1
01:224D 0E1603          	   194:   ASL SD_LBA
01:2250 2E1703          	   195:   ROL SD_LBA+1
01:2253 18              	   196:   CLC
01:2254 68              	   197:   PLA
01:2255 6D1603          	   198:   ADC SD_LBA
01:2258 8D1603          	   199:   STA SD_LBA
01:225B 68              	   200:   PLA
01:225C 6D1703          	   201:   ADC SD_LBA+1
01:225F 8D1703          	   202:   STA SD_LBA+1
01:2262 18              	   203:   CLC
01:2263 AD1603          	   204:   LDA SD_LBA
01:2266 65AD            	   205:   ADC DOC_I
01:2268 8D1603          	   206:   STA SD_LBA
01:226B AD1703          	   207:   LDA SD_LBA+1
01:226E 6940            	   208:   ADC #>DOC_BASE
01:2270 8D1703          	   209:   STA SD_LBA+1
01:2273 60              	   210:   RTS
                        	   211: 
                        	   212: DOC_LBA0:
01:2274 9C1603          	   213:   STZ SD_LBA
01:2277 A940            	   214:   LDA #>DOC_BASE
01:2279 8D1703          	   215:   STA SD_LBA+1
01:227C 9C1803          	   216:   STZ SD_LBA+2
01:227F 9C1903          	   217:   STZ SD_LBA+3
01:2282 60              	   218:   RTS
                        	   219: 
                        	   220: ; DOC_XFER: DOC_K = slot, A = RAM page of the data, X/Y = length (lo/hi), C=0 read, C=1 write
                        	   221: ; Transfers ceil(length / 512) sectors. C=1 SD error
                        	   222: DOC_XFER:
01:2283 85AF            	   223:   STA DOC_PG
01:2285 08              	   224:   PHP
01:2286 8A              	   225:   TXA                    ; sectors = (length + 511) / 512
01:2287 18              	   226:   CLC
01:2288 69FF            	   227:   ADC #$FF
01:228A 98              	   228:   TYA
01:228B 6901            	   229:   ADC #$01
01:228D 4A              	   230:   LSR
01:228E 85AE            	   231:   STA DOC_N
01:2290 64AD            	   232:   STZ DOC_I
01:2292 28              	   233:   PLP
01:2293 B017            	   234:   BCS .dx_w
                        	   235: .dx_r:
01:2295 A5AD            	   236:   LDA DOC_I
01:2297 C5AE            	   237:   CMP DOC_N
01:2299 B028            	   238:   BCS .dx_ok
01:229B 201F22          	   239:   JSR DOC_SECT
01:229E A200            	   240:   LDX #0
01:22A0 A4AF            	   241:   LDY DOC_PG
01:22A2 2018FD          	   242:   JSR JT_SD_READ
01:22A5 B01D            	   243:   BCS .dx_x
01:22A7 20C522          	   244:   JSR .dx_next
01:22AA 80E9            	   245:   BRA .dx_r
                        	   246: .dx_w:
01:22AC A5AD            	   247:   LDA DOC_I
01:22AE C5AE            	   248:   CMP DOC_N
01:22B0 B011            	   249:   BCS .dx_ok
01:22B2 201F22          	   250:   JSR DOC_SECT
01:22B5 A200            	   251:   LDX #0
01:22B7 A4AF            	   252:   LDY DOC_PG
01:22B9 201BFD          	   253:   JSR JT_SD_WRITE
01:22BC B006            	   254:   BCS .dx_x
01:22BE 20C522          	   255:   JSR .dx_next
01:22C1 80E9            	   256:   BRA .dx_w
                        	   257: .dx_ok:
01:22C3 18              	   258:   CLC
                        	   259: .dx_x:
01:22C4 60              	   260:   RTS
                        	   261: .dx_next:
01:22C5 E6AD            	   262:   INC DOC_I
01:22C7 E6AF            	   263:   INC DOC_PG
01:22C9 E6AF            	   264:   INC DOC_PG
01:22CB 4C521E          	   265:   JMP KB_POLL
