Source: "lib\ui.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   UI.ASM  -  the parts every application shows the same way  ;
                        	     4: ;                                                              ;
                        	     5: ;   - PROMPT: a question on row 23, the answer typed after it  ;
                        	     6: ;   - YESNO:  a Y/N question on row 23                         ;
                        	     7: ;   - DOC_PICK: the list of the SD documents (open / delete)   ;
                        	     8: ;   Needs lib/keys, lib/vtext, lib/num, lib/docs.              ;
                        	     9: ;   Uses: zp $B0-$B7, RAM $02A0-$02C7 (UI_LINE),               ;
                        	    10: ;         $02D8-$02F7 (UI_BUF)                                 ;
                        	    11: ;                                                              ;
                        	    12: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    13: 
                        	    14: UI_LINE     = $02A0    ; 40 characters: a row being built (the apps may use it too)
                        	    15: UI_BUF      = $02D8    ; PROMPT answer (31 + $00)
                        	    16: UI_PTXT     = $B0      ; 2 bytes: question
                        	    17: UI_PMAX     = $B2      ; longest answer
                        	    18: UI_PUPC     = $B3      ; 1 = letters in upper case
                        	    19: UI_PLEN     = $B4      ; answer length
                        	    20: UI_SEL      = $B5      ; DOC_PICK: slot under the bar
                        	    21: UI_ROW      = $B6
                        	    22: UI_ANY      = $B7      ; DOC_PICK: 1 = every type can be opened, 0 = only DOC_T
                        	    23: 
                        	    24: ; PROMPT: question A/X on row 23, the answer in UI_BUF (it starts with what is already
                        	    25: ; there), UI_PMAX characters at most. C=0 and A = length (Enter), C=1 Esc
                        	    26: PROMPT:
01:239D 85B0            	    27:   STA UI_PTXT
01:239F 86B1            	    28:   STX UI_PTXT+1
01:23A1 A200            	    29:   LDX #0
                        	    30: .pr_len:
01:23A3 BDD802          	    31:   LDA UI_BUF,X
01:23A6 F003            	    32:   BEQ .pr_d
01:23A8 E8              	    33:   INX
01:23A9 80F8            	    34:   BRA .pr_len
                        	    35: .pr_d:
01:23AB 86B4            	    36:   STX UI_PLEN
                        	    37: .pr_draw:
01:23AD A917            	    38:   LDA #23
01:23AF 201C1F          	    39:   JSR VT_ROW
01:23B2 64A4            	    40:   STZ VT_INV
01:23B4 A5B0            	    41:   LDA UI_PTXT
01:23B6 85A2            	    42:   STA VT_P
01:23B8 A5B1            	    43:   LDA UI_PTXT+1
01:23BA 85A3            	    44:   STA VT_P+1
01:23BC 20501F          	    45:   JSR VT_STR
01:23BF 84B6            	    46:   STY UI_ROW             ; (column)
01:23C1 A200            	    47:   LDX #0
                        	    48: .pr_c:
01:23C3 E4B4            	    49:   CPX UI_PLEN
01:23C5 F00B            	    50:   BEQ .pr_cur
01:23C7 BDD802          	    51:   LDA UI_BUF,X
01:23CA 8D00B0          	    52:   STA VDP_DATA
01:23CD E8              	    53:   INX
01:23CE E6B6            	    54:   INC UI_ROW
01:23D0 80F1            	    55:   BRA .pr_c
                        	    56: .pr_cur:
01:23D2 A9A0            	    57:   LDA #' '+$80           ; cursor
01:23D4 8D00B0          	    58:   STA VDP_DATA
01:23D7 E6B6            	    59:   INC UI_ROW
01:23D9 A928            	    60:   LDA #40
01:23DB 38              	    61:   SEC
01:23DC E5B6            	    62:   SBC UI_ROW
01:23DE 9008            	    63:   BCC .pr_k
01:23E0 F006            	    64:   BEQ .pr_k
01:23E2 AA              	    65:   TAX
01:23E3 A920            	    66:   LDA #' '
01:23E5 203B1F          	    67:   JSR VT_REP
                        	    68: .pr_k:
01:23E8 208F1E          	    69:   JSR WAITKEY
01:23EB C90D            	    70:   CMP #K_CR
01:23ED F034            	    71:   BEQ .pr_ok
01:23EF C91B            	    72:   CMP #K_ESC
01:23F1 F034            	    73:   BEQ .pr_esc
01:23F3 C908            	    74:   CMP #K_BS
01:23F5 F020            	    75:   BEQ .pr_bs
01:23F7 C920            	    76:   CMP #' '
01:23F9 90ED            	    77:   BCC .pr_k
01:23FB C97F            	    78:   CMP #$7F
01:23FD B0E9            	    79:   BCS .pr_k
01:23FF A6B4            	    80:   LDX UI_PLEN
01:2401 E4B2            	    81:   CPX UI_PMAX
01:2403 B0E3            	    82:   BCS .pr_k
01:2405 A4B3            	    83:   LDY UI_PUPC
01:2407 F003            	    84:   BEQ .pr_s
01:2409 202924          	    85:   JSR UI_UPC
                        	    86: .pr_s:
01:240C 9DD802          	    87:   STA UI_BUF,X
01:240F E8              	    88:   INX
01:2410 9ED802          	    89:   STZ UI_BUF,X
01:2413 86B4            	    90:   STX UI_PLEN
01:2415 8096            	    91:   BRA .pr_draw
                        	    92: .pr_bs:
01:2417 A6B4            	    93:   LDX UI_PLEN
01:2419 F0CD            	    94:   BEQ .pr_k
01:241B CA              	    95:   DEX
01:241C 9ED802          	    96:   STZ UI_BUF,X
01:241F 86B4            	    97:   STX UI_PLEN
01:2421 808A            	    98:   BRA .pr_draw
                        	    99: .pr_ok:
01:2423 A5B4            	   100:   LDA UI_PLEN
01:2425 18              	   101:   CLC
01:2426 60              	   102:   RTS
                        	   103: .pr_esc:
01:2427 38              	   104:   SEC
01:2428 60              	   105:   RTS
                        	   106: 
                        	   107: ; UI_UPC: lower case letter -> upper case. Keeps X, Y
                        	   108: UI_UPC:
01:2429 C961            	   109:   CMP #'a'
01:242B 9006            	   110:   BCC .uu_x
01:242D C97B            	   111:   CMP #'z'+1
01:242F B002            	   112:   BCS .uu_x
01:2431 29DF            	   113:   AND #$DF
                        	   114: .uu_x:
01:2433 60              	   115:   RTS
                        	   116: 
                        	   117: ; YESNO: question A/X on row 23; C=0 if the answer is Y
                        	   118: YESNO:
01:2434 DA              	   119:   PHX
01:2435 48              	   120:   PHA
01:2436 A917            	   121:   LDA #23
01:2438 201C1F          	   122:   JSR VT_ROW
01:243B 64A4            	   123:   STZ VT_INV
01:243D 68              	   124:   PLA
01:243E FA              	   125:   PLX
01:243F A000            	   126:   LDY #0
01:2441 20671F          	   127:   JSR VT_LINE
01:2444 208F1E          	   128:   JSR WAITKEY
01:2447 29DF            	   129:   AND #$DF
01:2449 C959            	   130:   CMP #'Y'
01:244B F002            	   131:   BEQ .yn_y
01:244D 38              	   132:   SEC
01:244E 60              	   133:   RTS
                        	   134: .yn_y:
01:244F 18              	   135:   CLC
01:2450 60              	   136:   RTS
                        	   137: 
                        	   138: ; DOC_PICK: whole-screen list of the documents; arrows (^E ^X) choose, Enter opens,
                        	   139: ; Del (^G) deletes after a question, Esc goes back. A/X = title.
                        	   140: ; Enter on a free slot, or (UI_ANY = 0) on a document of another type, does nothing.
                        	   141: ; C=0 and A = slot to open (index in DOC_IDX), C=1 and A=0 back, C=1 and A=$FF SD error.
                        	   142: ; The caller redraws its screen afterwards.
                        	   143: DOC_PICK:
01:2451 85B0            	   144:   STA UI_PTXT
01:2453 86B1            	   145:   STX UI_PTXT+1
01:2455 205C21          	   146:   JSR DOC_RDIDX
01:2458 9003            	   147:   BCC .dp_ok
01:245A A9FF            	   148:   LDA #$FF
01:245C 60              	   149:   RTS
                        	   150: .dp_ok:
01:245D A901            	   151:   LDA #1
01:245F 85B5            	   152:   STA UI_SEL
01:2461 208B1F          	   153:   JSR VT_CLS
                        	   154: .dp_draw:
01:2464 A900            	   155:   LDA #0
01:2466 201C1F          	   156:   JSR VT_ROW
01:2469 A980            	   157:   LDA #$80
01:246B 85A4            	   158:   STA VT_INV
01:246D A5B0            	   159:   LDA UI_PTXT
01:246F A6B1            	   160:   LDX UI_PTXT+1
01:2471 A000            	   161:   LDY #0
01:2473 20671F          	   162:   JSR VT_LINE
01:2476 A901            	   163:   LDA #1
01:2478 85B6            	   164:   STA UI_ROW
                        	   165: .dp_r:
01:247A 201D25          	   166:   JSR DP_ROW
01:247D E6B6            	   167:   INC UI_ROW
01:247F A5B6            	   168:   LDA UI_ROW
01:2481 C910            	   169:   CMP #DOC_SLOTS+1
01:2483 D0F5            	   170:   BNE .dp_r
01:2485 A916            	   171:   LDA #22
01:2487 201C1F          	   172:   JSR VT_ROW
01:248A 64A4            	   173:   STZ VT_INV
01:248C A9F7            	   174:   LDA #<DP_KEYS
01:248E A225            	   175:   LDX #>DP_KEYS
01:2490 A000            	   176:   LDY #0
01:2492 20671F          	   177:   JSR VT_LINE
01:2495 A917            	   178:   LDA #23
01:2497 201C1F          	   179:   JSR VT_ROW
01:249A A920            	   180:   LDA #' '
01:249C A228            	   181:   LDX #40
01:249E 203B1F          	   182:   JSR VT_REP
                        	   183: .dp_k:
01:24A1 208F1E          	   184:   JSR WAITKEY
01:24A4 C91B            	   185:   CMP #K_ESC
01:24A6 F036            	   186:   BEQ .dp_x
01:24A8 C980            	   187:   CMP #K_UP
01:24AA F01A            	   188:   BEQ .dp_up
01:24AC C905            	   189:   CMP #'E'-$40
01:24AE F016            	   190:   BEQ .dp_up
01:24B0 C981            	   191:   CMP #K_DOWN
01:24B2 F01C            	   192:   BEQ .dp_dn
01:24B4 C918            	   193:   CMP #'X'-$40
