Source: "lib\num.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   NUM.ASM  -  16-bit numbers to decimal text                 ;
                        	     4: ;   Uses: zp $A5-$A9                                           ;
                        	     5: ;                                                              ;
                        	     6: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     7: 
                        	     8: NUM         = $A5      ; 2 bytes: number to convert (destroyed)
                        	     9: BCD         = $A7      ; 3 bytes: BCD result, $A7 = lowest 2 digits
                        	    10: 
                        	    11: ; BIN2BCD: NUM -> BCD (double dabble with decimal mode)
                        	    12: BIN2BCD:
01:20F9 20521E          	    13:   JSR KB_POLL
01:20FC 64A7            	    14:   STZ BCD
01:20FE 64A8            	    15:   STZ BCD+1
01:2100 64A9            	    16:   STZ BCD+2
01:2102 A210            	    17:   LDX #16
01:2104 F8              	    18:   SED
                        	    19: .bb_l:
01:2105 06A5            	    20:   ASL NUM
01:2107 26A6            	    21:   ROL NUM+1
01:2109 A5A7            	    22:   LDA BCD
01:210B 65A7            	    23:   ADC BCD
01:210D 85A7            	    24:   STA BCD
01:210F A5A8            	    25:   LDA BCD+1
01:2111 65A8            	    26:   ADC BCD+1
01:2113 85A8            	    27:   STA BCD+1
01:2115 A5A9            	    28:   LDA BCD+2
01:2117 65A9            	    29:   ADC BCD+2
01:2119 85A9            	    30:   STA BCD+2
01:211B CA              	    31:   DEX
01:211C D0E7            	    32:   BNE .bb_l
01:211E D8              	    33:   CLD
01:211F 60              	    34:   RTS
                        	    35: 
                        	    36: ; NUMSTR: NUM -> 5 characters at (VT_P),Y.. with leading spaces (last digit always shown)
                        	    37: ; Y = first position; on exit Y = position after the number
                        	    38: NUMSTR:
01:2120 20F920          	    39:   JSR BIN2BCD
01:2123 20521E          	    40:   JSR KB_POLL            ; (BIN2BCD takes ~600 cycles)
01:2126 A200            	    41:   LDX #0                 ; X = 1 once a digit is not zero
01:2128 A5A9            	    42:   LDA BCD+2
01:212A 204821          	    43:   JSR .ns_dig            ; ten thousands
01:212D A5A8            	    44:   LDA BCD+1
01:212F 4A              	    45:   LSR
01:2130 4A              	    46:   LSR
01:2131 4A              	    47:   LSR
01:2132 4A              	    48:   LSR
01:2133 204821          	    49:   JSR .ns_dig
01:2136 A5A8            	    50:   LDA BCD+1
01:2138 204821          	    51:   JSR .ns_dig
01:213B A5A7            	    52:   LDA BCD
01:213D 4A              	    53:   LSR
01:213E 4A              	    54:   LSR
01:213F 4A              	    55:   LSR
01:2140 4A              	    56:   LSR
01:2141 204821          	    57:   JSR .ns_dig
01:2144 A5A7            	    58:   LDA BCD
01:2146 A201            	    59:   LDX #1                 ; the last digit is always written
                        	    60: .ns_dig:
01:2148 290F            	    61:   AND #$0F
01:214A D008            	    62:   BNE .ns_nz
01:214C E000            	    63:   CPX #0
01:214E D004            	    64:   BNE .ns_nz
01:2150 A920            	    65:   LDA #' '
01:2152 8004            	    66:   BRA .ns_put
                        	    67: .ns_nz:
01:2154 A201            	    68:   LDX #1
01:2156 0930            	    69:   ORA #'0'
                        	    70: .ns_put:
01:2158 91A2            	    71:   STA (VT_P),Y
01:215A C8              	    72:   INY
01:215B 60              	    73:   RTS
                        	    74: 

