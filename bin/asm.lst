Source: "lib\stream.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   STREAM.ASM  -  a document written / read byte by byte      ;
                        	     4: ;                                                              ;
                        	     5: ;   Through a 512-byte sector buffer, one sector at a time,    ;
                        	     6: ;   in the slot DOC_K of the document area (lib/docs.asm).     ;
                        	     7: ;   Uses: zp $E4-$EB, RAM $0800-$09FF (ST_BUF)                 ;
                        	     8: ;                                                              ;
                        	     9: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    10: 
                        	    11: ST_BUF      = $0800    ; sector buffer (page aligned)
                        	    12: ST_POS      = $E4      ; 2 bytes: position in ST_BUF
                        	    13: ST_SEC      = $E6      ; sector of the document
                        	    14: ST_LEFT     = $E7      ; 2 bytes: bytes still to read
                        	    15: ST_ERR      = $E9      ; 1 = SD error or too big
                        	    16: ST_P        = $EA      ; 2 bytes
                        	    17: 
                        	    18: ; ST_WOPEN: start writing the document DOC_K
                        	    19: ST_WOPEN:
01:22D4 64E4            	    20:   STZ ST_POS
01:22D6 64E5            	    21:   STZ ST_POS+1
01:22D8 64E6            	    22:   STZ ST_SEC
01:22DA 64E9            	    23:   STZ ST_ERR
01:22DC 60              	    24:   RTS
                        	    25: 
                        	    26: ; ST_PUT: A to the document. Keeps A, X, Y
                        	    27: ST_PUT:
01:22DD 48              	    28:   PHA
01:22DE DA              	    29:   PHX
01:22DF 5A              	    30:   PHY
01:22E0 48              	    31:   PHA
01:22E1 A5E4            	    32:   LDA ST_POS
01:22E3 85EA            	    33:   STA ST_P
01:22E5 A5E5            	    34:   LDA ST_POS+1
01:22E7 18              	    35:   CLC
01:22E8 6908            	    36:   ADC #>ST_BUF
01:22EA 85EB            	    37:   STA ST_P+1
01:22EC 68              	    38:   PLA
01:22ED 92EA            	    39:   STA (ST_P)
01:22EF E6E4            	    40:   INC ST_POS
01:22F1 D00B            	    41:   BNE .sp_x
01:22F3 E6E5            	    42:   INC ST_POS+1
01:22F5 A5E5            	    43:   LDA ST_POS+1
01:22F7 C902            	    44:   CMP #2
01:22F9 D003            	    45:   BNE .sp_x
01:22FB 200223          	    46:   JSR ST_FLUSH
                        	    47: .sp_x:
01:22FE 7A              	    48:   PLY
01:22FF FA              	    49:   PLX
01:2300 68              	    50:   PLA
01:2301 60              	    51:   RTS
                        	    52: 
                        	    53: ; ST_FLUSH: the buffer (ST_POS bytes) to sector ST_SEC, then an empty buffer
                        	    54: ST_FLUSH:
01:2302 A5E4            	    55:   LDA ST_POS
01:2304 05E5            	    56:   ORA ST_POS+1
01:2306 F01E            	    57:   BEQ .sf_x
01:2308 A5E6            	    58:   LDA ST_SEC
01:230A C928            	    59:   CMP #DOC_SECTS
01:230C B00E            	    60:   BCS .sf_big
01:230E 85AD            	    61:   STA DOC_I
01:2310 201F22          	    62:   JSR DOC_SECT
01:2313 A200            	    63:   LDX #<ST_BUF
01:2315 A008            	    64:   LDY #>ST_BUF
01:2317 201BFD          	    65:   JSR JT_SD_WRITE
01:231A 9004            	    66:   BCC .sf_n
                        	    67: .sf_big:
01:231C A901            	    68:   LDA #1
01:231E 85E9            	    69:   STA ST_ERR
                        	    70: .sf_n:
01:2320 E6E6            	    71:   INC ST_SEC
01:2322 64E4            	    72:   STZ ST_POS
01:2324 64E5            	    73:   STZ ST_POS+1
                        	    74: .sf_x:
01:2326 60              	    75:   RTS
                        	    76: 
                        	    77: ; ST_WCLOSE: the last part; DOC_LEN = length. C=1 SD error or more than 20 KB
                        	    78: ST_WCLOSE:
01:2327 A5E6            	    79:   LDA ST_SEC             ; length = sectors * 512 + position
01:2329 0A              	    80:   ASL
01:232A 18              	    81:   CLC
01:232B 65E5            	    82:   ADC ST_POS+1
01:232D 85BA            	    83:   STA DOC_LEN+1
01:232F A5E4            	    84:   LDA ST_POS
01:2331 85B9            	    85:   STA DOC_LEN
01:2333 200223          	    86:   JSR ST_FLUSH
01:2336 A5E9            	    87:   LDA ST_ERR
01:2338 C901            	    88:   CMP #1                 ; C=1 if ST_ERR
01:233A 60              	    89:   RTS
                        	    90: 
                        	    91: ; ST_ROPEN: start reading the document DOC_K of DOC_LEN bytes
                        	    92: ST_ROPEN:
01:233B A5B9            	    93:   LDA DOC_LEN
01:233D 85E7            	    94:   STA ST_LEFT
01:233F A5BA            	    95:   LDA DOC_LEN+1
01:2341 85E8            	    96:   STA ST_LEFT+1
01:2343 64E6            	    97:   STZ ST_SEC
01:2345 64E9            	    98:   STZ ST_ERR
01:2347 A902            	    99:   LDA #2                 ; (buffer empty: the first ST_GET reads a sector)
01:2349 85E5            	   100:   STA ST_POS+1
01:234B 64E4            	   101:   STZ ST_POS
01:234D 60              	   102:   RTS
                        	   103: 
                        	   104: ; ST_GET: A = next byte, C=1 at the end (ST_ERR = 1 if the SD failed). Keeps X, Y
                        	   105: ST_GET:
01:234E A5E7            	   106:   LDA ST_LEFT
01:2350 05E8            	   107:   ORA ST_LEFT+1
01:2352 F047            	   108:   BEQ .sg_end
01:2354 DA              	   109:   PHX
01:2355 5A              	   110:   PHY
01:2356 A5E5            	   111:   LDA ST_POS+1
01:2358 C902            	   112:   CMP #2
01:235A 9016            	   113:   BCC .sg_b
01:235C A5E6            	   114:   LDA ST_SEC             ; next sector
01:235E 85AD            	   115:   STA DOC_I
01:2360 201F22          	   116:   JSR DOC_SECT
01:2363 A200            	   117:   LDX #<ST_BUF
01:2365 A008            	   118:   LDY #>ST_BUF
01:2367 2018FD          	   119:   JSR JT_SD_READ
01:236A B025            	   120:   BCS .sg_err
01:236C E6E6            	   121:   INC ST_SEC
01:236E 64E4            	   122:   STZ ST_POS
01:2370 64E5            	   123:   STZ ST_POS+1
                        	   124: .sg_b:
01:2372 A5E4            	   125:   LDA ST_POS
01:2374 85EA            	   126:   STA ST_P
01:2376 A5E5            	   127:   LDA ST_POS+1
01:2378 18              	   128:   CLC
01:2379 6908            	   129:   ADC #>ST_BUF
01:237B 85EB            	   130:   STA ST_P+1
01:237D E6E4            	   131:   INC ST_POS
01:237F D002            	   132:   BNE .sg_d
01:2381 E6E5            	   133:   INC ST_POS+1
                        	   134: .sg_d:
01:2383 A5E7            	   135:   LDA ST_LEFT
01:2385 D002            	   136:   BNE .sg_l
01:2387 C6E8            	   137:   DEC ST_LEFT+1
                        	   138: .sg_l:
01:2389 C6E7            	   139:   DEC ST_LEFT
01:238B B2EA            	   140:   LDA (ST_P)
01:238D 7A              	   141:   PLY
01:238E FA              	   142:   PLX
01:238F 18              	   143:   CLC
01:2390 60              	   144:   RTS
                        	   145: .sg_err:
01:2391 7A              	   146:   PLY
01:2392 FA              	   147:   PLX
01:2393 A901            	   148:   LDA #1
01:2395 85E9            	   149:   STA ST_ERR
01:2397 64E7            	   150:   STZ ST_LEFT
01:2399 64E8            	   151:   STZ ST_LEFT+1
                        	   152: .sg_end:
01:239B 38              	   153:   SEC
01:239C 60              	   154:   RTS
                        	   155: 

