                        	   104: ; CON_STR: the $00-terminated string A/X
                        	   105: CON_STR:
01:204A 85A2            	   106:   STA VT_P
01:204C 86A3            	   107:   STX VT_P+1
01:204E A000            	   108:   LDY #0
                        	   109: .ct_l:
01:2050 B1A2            	   110:   LDA (VT_P),Y
01:2052 F006            	   111:   BEQ .ct_x
01:2054 20D61F          	   112:   JSR CON_PUT
01:2057 C8              	   113:   INY
01:2058 D0F6            	   114:   BNE .ct_l
                        	   115: .ct_x:
01:205A 60              	   116:   RTS
                        	   117: 
                        	   118: CON_SP:
01:205B A920            	   119:   LDA #' '
01:205D 4CD61F          	   120:   JMP CON_PUT
                        	   121: 
                        	   122: CON_CR:
01:2060 A90D            	   123:   LDA #K_CR
01:2062 4CD61F          	   124:   JMP CON_PUT
                        	   125: 
                        	   126: ; CON_HEX: A as 2 hex digits. Keeps X, Y
                        	   127: CON_HEX:
01:2065 48              	   128:   PHA
01:2066 4A              	   129:   LSR
01:2067 4A              	   130:   LSR
01:2068 4A              	   131:   LSR
01:2069 4A              	   132:   LSR
01:206A 207620          	   133:   JSR .ch_d
01:206D 68              	   134:   PLA
01:206E 48              	   135:   PHA
01:206F 290F            	   136:   AND #$0F
01:2071 207620          	   137:   JSR .ch_d
01:2074 68              	   138:   PLA
01:2075 60              	   139:   RTS
                        	   140: .ch_d:
01:2076 C90A            	   141:   CMP #10
01:2078 9002            	   142:   BCC .ch_n
01:207A 6906            	   143:   ADC #'A'-10-1-'0'      ; (C=1)
                        	   144: .ch_n:
01:207C 6930            	   145:   ADC #'0'
01:207E 4CD61F          	   146:   JMP CON_PUT
                        	   147: 
                        	   148: ; CON_GETS: reads a line at the cursor into CON_LINE. CON_LINE may hold a start text of
                        	   149: ; CON_LEN characters (printed first). Letters become upper case. A = length (Enter)
                        	   150: CON_GETS:
01:2081 A200            	   151:   LDX #0
                        	   152: .cg_p:
01:2083 E4EE            	   153:   CPX CON_LEN
01:2085 F009            	   154:   BEQ .cg_c
01:2087 BD9005          	   155:   LDA CON_LINE,X
01:208A 20D61F          	   156:   JSR CON_PUT
01:208D E8              	   157:   INX
01:208E 80F3            	   158:   BRA .cg_p
                        	   159: .cg_c:
01:2090 A5EC            	   160:   LDA CON_ROW            ; cursor
01:2092 A6ED            	   161:   LDX CON_COL
01:2094 20291F          	   162:   JSR VT_AT
01:2097 A9A0            	   163:   LDA #' '+$80
01:2099 8D00B0          	   164:   STA VDP_DATA
01:209C 208F1E          	   165:   JSR WAITKEY
01:209F C90D            	   166:   CMP #K_CR
01:20A1 F03F            	   167:   BEQ .cg_ok
01:20A3 C908            	   168:   CMP #K_BS
01:20A5 F021            	   169:   BEQ .cg_bs
01:20A7 C920            	   170:   CMP #' '
01:20A9 90E5            	   171:   BCC .cg_c
01:20AB C97F            	   172:   CMP #$7F
01:20AD B0E1            	   173:   BCS .cg_c
01:20AF A6EE            	   174:   LDX CON_LEN
01:20B1 E4EF            	   175:   CPX CON_MAX
01:20B3 B0DB            	   176:   BCS .cg_c
01:20B5 202924          	   177:   JSR UI_UPC
01:20B8 9D9005          	   178:   STA CON_LINE,X
01:20BB E6EE            	   179:   INC CON_LEN
01:20BD A6ED            	   180:   LDX CON_COL            ; (the last column is kept for the cursor)
01:20BF E027            	   181:   CPX #39
01:20C1 B0CD            	   182:   BCS .cg_c
01:20C3 20D61F          	   183:   JSR CON_PUT
01:20C6 80C8            	   184:   BRA .cg_c
                        	   185: .cg_bs:
01:20C8 A5EE            	   186:   LDA CON_LEN
01:20CA F0C4            	   187:   BEQ .cg_c
01:20CC C6EE            	   188:   DEC CON_LEN
01:20CE A5ED            	   189:   LDA CON_COL
01:20D0 F0BE            	   190:   BEQ .cg_c
01:20D2 A5EC            	   191:   LDA CON_ROW
01:20D4 A6ED            	   192:   LDX CON_COL
01:20D6 20291F          	   193:   JSR VT_AT
01:20D9 A920            	   194:   LDA #' '
01:20DB 8D00B0          	   195:   STA VDP_DATA
01:20DE C6ED            	   196:   DEC CON_COL
01:20E0 80AE            	   197:   BRA .cg_c
                        	   198: .cg_ok:
01:20E2 A5EC            	   199:   LDA CON_ROW            ; no cursor left behind
01:20E4 A6ED            	   200:   LDX CON_COL
01:20E6 20291F          	   201:   JSR VT_AT
01:20E9 A920            	   202:   LDA #' '
01:20EB 8D00B0          	   203:   STA VDP_DATA
01:20EE A6EE            	   204:   LDX CON_LEN
01:20F0 9E9005          	   205:   STZ CON_LINE,X
