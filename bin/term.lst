Source: "apps\term.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   TERM  -  miniVIC TERM, serial terminal (VicTerm style)     ;
                        	     4: ;   65C02 assembly, W65C51 at $C000, TMS9918A text 40 x 24     ;
                        	     5: ;   Needs the BIOS 27.10.26 KEYB/SD                            ;
                        	     6: ;                                                              ;
                        	     7: ;   - rows 1-23 show what arrives on the serial line (CR, LF,  ;
                        	     8: ;     BS, TAB, FF, ANSI ESC[ ... J H K A B C D); row 0 status  ;
                        	     9: ;   - typed keys go out (arrows as ESC[A..D, Del as $7F);      ;
                        	    10: ;     F2 local echo, F3 Enter sends CR LF, F7 speed            ;
                        	    11: ;   - F4 capture on/off (up to 20 KB of text), F5 saves it as  ;
                        	    12: ;     a text document (WRITE opens it), F6 sends a document    ;
                        	    13: ;   - received bytes: ACIA receive interrupt into a 256-byte   ;
                        	    14: ;     ring (lib/keys with KB_SERBUF), polled too               ;
                        	    15: ;   - the only program that talks on the serial line: the      ;
                        	    16: ;     others send only the "[TYPE] Name" line (user's choice)  ;
                        	    17: ;                                                              ;
                        	    18: ;   MEMORY                                                     ;
                        	    19: ;   $0050-$006F  zero page (lib $A0-$F1)                       ;
                        	    20: ;   $3000-$30FF  receive ring                                  ;
                        	    21: ;   $3100-$7FFF  capture buffer (20224 bytes)                  ;
                        	    22: ;                                                              ;
                        	    23: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    24: 
                        	    25:  .include "lib/system.inc"

Source: "lib\system.inc"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   SYSTEM.INC  -  miniVIC / BO6502 addresses for the apps     ;
                        	     4: ;   BIOS 27.10.26 KEYB/SD jump table, VDP, key codes           ;
                        	     5: ;                                                              ;
                        	     6: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     7: 
                        	     8: ; ---------------- BIOS jump table ($FD00) ----------------
                        	     9: JT_CHROUT       = $FD00    ; A = char to screen AND serial (not used by the apps)
                        	    10: JT_CHRIN        = $FD03    ; C=1 and A = key, C=0 no key (serial first, then keyboard)
                        	    11: JT_INIT_CRT     = $FD09    ; text mode, VRAM and font of the BIOS
                        	    12: JT_SHOW_MENU    = $FD0F    ; back to the BIOS menu (never returns)
                        	    13: JT_SD_READ      = $FD18    ; sector SD_LBA -> buffer X/Y (lo/hi, 512 bytes), C=1 error
                        	    14: JT_SD_WRITE     = $FD1B    ; buffer X/Y -> sector SD_LBA, C=1 error
                        	    15: JT_SD_INIT      = $FD1E    ; C=0 and A = card type, C=1 no card
                        	    16: JT_KB_MODE      = $FD21    ; A<>0 extended keyboard, A=0 classic
                        	    17: SD_LBA          = $0316    ; 4 bytes, sector number, little endian
                        	    18: 
                        	    19: ; ---------------- RAM vectors (everything is polled) ----------------
                        	    20: IRQ_VEC         = $0FA0    ; JSR $0FA0 from the BIOS IRQ handler
                        	    21: NMI_VEC         = $0FD0    ; JSR $0FD0 from the BIOS NMI handler
                        	    22: 
                        	    23: ; ---------------- VDP TMS9918A ----------------
                        	    24: VDP_DATA        = $B000
                        	    25: VDP_REG         = $B001
                        	    26: VRAM_NAME       = $0800    ; name table of the BIOS text mode (40 x 24)
                        	    27: VRAM_FONT       = $0000    ; patterns 0-127 (BIOS font), 128-255 = inverse (made by VT_INIT)
                        	    28: 
                        	    29: ; ---------------- serial W65C51 ----------------
                        	    30: ACIA_DATA   = $C000
                        	    31: ACIA_STATUS = $C001    ; bit 3 = byte received
                        	    32: ACIA_CMD    = $C002    ; BIOS: $8B (no parity, receive IRQ off, DTR on)
                        	    33: ACIA_CTRL   = $C003    ; BIOS: $1F (19200, 8 bits, 1 stop)
                        	    34: 
                        	    35: ; ---------------- key codes (extended mode) ----------------
                        	    36: K_CR            = $0D
                        	    37: K_BS            = $08
                        	    38: K_TAB           = $09
                        	    39: K_ESC           = $1B
                        	    40: K_UP            = $80
                        	    41: K_DOWN          = $81
                        	    42: K_LEFT          = $82
                        	    43: K_RIGHT         = $83
                        	    44: K_HOME          = $84
                        	    45: K_END           = $85
                        	    46: K_PGUP          = $86
                        	    47: K_PGDN          = $87
                        	    48: K_INS           = $88
                        	    49: K_DEL           = $89
                        	    50: K_F1            = $90      ; F1-F12 = $90-$9B
                        	    51: 

Source: "apps\term.asm"
                        	    26: 
                        	    27: KB_SERBUF   = $3000    ; (before lib/keys: received bytes go here)
                        	    28: CAPBUF      = $3100
                        	    29: CAPEND      = $8000
                        	    30: NAMELEN     = 12
                        	    31: CR          = $0D
                        	    32: LF          = $0A
                        	    33: 
                        	    34: ; ---------------- zero page ----------------
                        	    35: TROW        = $50      ; cursor (0-22: screen rows 1-23)
                        	    36: TCOL        = $51
                        	    37: ECHO        = $52
                        	    38: CRLF        = $53
                        	    39: CAPT        = $54      ; 1 = capture on
                        	    40: CPTR        = $55      ; 2 bytes: end of the captured text
                        	    41: BAUDI       = $57      ; speed 0-5
                        	    42: ESCST       = $58      ; 0 text, 1 after ESC, 2 inside ESC[
                        	    43: PARAM       = $59      ; first number of ESC[
                        	    44: CURON       = $5A      ; 1 = the cursor is drawn
                        	    45: CURCH       = $5B      ; character under it
                        	    46: T0          = $5C
                        	    47: T1          = $5D
                        	    48: P0          = $5E      ; 2 bytes
                        	    49: TXN         = $60      ; delay units per byte sent
                        	    50: LASTC       = $61      ; last byte captured
                        	    51: 
                        	    52:  .org $0FD0
00:0FD0 60              	    53:   RTS                    ; NMI trampoline (the VDP interrupt is off)
                        	    54:  .org $1000
                        	    55: 
                        	    56: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; start and main loop
                        	    57: 
                        	    58: RESET:
01:1000 78              	    59:   SEI
01:1001 D8              	    60:   CLD
01:1002 A2FF            	    61:   LDX #$FF
01:1004 9A              	    62:   TXS
01:1005 A960            	    63:   LDA #$60
01:1007 8DA00F          	    64:   STA IRQ_VEC
01:100A 200417          	    65:   JSR VT_INIT
01:100D A901            	    66:   LDA #1                 ; type 1 = text (capture and send)
01:100F 85B8            	    67:   STA DOC_T
01:1011 6452            	    68:   STZ ECHO
01:1013 6453            	    69:   STZ CRLF
01:1015 6454            	    70:   STZ CAPT
01:1017 6458            	    71:   STZ ESCST
01:1019 645A            	    72:   STZ CURON
01:101B A900            	    73:   LDA #<CAPBUF
01:101D 8555            	    74:   STA CPTR
01:101F A931            	    75:   LDA #>CAPBUF
01:1021 8556            	    76:   STA CPTR+1
01:1023 A905            	    77:   LDA #5                 ; 19200, as the BIOS set it
01:1025 201311          	    78:   JSR SETBAUD
01:1028 A989            	    79:   LDA #$89               ; DTR on, receive interrupt on, no parity
01:102A 8D02C0          	    80:   STA ACIA_CMD
01:102D 203E16          	    81:   JSR KB_INIT            ; (CLI)
01:1030 20DA11          	    82:   JSR TCLS
01:1033 204C11          	    83:   JSR STATUS
                        	    84: MAIN:
01:1036 20C516          	    85:   JSR SERGET             ; what arrived first
01:1039 900F            	    86:   BCC IDLE
01:103B 48              	    87:   PHA
01:103C 206113          	    88:   JSR CUROFF
01:103F 68              	    89:   PLA
01:1040 48              	    90:   PHA
01:1041 20F011          	    91:   JSR TOUT
01:1044 68              	    92:   PLA
01:1045 207013          	    93:   JSR CAPTURE
01:1048 80EC            	    94:   BRA MAIN
                        	    95: IDLE:
01:104A 203A13          	    96:   JSR CURDRAW
01:104D 20D716          	    97:   JSR GETKEY
01:1050 90E4            	    98:   BCC MAIN
01:1052 48              	    99:   PHA
01:1053 206113          	   100:   JSR CUROFF
01:1056 68              	   101:   PLA
01:1057 205C10          	   102:   JSR DOKEY
01:105A 80DA            	   103:   BRA MAIN
                        	   104: 
                        	   105: ; DOKEY: local commands (F keys), else the key goes out
                        	   106: DOKEY:
01:105C C990            	   107:   CMP #K_F1
01:105E F056            	   108:   BEQ .dk_help
01:1060 C991            	   109:   CMP #K_F1+1
01:1062 F055            	   110:   BEQ .dk_echo
01:1064 C992            	   111:   CMP #K_F1+2
01:1066 F05A            	   112:   BEQ .dk_lf
01:1068 C993            	   113:   CMP #K_F1+3
01:106A F05F            	   114:   BEQ .dk_cap
01:106C C994            	   115:   CMP #K_F1+4
01:106E D003            	   116:   BNE .dk_6
01:1070 4CAF13          	   117:   JMP CAPSAVE
                        	   118: .dk_6:
01:1073 C995            	   119:   CMP #K_F1+5
01:1075 D003            	   120:   BNE .dk_7
01:1077 4C3714          	   121:   JMP SENDDOC
                        	   122: .dk_7:
01:107A C996            	   123:   CMP #K_F1+6
01:107C F056            	   124:   BEQ .dk_baud
01:107E C999            	   125:   CMP #K_F1+9
01:1080 F061            	   126:   BEQ .dk_exit
01:1082 C980            	   127:   CMP #K_UP              ; arrows: ESC [ A B C D
01:1084 901F            	   128:   BCC .dk_send
01:1086 C984            	   129:   CMP #K_RIGHT+1
01:1088 B015            	   130:   BCS .dk_del
01:108A 38              	   131:   SEC
01:108B E980            	   132:   SBC #K_UP
01:108D AA              	   133:   TAX
01:108E BDF410          	   134:   LDA ARROWS,X           ; (SEND uses X)
01:1091 48              	   135:   PHA
01:1092 A91B            	   136:   LDA #K_ESC
01:1094 200311          	   137:   JSR SEND
01:1097 A95B            	   138:   LDA #'['
01:1099 200311          	   139:   JSR SEND
01:109C 68              	   140:   PLA
01:109D 8006            	   141:   BRA .dk_send
                        	   142: .dk_del:
01:109F C989            	   143:   CMP #K_DEL
01:10A1 D012            	   144:   BNE .dk_x
01:10A3 A97F            	   145:   LDA #$7F
                        	   146: .dk_send:
01:10A5 C90D            	   147:   CMP #K_CR
01:10A7 D009            	   148:   BNE .dk_s1
01:10A9 20F810          	   149:   JSR SENDE
01:10AC A553            	   150:   LDA CRLF
01:10AE F005            	   151:   BEQ .dk_x
01:10B0 A90A            	   152:   LDA #LF
                        	   153: .dk_s1:
01:10B2 4CF810          	   154:   JMP SENDE
                        	   155: .dk_x:
01:10B5 60              	   156:   RTS
                        	   157: .dk_help:
01:10B6 4CB614          	   158:   JMP HELP
                        	   159: .dk_echo:
01:10B9 A552            	   160:   LDA ECHO
01:10BB 4901            	   161:   EOR #1
01:10BD 8552            	   162:   STA ECHO
01:10BF 4C4C11          	   163:   JMP STATUS
                        	   164: .dk_lf:
01:10C2 A553            	   165:   LDA CRLF
01:10C4 4901            	   166:   EOR #1
01:10C6 8553            	   167:   STA CRLF
01:10C8 4C4C11          	   168:   JMP STATUS
                        	   169: .dk_cap:
01:10CB A554            	   170:   LDA CAPT
01:10CD 4901            	   171:   EOR #1
01:10CF 8554            	   172:   STA CAPT
01:10D1 4C4C11          	   173:   JMP STATUS
                        	   174: .dk_baud:
01:10D4 A557            	   175:   LDA BAUDI
01:10D6 1A              	   176:   INC A
01:10D7 C906            	   177:   CMP #6
01:10D9 9002            	   178:   BCC .dk_b
01:10DB A900            	   179:   LDA #0
                        	   180: .dk_b:
01:10DD 201311          	   181:   JSR SETBAUD
01:10E0 4C4C11          	   182:   JMP STATUS
                        	   183: .dk_exit:
01:10E3 78              	   184:   SEI
01:10E4 A98B            	   185:   LDA #$8B               ; the serial line as the BIOS wants it
01:10E6 8D02C0          	   186:   STA ACIA_CMD
01:10E9 A91F            	   187:   LDA #$1F
01:10EB 8D03C0          	   188:   STA ACIA_CTRL
01:10EE 206216          	   189:   JSR KB_EXIT
01:10F1 4C0FFD          	   190:   JMP JT_SHOW_MENU
                        	   191: 
01:10F4 41424443        	   192: ARROWS:     .byte "ABDC"   ; K_UP K_DOWN K_LEFT K_RIGHT
                        	   193: 
                        	   194: ; SENDE: A out, and on the screen too with the local echo
                        	   195: SENDE:
01:10F8 200311          	   196:   JSR SEND
01:10FB A652            	   197:   LDX ECHO
01:10FD F003            	   198:   BEQ .se_x
01:10FF 4CF011          	   199:   JMP TOUT
                        	   200: .se_x:
01:1102 60              	   201:   RTS
                        	   202: 
                        	   203: ; SEND: A to the serial line. The W65C51 does not say when a byte is gone: a fixed
                        	   204: ; wait of TXN x ~1.3 ms, as long as a byte at the speed chosen. Keeps A
                        	   205: SEND:
01:1103 8D00C0          	   206:   STA ACIA_DATA
01:1106 48              	   207:   PHA
01:1107 A660            	   208:   LDX TXN
                        	   209: .sd_o:
01:1109 A9FF            	   210:   LDA #$FF
                        	   211: .sd_l:
01:110B 3A              	   212:   DEC
01:110C D0FD            	   213:   BNE .sd_l
01:110E CA              	   214:   DEX
01:110F D0F8            	   215:   BNE .sd_o
01:1111 68              	   216:   PLA
01:1112 60              	   217:   RTS
                        	   218: 
                        	   219: ; SETBAUD: speed A (0-5): 300 1200 2400 4800 9600 19200
                        	   220: SETBAUD:
01:1113 8557            	   221:   STA BAUDI
01:1115 AA              	   222:   TAX
01:1116 BD2211          	   223:   LDA BAUDCTL,X
01:1119 8D03C0          	   224:   STA ACIA_CTRL
01:111C BD2811          	   225:   LDA BAUDTX,X
01:111F 8560            	   226:   STA TXN
01:1121 60              	   227:   RTS
