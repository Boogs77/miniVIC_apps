01:1123 18
01:1124 1A
01:1125 1C
01:1126 1E
01:1127 1F
01:1128 1C              	   230: BAUDTX:     .byte 28, 8, 4, 2, 1, 1
01:1129 08
01:112A 04
01:112B 02
01:112C 01
01:112D 01
01:112E 2020333030203132	   231: BAUDTXT:    .byte "  300 1200 2400 4800 960019200"
01:1136 3030203234303020
01:113E 3438303020393630
01:1146 303139323030
                        	   232: 
