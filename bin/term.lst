                        	   819:  .include "lib/ui.asm"

Source: "lib\ui.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   UI.ASM  -  the parts every application shows the same way  ;
                        	     4: ;                                                              ;
                        	     5: ;   - PROMPT: a question on row 23, the answer typed after it  ;
                        	     6: ;   - YESNO:  a Y/N question on row 23                         ;
                        	     7: ;   - DOC_PICK: the list of the SD documents (open / delete)   ;
                        	     8: ;   Needs lib/keys, lib/vtext, lib/num, lib/docs.              ;
                        	     9: ;   Uses: zp $B0-$B7, RAM $02A0-$02C7 (UI_LINE),               ;
                        	    10: ;         $02D8-$02F7 (UI_BUF)                                 ;
                        	    11: ;                                                              ;
                        	    12: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    13: 
                        	    14: UI_LINE     = $02A0    ; 40 characters: a row being built (the apps may use it too)
                        	    15: UI_BUF      = $02D8    ; PROMPT answer (31 + $00)
                        	    16: UI_PTXT     = $B0      ; 2 bytes: question
                        	    17: UI_PMAX     = $B2      ; longest answer
                        	    18: UI_PUPC     = $B3      ; 1 = letters in upper case
                        	    19: UI_PLEN     = $B4      ; answer length
                        	    20: UI_SEL      = $B5      ; DOC_PICK: slot under the bar
                        	    21: UI_ROW      = $B6
                        	    22: UI_ANY      = $B7      ; DOC_PICK: 1 = every type can be opened, 0 = only DOC_T
                        	    23: 
                        	    24: ; PROMPT: question A/X on row 23, the answer in UI_BUF (it starts with what is already
                        	    25: ; there), UI_PMAX characters at most. C=0 and A = length (Enter), C=1 Esc
                        	    26: PROMPT:
01:1AD6 85B0            	    27:   STA UI_PTXT
01:1AD8 86B1            	    28:   STX UI_PTXT+1
01:1ADA A200            	    29:   LDX #0
                        	    30: .pr_len:
01:1ADC BDD802          	    31:   LDA UI_BUF,X
01:1ADF F003            	    32:   BEQ .pr_d
01:1AE1 E8              	    33:   INX
01:1AE2 80F8            	    34:   BRA .pr_len
                        	    35: .pr_d:
01:1AE4 86B4            	    36:   STX UI_PLEN
                        	    37: .pr_draw:
01:1AE6 A917            	    38:   LDA #23
01:1AE8 207F17          	    39:   JSR VT_ROW
01:1AEB 64A4            	    40:   STZ VT_INV
01:1AED A5B0            	    41:   LDA UI_PTXT
01:1AEF 85A2            	    42:   STA VT_P
01:1AF1 A5B1            	    43:   LDA UI_PTXT+1
01:1AF3 85A3            	    44:   STA VT_P+1
01:1AF5 20B317          	    45:   JSR VT_STR
01:1AF8 84B6            	    46:   STY UI_ROW             ; (column)
01:1AFA A200            	    47:   LDX #0
                        	    48: .pr_c:
01:1AFC E4B4            	    49:   CPX UI_PLEN
01:1AFE F00B            	    50:   BEQ .pr_cur
01:1B00 BDD802          	    51:   LDA UI_BUF,X
01:1B03 8D00B0          	    52:   STA VDP_DATA
01:1B06 E8              	    53:   INX
01:1B07 E6B6            	    54:   INC UI_ROW
01:1B09 80F1            	    55:   BRA .pr_c
                        	    56: .pr_cur:
01:1B0B A9A0            	    57:   LDA #' '+$80           ; cursor
01:1B0D 8D00B0          	    58:   STA VDP_DATA
01:1B10 E6B6            	    59:   INC UI_ROW
01:1B12 A928            	    60:   LDA #40
01:1B14 38              	    61:   SEC
01:1B15 E5B6            	    62:   SBC UI_ROW
01:1B17 9008            	    63:   BCC .pr_k
01:1B19 F006            	    64:   BEQ .pr_k
01:1B1B AA              	    65:   TAX
01:1B1C A920            	    66:   LDA #' '
01:1B1E 209E17          	    67:   JSR VT_REP
                        	    68: .pr_k:
01:1B21 20F216          	    69:   JSR WAITKEY
01:1B24 C90D            	    70:   CMP #K_CR
01:1B26 F034            	    71:   BEQ .pr_ok
01:1B28 C91B            	    72:   CMP #K_ESC
01:1B2A F034            	    73:   BEQ .pr_esc
01:1B2C C908            	    74:   CMP #K_BS
01:1B2E F020            	    75:   BEQ .pr_bs
01:1B30 C920            	    76:   CMP #' '
01:1B32 90ED            	    77:   BCC .pr_k
01:1B34 C97F            	    78:   CMP #$7F
01:1B36 B0E9            	    79:   BCS .pr_k
01:1B38 A6B4            	    80:   LDX UI_PLEN
01:1B3A E4B2            	    81:   CPX UI_PMAX
01:1B3C B0E3            	    82:   BCS .pr_k
01:1B3E A4B3            	    83:   LDY UI_PUPC
01:1B40 F003            	    84:   BEQ .pr_s
01:1B42 20621B          	    85:   JSR UI_UPC
                        	    86: .pr_s:
01:1B45 9DD802          	    87:   STA UI_BUF,X
01:1B48 E8              	    88:   INX
01:1B49 9ED802          	    89:   STZ UI_BUF,X
01:1B4C 86B4            	    90:   STX UI_PLEN
01:1B4E 8096            	    91:   BRA .pr_draw
                        	    92: .pr_bs:
01:1B50 A6B4            	    93:   LDX UI_PLEN
01:1B52 F0CD            	    94:   BEQ .pr_k
01:1B54 CA              	    95:   DEX
01:1B55 9ED802          	    96:   STZ UI_BUF,X
01:1B58 86B4            	    97:   STX UI_PLEN
01:1B5A 808A            	    98:   BRA .pr_draw
                        	    99: .pr_ok:
01:1B5C A5B4            	   100:   LDA UI_PLEN
01:1B5E 18              	   101:   CLC
01:1B5F 60              	   102:   RTS
                        	   103: .pr_esc:
01:1B60 38              	   104:   SEC
01:1B61 60              	   105:   RTS
                        	   106: 
                        	   107: ; UI_UPC: lower case letter -> upper case. Keeps X, Y
                        	   108: UI_UPC:
01:1B62 C961            	   109:   CMP #'a'
01:1B64 9006            	   110:   BCC .uu_x
01:1B66 C97B            	   111:   CMP #'z'+1
01:1B68 B002            	   112:   BCS .uu_x
01:1B6A 29DF            	   113:   AND #$DF
                        	   114: .uu_x:
01:1B6C 60              	   115:   RTS
                        	   116: 
                        	   117: ; YESNO: question A/X on row 23; C=0 if the answer is Y
                        	   118: YESNO:
01:1B6D DA              	   119:   PHX
01:1B6E 48              	   120:   PHA
01:1B6F A917            	   121:   LDA #23
01:1B71 207F17          	   122:   JSR VT_ROW
01:1B74 64A4            	   123:   STZ VT_INV
01:1B76 68              	   124:   PLA
01:1B77 FA              	   125:   PLX
01:1B78 A000            	   126:   LDY #0
01:1B7A 20CA17          	   127:   JSR VT_LINE
01:1B7D 20F216          	   128:   JSR WAITKEY
01:1B80 29DF            	   129:   AND #$DF
01:1B82 C959            	   130:   CMP #'Y'
01:1B84 F002            	   131:   BEQ .yn_y
01:1B86 38              	   132:   SEC
01:1B87 60              	   133:   RTS
                        	   134: .yn_y:
01:1B88 18              	   135:   CLC
01:1B89 60              	   136:   RTS
                        	   137: 
                        	   138: ; DOC_PICK: whole-screen list of the documents; arrows (^E ^X) choose, Enter opens,
                        	   139: ; Del (^G) deletes after a question, Esc goes back. A/X = title.
                        	   140: ; Enter on a free slot, or (UI_ANY = 0) on a document of another type, does nothing.
                        	   141: ; C=0 and A = slot to open (index in DOC_IDX), C=1 and A=0 back, C=1 and A=$FF SD error.
                        	   142: ; The caller redraws its screen afterwards.
                        	   143: DOC_PICK:
01:1B8A 85B0            	   144:   STA UI_PTXT
01:1B8C 86B1            	   145:   STX UI_PTXT+1
01:1B8E 209518          	   146:   JSR DOC_RDIDX
01:1B91 9003            	   147:   BCC .dp_ok
01:1B93 A9FF            	   148:   LDA #$FF
01:1B95 60              	   149:   RTS
                        	   150: .dp_ok:
01:1B96 A901            	   151:   LDA #1
01:1B98 85B5            	   152:   STA UI_SEL
01:1B9A 20EE17          	   153:   JSR VT_CLS
