01:11F8 C930            	   342:   CMP #'0'               ; inside ESC[: digits make the first number
01:11FA 902C            	   343:   BCC .to_fin
01:11FC C93A            	   344:   CMP #'9'+1
01:11FE B012            	   345:   BCS .to_semi
01:1200 290F            	   346:   AND #$0F
01:1202 48              	   347:   PHA
