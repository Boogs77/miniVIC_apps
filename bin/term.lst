Source: "lib\keys.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   KEYS.ASM  -  key queue on top of the BIOS                  ;
                        	     4: ;                                                              ;
                        	     5: ;   The PS/2 board keeps one byte: a byte not read within      ;
                        	     6: ;   ~1 ms is lost (a lost $F0 turns a release into a second    ;
                        	     7: ;   press). Two ways in, both on: the CA1 interrupt of the     ;
                        	     8: ;   keyboard VIA (IRQ -> BIOS -> JMP KB_IRQ at $0FA0) reads    ;
                        	     9: ;   every byte at once; KB_POLL, called by the long loops,     ;
                        	    10: ;   does the same if the IRQ line is not there. Assembled      ;
                        	    11: ;   with -DKB_NOIRQ=1 only the polling is left.                ;
                        	    12: ;   The keys decoded by the BIOS go into a 32-key queue,       ;
                        	    13: ;   GETKEY takes them out. KB_EXIT before leaving the app.     ;
                        	    14: ;   An app that uses the serial line itself defines KB_SERBUF  ;
                        	    15: ;   (256-byte ring): the received bytes go there, not among    ;
                        	    16: ;   the keys (JT_CHRIN reads the serial line first: a byte it  ;
                        	    17: ;   returns while CA1 is still set came from the serial line). ;
                        	    18: ;   Uses: zp $A0-$A1 ($F0-$F1 with KB_SERBUF), RAM $05C0-$05DF ;
                        	    19: ;                                                              ;
                        	    20: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    21: 
                        	    22: KQ          = $05C0    ; 32-key ring
                        	    23: KQ_MASK     = $1F
                        	    24: KQR         = $A0      ; read index
                        	    25: KQW         = $A1      ; write index
                        	    26: KB_IFR      = $D18D    ; keyboard VIA: interrupt flags (bit 1 = CA1)
                        	    27: KB_IER      = $D18E    ;               interrupt enable
                        	    28: KB_SRR      = $F0      ; serial ring (KB_SERBUF): read index
                        	    29: KB_SRW      = $F1      ;                          write index
                        	    30: 
                        	    31: ; KB_INIT: extended keyboard, empty queue, CA1 interrupt on
                        	    32: KB_INIT:
01:163E 78              	    33:   SEI
01:163F A901            	    34:   LDA #1
01:1641 2021FD          	    35:   JSR JT_KB_MODE
01:1644 64A0            	    36:   STZ KQR
01:1646 64A1            	    37:   STZ KQW
01:1648 64F0            	    38:   STZ KB_SRR
01:164A 64F1            	    39:   STZ KB_SRW
                        	    40:  .ifndef KB_NOIRQ
01:164C A94C            	    41:   LDA #$4C               ; JMP KB_IRQ in the RAM vector of the BIOS
01:164E 8DA00F          	    42:   STA IRQ_VEC
01:1651 A96E            	    43:   LDA #<KB_IRQ
01:1653 8DA10F          	    44:   STA IRQ_VEC+1
01:1656 A916            	    45:   LDA #>KB_IRQ
01:1658 8DA20F          	    46:   STA IRQ_VEC+2
01:165B A982            	    47:   LDA #$82               ; CA1 interrupt enabled
01:165D 8D8ED1          	    48:   STA KB_IER
01:1660 58              	    49:   CLI
                        	    50:  .endif
01:1661 60              	    51:   RTS
                        	    52: 
                        	    53: ; KB_EXIT: interrupt off again (the BIOS menu works by polling)
                        	    54: KB_EXIT:
01:1662 78              	    55:   SEI
01:1663 A902            	    56:   LDA #$02
01:1665 8D8ED1          	    57:   STA KB_IER
01:1668 A960            	    58:   LDA #$60               ; RTS
01:166A 8DA00F          	    59:   STA IRQ_VEC
01:166D 60              	    60:   RTS
                        	    61: 
                        	    62: ; KB_IRQ: called by the BIOS IRQ handler (A, X, Y already saved)
                        	    63: KB_IRQ:
                        	    64:  .ifdef KB_SERBUF
01:166E 4C7E16          	    65:   JMP KB_TAKE            ; the keyboard or the serial line
                        	    66:  .else
                        	    67:   LDA KB_IFR
                        	    68:   AND #$02
                        	    69:   BEQ .ki_x
                        	    70:   JSR KB_TAKE
                        	    71: .ki_x:
                        	    72:   RTS
                        	    73:  .endif
                        	    74: 
                        	    75: ; KB_POLL: one BIOS poll with the interrupt held off. Keeps A, X, Y and the I flag
                        	    76: KB_POLL:
01:1671 08              	    77:   PHP
01:1672 78              	    78:   SEI
01:1673 48              	    79:   PHA
01:1674 DA              	    80:   PHX
01:1675 5A              	    81:   PHY
01:1676 207E16          	    82:   JSR KB_TAKE
01:1679 7A              	    83:   PLY
01:167A FA              	    84:   PLX
01:167B 68              	    85:   PLA
01:167C 28              	    86:   PLP
01:167D 60              	    87:   RTS
                        	    88: 
                        	    89: ; KB_TAKE: a key from the BIOS goes into the queue (full queue: dropped)
                        	    90: KB_TAKE:
                        	    91:  .ifdef KB_SERBUF
                        	    92: .kt_rx:
01:167E AD01C0          	    93:   LDA ACIA_STATUS        ; received bytes first, into their ring
01:1681 2908            	    94:   AND #$08
01:1683 F008            	    95:   BEQ .kt_kb
01:1685 AD00C0          	    96:   LDA ACIA_DATA
01:1688 20B816          	    97:   JSR KB_SERPUT
01:168B 80F1            	    98:   BRA .kt_rx
                        	    99: .kt_kb:
01:168D AD8DD1          	   100:   LDA KB_IFR
01:1690 2902            	   101:   AND #$02
01:1692 F023            	   102:   BEQ .kt_x
01:1694 2003FD          	   103:   JSR JT_CHRIN
01:1697 901E            	   104:   BCC .kt_x
01:1699 48              	   105:   PHA
01:169A AD8DD1          	   106:   LDA KB_IFR             ; CA1 still set: the BIOS took a serial byte, not the key
01:169D 2902            	   107:   AND #$02
01:169F F006            	   108:   BEQ .kt_key
01:16A1 68              	   109:   PLA
01:16A2 20B816          	   110:   JSR KB_SERPUT
01:16A5 80D7            	   111:   BRA .kt_rx
                        	   112: .kt_key:
01:16A7 68              	   113:   PLA
                        	   114:  .else
                        	   115:   JSR JT_CHRIN
                        	   116:   BCC .kt_x
                        	   117:  .endif
01:16A8 A6A1            	   118:   LDX KQW
01:16AA 9DC005          	   119:   STA KQ,X
01:16AD 8A              	   120:   TXA
01:16AE 1A              	   121:   INC A
01:16AF 291F            	   122:   AND #KQ_MASK
01:16B1 C5A0            	   123:   CMP KQR
01:16B3 F002            	   124:   BEQ .kt_x              ; full
01:16B5 85A1            	   125:   STA KQW
                        	   126: .kt_x:
01:16B7 60              	   127:   RTS
                        	   128: 
                        	   129:  .ifdef KB_SERBUF
                        	   130: ; KB_SERPUT: A into the serial ring (full: dropped)
                        	   131: KB_SERPUT:
01:16B8 A6F1            	   132:   LDX KB_SRW
01:16BA 9D0030          	   133:   STA KB_SERBUF,X
01:16BD E8              	   134:   INX
01:16BE E4F0            	   135:   CPX KB_SRR
01:16C0 F002            	   136:   BEQ .ks_x
01:16C2 86F1            	   137:   STX KB_SRW
                        	   138: .ks_x:
01:16C4 60              	   139:   RTS
                        	   140: 
                        	   141: ; SERGET: C=1 and A = next received byte, C=0 none
                        	   142: SERGET:
01:16C5 207116          	   143:   JSR KB_POLL
01:16C8 A6F0            	   144:   LDX KB_SRR
01:16CA E4F1            	   145:   CPX KB_SRW
01:16CC F007            	   146:   BEQ .sg_n
01:16CE BD0030          	   147:   LDA KB_SERBUF,X
01:16D1 E6F0            	   148:   INC KB_SRR
01:16D3 38              	   149:   SEC
01:16D4 60              	   150:   RTS
                        	   151: .sg_n:
01:16D5 18              	   152:   CLC
01:16D6 60              	   153:   RTS
                        	   154:  .endif
                        	   155: 
                        	   156: ; GETKEY: C=1 and A = key, C=0 queue empty (after one poll). Keeps X, Y
                        	   157: GETKEY:
01:16D7 207116          	   158:   JSR KB_POLL
01:16DA A5A0            	   159:   LDA KQR
01:16DC C5A1            	   160:   CMP KQW
01:16DE F010            	   161:   BEQ .gk_n
01:16E0 DA              	   162:   PHX
01:16E1 AA              	   163:   TAX
01:16E2 BDC005          	   164:   LDA KQ,X
01:16E5 48              	   165:   PHA
01:16E6 8A              	   166:   TXA
01:16E7 1A              	   167:   INC A
01:16E8 291F            	   168:   AND #KQ_MASK
01:16EA 85A0            	   169:   STA KQR
01:16EC 68              	   170:   PLA
01:16ED FA              	   171:   PLX
01:16EE 38              	   172:   SEC
01:16EF 60              	   173:   RTS
                        	   174: .gk_n:
01:16F0 18              	   175:   CLC
01:16F1 60              	   176:   RTS
                        	   177: 
                        	   178: ; WAITKEY: A = next key
                        	   179: WAITKEY:
01:16F2 20D716          	   180:   JSR GETKEY
01:16F5 90FB            	   181:   BCC WAITKEY
01:16F7 60              	   182:   RTS
                        	   183: 
                        	   184: ; KEYREADY: C=1 if a key is waiting in the queue
                        	   185: KEYREADY:
01:16F8 207116          	   186:   JSR KB_POLL
01:16FB A5A0            	   187:   LDA KQR
01:16FD C5A1            	   188:   CMP KQW
01:16FF 18              	   189:   CLC
01:1700 F001            	   190:   BEQ .kr_x
01:1702 38              	   191:   SEC
                        	   192: .kr_x:
01:1703 60              	   193:   RTS
                        	   194: 

