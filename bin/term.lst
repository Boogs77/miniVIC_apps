                        	   816:  .include "lib/num.asm"

Source: "lib\num.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   NUM.ASM  -  16-bit numbers to decimal text                 ;
                        	     4: ;   Uses: zp $A5-$A9                                           ;
                        	     5: ;                                                              ;
                        	     6: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     7: 
                        	     8: NUM         = $A5      ; 2 bytes: number to convert (destroyed)
                        	     9: BCD         = $A7      ; 3 bytes: BCD result, $A7 = lowest 2 digits
                        	    10: 
                        	    11: ; BIN2BCD: NUM -> BCD (double dabble with decimal mode)
                        	    12: BIN2BCD:
01:1832 207116          	    13:   JSR KB_POLL
01:1835 64A7            	    14:   STZ BCD
01:1837 64A8            	    15:   STZ BCD+1
01:1839 64A9            	    16:   STZ BCD+2
01:183B A210            	    17:   LDX #16
01:183D F8              	    18:   SED
                        	    19: .bb_l:
01:183E 06A5            	    20:   ASL NUM
01:1840 26A6            	    21:   ROL NUM+1
01:1842 A5A7            	    22:   LDA BCD
01:1844 65A7            	    23:   ADC BCD
01:1846 85A7            	    24:   STA BCD
01:1848 A5A8            	    25:   LDA BCD+1
01:184A 65A8            	    26:   ADC BCD+1
01:184C 85A8            	    27:   STA BCD+1
01:184E A5A9            	    28:   LDA BCD+2
01:1850 65A9            	    29:   ADC BCD+2
01:1852 85A9            	    30:   STA BCD+2
01:1854 CA              	    31:   DEX
01:1855 D0E7            	    32:   BNE .bb_l
01:1857 D8              	    33:   CLD
01:1858 60              	    34:   RTS
                        	    35: 
                        	    36: ; NUMSTR: NUM -> 5 characters at (VT_P),Y.. with leading spaces (last digit always shown)
                        	    37: ; Y = first position; on exit Y = position after the number
                        	    38: NUMSTR:
01:1859 203218          	    39:   JSR BIN2BCD
01:185C 207116          	    40:   JSR KB_POLL            ; (BIN2BCD takes ~600 cycles)
01:185F A200            	    41:   LDX #0                 ; X = 1 once a digit is not zero
01:1861 A5A9            	    42:   LDA BCD+2
01:1863 208118          	    43:   JSR .ns_dig            ; ten thousands
01:1866 A5A8            	    44:   LDA BCD+1
01:1868 4A              	    45:   LSR
01:1869 4A              	    46:   LSR
01:186A 4A              	    47:   LSR
01:186B 4A              	    48:   LSR
01:186C 208118          	    49:   JSR .ns_dig
01:186F A5A8            	    50:   LDA BCD+1
01:1871 208118          	    51:   JSR .ns_dig
01:1874 A5A7            	    52:   LDA BCD
01:1876 4A              	    53:   LSR
01:1877 4A              	    54:   LSR
01:1878 4A              	    55:   LSR
01:1879 4A              	    56:   LSR
01:187A 208118          	    57:   JSR .ns_dig
01:187D A5A7            	    58:   LDA BCD
01:187F A201            	    59:   LDX #1                 ; the last digit is always written
                        	    60: .ns_dig:
01:1881 290F            	    61:   AND #$0F
01:1883 D008            	    62:   BNE .ns_nz
01:1885 E000            	    63:   CPX #0
01:1887 D004            	    64:   BNE .ns_nz
01:1889 A920            	    65:   LDA #' '
01:188B 8004            	    66:   BRA .ns_put
                        	    67: .ns_nz:
01:188D A201            	    68:   LDX #1
01:188F 0930            	    69:   ORA #'0'
                        	    70: .ns_put:
01:1891 91A2            	    71:   STA (VT_P),Y
01:1893 C8              	    72:   INY
01:1894 60              	    73:   RTS
                        	    74: 

Source: "apps\term.asm"
                        	   817:  .include "lib/docs.asm"

Source: "lib\docs.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   DOCS.ASM  -  documents in the SD document area             ;
                        	     4: ;                                                              ;
                        	     5: ;   Sector 16384 ($00800000, after the 255 program blocks)     ;
                        	     6: ;   is the index: +0 "DOCS", +4 version 1, +5 slots (15);      ;
                        	     7: ;   entry k (1-15) at k*32: +0 type (0 free, 1 text,           ;
                        	     8: ;   2 sheet, 3 card file),                                     ;
                        	     9: ;   +1/+2 length, +4..+15 name (12 chars, $00 padded).         ;
                        	    10: ;   Document k = 40 sectors (20 KB) from sector 16384 + k*40.  ;
                        	    11: ;   Sectors go through the BIOS (JT_SD_READ / JT_SD_WRITE).    ;
                        	    12: ;   Uses: zp $AA-$AF, $B8-$BA, RAM $0600-$07FF (index sector)  ;
                        	    13: ;                                                              ;
                        	    14: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    15: 
                        	    16: DOC_IDX     = $0600    ; index sector (512 bytes)
                        	    17: DOC_BASE    = $4000    ; sector 16384
                        	    18: DOC_SLOTS   = 15
                        	    19: DOC_SECTS   = 40       ; sectors per document
                        	    20: DOC_NAMELEN = 12
                        	    21: DOC_E       = $AA      ; 2 bytes: pointer to the index entry
                        	    22: DOC_K       = $AC      ; slot
                        	    23: DOC_I       = $AD      ; sector inside the document
                        	    24: DOC_N       = $AE      ; sectors to transfer
                        	    25: DOC_PG      = $AF      ; RAM page of the transfer
                        	    26: DOC_T       = $B8      ; document type of the application (1 text, 2 sheet, 3 card file)
                        	    27: DOC_LEN     = $B9      ; 2 bytes: length for DOC_SETENT
                        	    28: 
                        	    29: ; DOC_RDIDX: reads the index; a sector without "DOCS" becomes an empty index. C=1 SD error
                        	    30: DOC_RDIDX:
01:1895 20AD19          	    31:   JSR DOC_LBA0
01:1898 A200            	    32:   LDX #<DOC_IDX
01:189A A006            	    33:   LDY #>DOC_IDX
01:189C 2018FD          	    34:   JSR JT_SD_READ
01:189F B00E            	    35:   BCS .dr_x
01:18A1 A203            	    36:   LDX #3
                        	    37: .dr_m:
01:18A3 BD0006          	    38:   LDA DOC_IDX,X
01:18A6 DD071A          	    39:   CMP DOC_MAGIC,X
01:18A9 D005            	    40:   BNE .dr_new
01:18AB CA              	    41:   DEX
01:18AC 10F5            	    42:   BPL .dr_m
01:18AE 18              	    43:   CLC
                        	    44: .dr_x:
01:18AF 60              	    45:   RTS
                        	    46: .dr_new:
01:18B0 A200            	    47:   LDX #0
                        	    48: .dr_z:
01:18B2 9E0006          	    49:   STZ DOC_IDX,X
01:18B5 9E0007          	    50:   STZ DOC_IDX+$100,X
01:18B8 E8              	    51:   INX
01:18B9 D0F7            	    52:   BNE .dr_z
01:18BB A205            	    53:   LDX #5
                        	    54: .dr_h:
01:18BD BD071A          	    55:   LDA DOC_MAGIC,X
01:18C0 9D0006          	    56:   STA DOC_IDX,X
01:18C3 CA              	    57:   DEX
01:18C4 10F7            	    58:   BPL .dr_h
01:18C6 18              	    59:   CLC
01:18C7 60              	    60:   RTS
                        	    61: 
                        	    62: ; DOC_WRIDX: writes the index. C=1 SD error
                        	    63: DOC_WRIDX:
01:18C8 20AD19          	    64:   JSR DOC_LBA0
01:18CB A200            	    65:   LDX #<DOC_IDX
01:18CD A006            	    66:   LDY #>DOC_IDX
01:18CF 4C1BFD          	    67:   JMP JT_SD_WRITE
                        	    68: 
                        	    69: ; DOC_ENTRY: A = slot (1-15) -> DOC_E = its index entry. Keeps X, Y
                        	    70: DOC_ENTRY:
01:18D2 85AC            	    71:   STA DOC_K
01:18D4 4A              	    72:   LSR
01:18D5 4A              	    73:   LSR
01:18D6 4A              	    74:   LSR
01:18D7 18              	    75:   CLC
01:18D8 6906            	    76:   ADC #>DOC_IDX
01:18DA 85AB            	    77:   STA DOC_E+1
01:18DC A5AC            	    78:   LDA DOC_K
01:18DE 0A              	    79:   ASL
01:18DF 0A              	    80:   ASL
01:18E0 0A              	    81:   ASL
01:18E1 0A              	    82:   ASL
01:18E2 0A              	    83:   ASL
01:18E3 85AA            	    84:   STA DOC_E              ; (DOC_IDX is page aligned)
01:18E5 60              	    85:   RTS
                        	    86: 
                        	    87: ; DOC_FIND: name of 12 bytes at (DOC_P) and type DOC_T -> C=0 and A = slot, C=1 not found
                        	    88: DOC_P       = VT_P     ; (shares the string pointer)
                        	    89: DOC_FIND:
01:18E6 A901            	    90:   LDA #1
                        	    91: .df_k:
01:18E8 48              	    92:   PHA
01:18E9 20D218          	    93:   JSR DOC_ENTRY
01:18EC A000            	    94:   LDY #0
01:18EE B1AA            	    95:   LDA (DOC_E),Y
01:18F0 C5B8            	    96:   CMP DOC_T
01:18F2 D01A            	    97:   BNE .df_n              ; free or another type
01:18F4 A00B            	    98:   LDY #DOC_NAMELEN-1
                        	    99: .df_c:
01:18F6 B1A2            	   100:   LDA (DOC_P),Y
01:18F8 85AD            	   101:   STA DOC_I              ; (temporary)
01:18FA C8              	   102:   INY                    ; name in the entry at +4
01:18FB C8              	   103:   INY
01:18FC C8              	   104:   INY
01:18FD C8              	   105:   INY
01:18FE B1AA            	   106:   LDA (DOC_E),Y
01:1900 C5AD            	   107:   CMP DOC_I
01:1902 D00A            	   108:   BNE .df_n
01:1904 88              	   109:   DEY                    ; back to the previous character
01:1905 88              	   110:   DEY
01:1906 88              	   111:   DEY
01:1907 88              	   112:   DEY
01:1908 88              	   113:   DEY
01:1909 10EB            	   114:   BPL .df_c
01:190B 68              	   115:   PLA
01:190C 18              	   116:   CLC
01:190D 60              	   117:   RTS
                        	   118: .df_n:
01:190E 68              	   119:   PLA
01:190F 1A              	   120:   INC A
01:1910 C910            	   121:   CMP #DOC_SLOTS+1
01:1912 D0D4            	   122:   BNE .df_k
01:1914 38              	   123:   SEC
01:1915 60              	   124:   RTS
                        	   125: 
                        	   126: ; DOC_FREE: C=0 and A = first free slot, C=1 index full
                        	   127: DOC_FREE:
01:1916 A901            	   128:   LDA #1
                        	   129: .dfr_k:
01:1918 20D218          	   130:   JSR DOC_ENTRY
01:191B A000            	   131:   LDY #0
01:191D B1AA            	   132:   LDA (DOC_E),Y
01:191F F009            	   133:   BEQ .dfr_y
01:1921 A5AC            	   134:   LDA DOC_K
01:1923 1A              	   135:   INC A
01:1924 C910            	   136:   CMP #DOC_SLOTS+1
01:1926 D0F0            	   137:   BNE .dfr_k
01:1928 38              	   138:   SEC
01:1929 60              	   139:   RTS
                        	   140: .dfr_y:
01:192A A5AC            	   141:   LDA DOC_K
01:192C 18              	   142:   CLC
01:192D 60              	   143:   RTS
                        	   144: 
                        	   145: ; DOC_SETENT: entry of slot A = type DOC_T, length DOC_LEN, name (DOC_P) (12 bytes)
                        	   146: DOC_SETENT:
01:192E 20D218          	   147:   JSR DOC_ENTRY
01:1931 A000            	   148:   LDY #0
01:1933 A5B8            	   149:   LDA DOC_T
01:1935 91AA            	   150:   STA (DOC_E),Y
01:1937 C8              	   151:   INY
01:1938 A5B9            	   152:   LDA DOC_LEN
01:193A 91AA            	   153:   STA (DOC_E),Y
01:193C C8              	   154:   INY
01:193D A5BA            	   155:   LDA DOC_LEN+1
01:193F 91AA            	   156:   STA (DOC_E),Y
01:1941 C8              	   157:   INY
01:1942 A900            	   158:   LDA #0
01:1944 91AA            	   159:   STA (DOC_E),Y
01:1946 A000            	   160:   LDY #0                 ; name: (DOC_P)+0..11 -> entry +4..15
                        	   161: .dse_n:
01:1948 B1A2            	   162:   LDA (DOC_P),Y
01:194A C8              	   163:   INY
01:194B C8              	   164:   INY
01:194C C8              	   165:   INY
01:194D C8              	   166:   INY
01:194E 91AA            	   167:   STA (DOC_E),Y
01:1950 88              	   168:   DEY
01:1951 88              	   169:   DEY
01:1952 88              	   170:   DEY
01:1953 C00C            	   171:   CPY #DOC_NAMELEN
01:1955 D0F1            	   172:   BNE .dse_n
01:1957 60              	   173:   RTS
                        	   174: 
                        	   175: ; DOC_SECT: SD_LBA = DOC_BASE + DOC_K*40 + DOC_I
                        	   176: DOC_SECT:
01:1958 9C1803          	   177:   STZ SD_LBA+2
01:195B 9C1903          	   178:   STZ SD_LBA+3
01:195E A5AC            	   179:   LDA DOC_K
01:1960 8D1603          	   180:   STA SD_LBA
01:1963 9C1703          	   181:   STZ SD_LBA+1
01:1966 0E1603          	   182:   ASL SD_LBA             ; k*8
01:1969 2E1703          	   183:   ROL SD_LBA+1
01:196C 0E1603          	   184:   ASL SD_LBA
01:196F 2E1703          	   185:   ROL SD_LBA+1
01:1972 0E1603          	   186:   ASL SD_LBA
01:1975 2E1703          	   187:   ROL SD_LBA+1
01:1978 AD1703          	   188:   LDA SD_LBA+1           ; + k*32 = 4 * (k*8)
01:197B 48              	   189:   PHA
01:197C AD1603          	   190:   LDA SD_LBA
01:197F 48              	   191:   PHA
01:1980 0E1603          	   192:   ASL SD_LBA
01:1983 2E1703          	   193:   ROL SD_LBA+1
01:1986 0E1603          	   194:   ASL SD_LBA
01:1989 2E1703          	   195:   ROL SD_LBA+1
01:198C 18              	   196:   CLC
01:198D 68              	   197:   PLA
01:198E 6D1603          	   198:   ADC SD_LBA
01:1991 8D1603          	   199:   STA SD_LBA
01:1994 68              	   200:   PLA
01:1995 6D1703          	   201:   ADC SD_LBA+1
01:1998 8D1703          	   202:   STA SD_LBA+1
01:199B 18              	   203:   CLC
01:199C AD1603          	   204:   LDA SD_LBA
01:199F 65AD            	   205:   ADC DOC_I
01:19A1 8D1603          	   206:   STA SD_LBA
01:19A4 AD1703          	   207:   LDA SD_LBA+1
01:19A7 6940            	   208:   ADC #>DOC_BASE
01:19A9 8D1703          	   209:   STA SD_LBA+1
01:19AC 60              	   210:   RTS
                        	   211: 
                        	   212: DOC_LBA0:
01:19AD 9C1603          	   213:   STZ SD_LBA
01:19B0 A940            	   214:   LDA #>DOC_BASE
01:19B2 8D1703          	   215:   STA SD_LBA+1
01:19B5 9C1803          	   216:   STZ SD_LBA+2
01:19B8 9C1903          	   217:   STZ SD_LBA+3
01:19BB 60              	   218:   RTS
                        	   219: 
                        	   220: ; DOC_XFER: DOC_K = slot, A = RAM page of the data, X/Y = length (lo/hi), C=0 read, C=1 write
                        	   221: ; Transfers ceil(length / 512) sectors. C=1 SD error
                        	   222: DOC_XFER:
01:19BC 85AF            	   223:   STA DOC_PG
01:19BE 08              	   224:   PHP
01:19BF 8A              	   225:   TXA                    ; sectors = (length + 511) / 512
01:19C0 18              	   226:   CLC
01:19C1 69FF            	   227:   ADC #$FF
01:19C3 98              	   228:   TYA
01:19C4 6901            	   229:   ADC #$01
01:19C6 4A              	   230:   LSR
01:19C7 85AE            	   231:   STA DOC_N
01:19C9 64AD            	   232:   STZ DOC_I
01:19CB 28              	   233:   PLP
01:19CC B017            	   234:   BCS .dx_w
                        	   235: .dx_r:
01:19CE A5AD            	   236:   LDA DOC_I
01:19D0 C5AE            	   237:   CMP DOC_N
01:19D2 B028            	   238:   BCS .dx_ok
01:19D4 205819          	   239:   JSR DOC_SECT
01:19D7 A200            	   240:   LDX #0
01:19D9 A4AF            	   241:   LDY DOC_PG
01:19DB 2018FD          	   242:   JSR JT_SD_READ
01:19DE B01D            	   243:   BCS .dx_x
01:19E0 20FE19          	   244:   JSR .dx_next
01:19E3 80E9            	   245:   BRA .dx_r
                        	   246: .dx_w:
01:19E5 A5AD            	   247:   LDA DOC_I
01:19E7 C5AE            	   248:   CMP DOC_N
01:19E9 B011            	   249:   BCS .dx_ok
01:19EB 205819          	   250:   JSR DOC_SECT
01:19EE A200            	   251:   LDX #0
01:19F0 A4AF            	   252:   LDY DOC_PG
01:19F2 201BFD          	   253:   JSR JT_SD_WRITE
01:19F5 B006            	   254:   BCS .dx_x
01:19F7 20FE19          	   255:   JSR .dx_next
01:19FA 80E9            	   256:   BRA .dx_w
                        	   257: .dx_ok:
01:19FC 18              	   258:   CLC
                        	   259: .dx_x:
01:19FD 60              	   260:   RTS
                        	   261: .dx_next:
01:19FE E6AD            	   262:   INC DOC_I
01:1A00 E6AF            	   263:   INC DOC_PG
01:1A02 E6AF            	   264:   INC DOC_PG
01:1A04 4C7116          	   265:   JMP KB_POLL
                        	   266: 
                        	   267: DOC_MAGIC:
01:1A07 444F4353        	   268:   .byte "DOCS",1,DOC_SLOTS
01:1A0B 01
01:1A0C 0F
                        	   269: 

Source: "apps\term.asm"
                        	   818:  .include "lib/stream.asm"

Source: "lib\stream.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   STREAM.ASM  -  a document written / read byte by byte      ;
                        	     4: ;                                                              ;
                        	     5: ;   Through a 512-byte sector buffer, one sector at a time,    ;
                        	     6: ;   in the slot DOC_K of the document area (lib/docs.asm).     ;
                        	     7: ;   Uses: zp $E4-$EB, RAM $0800-$09FF (ST_BUF)                 ;
                        	     8: ;                                                              ;
                        	     9: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    10: 
                        	    11: ST_BUF      = $0800    ; sector buffer (page aligned)
                        	    12: ST_POS      = $E4      ; 2 bytes: position in ST_BUF
                        	    13: ST_SEC      = $E6      ; sector of the document
                        	    14: ST_LEFT     = $E7      ; 2 bytes: bytes still to read
                        	    15: ST_ERR      = $E9      ; 1 = SD error or too big
                        	    16: ST_P        = $EA      ; 2 bytes
                        	    17: 
                        	    18: ; ST_WOPEN: start writing the document DOC_K
                        	    19: ST_WOPEN:
01:1A0D 64E4            	    20:   STZ ST_POS
01:1A0F 64E5            	    21:   STZ ST_POS+1
01:1A11 64E6            	    22:   STZ ST_SEC
01:1A13 64E9            	    23:   STZ ST_ERR
01:1A15 60              	    24:   RTS
                        	    25: 
                        	    26: ; ST_PUT: A to the document. Keeps A, X, Y
                        	    27: ST_PUT:
01:1A16 48              	    28:   PHA
01:1A17 DA              	    29:   PHX
01:1A18 5A              	    30:   PHY
01:1A19 48              	    31:   PHA
