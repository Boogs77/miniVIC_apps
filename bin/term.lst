                        	    53: ; ST_FLUSH: the buffer (ST_POS bytes) to sector ST_SEC, then an empty buffer
                        	    54: ST_FLUSH:
01:1A3B A5E4            	    55:   LDA ST_POS
01:1A3D 05E5            	    56:   ORA ST_POS+1
01:1A3F F01E            	    57:   BEQ .sf_x
01:1A41 A5E6            	    58:   LDA ST_SEC
01:1A43 C928            	    59:   CMP #DOC_SECTS
01:1A45 B00E            	    60:   BCS .sf_big
01:1A47 85AD            	    61:   STA DOC_I
01:1A49 205819          	    62:   JSR DOC_SECT
01:1A4C A200            	    63:   LDX #<ST_BUF
01:1A4E A008            	    64:   LDY #>ST_BUF
01:1A50 201BFD          	    65:   JSR JT_SD_WRITE
01:1A53 9004            	    66:   BCC .sf_n
                        	    67: .sf_big:
01:1A55 A901            	    68:   LDA #1
01:1A57 85E9            	    69:   STA ST_ERR
                        	    70: .sf_n:
01:1A59 E6E6            	    71:   INC ST_SEC
01:1A5B 64E4            	    72:   STZ ST_POS
01:1A5D 64E5            	    73:   STZ ST_POS+1
                        	    74: .sf_x:
01:1A5F 60              	    75:   RTS
                        	    76: 
                        	    77: ; ST_WCLOSE: the last part; DOC_LEN = length. C=1 SD error or more than 20 KB
                        	    78: ST_WCLOSE:
01:1A60 A5E6            	    79:   LDA ST_SEC             ; length = sectors * 512 + position
01:1A62 0A              	    80:   ASL
01:1A63 18              	    81:   CLC
01:1A64 65E5            	    82:   ADC ST_POS+1
01:1A66 85BA            	    83:   STA DOC_LEN+1
01:1A68 A5E4            	    84:   LDA ST_POS
01:1A6A 85B9            	    85:   STA DOC_LEN
01:1A6C 203B1A          	    86:   JSR ST_FLUSH
01:1A6F A5E9            	    87:   LDA ST_ERR
01:1A71 C901            	    88:   CMP #1                 ; C=1 if ST_ERR
01:1A73 60              	    89:   RTS
                        	    90: 
                        	    91: ; ST_ROPEN: start reading the document DOC_K of DOC_LEN bytes
                        	    92: ST_ROPEN:
01:1A74 A5B9            	    93:   LDA DOC_LEN
01:1A76 85E7            	    94:   STA ST_LEFT
01:1A78 A5BA            	    95:   LDA DOC_LEN+1
01:1A7A 85E8            	    96:   STA ST_LEFT+1
01:1A7C 64E6            	    97:   STZ ST_SEC
01:1A7E 64E9            	    98:   STZ ST_ERR
01:1A80 A902            	    99:   LDA #2                 ; (buffer empty: the first ST_GET reads a sector)
01:1A82 85E5            	   100:   STA ST_POS+1
01:1A84 64E4            	   101:   STZ ST_POS
01:1A86 60              	   102:   RTS
                        	   103: 
                        	   104: ; ST_GET: A = next byte, C=1 at the end (ST_ERR = 1 if the SD failed). Keeps X, Y
                        	   105: ST_GET:
01:1A87 A5E7            	   106:   LDA ST_LEFT
01:1A89 05E8            	   107:   ORA ST_LEFT+1
