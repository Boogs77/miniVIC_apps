                        	   815:  .include "lib/vtext.asm"

Source: "lib\vtext.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   VTEXT.ASM  -  40 x 24 text screen on the TMS9918A          ;
                        	     4: ;                                                              ;
                        	     5: ;   BIOS text mode (VDP interrupt off, so the main loop can    ;
                        	     6: ;   write the VRAM at any time). VT_INIT also builds the       ;
                        	     7: ;   inverse font: codes $80-$FF = codes $00-$7F inverted,      ;
                        	     8: ;   used for the cursor, the status bar and the marked block.  ;
                        	     9: ;   Long loops call KB_POLL (lib/keys.asm).                    ;
                        	    10: ;   Uses: zp $A2-$A4, RAM $0800-$0BFF only inside VT_INIT      ;
                        	    11: ;                                                              ;
                        	    12: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    13: 
                        	    14: VT_P        = $A2      ; 2 bytes: string pointer
                        	    15: VT_INV      = $A4      ; ORed to every character of VT_STR ($80 = inverse)
                        	    16: VT_FONTTMP  = $0800    ; RAM copy of the font (1 KB, only during VT_INIT)
                        	    17: 
                        	    18: ; VT_INIT: text mode of the BIOS, inverse font, empty screen
                        	    19: VT_INIT:
01:1704 2009FD          	    20:   JSR JT_INIT_CRT
01:1707 A900            	    21:   LDA #<VRAM_FONT        ; read patterns 0-127 (1 KB)
01:1709 A200            	    22:   LDX #>VRAM_FONT
01:170B 207817          	    23:   JSR VT_RADDR
01:170E A200            	    24:   LDX #0                 ; (the VRAM address increases by itself)
                        	    25: .vi_r0:
01:1710 AD00B0          	    26:   LDA VDP_DATA
01:1713 9D0008          	    27:   STA VT_FONTTMP,X
01:1716 E8              	    28:   INX
01:1717 D0F7            	    29:   BNE .vi_r0
                        	    30: .vi_r1:
01:1719 AD00B0          	    31:   LDA VDP_DATA
01:171C 9D0009          	    32:   STA VT_FONTTMP+$100,X
01:171F E8              	    33:   INX
01:1720 D0F7            	    34:   BNE .vi_r1
                        	    35: .vi_r2:
01:1722 AD00B0          	    36:   LDA VDP_DATA
01:1725 9D000A          	    37:   STA VT_FONTTMP+$200,X
01:1728 E8              	    38:   INX
01:1729 D0F7            	    39:   BNE .vi_r2
                        	    40: .vi_r3:
01:172B AD00B0          	    41:   LDA VDP_DATA
01:172E 9D000B          	    42:   STA VT_FONTTMP+$300,X
01:1731 E8              	    43:   INX
01:1732 D0F7            	    44:   BNE .vi_r3
01:1734 A900            	    45:   LDA #<(VRAM_FONT+$400) ; inverted copy at pattern 128
01:1736 A204            	    46:   LDX #>(VRAM_FONT+$400)
01:1738 206E17          	    47:   JSR VT_WADDR
01:173B A200            	    48:   LDX #0
                        	    49: .vi_w0:
01:173D BD0008          	    50:   LDA VT_FONTTMP,X
01:1740 49FF            	    51:   EOR #$FF
01:1742 8D00B0          	    52:   STA VDP_DATA
01:1745 E8              	    53:   INX
01:1746 D0F5            	    54:   BNE .vi_w0
                        	    55: .vi_w1:
01:1748 BD0009          	    56:   LDA VT_FONTTMP+$100,X
01:174B 49FF            	    57:   EOR #$FF
01:174D 8D00B0          	    58:   STA VDP_DATA
01:1750 E8              	    59:   INX
01:1751 D0F5            	    60:   BNE .vi_w1
                        	    61: .vi_w2:
01:1753 BD000A          	    62:   LDA VT_FONTTMP+$200,X
01:1756 49FF            	    63:   EOR #$FF
01:1758 8D00B0          	    64:   STA VDP_DATA
01:175B E8              	    65:   INX
01:175C D0F5            	    66:   BNE .vi_w2
                        	    67: .vi_w3:
01:175E BD000B          	    68:   LDA VT_FONTTMP+$300,X
01:1761 49FF            	    69:   EOR #$FF
01:1763 8D00B0          	    70:   STA VDP_DATA
01:1766 E8              	    71:   INX
01:1767 D0F5            	    72:   BNE .vi_w3
01:1769 64A4            	    73:   STZ VT_INV
01:176B 4CEE17          	    74:   JMP VT_CLS
                        	    75: 
                        	    76: ; VT_WADDR: VRAM write address A (lo) / X (hi)
                        	    77: VT_WADDR:
01:176E 8D01B0          	    78:   STA VDP_REG
01:1771 8A              	    79:   TXA
01:1772 0940            	    80:   ORA #$40
01:1774 8D01B0          	    81:   STA VDP_REG
01:1777 60              	    82:   RTS
                        	    83: 
                        	    84: ; VT_RADDR: VRAM read address A (lo) / X (hi)
                        	    85: VT_RADDR:
01:1778 8D01B0          	    86:   STA VDP_REG
01:177B 8E01B0          	    87:   STX VDP_REG
01:177E 60              	    88:   RTS
                        	    89: 
                        	    90: ; VT_ROW: write address at column 0 of row A (0-23). Keeps Y
                        	    91: VT_ROW:
01:177F AA              	    92:   TAX
01:1780 BD0218          	    93:   LDA VT_ROWLO,X
01:1783 48              	    94:   PHA
01:1784 BD1A18          	    95:   LDA VT_ROWHI,X
01:1787 AA              	    96:   TAX
01:1788 68              	    97:   PLA
01:1789 4C6E17          	    98:   JMP VT_WADDR
                        	    99: 
                        	   100: ; VT_AT: write address at row A, column X. Keeps Y
                        	   101: VT_AT:
01:178C DA              	   102:   PHX
01:178D AA              	   103:   TAX
01:178E 68              	   104:   PLA
01:178F 18              	   105:   CLC
01:1790 7D0218          	   106:   ADC VT_ROWLO,X
01:1793 48              	   107:   PHA
01:1794 BD1A18          	   108:   LDA VT_ROWHI,X
01:1797 6900            	   109:   ADC #0
01:1799 AA              	   110:   TAX
01:179A 68              	   111:   PLA
01:179B 4C6E17          	   112:   JMP VT_WADDR
                        	   113: 
                        	   114: ; VT_REP: writes X times the character A
                        	   115: VT_REP:
01:179E E000            	   116:   CPX #0
01:17A0 F010            	   117:   BEQ .vr_x
                        	   118: .vr_l:
01:17A2 8D00B0          	   119:   STA VDP_DATA
01:17A5 48              	   120:   PHA
01:17A6 8A              	   121:   TXA
01:17A7 290F            	   122:   AND #$0F
01:17A9 D003            	   123:   BNE .vr_n
01:17AB 207116          	   124:   JSR KB_POLL
                        	   125: .vr_n:
01:17AE 68              	   126:   PLA
01:17AF CA              	   127:   DEX
01:17B0 D0F0            	   128:   BNE .vr_l
                        	   129: .vr_x:
01:17B2 60              	   130:   RTS
                        	   131: 
                        	   132: ; VT_STR: writes the $00-terminated string at VT_P (ORA VT_INV). Y = characters written
                        	   133: VT_STR:
01:17B3 A000            	   134:   LDY #0
                        	   135: .vs_l:
01:17B5 B1A2            	   136:   LDA (VT_P),Y
01:17B7 F010            	   137:   BEQ .vs_x
01:17B9 05A4            	   138:   ORA VT_INV
01:17BB 8D00B0          	   139:   STA VDP_DATA
01:17BE C8              	   140:   INY
01:17BF 98              	   141:   TYA
01:17C0 290F            	   142:   AND #$0F
01:17C2 D0F1            	   143:   BNE .vs_l
01:17C4 207116          	   144:   JSR KB_POLL
01:17C7 80EC            	   145:   BRA .vs_l
                        	   146: .vs_x:
01:17C9 60              	   147:   RTS
                        	   148: 
                        	   149: ; VT_LINE: string A/X (lo/hi) at the current address, then spaces (ORA VT_INV) up to
                        	   150: ; column 40 of the row. Y = start column on entry
                        	   151: VT_LINE:
01:17CA 85A2            	   152:   STA VT_P
01:17CC 86A3            	   153:   STX VT_P+1
01:17CE 8CED17          	   154:   STY .vl_c
01:17D1 20B317          	   155:   JSR VT_STR
01:17D4 98              	   156:   TYA
01:17D5 18              	   157:   CLC
01:17D6 6DED17          	   158:   ADC .vl_c
01:17D9 8DED17          	   159:   STA .vl_c
01:17DC A928            	   160:   LDA #40
01:17DE 38              	   161:   SEC
01:17DF EDED17          	   162:   SBC .vl_c
01:17E2 9008            	   163:   BCC .vl_x
01:17E4 AA              	   164:   TAX
01:17E5 A920            	   165:   LDA #' '
01:17E7 05A4            	   166:   ORA VT_INV
01:17E9 4C9E17          	   167:   JMP VT_REP
                        	   168: .vl_x:
01:17EC 60              	   169:   RTS
                        	   170: .vl_c:
01:17ED 00              	   171:   .byte 0
                        	   172: 
                        	   173: ; VT_CLS: whole screen blank
                        	   174: VT_CLS:
01:17EE A900            	   175:   LDA #<VRAM_NAME
01:17F0 A208            	   176:   LDX #>VRAM_NAME
01:17F2 206E17          	   177:   JSR VT_WADDR
01:17F5 A004            	   178:   LDY #4                 ; 4 x 240 = 960
                        	   179: .vc_l:
01:17F7 A920            	   180:   LDA #' '
01:17F9 A2F0            	   181:   LDX #240
01:17FB 209E17          	   182:   JSR VT_REP
01:17FE 88              	   183:   DEY
01:17FF D0F6            	   184:   BNE .vc_l
01:1801 60              	   185:   RTS
                        	   186: 
                        	   187: VT_ROWLO:
01:1802 00              	   188:   .byte <(VRAM_NAME+0*40),<(VRAM_NAME+1*40),<(VRAM_NAME+2*40),<(VRAM_NAME+3*40)
01:1803 28
01:1804 50
01:1805 78
01:1806 A0              	   189:   .byte <(VRAM_NAME+4*40),<(VRAM_NAME+5*40),<(VRAM_NAME+6*40),<(VRAM_NAME+7*40)
01:1807 C8
01:1808 F0
01:1809 18
01:180A 40              	   190:   .byte <(VRAM_NAME+8*40),<(VRAM_NAME+9*40),<(VRAM_NAME+10*40),<(VRAM_NAME+11*40)
01:180B 68
01:180C 90
01:180D B8
01:180E E0              	   191:   .byte <(VRAM_NAME+12*40),<(VRAM_NAME+13*40),<(VRAM_NAME+14*40),<(VRAM_NAME+15*40)
01:180F 08
01:1810 30
01:1811 58
01:1812 80              	   192:   .byte <(VRAM_NAME+16*40),<(VRAM_NAME+17*40),<(VRAM_NAME+18*40),<(VRAM_NAME+19*40)
01:1813 A8
01:1814 D0
01:1815 F8
01:1816 20              	   193:   .byte <(VRAM_NAME+20*40),<(VRAM_NAME+21*40),<(VRAM_NAME+22*40),<(VRAM_NAME+23*40)
01:1817 48
01:1818 70
01:1819 98
                        	   194: VT_ROWHI:
01:181A 08              	   195:   .byte >(VRAM_NAME+0*40),>(VRAM_NAME+1*40),>(VRAM_NAME+2*40),>(VRAM_NAME+3*40)
01:181B 08
01:181C 08
01:181D 08
01:181E 08              	   196:   .byte >(VRAM_NAME+4*40),>(VRAM_NAME+5*40),>(VRAM_NAME+6*40),>(VRAM_NAME+7*40)
01:181F 08
01:1820 08
01:1821 09
01:1822 09              	   197:   .byte >(VRAM_NAME+8*40),>(VRAM_NAME+9*40),>(VRAM_NAME+10*40),>(VRAM_NAME+11*40)
01:1823 09
01:1824 09
01:1825 09
01:1826 09              	   198:   .byte >(VRAM_NAME+12*40),>(VRAM_NAME+13*40),>(VRAM_NAME+14*40),>(VRAM_NAME+15*40)
01:1827 0A
01:1828 0A
01:1829 0A
01:182A 0A              	   199:   .byte >(VRAM_NAME+16*40),>(VRAM_NAME+17*40),>(VRAM_NAME+18*40),>(VRAM_NAME+19*40)
01:182B 0A
01:182C 0A
01:182D 0A
01:182E 0B              	   200:   .byte >(VRAM_NAME+20*40),>(VRAM_NAME+21*40),>(VRAM_NAME+22*40),>(VRAM_NAME+23*40)
01:182F 0B
01:1830 0B
01:1831 0B
