Source: "apps\disk.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   DISK  -  miniVIC DISK, the SD card manager (a small DOS)   ;
                        	     4: ;   65C02 assembly, TMS9918A text mode 40 x 24                 ;
                        	     5: ;   Needs the BIOS 27.10.26 KEYB/SD                            ;
                        	     6: ;                                                              ;
                        	     7: ;   - F2 the programs of the SD (directory pages of make_sd),  ;
                        	     8: ;     Enter runs one (JT_LOAD_RUN_SLOT, as the BIOS menu does) ;
                        	     9: ;   - F3 the documents (WRITE, CALC, FILE, MON, TERM):         ;
                        	    10: ;     V view (text, or hex for code), R rename, C copy,        ;
                        	    11: ;     Del delete, F empty the whole document index             ;
                        	    12: ;   - arrows / ^E ^X, PgUp PgDn choose; Tab the other list;    ;
                        	    13: ;     Q or F10 back to the BIOS menu                           ;
                        	    14: ;                                                              ;
                        	    15: ;   MEMORY                                                     ;
                        	    16: ;   $0050-$006F  zero page (lib $A0-$F1)                       ;
                        	    17: ;   $0210-$021F  name                                          ;
                        	    18: ;   $0600-$09FF  document index, sector buffer                 ;
                        	    19: ;   $3000-$57FF  the programs: 40 bytes each (255 at most)     ;
                        	    20: ;                                                              ;
                        	    21: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    22: 
                        	    23:  .include "lib/system.inc"

Source: "lib\system.inc"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   SYSTEM.INC  -  miniVIC / BO6502 addresses for the apps     ;
                        	     4: ;   BIOS 27.10.26 KEYB/SD jump table, VDP, key codes           ;
                        	     5: ;                                                              ;
                        	     6: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     7: 
                        	     8: ; ---------------- BIOS jump table ($FD00) ----------------
                        	     9: JT_CHROUT       = $FD00    ; A = char to screen AND serial (not used by the apps)
                        	    10: JT_CHRIN        = $FD03    ; C=1 and A = key, C=0 no key (serial first, then keyboard)
                        	    11: JT_INIT_CRT     = $FD09    ; text mode, VRAM and font of the BIOS
                        	    12: JT_LOAD_RUN_SLOT = $FD0C   ; A = SD slot: loads and runs it (never returns; error: BIOS menu)
                        	    13: JT_SHOW_MENU    = $FD0F    ; back to the BIOS menu (never returns)
                        	    14: JT_SD_READ      = $FD18    ; sector SD_LBA -> buffer X/Y (lo/hi, 512 bytes), C=1 error
                        	    15: JT_SD_WRITE     = $FD1B    ; buffer X/Y -> sector SD_LBA, C=1 error
                        	    16: JT_SD_INIT      = $FD1E    ; C=0 and A = card type, C=1 no card
                        	    17: JT_KB_MODE      = $FD21    ; A<>0 extended keyboard, A=0 classic
                        	    18: SD_LBA          = $0316    ; 4 bytes, sector number, little endian
                        	    19: 
                        	    20: ; ---------------- RAM vectors (everything is polled) ----------------
                        	    21: IRQ_VEC         = $0FA0    ; JSR $0FA0 from the BIOS IRQ handler
                        	    22: NMI_VEC         = $0FD0    ; JSR $0FD0 from the BIOS NMI handler
                        	    23: 
                        	    24: ; ---------------- VDP TMS9918A ----------------
                        	    25: VDP_DATA        = $B000
                        	    26: VDP_REG         = $B001
                        	    27: VRAM_NAME       = $0800    ; name table of the BIOS text mode (40 x 24)
                        	    28: VRAM_FONT       = $0000    ; patterns 0-127 (BIOS font), 128-255 = inverse (made by VT_INIT)
                        	    29: 
                        	    30: ; ---------------- serial W65C51 ----------------
                        	    31: ACIA_DATA   = $C000
                        	    32: ACIA_STATUS = $C001    ; bit 3 = byte received
                        	    33: ACIA_CMD    = $C002    ; BIOS: $8B (no parity, receive IRQ off, DTR on)
                        	    34: ACIA_CTRL   = $C003    ; BIOS: $1F (19200, 8 bits, 1 stop)
                        	    35: 
                        	    36: ; ---------------- key codes (extended mode) ----------------
                        	    37: K_CR            = $0D
                        	    38: K_BS            = $08
                        	    39: K_TAB           = $09
                        	    40: K_ESC           = $1B
                        	    41: K_UP            = $80
                        	    42: K_DOWN          = $81
                        	    43: K_LEFT          = $82
                        	    44: K_RIGHT         = $83
                        	    45: K_HOME          = $84
                        	    46: K_END           = $85
                        	    47: K_PGUP          = $86
                        	    48: K_PGDN          = $87
                        	    49: K_INS           = $88
                        	    50: K_DEL           = $89
                        	    51: K_F1            = $90      ; F1-F12 = $90-$9B
                        	    52: 

Source: "apps\disk.asm"
                        	    24: 
                        	    25: PROGTAB     = $3000    ; per program: name (32), load, length, entry (2 each), type, run flag
                        	    26: PE          = 40
                        	    27: LROWS       = 20       ; list rows (screen rows 2-21)
                        	    28: NAMELEN     = 12
                        	    29: 
                        	    30: ; ---------------- zero page ----------------
                        	    31: VIEW        = $50      ; 0 programs, 1 documents
                        	    32: SEL         = $51      ; selected row (program 0-254, or document slot 1-15)
                        	    33: TOPI        = $52      ; first row on the screen (programs)
                        	    34: NPROG       = $53
                        	    35: CTYPE       = $54      ; SD card type (0 none)
                        	    36: T0          = $55
                        	    37: T1          = $56
                        	    38: T2          = $57
                        	    39: T3          = $58
                        	    40: P0          = $59      ; 2 bytes
                        	    41: P1          = $5B      ; 2 bytes
                        	    42: MSGP        = $5D      ; 2 bytes
                        	    43: ROWI        = $5F
                        	    44: PG          = $60      ; directory page being read
                        	    45: NDOC        = $61      ; documents in use
                        	    46: HEXV        = $62      ; view: 1 = hex
                        	    47: VCOL        = $63      ; view: column
                        	    48: VOFF        = $64      ; view: 2 bytes, offset (hex)
                        	    49: 
                        	    50: NAMEB       = $0210
                        	    51: 
                        	    52:  .org $0FD0
00:0FD0 60              	    53:   RTS                    ; NMI trampoline (the VDP interrupt is off)
                        	    54:  .org $1000
                        	    55: 
