Source: "lib\keys.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   KEYS.ASM  -  key queue on top of the BIOS                  ;
                        	     4: ;                                                              ;
                        	     5: ;   The PS/2 board keeps one byte: a byte not read within      ;
                        	     6: ;   ~1 ms is lost (a lost $F0 turns a release into a second    ;
                        	     7: ;   press). Two ways in, both on: the CA1 interrupt of the     ;
                        	     8: ;   keyboard VIA (IRQ -> BIOS -> JMP KB_IRQ at $0FA0) reads    ;
                        	     9: ;   every byte at once; KB_POLL, called by the long loops,     ;
                        	    10: ;   does the same if the IRQ line is not there. Assembled      ;
                        	    11: ;   with -DKB_NOIRQ=1 only the polling is left.                ;
                        	    12: ;   The keys decoded by the BIOS go into a 32-key queue,       ;
                        	    13: ;   GETKEY takes them out. KB_EXIT before leaving the app.     ;
                        	    14: ;   An app that uses the serial line itself defines KB_SERBUF  ;
                        	    15: ;   (256-byte ring): the received bytes go there, not among    ;
                        	    16: ;   the keys (JT_CHRIN reads the serial line first: a byte it  ;
                        	    17: ;   returns while CA1 is still set came from the serial line). ;
                        	    18: ;   Uses: zp $A0-$A1 ($F0-$F1 with KB_SERBUF), RAM $05C0-$05DF ;
                        	    19: ;                                                              ;
                        	    20: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    21: 
                        	    22: KQ          = $05C0    ; 32-key ring
                        	    23: KQ_MASK     = $1F
                        	    24: KQR         = $A0      ; read index
                        	    25: KQW         = $A1      ; write index
                        	    26: KB_IFR      = $D18D    ; keyboard VIA: interrupt flags (bit 1 = CA1)
                        	    27: KB_IER      = $D18E    ;               interrupt enable
                        	    28: KB_SRR      = $F0      ; serial ring (KB_SERBUF): read index
                        	    29: KB_SRW      = $F1      ;                          write index
                        	    30: 
                        	    31: ; KB_INIT: extended keyboard, empty queue, CA1 interrupt on
                        	    32: KB_INIT:
01:182F 78              	    33:   SEI
01:1830 A901            	    34:   LDA #1
01:1832 2021FD          	    35:   JSR JT_KB_MODE
01:1835 64A0            	    36:   STZ KQR
01:1837 64A1            	    37:   STZ KQW
01:1839 64F0            	    38:   STZ KB_SRR
01:183B 64F1            	    39:   STZ KB_SRW
                        	    40:  .ifndef KB_NOIRQ
01:183D A94C            	    41:   LDA #$4C               ; JMP KB_IRQ in the RAM vector of the BIOS
01:183F 8DA00F          	    42:   STA IRQ_VEC
01:1842 A95F            	    43:   LDA #<KB_IRQ
01:1844 8DA10F          	    44:   STA IRQ_VEC+1
01:1847 A918            	    45:   LDA #>KB_IRQ
01:1849 8DA20F          	    46:   STA IRQ_VEC+2
01:184C A982            	    47:   LDA #$82               ; CA1 interrupt enabled
01:184E 8D8ED1          	    48:   STA KB_IER
01:1851 58              	    49:   CLI
                        	    50:  .endif
01:1852 60              	    51:   RTS
                        	    52: 
                        	    53: ; KB_EXIT: interrupt off again (the BIOS menu works by polling)
                        	    54: KB_EXIT:
01:1853 78              	    55:   SEI
01:1854 A902            	    56:   LDA #$02
01:1856 8D8ED1          	    57:   STA KB_IER
01:1859 A960            	    58:   LDA #$60               ; RTS
01:185B 8DA00F          	    59:   STA IRQ_VEC
01:185E 60              	    60:   RTS
                        	    61: 
                        	    62: ; KB_IRQ: called by the BIOS IRQ handler (A, X, Y already saved)
                        	    63: KB_IRQ:
                        	    64:  .ifdef KB_SERBUF
                        	    65:   JMP KB_TAKE            ; the keyboard or the serial line
                        	    66:  .else
01:185F AD8DD1          	    67:   LDA KB_IFR
01:1862 2902            	    68:   AND #$02
01:1864 F003            	    69:   BEQ .ki_x
01:1866 207718          	    70:   JSR KB_TAKE
                        	    71: .ki_x:
01:1869 60              	    72:   RTS
                        	    73:  .endif
                        	    74: 
                        	    75: ; KB_POLL: one BIOS poll with the interrupt held off. Keeps A, X, Y and the I flag
                        	    76: KB_POLL:
01:186A 08              	    77:   PHP
01:186B 78              	    78:   SEI
01:186C 48              	    79:   PHA
01:186D DA              	    80:   PHX
01:186E 5A              	    81:   PHY
01:186F 207718          	    82:   JSR KB_TAKE
01:1872 7A              	    83:   PLY
01:1873 FA              	    84:   PLX
01:1874 68              	    85:   PLA
01:1875 28              	    86:   PLP
01:1876 60              	    87:   RTS
                        	    88: 
                        	    89: ; KB_TAKE: a key from the BIOS goes into the queue (full queue: dropped)
                        	    90: KB_TAKE:
                        	    91:  .ifdef KB_SERBUF
                        	    92: .kt_rx:
                        	    93:   LDA ACIA_STATUS        ; received bytes first, into their ring
                        	    94:   AND #$08
                        	    95:   BEQ .kt_kb
                        	    96:   LDA ACIA_DATA
                        	    97:   JSR KB_SERPUT
                        	    98:   BRA .kt_rx
                        	    99: .kt_kb:
                        	   100:   LDA KB_IFR
                        	   101:   AND #$02
                        	   102:   BEQ .kt_x
                        	   103:   JSR JT_CHRIN
                        	   104:   BCC .kt_x
                        	   105:   PHA
                        	   106:   LDA KB_IFR             ; CA1 still set: the BIOS took a serial byte, not the key
                        	   107:   AND #$02
                        	   108:   BEQ .kt_key
                        	   109:   PLA
                        	   110:   JSR KB_SERPUT
                        	   111:   BRA .kt_rx
                        	   112: .kt_key:
                        	   113:   PLA
                        	   114:  .else
01:1877 2003FD          	   115:   JSR JT_CHRIN
01:187A 900F            	   116:   BCC .kt_x
                        	   117:  .endif
01:187C A6A1            	   118:   LDX KQW
01:187E 9DC005          	   119:   STA KQ,X
01:1881 8A              	   120:   TXA
01:1882 1A              	   121:   INC A
01:1883 291F            	   122:   AND #KQ_MASK
01:1885 C5A0            	   123:   CMP KQR
01:1887 F002            	   124:   BEQ .kt_x              ; full
01:1889 85A1            	   125:   STA KQW
                        	   126: .kt_x:
01:188B 60              	   127:   RTS
                        	   128: 
                        	   129:  .ifdef KB_SERBUF
                        	   130: ; KB_SERPUT: A into the serial ring (full: dropped)
                        	   131: KB_SERPUT:
                        	   132:   LDX KB_SRW
                        	   133:   STA KB_SERBUF,X
                        	   134:   INX
                        	   135:   CPX KB_SRR
                        	   136:   BEQ .ks_x
                        	   137:   STX KB_SRW
                        	   138: .ks_x:
                        	   139:   RTS
                        	   140: 
                        	   141: ; SERGET: C=1 and A = next received byte, C=0 none
                        	   142: SERGET:
                        	   143:   JSR KB_POLL
                        	   144:   LDX KB_SRR
                        	   145:   CPX KB_SRW
                        	   146:   BEQ .sg_n
                        	   147:   LDA KB_SERBUF,X
                        	   148:   INC KB_SRR
                        	   149:   SEC
                        	   150:   RTS
                        	   151: .sg_n:
                        	   152:   CLC
                        	   153:   RTS
                        	   154:  .endif
                        	   155: 
                        	   156: ; GETKEY: C=1 and A = key, C=0 queue empty (after one poll). Keeps X, Y
                        	   157: GETKEY:
01:188C 206A18          	   158:   JSR KB_POLL
01:188F A5A0            	   159:   LDA KQR
01:1891 C5A1            	   160:   CMP KQW
01:1893 F010            	   161:   BEQ .gk_n
01:1895 DA              	   162:   PHX
01:1896 AA              	   163:   TAX
01:1897 BDC005          	   164:   LDA KQ,X
01:189A 48              	   165:   PHA
01:189B 8A              	   166:   TXA
01:189C 1A              	   167:   INC A
01:189D 291F            	   168:   AND #KQ_MASK
01:189F 85A0            	   169:   STA KQR
01:18A1 68              	   170:   PLA
01:18A2 FA              	   171:   PLX
01:18A3 38              	   172:   SEC
01:18A4 60              	   173:   RTS
                        	   174: .gk_n:
01:18A5 18              	   175:   CLC
01:18A6 60              	   176:   RTS
                        	   177: 
                        	   178: ; WAITKEY: A = next key
                        	   179: WAITKEY:
01:18A7 208C18          	   180:   JSR GETKEY
01:18AA 90FB            	   181:   BCC WAITKEY
01:18AC 60              	   182:   RTS
                        	   183: 
                        	   184: ; KEYREADY: C=1 if a key is waiting in the queue
                        	   185: KEYREADY:
01:18AD 206A18          	   186:   JSR KB_POLL
01:18B0 A5A0            	   187:   LDA KQR
01:18B2 C5A1            	   188:   CMP KQW
01:18B4 18              	   189:   CLC
01:18B5 F001            	   190:   BEQ .kr_x
01:18B7 38              	   191:   SEC
                        	   192: .kr_x:
01:18B8 60              	   193:   RTS
                        	   194: 

Source: "apps\disk.asm"
                        	  1054:  .include "lib/vtext.asm"

Source: "lib\vtext.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   VTEXT.ASM  -  40 x 24 text screen on the TMS9918A          ;
                        	     4: ;                                                              ;
                        	     5: ;   BIOS text mode (VDP interrupt off, so the main loop can    ;
                        	     6: ;   write the VRAM at any time). VT_INIT also builds the       ;
                        	     7: ;   inverse font: codes $80-$FF = codes $00-$7F inverted,      ;
                        	     8: ;   used for the cursor, the status bar and the marked block.  ;
                        	     9: ;   Long loops call KB_POLL (lib/keys.asm).                    ;
                        	    10: ;   Uses: zp $A2-$A4, RAM $0800-$0BFF only inside VT_INIT      ;
                        	    11: ;                                                              ;
                        	    12: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    13: 
                        	    14: VT_P        = $A2      ; 2 bytes: string pointer
                        	    15: VT_INV      = $A4      ; ORed to every character of VT_STR ($80 = inverse)
                        	    16: VT_FONTTMP  = $0800    ; RAM copy of the font (1 KB, only during VT_INIT)
                        	    17: 
                        	    18: ; VT_INIT: text mode of the BIOS, inverse font, empty screen
                        	    19: VT_INIT:
01:18B9 2009FD          	    20:   JSR JT_INIT_CRT
01:18BC A900            	    21:   LDA #<VRAM_FONT        ; read patterns 0-127 (1 KB)
01:18BE A200            	    22:   LDX #>VRAM_FONT
01:18C0 202D19          	    23:   JSR VT_RADDR
01:18C3 A200            	    24:   LDX #0                 ; (the VRAM address increases by itself)
                        	    25: .vi_r0:
01:18C5 AD00B0          	    26:   LDA VDP_DATA
01:18C8 9D0008          	    27:   STA VT_FONTTMP,X
01:18CB E8              	    28:   INX
01:18CC D0F7            	    29:   BNE .vi_r0
                        	    30: .vi_r1:
01:18CE AD00B0          	    31:   LDA VDP_DATA
01:18D1 9D0009          	    32:   STA VT_FONTTMP+$100,X
01:18D4 E8              	    33:   INX
01:18D5 D0F7            	    34:   BNE .vi_r1
                        	    35: .vi_r2:
01:18D7 AD00B0          	    36:   LDA VDP_DATA
01:18DA 9D000A          	    37:   STA VT_FONTTMP+$200,X
01:18DD E8              	    38:   INX
01:18DE D0F7            	    39:   BNE .vi_r2
                        	    40: .vi_r3:
01:18E0 AD00B0          	    41:   LDA VDP_DATA
01:18E3 9D000B          	    42:   STA VT_FONTTMP+$300,X
01:18E6 E8              	    43:   INX
01:18E7 D0F7            	    44:   BNE .vi_r3
01:18E9 A900            	    45:   LDA #<(VRAM_FONT+$400) ; inverted copy at pattern 128
01:18EB A204            	    46:   LDX #>(VRAM_FONT+$400)
01:18ED 202319          	    47:   JSR VT_WADDR
01:18F0 A200            	    48:   LDX #0
                        	    49: .vi_w0:
01:18F2 BD0008          	    50:   LDA VT_FONTTMP,X
01:18F5 49FF            	    51:   EOR #$FF
01:18F7 8D00B0          	    52:   STA VDP_DATA
01:18FA E8              	    53:   INX
01:18FB D0F5            	    54:   BNE .vi_w0
                        	    55: .vi_w1:
01:18FD BD0009          	    56:   LDA VT_FONTTMP+$100,X
01:1900 49FF            	    57:   EOR #$FF
01:1902 8D00B0          	    58:   STA VDP_DATA
01:1905 E8              	    59:   INX
01:1906 D0F5            	    60:   BNE .vi_w1
                        	    61: .vi_w2:
01:1908 BD000A          	    62:   LDA VT_FONTTMP+$200,X
01:190B 49FF            	    63:   EOR #$FF
01:190D 8D00B0          	    64:   STA VDP_DATA
01:1910 E8              	    65:   INX
01:1911 D0F5            	    66:   BNE .vi_w2
                        	    67: .vi_w3:
01:1913 BD000B          	    68:   LDA VT_FONTTMP+$300,X
01:1916 49FF            	    69:   EOR #$FF
01:1918 8D00B0          	    70:   STA VDP_DATA
01:191B E8              	    71:   INX
01:191C D0F5            	    72:   BNE .vi_w3
01:191E 64A4            	    73:   STZ VT_INV
01:1920 4CA319          	    74:   JMP VT_CLS
                        	    75: 
                        	    76: ; VT_WADDR: VRAM write address A (lo) / X (hi)
                        	    77: VT_WADDR:
01:1923 8D01B0          	    78:   STA VDP_REG
01:1926 8A              	    79:   TXA
01:1927 0940            	    80:   ORA #$40
01:1929 8D01B0          	    81:   STA VDP_REG
01:192C 60              	    82:   RTS
                        	    83: 
                        	    84: ; VT_RADDR: VRAM read address A (lo) / X (hi)
                        	    85: VT_RADDR:
01:192D 8D01B0          	    86:   STA VDP_REG
01:1930 8E01B0          	    87:   STX VDP_REG
01:1933 60              	    88:   RTS
                        	    89: 
                        	    90: ; VT_ROW: write address at column 0 of row A (0-23). Keeps Y
                        	    91: VT_ROW:
01:1934 AA              	    92:   TAX
01:1935 BDB719          	    93:   LDA VT_ROWLO,X
01:1938 48              	    94:   PHA
01:1939 BDCF19          	    95:   LDA VT_ROWHI,X
01:193C AA              	    96:   TAX
01:193D 68              	    97:   PLA
01:193E 4C2319          	    98:   JMP VT_WADDR
                        	    99: 
                        	   100: ; VT_AT: write address at row A, column X. Keeps Y
                        	   101: VT_AT:
01:1941 DA              	   102:   PHX
01:1942 AA              	   103:   TAX
01:1943 68              	   104:   PLA
01:1944 18              	   105:   CLC
01:1945 7DB719          	   106:   ADC VT_ROWLO,X
01:1948 48              	   107:   PHA
01:1949 BDCF19          	   108:   LDA VT_ROWHI,X
01:194C 6900            	   109:   ADC #0
01:194E AA              	   110:   TAX
01:194F 68              	   111:   PLA
01:1950 4C2319          	   112:   JMP VT_WADDR
                        	   113: 
                        	   114: ; VT_REP: writes X times the character A
                        	   115: VT_REP:
01:1953 E000            	   116:   CPX #0
01:1955 F010            	   117:   BEQ .vr_x
                        	   118: .vr_l:
01:1957 8D00B0          	   119:   STA VDP_DATA
01:195A 48              	   120:   PHA
01:195B 8A              	   121:   TXA
01:195C 290F            	   122:   AND #$0F
01:195E D003            	   123:   BNE .vr_n
01:1960 206A18          	   124:   JSR KB_POLL
                        	   125: .vr_n:
01:1963 68              	   126:   PLA
01:1964 CA              	   127:   DEX
01:1965 D0F0            	   128:   BNE .vr_l
                        	   129: .vr_x:
01:1967 60              	   130:   RTS
                        	   131: 
                        	   132: ; VT_STR: writes the $00-terminated string at VT_P (ORA VT_INV). Y = characters written
                        	   133: VT_STR:
01:1968 A000            	   134:   LDY #0
                        	   135: .vs_l:
01:196A B1A2            	   136:   LDA (VT_P),Y
01:196C F010            	   137:   BEQ .vs_x
01:196E 05A4            	   138:   ORA VT_INV
01:1970 8D00B0          	   139:   STA VDP_DATA
01:1973 C8              	   140:   INY
01:1974 98              	   141:   TYA
01:1975 290F            	   142:   AND #$0F
01:1977 D0F1            	   143:   BNE .vs_l
01:1979 206A18          	   144:   JSR KB_POLL
01:197C 80EC            	   145:   BRA .vs_l
                        	   146: .vs_x:
01:197E 60              	   147:   RTS
                        	   148: 
                        	   149: ; VT_LINE: string A/X (lo/hi) at the current address, then spaces (ORA VT_INV) up to
                        	   150: ; column 40 of the row. Y = start column on entry
                        	   151: VT_LINE:
01:197F 85A2            	   152:   STA VT_P
01:1981 86A3            	   153:   STX VT_P+1
01:1983 8CA219          	   154:   STY .vl_c
01:1986 206819          	   155:   JSR VT_STR
01:1989 98              	   156:   TYA
01:198A 18              	   157:   CLC
01:198B 6DA219          	   158:   ADC .vl_c
01:198E 8DA219          	   159:   STA .vl_c
01:1991 A928            	   160:   LDA #40
01:1993 38              	   161:   SEC
01:1994 EDA219          	   162:   SBC .vl_c
01:1997 9008            	   163:   BCC .vl_x
01:1999 AA              	   164:   TAX
01:199A A920            	   165:   LDA #' '
01:199C 05A4            	   166:   ORA VT_INV
01:199E 4C5319          	   167:   JMP VT_REP
                        	   168: .vl_x:
01:19A1 60              	   169:   RTS
                        	   170: .vl_c:
01:19A2 00              	   171:   .byte 0
                        	   172: 
                        	   173: ; VT_CLS: whole screen blank
                        	   174: VT_CLS:
01:19A3 A900            	   175:   LDA #<VRAM_NAME
01:19A5 A208            	   176:   LDX #>VRAM_NAME
01:19A7 202319          	   177:   JSR VT_WADDR
01:19AA A004            	   178:   LDY #4                 ; 4 x 240 = 960
                        	   179: .vc_l:
01:19AC A920            	   180:   LDA #' '
01:19AE A2F0            	   181:   LDX #240
01:19B0 205319          	   182:   JSR VT_REP
01:19B3 88              	   183:   DEY
01:19B4 D0F6            	   184:   BNE .vc_l
01:19B6 60              	   185:   RTS
                        	   186: 
                        	   187: VT_ROWLO:
01:19B7 00              	   188:   .byte <(VRAM_NAME+0*40),<(VRAM_NAME+1*40),<(VRAM_NAME+2*40),<(VRAM_NAME+3*40)
01:19B8 28
01:19B9 50
01:19BA 78
01:19BB A0              	   189:   .byte <(VRAM_NAME+4*40),<(VRAM_NAME+5*40),<(VRAM_NAME+6*40),<(VRAM_NAME+7*40)
01:19BC C8
01:19BD F0
01:19BE 18
01:19BF 40              	   190:   .byte <(VRAM_NAME+8*40),<(VRAM_NAME+9*40),<(VRAM_NAME+10*40),<(VRAM_NAME+11*40)
01:19C0 68
01:19C1 90
01:19C2 B8
01:19C3 E0              	   191:   .byte <(VRAM_NAME+12*40),<(VRAM_NAME+13*40),<(VRAM_NAME+14*40),<(VRAM_NAME+15*40)
01:19C4 08
01:19C5 30
01:19C6 58
01:19C7 80              	   192:   .byte <(VRAM_NAME+16*40),<(VRAM_NAME+17*40),<(VRAM_NAME+18*40),<(VRAM_NAME+19*40)
01:19C8 A8
01:19C9 D0
01:19CA F8
01:19CB 20              	   193:   .byte <(VRAM_NAME+20*40),<(VRAM_NAME+21*40),<(VRAM_NAME+22*40),<(VRAM_NAME+23*40)
01:19CC 48
01:19CD 70
01:19CE 98
                        	   194: VT_ROWHI:
01:19CF 08              	   195:   .byte >(VRAM_NAME+0*40),>(VRAM_NAME+1*40),>(VRAM_NAME+2*40),>(VRAM_NAME+3*40)
01:19D0 08
01:19D1 08
01:19D2 08
01:19D3 08              	   196:   .byte >(VRAM_NAME+4*40),>(VRAM_NAME+5*40),>(VRAM_NAME+6*40),>(VRAM_NAME+7*40)
01:19D4 08
01:19D5 08
01:19D6 09
01:19D7 09              	   197:   .byte >(VRAM_NAME+8*40),>(VRAM_NAME+9*40),>(VRAM_NAME+10*40),>(VRAM_NAME+11*40)
01:19D8 09
01:19D9 09
01:19DA 09
01:19DB 09              	   198:   .byte >(VRAM_NAME+12*40),>(VRAM_NAME+13*40),>(VRAM_NAME+14*40),>(VRAM_NAME+15*40)
01:19DC 0A
01:19DD 0A
01:19DE 0A
01:19DF 0A              	   199:   .byte >(VRAM_NAME+16*40),>(VRAM_NAME+17*40),>(VRAM_NAME+18*40),>(VRAM_NAME+19*40)
01:19E0 0A
01:19E1 0A
01:19E2 0A
01:19E3 0B              	   200:   .byte >(VRAM_NAME+20*40),>(VRAM_NAME+21*40),>(VRAM_NAME+22*40),>(VRAM_NAME+23*40)
01:19E4 0B
01:19E5 0B
01:19E6 0B
                        	   201: 

Source: "apps\disk.asm"
                        	  1055:  .include "lib/num.asm"

Source: "lib\num.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   NUM.ASM  -  16-bit numbers to decimal text                 ;
                        	     4: ;   Uses: zp $A5-$A9                                           ;
                        	     5: ;                                                              ;
                        	     6: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     7: 
                        	     8: NUM         = $A5      ; 2 bytes: number to convert (destroyed)
                        	     9: BCD         = $A7      ; 3 bytes: BCD result, $A7 = lowest 2 digits
                        	    10: 
                        	    11: ; BIN2BCD: NUM -> BCD (double dabble with decimal mode)
                        	    12: BIN2BCD:
01:19E7 206A18          	    13:   JSR KB_POLL
01:19EA 64A7            	    14:   STZ BCD
01:19EC 64A8            	    15:   STZ BCD+1
01:19EE 64A9            	    16:   STZ BCD+2
01:19F0 A210            	    17:   LDX #16
01:19F2 F8              	    18:   SED
                        	    19: .bb_l:
01:19F3 06A5            	    20:   ASL NUM
01:19F5 26A6            	    21:   ROL NUM+1
01:19F7 A5A7            	    22:   LDA BCD
01:19F9 65A7            	    23:   ADC BCD
01:19FB 85A7            	    24:   STA BCD
01:19FD A5A8            	    25:   LDA BCD+1
01:19FF 65A8            	    26:   ADC BCD+1
01:1A01 85A8            	    27:   STA BCD+1
01:1A03 A5A9            	    28:   LDA BCD+2
01:1A05 65A9            	    29:   ADC BCD+2
01:1A07 85A9            	    30:   STA BCD+2
01:1A09 CA              	    31:   DEX
01:1A0A D0E7            	    32:   BNE .bb_l
01:1A0C D8              	    33:   CLD
01:1A0D 60              	    34:   RTS
                        	    35: 
                        	    36: ; NUMSTR: NUM -> 5 characters at (VT_P),Y.. with leading spaces (last digit always shown)
                        	    37: ; Y = first position; on exit Y = position after the number
                        	    38: NUMSTR:
01:1A0E 20E719          	    39:   JSR BIN2BCD
01:1A11 206A18          	    40:   JSR KB_POLL            ; (BIN2BCD takes ~600 cycles)
01:1A14 A200            	    41:   LDX #0                 ; X = 1 once a digit is not zero
01:1A16 A5A9            	    42:   LDA BCD+2
01:1A18 20361A          	    43:   JSR .ns_dig            ; ten thousands
01:1A1B A5A8            	    44:   LDA BCD+1
01:1A1D 4A              	    45:   LSR
01:1A1E 4A              	    46:   LSR
01:1A1F 4A              	    47:   LSR
01:1A20 4A              	    48:   LSR
01:1A21 20361A          	    49:   JSR .ns_dig
01:1A24 A5A8            	    50:   LDA BCD+1
01:1A26 20361A          	    51:   JSR .ns_dig
01:1A29 A5A7            	    52:   LDA BCD
01:1A2B 4A              	    53:   LSR
01:1A2C 4A              	    54:   LSR
01:1A2D 4A              	    55:   LSR
01:1A2E 4A              	    56:   LSR
01:1A2F 20361A          	    57:   JSR .ns_dig
01:1A32 A5A7            	    58:   LDA BCD
01:1A34 A201            	    59:   LDX #1                 ; the last digit is always written
                        	    60: .ns_dig:
01:1A36 290F            	    61:   AND #$0F
01:1A38 D008            	    62:   BNE .ns_nz
01:1A3A E000            	    63:   CPX #0
01:1A3C D004            	    64:   BNE .ns_nz
01:1A3E A920            	    65:   LDA #' '
01:1A40 8004            	    66:   BRA .ns_put
                        	    67: .ns_nz:
01:1A42 A201            	    68:   LDX #1
01:1A44 0930            	    69:   ORA #'0'
                        	    70: .ns_put:
01:1A46 91A2            	    71:   STA (VT_P),Y
01:1A48 C8              	    72:   INY
01:1A49 60              	    73:   RTS
                        	    74: 

Source: "apps\disk.asm"
                        	  1056:  .include "lib/docs.asm"

Source: "lib\docs.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   DOCS.ASM  -  documents in the SD document area             ;
                        	     4: ;                                                              ;
                        	     5: ;   Sector 16384 ($00800000, after the 255 program blocks)     ;
                        	     6: ;   is the index: +0 "DOCS", +4 version 1, +5 slots (15);      ;
                        	     7: ;   entry k (1-15) at k*32: +0 type (0 free, 1 text,           ;
                        	     8: ;   2 sheet, 3 card file),                                     ;
                        	     9: ;   +1/+2 length, +4..+15 name (12 chars, $00 padded).         ;
                        	    10: ;   Document k = 40 sectors (20 KB) from sector 16384 + k*40.  ;
                        	    11: ;   Sectors go through the BIOS (JT_SD_READ / JT_SD_WRITE).    ;
                        	    12: ;   Uses: zp $AA-$AF, $B8-$BA, RAM $0600-$07FF (index sector)  ;
                        	    13: ;                                                              ;
                        	    14: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    15: 
                        	    16: DOC_IDX     = $0600    ; index sector (512 bytes)
                        	    17: DOC_BASE    = $4000    ; sector 16384
                        	    18: DOC_SLOTS   = 15
                        	    19: DOC_SECTS   = 40       ; sectors per document
                        	    20: DOC_NAMELEN = 12
                        	    21: DOC_E       = $AA      ; 2 bytes: pointer to the index entry
                        	    22: DOC_K       = $AC      ; slot
                        	    23: DOC_I       = $AD      ; sector inside the document
                        	    24: DOC_N       = $AE      ; sectors to transfer
                        	    25: DOC_PG      = $AF      ; RAM page of the transfer
                        	    26: DOC_T       = $B8      ; document type of the application (1 text, 2 sheet, 3 card file)
                        	    27: DOC_LEN     = $B9      ; 2 bytes: length for DOC_SETENT
                        	    28: 
                        	    29: ; DOC_RDIDX: reads the index; a sector without "DOCS" becomes an empty index. C=1 SD error
                        	    30: DOC_RDIDX:
01:1A4A 20621B          	    31:   JSR DOC_LBA0
01:1A4D A200            	    32:   LDX #<DOC_IDX
01:1A4F A006            	    33:   LDY #>DOC_IDX
01:1A51 2018FD          	    34:   JSR JT_SD_READ
01:1A54 B00E            	    35:   BCS .dr_x
01:1A56 A203            	    36:   LDX #3
                        	    37: .dr_m:
01:1A58 BD0006          	    38:   LDA DOC_IDX,X
01:1A5B DDBC1B          	    39:   CMP DOC_MAGIC,X
01:1A5E D005            	    40:   BNE .dr_new
01:1A60 CA              	    41:   DEX
01:1A61 10F5            	    42:   BPL .dr_m
01:1A63 18              	    43:   CLC
                        	    44: .dr_x:
01:1A64 60              	    45:   RTS
                        	    46: .dr_new:
01:1A65 A200            	    47:   LDX #0
                        	    48: .dr_z:
01:1A67 9E0006          	    49:   STZ DOC_IDX,X
01:1A6A 9E0007          	    50:   STZ DOC_IDX+$100,X
01:1A6D E8              	    51:   INX
01:1A6E D0F7            	    52:   BNE .dr_z
01:1A70 A205            	    53:   LDX #5
                        	    54: .dr_h:
01:1A72 BDBC1B          	    55:   LDA DOC_MAGIC,X
01:1A75 9D0006          	    56:   STA DOC_IDX,X
01:1A78 CA              	    57:   DEX
01:1A79 10F7            	    58:   BPL .dr_h
01:1A7B 18              	    59:   CLC
01:1A7C 60              	    60:   RTS
                        	    61: 
                        	    62: ; DOC_WRIDX: writes the index. C=1 SD error
                        	    63: DOC_WRIDX:
01:1A7D 20621B          	    64:   JSR DOC_LBA0
01:1A80 A200            	    65:   LDX #<DOC_IDX
01:1A82 A006            	    66:   LDY #>DOC_IDX
01:1A84 4C1BFD          	    67:   JMP JT_SD_WRITE
                        	    68: 
                        	    69: ; DOC_ENTRY: A = slot (1-15) -> DOC_E = its index entry. Keeps X, Y
                        	    70: DOC_ENTRY:
01:1A87 85AC            	    71:   STA DOC_K
01:1A89 4A              	    72:   LSR
01:1A8A 4A              	    73:   LSR
01:1A8B 4A              	    74:   LSR
01:1A8C 18              	    75:   CLC
01:1A8D 6906            	    76:   ADC #>DOC_IDX
01:1A8F 85AB            	    77:   STA DOC_E+1
01:1A91 A5AC            	    78:   LDA DOC_K
01:1A93 0A              	    79:   ASL
01:1A94 0A              	    80:   ASL
01:1A95 0A              	    81:   ASL
01:1A96 0A              	    82:   ASL
01:1A97 0A              	    83:   ASL
01:1A98 85AA            	    84:   STA DOC_E              ; (DOC_IDX is page aligned)
01:1A9A 60              	    85:   RTS
                        	    86: 
                        	    87: ; DOC_FIND: name of 12 bytes at (DOC_P) and type DOC_T -> C=0 and A = slot, C=1 not found
                        	    88: DOC_P       = VT_P     ; (shares the string pointer)
                        	    89: DOC_FIND:
01:1A9B A901            	    90:   LDA #1
                        	    91: .df_k:
01:1A9D 48              	    92:   PHA
01:1A9E 20871A          	    93:   JSR DOC_ENTRY
01:1AA1 A000            	    94:   LDY #0
01:1AA3 B1AA            	    95:   LDA (DOC_E),Y
01:1AA5 C5B8            	    96:   CMP DOC_T
01:1AA7 D01A            	    97:   BNE .df_n              ; free or another type
01:1AA9 A00B            	    98:   LDY #DOC_NAMELEN-1
                        	    99: .df_c:
01:1AAB B1A2            	   100:   LDA (DOC_P),Y
01:1AAD 85AD            	   101:   STA DOC_I              ; (temporary)
01:1AAF C8              	   102:   INY                    ; name in the entry at +4
01:1AB0 C8              	   103:   INY
01:1AB1 C8              	   104:   INY
01:1AB2 C8              	   105:   INY
01:1AB3 B1AA            	   106:   LDA (DOC_E),Y
01:1AB5 C5AD            	   107:   CMP DOC_I
01:1AB7 D00A            	   108:   BNE .df_n
01:1AB9 88              	   109:   DEY                    ; back to the previous character
01:1ABA 88              	   110:   DEY
01:1ABB 88              	   111:   DEY
01:1ABC 88              	   112:   DEY
01:1ABD 88              	   113:   DEY
01:1ABE 10EB            	   114:   BPL .df_c
01:1AC0 68              	   115:   PLA
01:1AC1 18              	   116:   CLC
01:1AC2 60              	   117:   RTS
                        	   118: .df_n:
01:1AC3 68              	   119:   PLA
01:1AC4 1A              	   120:   INC A
01:1AC5 C910            	   121:   CMP #DOC_SLOTS+1
01:1AC7 D0D4            	   122:   BNE .df_k
01:1AC9 38              	   123:   SEC
01:1ACA 60              	   124:   RTS
                        	   125: 
                        	   126: ; DOC_FREE: C=0 and A = first free slot, C=1 index full
                        	   127: DOC_FREE:
01:1ACB A901            	   128:   LDA #1
                        	   129: .dfr_k:
01:1ACD 20871A          	   130:   JSR DOC_ENTRY
01:1AD0 A000            	   131:   LDY #0
01:1AD2 B1AA            	   132:   LDA (DOC_E),Y
01:1AD4 F009            	   133:   BEQ .dfr_y
01:1AD6 A5AC            	   134:   LDA DOC_K
01:1AD8 1A              	   135:   INC A
01:1AD9 C910            	   136:   CMP #DOC_SLOTS+1
01:1ADB D0F0            	   137:   BNE .dfr_k
01:1ADD 38              	   138:   SEC
01:1ADE 60              	   139:   RTS
                        	   140: .dfr_y:
01:1ADF A5AC            	   141:   LDA DOC_K
01:1AE1 18              	   142:   CLC
01:1AE2 60              	   143:   RTS
                        	   144: 
                        	   145: ; DOC_SETENT: entry of slot A = type DOC_T, length DOC_LEN, name (DOC_P) (12 bytes)
                        	   146: DOC_SETENT:
01:1AE3 20871A          	   147:   JSR DOC_ENTRY
01:1AE6 A000            	   148:   LDY #0
01:1AE8 A5B8            	   149:   LDA DOC_T
01:1AEA 91AA            	   150:   STA (DOC_E),Y
01:1AEC C8              	   151:   INY
01:1AED A5B9            	   152:   LDA DOC_LEN
01:1AEF 91AA            	   153:   STA (DOC_E),Y
01:1AF1 C8              	   154:   INY
01:1AF2 A5BA            	   155:   LDA DOC_LEN+1
01:1AF4 91AA            	   156:   STA (DOC_E),Y
01:1AF6 C8              	   157:   INY
01:1AF7 A900            	   158:   LDA #0
01:1AF9 91AA            	   159:   STA (DOC_E),Y
01:1AFB A000            	   160:   LDY #0                 ; name: (DOC_P)+0..11 -> entry +4..15
                        	   161: .dse_n:
01:1AFD B1A2            	   162:   LDA (DOC_P),Y
01:1AFF C8              	   163:   INY
01:1B00 C8              	   164:   INY
01:1B01 C8              	   165:   INY
01:1B02 C8              	   166:   INY
01:1B03 91AA            	   167:   STA (DOC_E),Y
01:1B05 88              	   168:   DEY
01:1B06 88              	   169:   DEY
01:1B07 88              	   170:   DEY
01:1B08 C00C            	   171:   CPY #DOC_NAMELEN
01:1B0A D0F1            	   172:   BNE .dse_n
01:1B0C 60              	   173:   RTS
                        	   174: 
                        	   175: ; DOC_SECT: SD_LBA = DOC_BASE + DOC_K*40 + DOC_I
                        	   176: DOC_SECT:
01:1B0D 9C1803          	   177:   STZ SD_LBA+2
01:1B10 9C1903          	   178:   STZ SD_LBA+3
01:1B13 A5AC            	   179:   LDA DOC_K
01:1B15 8D1603          	   180:   STA SD_LBA
01:1B18 9C1703          	   181:   STZ SD_LBA+1
01:1B1B 0E1603          	   182:   ASL SD_LBA             ; k*8
01:1B1E 2E1703          	   183:   ROL SD_LBA+1
01:1B21 0E1603          	   184:   ASL SD_LBA
01:1B24 2E1703          	   185:   ROL SD_LBA+1
01:1B27 0E1603          	   186:   ASL SD_LBA
01:1B2A 2E1703          	   187:   ROL SD_LBA+1
01:1B2D AD1703          	   188:   LDA SD_LBA+1           ; + k*32 = 4 * (k*8)
01:1B30 48              	   189:   PHA
01:1B31 AD1603          	   190:   LDA SD_LBA
01:1B34 48              	   191:   PHA
01:1B35 0E1603          	   192:   ASL SD_LBA
01:1B38 2E1703          	   193:   ROL SD_LBA+1
01:1B3B 0E1603          	   194:   ASL SD_LBA
01:1B3E 2E1703          	   195:   ROL SD_LBA+1
01:1B41 18              	   196:   CLC
01:1B42 68              	   197:   PLA
01:1B43 6D1603          	   198:   ADC SD_LBA
01:1B46 8D1603          	   199:   STA SD_LBA
01:1B49 68              	   200:   PLA
01:1B4A 6D1703          	   201:   ADC SD_LBA+1
01:1B4D 8D1703          	   202:   STA SD_LBA+1
01:1B50 18              	   203:   CLC
01:1B51 AD1603          	   204:   LDA SD_LBA
01:1B54 65AD            	   205:   ADC DOC_I
01:1B56 8D1603          	   206:   STA SD_LBA
01:1B59 AD1703          	   207:   LDA SD_LBA+1
01:1B5C 6940            	   208:   ADC #>DOC_BASE
01:1B5E 8D1703          	   209:   STA SD_LBA+1
01:1B61 60              	   210:   RTS
                        	   211: 
                        	   212: DOC_LBA0:
01:1B62 9C1603          	   213:   STZ SD_LBA
01:1B65 A940            	   214:   LDA #>DOC_BASE
01:1B67 8D1703          	   215:   STA SD_LBA+1
01:1B6A 9C1803          	   216:   STZ SD_LBA+2
01:1B6D 9C1903          	   217:   STZ SD_LBA+3
01:1B70 60              	   218:   RTS
                        	   219: 
                        	   220: ; DOC_XFER: DOC_K = slot, A = RAM page of the data, X/Y = length (lo/hi), C=0 read, C=1 write
                        	   221: ; Transfers ceil(length / 512) sectors. C=1 SD error
                        	   222: DOC_XFER:
01:1B71 85AF            	   223:   STA DOC_PG
01:1B73 08              	   224:   PHP
01:1B74 8A              	   225:   TXA                    ; sectors = (length + 511) / 512
01:1B75 18              	   226:   CLC
01:1B76 69FF            	   227:   ADC #$FF
01:1B78 98              	   228:   TYA
01:1B79 6901            	   229:   ADC #$01
01:1B7B 4A              	   230:   LSR
01:1B7C 85AE            	   231:   STA DOC_N
01:1B7E 64AD            	   232:   STZ DOC_I
01:1B80 28              	   233:   PLP
01:1B81 B017            	   234:   BCS .dx_w
                        	   235: .dx_r:
01:1B83 A5AD            	   236:   LDA DOC_I
01:1B85 C5AE            	   237:   CMP DOC_N
01:1B87 B028            	   238:   BCS .dx_ok
01:1B89 200D1B          	   239:   JSR DOC_SECT
01:1B8C A200            	   240:   LDX #0
01:1B8E A4AF            	   241:   LDY DOC_PG
01:1B90 2018FD          	   242:   JSR JT_SD_READ
01:1B93 B01D            	   243:   BCS .dx_x
01:1B95 20B31B          	   244:   JSR .dx_next
01:1B98 80E9            	   245:   BRA .dx_r
                        	   246: .dx_w:
01:1B9A A5AD            	   247:   LDA DOC_I
01:1B9C C5AE            	   248:   CMP DOC_N
01:1B9E B011            	   249:   BCS .dx_ok
01:1BA0 200D1B          	   250:   JSR DOC_SECT
01:1BA3 A200            	   251:   LDX #0
01:1BA5 A4AF            	   252:   LDY DOC_PG
01:1BA7 201BFD          	   253:   JSR JT_SD_WRITE
01:1BAA B006            	   254:   BCS .dx_x
01:1BAC 20B31B          	   255:   JSR .dx_next
01:1BAF 80E9            	   256:   BRA .dx_w
                        	   257: .dx_ok:
01:1BB1 18              	   258:   CLC
                        	   259: .dx_x:
01:1BB2 60              	   260:   RTS
                        	   261: .dx_next:
01:1BB3 E6AD            	   262:   INC DOC_I
01:1BB5 E6AF            	   263:   INC DOC_PG
01:1BB7 E6AF            	   264:   INC DOC_PG
01:1BB9 4C6A18          	   265:   JMP KB_POLL
                        	   266: 
                        	   267: DOC_MAGIC:
01:1BBC 444F4353        	   268:   .byte "DOCS",1,DOC_SLOTS
01:1BC0 01
01:1BC1 0F
                        	   269: 

