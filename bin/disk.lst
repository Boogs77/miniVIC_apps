                        	  1057:  .include "lib/stream.asm"

Source: "lib\stream.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   STREAM.ASM  -  a document written / read byte by byte      ;
                        	     4: ;                                                              ;
                        	     5: ;   Through a 512-byte sector buffer, one sector at a time,    ;
                        	     6: ;   in the slot DOC_K of the document area (lib/docs.asm).     ;
                        	     7: ;   Uses: zp $E4-$EB, RAM $0800-$09FF (ST_BUF)                 ;
                        	     8: ;                                                              ;
                        	     9: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    10: 
                        	    11: ST_BUF      = $0800    ; sector buffer (page aligned)
                        	    12: ST_POS      = $E4      ; 2 bytes: position in ST_BUF
                        	    13: ST_SEC      = $E6      ; sector of the document
                        	    14: ST_LEFT     = $E7      ; 2 bytes: bytes still to read
                        	    15: ST_ERR      = $E9      ; 1 = SD error or too big
                        	    16: ST_P        = $EA      ; 2 bytes
                        	    17: 
                        	    18: ; ST_WOPEN: start writing the document DOC_K
                        	    19: ST_WOPEN:
01:1BC2 64E4            	    20:   STZ ST_POS
01:1BC4 64E5            	    21:   STZ ST_POS+1
01:1BC6 64E6            	    22:   STZ ST_SEC
01:1BC8 64E9            	    23:   STZ ST_ERR
01:1BCA 60              	    24:   RTS
                        	    25: 
                        	    26: ; ST_PUT: A to the document. Keeps A, X, Y
                        	    27: ST_PUT:
01:1BCB 48              	    28:   PHA
01:1BCC DA              	    29:   PHX
01:1BCD 5A              	    30:   PHY
01:1BCE 48              	    31:   PHA
01:1BCF A5E4            	    32:   LDA ST_POS
01:1BD1 85EA            	    33:   STA ST_P
01:1BD3 A5E5            	    34:   LDA ST_POS+1
01:1BD5 18              	    35:   CLC
01:1BD6 6908            	    36:   ADC #>ST_BUF
01:1BD8 85EB            	    37:   STA ST_P+1
01:1BDA 68              	    38:   PLA
01:1BDB 92EA            	    39:   STA (ST_P)
01:1BDD E6E4            	    40:   INC ST_POS
01:1BDF D00B            	    41:   BNE .sp_x
01:1BE1 E6E5            	    42:   INC ST_POS+1
01:1BE3 A5E5            	    43:   LDA ST_POS+1
01:1BE5 C902            	    44:   CMP #2
01:1BE7 D003            	    45:   BNE .sp_x
01:1BE9 20F01B          	    46:   JSR ST_FLUSH
                        	    47: .sp_x:
01:1BEC 7A              	    48:   PLY
01:1BED FA              	    49:   PLX
01:1BEE 68              	    50:   PLA
01:1BEF 60              	    51:   RTS
                        	    52: 
                        	    53: ; ST_FLUSH: the buffer (ST_POS bytes) to sector ST_SEC, then an empty buffer
                        	    54: ST_FLUSH:
01:1BF0 A5E4            	    55:   LDA ST_POS
01:1BF2 05E5            	    56:   ORA ST_POS+1
01:1BF4 F01E            	    57:   BEQ .sf_x
01:1BF6 A5E6            	    58:   LDA ST_SEC
01:1BF8 C928            	    59:   CMP #DOC_SECTS
01:1BFA B00E            	    60:   BCS .sf_big
01:1BFC 85AD            	    61:   STA DOC_I
01:1BFE 200D1B          	    62:   JSR DOC_SECT
01:1C01 A200            	    63:   LDX #<ST_BUF
01:1C03 A008            	    64:   LDY #>ST_BUF
01:1C05 201BFD          	    65:   JSR JT_SD_WRITE
01:1C08 9004            	    66:   BCC .sf_n
                        	    67: .sf_big:
01:1C0A A901            	    68:   LDA #1
01:1C0C 85E9            	    69:   STA ST_ERR
                        	    70: .sf_n:
01:1C0E E6E6            	    71:   INC ST_SEC
01:1C10 64E4            	    72:   STZ ST_POS
01:1C12 64E5            	    73:   STZ ST_POS+1
                        	    74: .sf_x:
01:1C14 60              	    75:   RTS
                        	    76: 
                        	    77: ; ST_WCLOSE: the last part; DOC_LEN = length. C=1 SD error or more than 20 KB
                        	    78: ST_WCLOSE:
01:1C15 A5E6            	    79:   LDA ST_SEC             ; length = sectors * 512 + position
01:1C17 0A              	    80:   ASL
01:1C18 18              	    81:   CLC
01:1C19 65E5            	    82:   ADC ST_POS+1
01:1C1B 85BA            	    83:   STA DOC_LEN+1
01:1C1D A5E4            	    84:   LDA ST_POS
01:1C1F 85B9            	    85:   STA DOC_LEN
01:1C21 20F01B          	    86:   JSR ST_FLUSH
01:1C24 A5E9            	    87:   LDA ST_ERR
01:1C26 C901            	    88:   CMP #1                 ; C=1 if ST_ERR
01:1C28 60              	    89:   RTS
                        	    90: 
                        	    91: ; ST_ROPEN: start reading the document DOC_K of DOC_LEN bytes
                        	    92: ST_ROPEN:
01:1C29 A5B9            	    93:   LDA DOC_LEN
01:1C2B 85E7            	    94:   STA ST_LEFT
01:1C2D A5BA            	    95:   LDA DOC_LEN+1
01:1C2F 85E8            	    96:   STA ST_LEFT+1
01:1C31 64E6            	    97:   STZ ST_SEC
01:1C33 64E9            	    98:   STZ ST_ERR
01:1C35 A902            	    99:   LDA #2                 ; (buffer empty: the first ST_GET reads a sector)
01:1C37 85E5            	   100:   STA ST_POS+1
01:1C39 64E4            	   101:   STZ ST_POS
01:1C3B 60              	   102:   RTS
                        	   103: 
                        	   104: ; ST_GET: A = next byte, C=1 at the end (ST_ERR = 1 if the SD failed). Keeps X, Y
                        	   105: ST_GET:
01:1C3C A5E7            	   106:   LDA ST_LEFT
01:1C3E 05E8            	   107:   ORA ST_LEFT+1
01:1C40 F047            	   108:   BEQ .sg_end
01:1C42 DA              	   109:   PHX
01:1C43 5A              	   110:   PHY
01:1C44 A5E5            	   111:   LDA ST_POS+1
01:1C46 C902            	   112:   CMP #2
01:1C48 9016            	   113:   BCC .sg_b
01:1C4A A5E6            	   114:   LDA ST_SEC             ; next sector
01:1C4C 85AD            	   115:   STA DOC_I
01:1C4E 200D1B          	   116:   JSR DOC_SECT
01:1C51 A200            	   117:   LDX #<ST_BUF
01:1C53 A008            	   118:   LDY #>ST_BUF
01:1C55 2018FD          	   119:   JSR JT_SD_READ
01:1C58 B025            	   120:   BCS .sg_err
01:1C5A E6E6            	   121:   INC ST_SEC
01:1C5C 64E4            	   122:   STZ ST_POS
01:1C5E 64E5            	   123:   STZ ST_POS+1
                        	   124: .sg_b:
01:1C60 A5E4            	   125:   LDA ST_POS
01:1C62 85EA            	   126:   STA ST_P
01:1C64 A5E5            	   127:   LDA ST_POS+1
01:1C66 18              	   128:   CLC
01:1C67 6908            	   129:   ADC #>ST_BUF
01:1C69 85EB            	   130:   STA ST_P+1
01:1C6B E6E4            	   131:   INC ST_POS
01:1C6D D002            	   132:   BNE .sg_d
01:1C6F E6E5            	   133:   INC ST_POS+1
                        	   134: .sg_d:
01:1C71 A5E7            	   135:   LDA ST_LEFT
01:1C73 D002            	   136:   BNE .sg_l
01:1C75 C6E8            	   137:   DEC ST_LEFT+1
                        	   138: .sg_l:
01:1C77 C6E7            	   139:   DEC ST_LEFT
01:1C79 B2EA            	   140:   LDA (ST_P)
01:1C7B 7A              	   141:   PLY
01:1C7C FA              	   142:   PLX
01:1C7D 18              	   143:   CLC
01:1C7E 60              	   144:   RTS
                        	   145: .sg_err:
01:1C7F 7A              	   146:   PLY
01:1C80 FA              	   147:   PLX
01:1C81 A901            	   148:   LDA #1
01:1C83 85E9            	   149:   STA ST_ERR
01:1C85 64E7            	   150:   STZ ST_LEFT
01:1C87 64E8            	   151:   STZ ST_LEFT+1
                        	   152: .sg_end:
01:1C89 38              	   153:   SEC
01:1C8A 60              	   154:   RTS
                        	   155: 

Source: "apps\disk.asm"
                        	  1058:  .include "lib/ui.asm"

Source: "lib\ui.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   UI.ASM  -  the parts every application shows the same way  ;
                        	     4: ;                                                              ;
                        	     5: ;   - PROMPT: a question on row 23, the answer typed after it  ;
                        	     6: ;   - YESNO:  a Y/N question on row 23                         ;
                        	     7: ;   - DOC_PICK: the list of the SD documents (open / delete)   ;
                        	     8: ;   Needs lib/keys, lib/vtext, lib/num, lib/docs.              ;
                        	     9: ;   Uses: zp $B0-$B7, RAM $02A0-$02C7 (UI_LINE),               ;
                        	    10: ;         $02D8-$02F7 (UI_BUF)                                 ;
                        	    11: ;                                                              ;
                        	    12: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    13: 
                        	    14: UI_LINE     = $02A0    ; 40 characters: a row being built (the apps may use it too)
                        	    15: UI_BUF      = $02D8    ; PROMPT answer (31 + $00)
                        	    16: UI_PTXT     = $B0      ; 2 bytes: question
                        	    17: UI_PMAX     = $B2      ; longest answer
                        	    18: UI_PUPC     = $B3      ; 1 = letters in upper case
                        	    19: UI_PLEN     = $B4      ; answer length
                        	    20: UI_SEL      = $B5      ; DOC_PICK: slot under the bar
                        	    21: UI_ROW      = $B6
                        	    22: UI_ANY      = $B7      ; DOC_PICK: 1 = every type can be opened, 0 = only DOC_T
                        	    23: 
                        	    24: ; PROMPT: question A/X on row 23, the answer in UI_BUF (it starts with what is already
                        	    25: ; there), UI_PMAX characters at most. C=0 and A = length (Enter), C=1 Esc
                        	    26: PROMPT:
01:1C8B 85B0            	    27:   STA UI_PTXT
01:1C8D 86B1            	    28:   STX UI_PTXT+1
01:1C8F A200            	    29:   LDX #0
                        	    30: .pr_len:
01:1C91 BDD802          	    31:   LDA UI_BUF,X
01:1C94 F003            	    32:   BEQ .pr_d
01:1C96 E8              	    33:   INX
01:1C97 80F8            	    34:   BRA .pr_len
                        	    35: .pr_d:
01:1C99 86B4            	    36:   STX UI_PLEN
                        	    37: .pr_draw:
01:1C9B A917            	    38:   LDA #23
01:1C9D 203419          	    39:   JSR VT_ROW
01:1CA0 64A4            	    40:   STZ VT_INV
01:1CA2 A5B0            	    41:   LDA UI_PTXT
01:1CA4 85A2            	    42:   STA VT_P
01:1CA6 A5B1            	    43:   LDA UI_PTXT+1
01:1CA8 85A3            	    44:   STA VT_P+1
01:1CAA 206819          	    45:   JSR VT_STR
