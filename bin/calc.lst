                        	   307: ; F_MUL: FA = FA * FB / 100. C=1 overflow
                        	   308: F_MUL:
01:2DAB 20AC2C          	   309:   JSR F_SIGNS
01:2DAE 20EA2C          	   310:   JSR MUL32
