01:2A04 204226          	   128:   JSR WAITKEY
01:2A07 29DF            	   129:   AND #$DF
01:2A09 C959            	   130:   CMP #'Y'
01:2A0B F002            	   131:   BEQ .yn_y
01:2A0D 38              	   132:   SEC
01:2A0E 60              	   133:   RTS
                        	   134: .yn_y:
01:2A0F 18              	   135:   CLC
01:2A10 60              	   136:   RTS
