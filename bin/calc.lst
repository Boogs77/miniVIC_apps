01:2981 A200            	    47:   LDX #0
                        	    48: .pr_c:
01:2983 E4B4            	    49:   CPX UI_PLEN
01:2985 F00B            	    50:   BEQ .pr_cur
01:2987 BDD802          	    51:   LDA UI_BUF,X
