01:29E5 18              	   101:   CLC
01:29E6 60              	   102:   RTS
                        	   103: .pr_esc:
01:29E7 38              	   104:   SEC
01:29E8 60              	   105:   RTS
                        	   106: 
                        	   107: ; UI_UPC: lower case letter -> upper case. Keeps X, Y
                        	   108: UI_UPC:
01:29E9 C961            	   109:   CMP #'a'
01:29EB 9006            	   110:   BCC .uu_x
01:29ED C97B            	   111:   CMP #'z'+1
01:29EF B002            	   112:   BCS .uu_x
01:29F1 29DF            	   113:   AND #$DF
                        	   114: .uu_x:
01:29F3 60              	   115:   RTS
                        	   116: 
                        	   117: ; YESNO: question A/X on row 23; C=0 if the answer is Y
                        	   118: YESNO:
01:29F4 DA              	   119:   PHX
01:29F5 48              	   120:   PHA
01:29F6 A917            	   121:   LDA #23
01:29F8 20CF26          	   122:   JSR VT_ROW
01:29FB 64A4            	   123:   STZ VT_INV
01:29FD 68              	   124:   PLA
01:29FE FA              	   125:   PLX
01:29FF A000            	   126:   LDY #0
