01:29CF E8              	    88:   INX
01:29D0 9ED802          	    89:   STZ UI_BUF,X
01:29D3 86B4            	    90:   STX UI_PLEN
01:29D5 8096            	    91:   BRA .pr_draw
                        	    92: .pr_bs:
01:29D7 A6B4            	    93:   LDX UI_PLEN
01:29D9 F0CD            	    94:   BEQ .pr_k
01:29DB CA              	    95:   DEX
