                        	  3012:  .include "lib/fix32.asm"

Source: "lib\fix32.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   FIX32.ASM  -  fixed point numbers: 32-bit signed x 100     ;
                        	     4: ;                                                              ;
                        	     5: ;   A number is an integer of hundredths: 1234 = 12.34, range  ;
                        	     6: ;   -21474836.47 .. 21474836.47. No floating point: + - * /    ;
                        	     7: ;   with shift and add, results truncated. Every routine that  ;
                        	     8: ;   can fail returns C=1 (overflow, division by zero, bad      ;
                        	     9: ;   number). The accumulator is FA, the operand FB.            ;
                        	    10: ;   Uses: zp $C0-$E3, RAM $05F0-$05FF (F_OUT)                  ;
                        	    11: ;                                                              ;
                        	    12: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    13: 
                        	    14: FA          = $C0      ; 4 bytes, little endian
                        	    15: FB          = $C4      ; 4 bytes
                        	    16: FP          = $C8      ; 8 bytes: product / dividend, then quotient
                        	    17: FR          = $D0      ; 4 bytes: remainder
                        	    18: FS          = $D4      ; sign of the result (1 = negative)
                        	    19: FD          = $D5      ; decimals read by F_PARSE ($FF = no point)
                        	    20: FT          = $D6      ; 8-bit divisor
                        	    21: F_PTR       = $D7      ; 2 bytes: text read by F_PARSE
                        	    22: FX          = $D9      ; 4 bytes: temporary
                        	    23: FBCD        = $DD      ; 5 bytes: BCD digits of F_FMT ($DD = lowest 2)
                        	    24: FY          = $E2      ; 2 bytes (plus FX): saved divisor
                        	    25: F_OUT       = $05F0    ; F_FMT result (up to 13 characters + $00)
                        	    26: 
                        	    27: ; F_ZERO: FA = 0
                        	    28: F_ZERO:
01:2BF4 64C0            	    29:   STZ FA
01:2BF6 64C1            	    30:   STZ FA+1
01:2BF8 64C2            	    31:   STZ FA+2
01:2BFA 64C3            	    32:   STZ FA+3
01:2BFC 60              	    33:   RTS
                        	    34: 
                        	    35: ; F_ISZ: Z=1 if FA = 0
                        	    36: F_ISZ:
01:2BFD A5C0            	    37:   LDA FA
01:2BFF 05C1            	    38:   ORA FA+1
01:2C01 05C2            	    39:   ORA FA+2
01:2C03 05C3            	    40:   ORA FA+3
01:2C05 60              	    41:   RTS
                        	    42: 
                        	    43: ; F_NEG / F_NEGB: FA = -FA / FB = -FB
                        	    44: F_NEG:
01:2C06 38              	    45:   SEC
01:2C07 A900            	    46:   LDA #0
01:2C09 E5C0            	    47:   SBC FA
01:2C0B 85C0            	    48:   STA FA
01:2C0D A900            	    49:   LDA #0
01:2C0F E5C1            	    50:   SBC FA+1
01:2C11 85C1            	    51:   STA FA+1
01:2C13 A900            	    52:   LDA #0
01:2C15 E5C2            	    53:   SBC FA+2
01:2C17 85C2            	    54:   STA FA+2
01:2C19 A900            	    55:   LDA #0
01:2C1B E5C3            	    56:   SBC FA+3
01:2C1D 85C3            	    57:   STA FA+3
01:2C1F 60              	    58:   RTS
                        	    59: F_NEGB:
01:2C20 38              	    60:   SEC
01:2C21 A900            	    61:   LDA #0
01:2C23 E5C4            	    62:   SBC FB
01:2C25 85C4            	    63:   STA FB
01:2C27 A900            	    64:   LDA #0
01:2C29 E5C5            	    65:   SBC FB+1
01:2C2B 85C5            	    66:   STA FB+1
01:2C2D A900            	    67:   LDA #0
01:2C2F E5C6            	    68:   SBC FB+2
01:2C31 85C6            	    69:   STA FB+2
01:2C33 A900            	    70:   LDA #0
01:2C35 E5C7            	    71:   SBC FB+3
01:2C37 85C7            	    72:   STA FB+3
01:2C39 60              	    73:   RTS
                        	    74: 
                        	    75: ; F_ADD / F_SUB: FA = FA + FB / FA - FB. C=1 overflow
                        	    76: F_ADD:
01:2C3A 18              	    77:   CLC
01:2C3B A5C0            	    78:   LDA FA
01:2C3D 65C4            	    79:   ADC FB
01:2C3F 85C0            	    80:   STA FA
01:2C41 A5C1            	    81:   LDA FA+1
01:2C43 65C5            	    82:   ADC FB+1
01:2C45 85C1            	    83:   STA FA+1
01:2C47 A5C2            	    84:   LDA FA+2
01:2C49 65C6            	    85:   ADC FB+2
01:2C4B 85C2            	    86:   STA FA+2
01:2C4D A5C3            	    87:   LDA FA+3
01:2C4F 65C7            	    88:   ADC FB+3
01:2C51 85C3            	    89:   STA FA+3
01:2C53 701F            	    90:   BVS F_ERR
01:2C55 18              	    91:   CLC
01:2C56 60              	    92:   RTS
                        	    93: F_SUB:
01:2C57 38              	    94:   SEC
01:2C58 A5C0            	    95:   LDA FA
01:2C5A E5C4            	    96:   SBC FB
01:2C5C 85C0            	    97:   STA FA
01:2C5E A5C1            	    98:   LDA FA+1
01:2C60 E5C5            	    99:   SBC FB+1
01:2C62 85C1            	   100:   STA FA+1
01:2C64 A5C2            	   101:   LDA FA+2
01:2C66 E5C6            	   102:   SBC FB+2
01:2C68 85C2            	   103:   STA FA+2
01:2C6A A5C3            	   104:   LDA FA+3
01:2C6C E5C7            	   105:   SBC FB+3
01:2C6E 85C3            	   106:   STA FA+3
01:2C70 7002            	   107:   BVS F_ERR
01:2C72 18              	   108:   CLC
01:2C73 60              	   109:   RTS
                        	   110: F_ERR:
01:2C74 38              	   111:   SEC
01:2C75 60              	   112:   RTS
                        	   113: 
                        	   114: ; F_CMP: compares FA with FB (signed). C=1 if FA >= FB, Z=1 if equal
                        	   115: F_CMP:
01:2C76 A5C0            	   116:   LDA FA
01:2C78 C5C4            	   117:   CMP FB
01:2C7A D012            	   118:   BNE .fc_ne
01:2C7C A5C1            	   119:   LDA FA+1
01:2C7E C5C5            	   120:   CMP FB+1
01:2C80 D00C            	   121:   BNE .fc_ne
01:2C82 A5C2            	   122:   LDA FA+2
01:2C84 C5C6            	   123:   CMP FB+2
01:2C86 D006            	   124:   BNE .fc_ne
01:2C88 A5C3            	   125:   LDA FA+3
01:2C8A C5C7            	   126:   CMP FB+3
01:2C8C F01D            	   127:   BEQ .fc_x              ; equal: Z=1, C=1
                        	   128: .fc_ne:
01:2C8E 38              	   129:   SEC                    ; signed compare of the whole numbers
01:2C8F A5C0            	   130:   LDA FA
01:2C91 E5C4            	   131:   SBC FB
01:2C93 A5C1            	   132:   LDA FA+1
01:2C95 E5C5            	   133:   SBC FB+1
01:2C97 A5C2            	   134:   LDA FA+2
01:2C99 E5C6            	   135:   SBC FB+2
01:2C9B A5C3            	   136:   LDA FA+3
01:2C9D E5C7            	   137:   SBC FB+3
01:2C9F 5002            	   138:   BVC .fc_v
01:2CA1 4980            	   139:   EOR #$80
                        	   140: .fc_v:
01:2CA3 0A              	   141:   ASL                    ; C = sign of the difference
01:2CA4 A901            	   142:   LDA #1                 ; Z=0
01:2CA6 9002            	   143:   BCC .fc_ge
01:2CA8 18              	   144:   CLC                    ; negative: FA < FB
01:2CA9 60              	   145:   RTS
                        	   146: .fc_ge:
01:2CAA 38              	   147:   SEC
                        	   148: .fc_x:
01:2CAB 60              	   149:   RTS
                        	   150: 
                        	   151: ; F_SIGNS: FA and FB made positive, FS = 1 if exactly one was negative
                        	   152: F_SIGNS:
01:2CAC 64D4            	   153:   STZ FS
01:2CAE A5C3            	   154:   LDA FA+3
01:2CB0 1005            	   155:   BPL .fs_b
01:2CB2 20062C          	   156:   JSR F_NEG
01:2CB5 E6D4            	   157:   INC FS
                        	   158: .fs_b:
01:2CB7 A5C7            	   159:   LDA FB+3
01:2CB9 1009            	   160:   BPL .fs_x
01:2CBB 20202C          	   161:   JSR F_NEGB
01:2CBE A5D4            	   162:   LDA FS
01:2CC0 4901            	   163:   EOR #1
01:2CC2 85D4            	   164:   STA FS
                        	   165: .fs_x:
01:2CC4 60              	   166:   RTS
                        	   167: 
                        	   168: ; F_SIGNR: FA = FP (low 32 bits) with the sign FS; C=1 if FP does not fit in 31 bits
                        	   169: F_SIGNR:
01:2CC5 A5CC            	   170:   LDA FP+4
01:2CC7 05CD            	   171:   ORA FP+5
01:2CC9 05CE            	   172:   ORA FP+6
01:2CCB 05CF            	   173:   ORA FP+7
01:2CCD D0A5            	   174:   BNE F_ERR
01:2CCF A5CB            	   175:   LDA FP+3
01:2CD1 30A1            	   176:   BMI F_ERR
01:2CD3 85C3            	   177:   STA FA+3
01:2CD5 A5CA            	   178:   LDA FP+2
01:2CD7 85C2            	   179:   STA FA+2
01:2CD9 A5C9            	   180:   LDA FP+1
01:2CDB 85C1            	   181:   STA FA+1
01:2CDD A5C8            	   182:   LDA FP
01:2CDF 85C0            	   183:   STA FA
01:2CE1 A5D4            	   184:   LDA FS
01:2CE3 F003            	   185:   BEQ .sr_x
01:2CE5 20062C          	   186:   JSR F_NEG
                        	   187: .sr_x:
01:2CE8 18              	   188:   CLC
01:2CE9 60              	   189:   RTS
                        	   190: 
                        	   191: ; MUL32: FP = FA * FB (unsigned, 64 bits)
                        	   192: MUL32:
01:2CEA A5C0            	   193:   LDA FA
01:2CEC 85C8            	   194:   STA FP
01:2CEE A5C1            	   195:   LDA FA+1
01:2CF0 85C9            	   196:   STA FP+1
01:2CF2 A5C2            	   197:   LDA FA+2
01:2CF4 85CA            	   198:   STA FP+2
01:2CF6 A5C3            	   199:   LDA FA+3
01:2CF8 85CB            	   200:   STA FP+3
01:2CFA 64CC            	   201:   STZ FP+4
01:2CFC 64CD            	   202:   STZ FP+5
01:2CFE 64CE            	   203:   STZ FP+6
01:2D00 64CF            	   204:   STZ FP+7
01:2D02 A220            	   205:   LDX #32
                        	   206: .m_l:
01:2D04 A5C8            	   207:   LDA FP
01:2D06 4A              	   208:   LSR
01:2D07 9019            	   209:   BCC .m_r
01:2D09 18              	   210:   CLC
01:2D0A A5CC            	   211:   LDA FP+4
01:2D0C 65C4            	   212:   ADC FB
01:2D0E 85CC            	   213:   STA FP+4
01:2D10 A5CD            	   214:   LDA FP+5
01:2D12 65C5            	   215:   ADC FB+1
01:2D14 85CD            	   216:   STA FP+5
01:2D16 A5CE            	   217:   LDA FP+6
01:2D18 65C6            	   218:   ADC FB+2
01:2D1A 85CE            	   219:   STA FP+6
01:2D1C A5CF            	   220:   LDA FP+7
01:2D1E 65C7            	   221:   ADC FB+3
01:2D20 85CF            	   222:   STA FP+7
                        	   223: .m_r:
01:2D22 66CF            	   224:   ROR FP+7
01:2D24 66CE            	   225:   ROR FP+6
01:2D26 66CD            	   226:   ROR FP+5
01:2D28 66CC            	   227:   ROR FP+4
01:2D2A 66CB            	   228:   ROR FP+3
01:2D2C 66CA            	   229:   ROR FP+2
01:2D2E 66C9            	   230:   ROR FP+1
01:2D30 66C8            	   231:   ROR FP
01:2D32 CA              	   232:   DEX
01:2D33 D0CF            	   233:   BNE .m_l
01:2D35 60              	   234:   RTS
                        	   235: 
                        	   236: ; DIVP8: FP = FP / FT (FT < 128), FR = remainder
                        	   237: DIVP8:
01:2D36 64D0            	   238:   STZ FR
01:2D38 A240            	   239:   LDX #64
                        	   240: .d8_l:
01:2D3A 06C8            	   241:   ASL FP
01:2D3C 26C9            	   242:   ROL FP+1
01:2D3E 26CA            	   243:   ROL FP+2
01:2D40 26CB            	   244:   ROL FP+3
01:2D42 26CC            	   245:   ROL FP+4
01:2D44 26CD            	   246:   ROL FP+5
01:2D46 26CE            	   247:   ROL FP+6
01:2D48 26CF            	   248:   ROL FP+7
01:2D4A 26D0            	   249:   ROL FR
01:2D4C A5D0            	   250:   LDA FR
