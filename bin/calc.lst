Source: "lib\num.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   NUM.ASM  -  16-bit numbers to decimal text                 ;
                        	     4: ;   Uses: zp $A5-$A9                                           ;
                        	     5: ;                                                              ;
                        	     6: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     7: 
                        	     8: NUM         = $A5      ; 2 bytes: number to convert (destroyed)
                        	     9: BCD         = $A7      ; 3 bytes: BCD result, $A7 = lowest 2 digits
                        	    10: 
                        	    11: ; BIN2BCD: NUM -> BCD (double dabble with decimal mode)
                        	    12: BIN2BCD:
01:2782 200526          	    13:   JSR KB_POLL
01:2785 64A7            	    14:   STZ BCD
01:2787 64A8            	    15:   STZ BCD+1
01:2789 64A9            	    16:   STZ BCD+2
01:278B A210            	    17:   LDX #16
01:278D F8              	    18:   SED
                        	    19: .bb_l:
01:278E 06A5            	    20:   ASL NUM
01:2790 26A6            	    21:   ROL NUM+1
01:2792 A5A7            	    22:   LDA BCD
01:2794 65A7            	    23:   ADC BCD
01:2796 85A7            	    24:   STA BCD
01:2798 A5A8            	    25:   LDA BCD+1
01:279A 65A8            	    26:   ADC BCD+1
01:279C 85A8            	    27:   STA BCD+1
01:279E A5A9            	    28:   LDA BCD+2
01:27A0 65A9            	    29:   ADC BCD+2
01:27A2 85A9            	    30:   STA BCD+2
01:27A4 CA              	    31:   DEX
01:27A5 D0E7            	    32:   BNE .bb_l
01:27A7 D8              	    33:   CLD
01:27A8 60              	    34:   RTS
                        	    35: 
                        	    36: ; NUMSTR: NUM -> 5 characters at (VT_P),Y.. with leading spaces (last digit always shown)
                        	    37: ; Y = first position; on exit Y = position after the number
                        	    38: NUMSTR:
01:27A9 208227          	    39:   JSR BIN2BCD
01:27AC 200526          	    40:   JSR KB_POLL            ; (BIN2BCD takes ~600 cycles)
01:27AF A200            	    41:   LDX #0                 ; X = 1 once a digit is not zero
01:27B1 A5A9            	    42:   LDA BCD+2
01:27B3 20D127          	    43:   JSR .ns_dig            ; ten thousands
01:27B6 A5A8            	    44:   LDA BCD+1
01:27B8 4A              	    45:   LSR
01:27B9 4A              	    46:   LSR
01:27BA 4A              	    47:   LSR
01:27BB 4A              	    48:   LSR
01:27BC 20D127          	    49:   JSR .ns_dig
01:27BF A5A8            	    50:   LDA BCD+1
01:27C1 20D127          	    51:   JSR .ns_dig
01:27C4 A5A7            	    52:   LDA BCD
01:27C6 4A              	    53:   LSR
01:27C7 4A              	    54:   LSR
01:27C8 4A              	    55:   LSR
01:27C9 4A              	    56:   LSR
01:27CA 20D127          	    57:   JSR .ns_dig
01:27CD A5A7            	    58:   LDA BCD
01:27CF A201            	    59:   LDX #1                 ; the last digit is always written
                        	    60: .ns_dig:
01:27D1 290F            	    61:   AND #$0F
01:27D3 D008            	    62:   BNE .ns_nz
01:27D5 E000            	    63:   CPX #0
01:27D7 D004            	    64:   BNE .ns_nz
01:27D9 A920            	    65:   LDA #' '
01:27DB 8004            	    66:   BRA .ns_put
                        	    67: .ns_nz:
01:27DD A201            	    68:   LDX #1
01:27DF 0930            	    69:   ORA #'0'
                        	    70: .ns_put:
01:27E1 91A2            	    71:   STA (VT_P),Y
01:27E3 C8              	    72:   INY
01:27E4 60              	    73:   RTS
                        	    74: 

Source: "apps\calc.asm"
                        	  3010:  .include "lib/docs.asm"

Source: "lib\docs.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   DOCS.ASM  -  documents in the SD document area             ;
                        	     4: ;                                                              ;
                        	     5: ;   Sector 16384 ($00800000, after the 255 program blocks)     ;
                        	     6: ;   is the index: +0 "DOCS", +4 version 1, +5 slots (15);      ;
                        	     7: ;   entry k (1-15) at k*32: +0 type (0 free, 1 text,           ;
                        	     8: ;   2 sheet, 3 card file),                                     ;
                        	     9: ;   +1/+2 length, +4..+15 name (12 chars, $00 padded).         ;
                        	    10: ;   Document k = 40 sectors (20 KB) from sector 16384 + k*40.  ;
                        	    11: ;   Sectors go through the BIOS (JT_SD_READ / JT_SD_WRITE).    ;
                        	    12: ;   Uses: zp $AA-$AF, $B8-$BA, RAM $0600-$07FF (index sector)  ;
                        	    13: ;                                                              ;
                        	    14: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    15: 
                        	    16: DOC_IDX     = $0600    ; index sector (512 bytes)
                        	    17: DOC_BASE    = $4000    ; sector 16384
                        	    18: DOC_SLOTS   = 15
                        	    19: DOC_SECTS   = 40       ; sectors per document
                        	    20: DOC_NAMELEN = 12
                        	    21: DOC_E       = $AA      ; 2 bytes: pointer to the index entry
                        	    22: DOC_K       = $AC      ; slot
                        	    23: DOC_I       = $AD      ; sector inside the document
                        	    24: DOC_N       = $AE      ; sectors to transfer
                        	    25: DOC_PG      = $AF      ; RAM page of the transfer
                        	    26: DOC_T       = $B8      ; document type of the application (1 text, 2 sheet, 3 card file)
                        	    27: DOC_LEN     = $B9      ; 2 bytes: length for DOC_SETENT
                        	    28: 
                        	    29: ; DOC_RDIDX: reads the index; a sector without "DOCS" becomes an empty index. C=1 SD error
                        	    30: DOC_RDIDX:
01:27E5 20FD28          	    31:   JSR DOC_LBA0
01:27E8 A200            	    32:   LDX #<DOC_IDX
01:27EA A006            	    33:   LDY #>DOC_IDX
01:27EC 2018FD          	    34:   JSR JT_SD_READ
01:27EF B00E            	    35:   BCS .dr_x
01:27F1 A203            	    36:   LDX #3
                        	    37: .dr_m:
01:27F3 BD0006          	    38:   LDA DOC_IDX,X
01:27F6 DD5729          	    39:   CMP DOC_MAGIC,X
01:27F9 D005            	    40:   BNE .dr_new
01:27FB CA              	    41:   DEX
01:27FC 10F5            	    42:   BPL .dr_m
01:27FE 18              	    43:   CLC
                        	    44: .dr_x:
01:27FF 60              	    45:   RTS
                        	    46: .dr_new:
01:2800 A200            	    47:   LDX #0
                        	    48: .dr_z:
01:2802 9E0006          	    49:   STZ DOC_IDX,X
01:2805 9E0007          	    50:   STZ DOC_IDX+$100,X
01:2808 E8              	    51:   INX
01:2809 D0F7            	    52:   BNE .dr_z
01:280B A205            	    53:   LDX #5
                        	    54: .dr_h:
01:280D BD5729          	    55:   LDA DOC_MAGIC,X
01:2810 9D0006          	    56:   STA DOC_IDX,X
01:2813 CA              	    57:   DEX
01:2814 10F7            	    58:   BPL .dr_h
01:2816 18              	    59:   CLC
01:2817 60              	    60:   RTS
                        	    61: 
                        	    62: ; DOC_WRIDX: writes the index. C=1 SD error
                        	    63: DOC_WRIDX:
01:2818 20FD28          	    64:   JSR DOC_LBA0
01:281B A200            	    65:   LDX #<DOC_IDX
01:281D A006            	    66:   LDY #>DOC_IDX
01:281F 4C1BFD          	    67:   JMP JT_SD_WRITE
                        	    68: 
                        	    69: ; DOC_ENTRY: A = slot (1-15) -> DOC_E = its index entry. Keeps X, Y
                        	    70: DOC_ENTRY:
01:2822 85AC            	    71:   STA DOC_K
01:2824 4A              	    72:   LSR
01:2825 4A              	    73:   LSR
01:2826 4A              	    74:   LSR
01:2827 18              	    75:   CLC
01:2828 6906            	    76:   ADC #>DOC_IDX
01:282A 85AB            	    77:   STA DOC_E+1
01:282C A5AC            	    78:   LDA DOC_K
01:282E 0A              	    79:   ASL
01:282F 0A              	    80:   ASL
01:2830 0A              	    81:   ASL
01:2831 0A              	    82:   ASL
01:2832 0A              	    83:   ASL
01:2833 85AA            	    84:   STA DOC_E              ; (DOC_IDX is page aligned)
01:2835 60              	    85:   RTS
                        	    86: 
                        	    87: ; DOC_FIND: name of 12 bytes at (DOC_P) and type DOC_T -> C=0 and A = slot, C=1 not found
                        	    88: DOC_P       = VT_P     ; (shares the string pointer)
                        	    89: DOC_FIND:
01:2836 A901            	    90:   LDA #1
                        	    91: .df_k:
01:2838 48              	    92:   PHA
01:2839 202228          	    93:   JSR DOC_ENTRY
01:283C A000            	    94:   LDY #0
01:283E B1AA            	    95:   LDA (DOC_E),Y
01:2840 C5B8            	    96:   CMP DOC_T
01:2842 D01A            	    97:   BNE .df_n              ; free or another type
01:2844 A00B            	    98:   LDY #DOC_NAMELEN-1
                        	    99: .df_c:
01:2846 B1A2            	   100:   LDA (DOC_P),Y
01:2848 85AD            	   101:   STA DOC_I              ; (temporary)
01:284A C8              	   102:   INY                    ; name in the entry at +4
01:284B C8              	   103:   INY
01:284C C8              	   104:   INY
01:284D C8              	   105:   INY
01:284E B1AA            	   106:   LDA (DOC_E),Y
01:2850 C5AD            	   107:   CMP DOC_I
01:2852 D00A            	   108:   BNE .df_n
01:2854 88              	   109:   DEY                    ; back to the previous character
01:2855 88              	   110:   DEY
01:2856 88              	   111:   DEY
01:2857 88              	   112:   DEY
01:2858 88              	   113:   DEY
01:2859 10EB            	   114:   BPL .df_c
01:285B 68              	   115:   PLA
01:285C 18              	   116:   CLC
01:285D 60              	   117:   RTS
                        	   118: .df_n:
01:285E 68              	   119:   PLA
01:285F 1A              	   120:   INC A
01:2860 C910            	   121:   CMP #DOC_SLOTS+1
01:2862 D0D4            	   122:   BNE .df_k
01:2864 38              	   123:   SEC
01:2865 60              	   124:   RTS
                        	   125: 
                        	   126: ; DOC_FREE: C=0 and A = first free slot, C=1 index full
                        	   127: DOC_FREE:
01:2866 A901            	   128:   LDA #1
                        	   129: .dfr_k:
01:2868 202228          	   130:   JSR DOC_ENTRY
01:286B A000            	   131:   LDY #0
01:286D B1AA            	   132:   LDA (DOC_E),Y
01:286F F009            	   133:   BEQ .dfr_y
01:2871 A5AC            	   134:   LDA DOC_K
01:2873 1A              	   135:   INC A
01:2874 C910            	   136:   CMP #DOC_SLOTS+1
01:2876 D0F0            	   137:   BNE .dfr_k
01:2878 38              	   138:   SEC
01:2879 60              	   139:   RTS
                        	   140: .dfr_y:
01:287A A5AC            	   141:   LDA DOC_K
01:287C 18              	   142:   CLC
01:287D 60              	   143:   RTS
                        	   144: 
                        	   145: ; DOC_SETENT: entry of slot A = type DOC_T, length DOC_LEN, name (DOC_P) (12 bytes)
                        	   146: DOC_SETENT:
01:287E 202228          	   147:   JSR DOC_ENTRY
01:2881 A000            	   148:   LDY #0
01:2883 A5B8            	   149:   LDA DOC_T
01:2885 91AA            	   150:   STA (DOC_E),Y
01:2887 C8              	   151:   INY
01:2888 A5B9            	   152:   LDA DOC_LEN
01:288A 91AA            	   153:   STA (DOC_E),Y
01:288C C8              	   154:   INY
