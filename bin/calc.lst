Source: "lib\keys.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   KEYS.ASM  -  key queue on top of the BIOS                  ;
                        	     4: ;                                                              ;
                        	     5: ;   The PS/2 board keeps one byte: a byte not read within      ;
                        	     6: ;   ~1 ms is lost (a lost $F0 turns a release into a second    ;
                        	     7: ;   press). Two ways in, both on: the CA1 interrupt of the     ;
                        	     8: ;   keyboard VIA (IRQ -> BIOS -> JMP KB_IRQ at $0FA0) reads    ;
                        	     9: ;   every byte at once; KB_POLL, called by the long loops,     ;
                        	    10: ;   does the same if the IRQ line is not there. Assembled      ;
                        	    11: ;   with -DKB_NOIRQ=1 only the polling is left.                ;
                        	    12: ;   The keys decoded by the BIOS go into a 32-key queue,       ;
                        	    13: ;   GETKEY takes them out. KB_EXIT before leaving the app.     ;
                        	    14: ;   An app that uses the serial line itself defines KB_SERBUF  ;
                        	    15: ;   (256-byte ring): the received bytes go there, not among    ;
                        	    16: ;   the keys (JT_CHRIN reads the serial line first: a byte it  ;
                        	    17: ;   returns while CA1 is still set came from the serial line). ;
                        	    18: ;   Uses: zp $A0-$A1 ($F0-$F1 with KB_SERBUF), RAM $05C0-$05DF ;
                        	    19: ;                                                              ;
                        	    20: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    21: 
                        	    22: KQ          = $05C0    ; 32-key ring
                        	    23: KQ_MASK     = $1F
                        	    24: KQR         = $A0      ; read index
                        	    25: KQW         = $A1      ; write index
                        	    26: KB_IFR      = $D18D    ; keyboard VIA: interrupt flags (bit 1 = CA1)
                        	    27: KB_IER      = $D18E    ;               interrupt enable
                        	    28: KB_SRR      = $F0      ; serial ring (KB_SERBUF): read index
                        	    29: KB_SRW      = $F1      ;                          write index
                        	    30: 
                        	    31: ; KB_INIT: extended keyboard, empty queue, CA1 interrupt on
                        	    32: KB_INIT:
01:25CA 78              	    33:   SEI
01:25CB A901            	    34:   LDA #1
01:25CD 2021FD          	    35:   JSR JT_KB_MODE
01:25D0 64A0            	    36:   STZ KQR
01:25D2 64A1            	    37:   STZ KQW
01:25D4 64F0            	    38:   STZ KB_SRR
01:25D6 64F1            	    39:   STZ KB_SRW
                        	    40:  .ifndef KB_NOIRQ
01:25D8 A94C            	    41:   LDA #$4C               ; JMP KB_IRQ in the RAM vector of the BIOS
01:25DA 8DA00F          	    42:   STA IRQ_VEC
01:25DD A9FA            	    43:   LDA #<KB_IRQ
01:25DF 8DA10F          	    44:   STA IRQ_VEC+1
01:25E2 A925            	    45:   LDA #>KB_IRQ
01:25E4 8DA20F          	    46:   STA IRQ_VEC+2
01:25E7 A982            	    47:   LDA #$82               ; CA1 interrupt enabled
01:25E9 8D8ED1          	    48:   STA KB_IER
01:25EC 58              	    49:   CLI
                        	    50:  .endif
01:25ED 60              	    51:   RTS
                        	    52: 
                        	    53: ; KB_EXIT: interrupt off again (the BIOS menu works by polling)
                        	    54: KB_EXIT:
01:25EE 78              	    55:   SEI
01:25EF A902            	    56:   LDA #$02
01:25F1 8D8ED1          	    57:   STA KB_IER
01:25F4 A960            	    58:   LDA #$60               ; RTS
01:25F6 8DA00F          	    59:   STA IRQ_VEC
01:25F9 60              	    60:   RTS
                        	    61: 
                        	    62: ; KB_IRQ: called by the BIOS IRQ handler (A, X, Y already saved)
                        	    63: KB_IRQ:
                        	    64:  .ifdef KB_SERBUF
                        	    65:   JMP KB_TAKE            ; the keyboard or the serial line
                        	    66:  .else
01:25FA AD8DD1          	    67:   LDA KB_IFR
01:25FD 2902            	    68:   AND #$02
01:25FF F003            	    69:   BEQ .ki_x
01:2601 201226          	    70:   JSR KB_TAKE
                        	    71: .ki_x:
01:2604 60              	    72:   RTS
                        	    73:  .endif
                        	    74: 
                        	    75: ; KB_POLL: one BIOS poll with the interrupt held off. Keeps A, X, Y and the I flag
                        	    76: KB_POLL:
01:2605 08              	    77:   PHP
01:2606 78              	    78:   SEI
01:2607 48              	    79:   PHA
01:2608 DA              	    80:   PHX
01:2609 5A              	    81:   PHY
01:260A 201226          	    82:   JSR KB_TAKE
01:260D 7A              	    83:   PLY
01:260E FA              	    84:   PLX
01:260F 68              	    85:   PLA
01:2610 28              	    86:   PLP
01:2611 60              	    87:   RTS
                        	    88: 
                        	    89: ; KB_TAKE: a key from the BIOS goes into the queue (full queue: dropped)
                        	    90: KB_TAKE:
                        	    91:  .ifdef KB_SERBUF
                        	    92: .kt_rx:
                        	    93:   LDA ACIA_STATUS        ; received bytes first, into their ring
                        	    94:   AND #$08
                        	    95:   BEQ .kt_kb
                        	    96:   LDA ACIA_DATA
                        	    97:   JSR KB_SERPUT
                        	    98:   BRA .kt_rx
                        	    99: .kt_kb:
                        	   100:   LDA KB_IFR
                        	   101:   AND #$02
                        	   102:   BEQ .kt_x
                        	   103:   JSR JT_CHRIN
                        	   104:   BCC .kt_x
                        	   105:   PHA
                        	   106:   LDA KB_IFR             ; CA1 still set: the BIOS took a serial byte, not the key
                        	   107:   AND #$02
                        	   108:   BEQ .kt_key
                        	   109:   PLA
                        	   110:   JSR KB_SERPUT
                        	   111:   BRA .kt_rx
                        	   112: .kt_key:
                        	   113:   PLA
                        	   114:  .else
01:2612 2003FD          	   115:   JSR JT_CHRIN
01:2615 900F            	   116:   BCC .kt_x
                        	   117:  .endif
01:2617 A6A1            	   118:   LDX KQW
01:2619 9DC005          	   119:   STA KQ,X
01:261C 8A              	   120:   TXA
01:261D 1A              	   121:   INC A
01:261E 291F            	   122:   AND #KQ_MASK
01:2620 C5A0            	   123:   CMP KQR
01:2622 F002            	   124:   BEQ .kt_x              ; full
01:2624 85A1            	   125:   STA KQW
                        	   126: .kt_x:
01:2626 60              	   127:   RTS
                        	   128: 
                        	   129:  .ifdef KB_SERBUF
                        	   130: ; KB_SERPUT: A into the serial ring (full: dropped)
                        	   131: KB_SERPUT:
                        	   132:   LDX KB_SRW
                        	   133:   STA KB_SERBUF,X
                        	   134:   INX
                        	   135:   CPX KB_SRR
                        	   136:   BEQ .ks_x
                        	   137:   STX KB_SRW
                        	   138: .ks_x:
                        	   139:   RTS
                        	   140: 
                        	   141: ; SERGET: C=1 and A = next received byte, C=0 none
                        	   142: SERGET:
                        	   143:   JSR KB_POLL
                        	   144:   LDX KB_SRR
                        	   145:   CPX KB_SRW
                        	   146:   BEQ .sg_n
                        	   147:   LDA KB_SERBUF,X
                        	   148:   INC KB_SRR
                        	   149:   SEC
                        	   150:   RTS
                        	   151: .sg_n:
                        	   152:   CLC
                        	   153:   RTS
                        	   154:  .endif
                        	   155: 
                        	   156: ; GETKEY: C=1 and A = key, C=0 queue empty (after one poll). Keeps X, Y
                        	   157: GETKEY:
01:2627 200526          	   158:   JSR KB_POLL
01:262A A5A0            	   159:   LDA KQR
01:262C C5A1            	   160:   CMP KQW
01:262E F010            	   161:   BEQ .gk_n
01:2630 DA              	   162:   PHX
01:2631 AA              	   163:   TAX
01:2632 BDC005          	   164:   LDA KQ,X
01:2635 48              	   165:   PHA
01:2636 8A              	   166:   TXA
01:2637 1A              	   167:   INC A
01:2638 291F            	   168:   AND #KQ_MASK
01:263A 85A0            	   169:   STA KQR
01:263C 68              	   170:   PLA
01:263D FA              	   171:   PLX
01:263E 38              	   172:   SEC
01:263F 60              	   173:   RTS
                        	   174: .gk_n:
01:2640 18              	   175:   CLC
01:2641 60              	   176:   RTS
                        	   177: 
                        	   178: ; WAITKEY: A = next key
                        	   179: WAITKEY:
01:2642 202726          	   180:   JSR GETKEY
01:2645 90FB            	   181:   BCC WAITKEY
01:2647 60              	   182:   RTS
                        	   183: 
                        	   184: ; KEYREADY: C=1 if a key is waiting in the queue
                        	   185: KEYREADY:
01:2648 200526          	   186:   JSR KB_POLL
01:264B A5A0            	   187:   LDA KQR
01:264D C5A1            	   188:   CMP KQW
01:264F 18              	   189:   CLC
01:2650 F001            	   190:   BEQ .kr_x
01:2652 38              	   191:   SEC
                        	   192: .kr_x:
01:2653 60              	   193:   RTS
                        	   194: 

Source: "apps\calc.asm"
                        	  3008:  .include "lib/vtext.asm"

Source: "lib\vtext.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   VTEXT.ASM  -  40 x 24 text screen on the TMS9918A          ;
                        	     4: ;                                                              ;
                        	     5: ;   BIOS text mode (VDP interrupt off, so the main loop can    ;
                        	     6: ;   write the VRAM at any time). VT_INIT also builds the       ;
                        	     7: ;   inverse font: codes $80-$FF = codes $00-$7F inverted,      ;
                        	     8: ;   used for the cursor, the status bar and the marked block.  ;
                        	     9: ;   Long loops call KB_POLL (lib/keys.asm).                    ;
                        	    10: ;   Uses: zp $A2-$A4, RAM $0800-$0BFF only inside VT_INIT      ;
                        	    11: ;                                                              ;
                        	    12: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    13: 
                        	    14: VT_P        = $A2      ; 2 bytes: string pointer
                        	    15: VT_INV      = $A4      ; ORed to every character of VT_STR ($80 = inverse)
                        	    16: VT_FONTTMP  = $0800    ; RAM copy of the font (1 KB, only during VT_INIT)
                        	    17: 
                        	    18: ; VT_INIT: text mode of the BIOS, inverse font, empty screen
                        	    19: VT_INIT:
01:2654 2009FD          	    20:   JSR JT_INIT_CRT
01:2657 A900            	    21:   LDA #<VRAM_FONT        ; read patterns 0-127 (1 KB)
01:2659 A200            	    22:   LDX #>VRAM_FONT
01:265B 20C826          	    23:   JSR VT_RADDR
01:265E A200            	    24:   LDX #0                 ; (the VRAM address increases by itself)
                        	    25: .vi_r0:
01:2660 AD00B0          	    26:   LDA VDP_DATA
01:2663 9D0008          	    27:   STA VT_FONTTMP,X
01:2666 E8              	    28:   INX
01:2667 D0F7            	    29:   BNE .vi_r0
                        	    30: .vi_r1:
01:2669 AD00B0          	    31:   LDA VDP_DATA
01:266C 9D0009          	    32:   STA VT_FONTTMP+$100,X
01:266F E8              	    33:   INX
01:2670 D0F7            	    34:   BNE .vi_r1
                        	    35: .vi_r2:
01:2672 AD00B0          	    36:   LDA VDP_DATA
01:2675 9D000A          	    37:   STA VT_FONTTMP+$200,X
01:2678 E8              	    38:   INX
01:2679 D0F7            	    39:   BNE .vi_r2
                        	    40: .vi_r3:
01:267B AD00B0          	    41:   LDA VDP_DATA
01:267E 9D000B          	    42:   STA VT_FONTTMP+$300,X
01:2681 E8              	    43:   INX
01:2682 D0F7            	    44:   BNE .vi_r3
01:2684 A900            	    45:   LDA #<(VRAM_FONT+$400) ; inverted copy at pattern 128
01:2686 A204            	    46:   LDX #>(VRAM_FONT+$400)
01:2688 20BE26          	    47:   JSR VT_WADDR
01:268B A200            	    48:   LDX #0
                        	    49: .vi_w0:
01:268D BD0008          	    50:   LDA VT_FONTTMP,X
01:2690 49FF            	    51:   EOR #$FF
01:2692 8D00B0          	    52:   STA VDP_DATA
01:2695 E8              	    53:   INX
01:2696 D0F5            	    54:   BNE .vi_w0
                        	    55: .vi_w1:
01:2698 BD0009          	    56:   LDA VT_FONTTMP+$100,X
01:269B 49FF            	    57:   EOR #$FF
01:269D 8D00B0          	    58:   STA VDP_DATA
01:26A0 E8              	    59:   INX
01:26A1 D0F5            	    60:   BNE .vi_w1
                        	    61: .vi_w2:
01:26A3 BD000A          	    62:   LDA VT_FONTTMP+$200,X
01:26A6 49FF            	    63:   EOR #$FF
01:26A8 8D00B0          	    64:   STA VDP_DATA
01:26AB E8              	    65:   INX
01:26AC D0F5            	    66:   BNE .vi_w2
                        	    67: .vi_w3:
01:26AE BD000B          	    68:   LDA VT_FONTTMP+$300,X
01:26B1 49FF            	    69:   EOR #$FF
01:26B3 8D00B0          	    70:   STA VDP_DATA
01:26B6 E8              	    71:   INX
01:26B7 D0F5            	    72:   BNE .vi_w3
01:26B9 64A4            	    73:   STZ VT_INV
01:26BB 4C3E27          	    74:   JMP VT_CLS
                        	    75: 
                        	    76: ; VT_WADDR: VRAM write address A (lo) / X (hi)
                        	    77: VT_WADDR:
01:26BE 8D01B0          	    78:   STA VDP_REG
01:26C1 8A              	    79:   TXA
01:26C2 0940            	    80:   ORA #$40
01:26C4 8D01B0          	    81:   STA VDP_REG
01:26C7 60              	    82:   RTS
                        	    83: 
                        	    84: ; VT_RADDR: VRAM read address A (lo) / X (hi)
                        	    85: VT_RADDR:
01:26C8 8D01B0          	    86:   STA VDP_REG
01:26CB 8E01B0          	    87:   STX VDP_REG
01:26CE 60              	    88:   RTS
                        	    89: 
                        	    90: ; VT_ROW: write address at column 0 of row A (0-23). Keeps Y
                        	    91: VT_ROW:
01:26CF AA              	    92:   TAX
01:26D0 BD5227          	    93:   LDA VT_ROWLO,X
01:26D3 48              	    94:   PHA
01:26D4 BD6A27          	    95:   LDA VT_ROWHI,X
01:26D7 AA              	    96:   TAX
01:26D8 68              	    97:   PLA
01:26D9 4CBE26          	    98:   JMP VT_WADDR
                        	    99: 
                        	   100: ; VT_AT: write address at row A, column X. Keeps Y
                        	   101: VT_AT:
01:26DC DA              	   102:   PHX
01:26DD AA              	   103:   TAX
01:26DE 68              	   104:   PLA
01:26DF 18              	   105:   CLC
01:26E0 7D5227          	   106:   ADC VT_ROWLO,X
01:26E3 48              	   107:   PHA
01:26E4 BD6A27          	   108:   LDA VT_ROWHI,X
01:26E7 6900            	   109:   ADC #0
01:26E9 AA              	   110:   TAX
01:26EA 68              	   111:   PLA
01:26EB 4CBE26          	   112:   JMP VT_WADDR
                        	   113: 
                        	   114: ; VT_REP: writes X times the character A
                        	   115: VT_REP:
01:26EE E000            	   116:   CPX #0
01:26F0 F010            	   117:   BEQ .vr_x
                        	   118: .vr_l:
01:26F2 8D00B0          	   119:   STA VDP_DATA
01:26F5 48              	   120:   PHA
01:26F6 8A              	   121:   TXA
01:26F7 290F            	   122:   AND #$0F
01:26F9 D003            	   123:   BNE .vr_n
01:26FB 200526          	   124:   JSR KB_POLL
                        	   125: .vr_n:
01:26FE 68              	   126:   PLA
01:26FF CA              	   127:   DEX
01:2700 D0F0            	   128:   BNE .vr_l
                        	   129: .vr_x:
01:2702 60              	   130:   RTS
                        	   131: 
                        	   132: ; VT_STR: writes the $00-terminated string at VT_P (ORA VT_INV). Y = characters written
                        	   133: VT_STR:
01:2703 A000            	   134:   LDY #0
                        	   135: .vs_l:
01:2705 B1A2            	   136:   LDA (VT_P),Y
01:2707 F010            	   137:   BEQ .vs_x
01:2709 05A4            	   138:   ORA VT_INV
01:270B 8D00B0          	   139:   STA VDP_DATA
01:270E C8              	   140:   INY
01:270F 98              	   141:   TYA
01:2710 290F            	   142:   AND #$0F
01:2712 D0F1            	   143:   BNE .vs_l
01:2714 200526          	   144:   JSR KB_POLL
01:2717 80EC            	   145:   BRA .vs_l
                        	   146: .vs_x:
01:2719 60              	   147:   RTS
                        	   148: 
                        	   149: ; VT_LINE: string A/X (lo/hi) at the current address, then spaces (ORA VT_INV) up to
                        	   150: ; column 40 of the row. Y = start column on entry
                        	   151: VT_LINE:
01:271A 85A2            	   152:   STA VT_P
01:271C 86A3            	   153:   STX VT_P+1
01:271E 8C3D27          	   154:   STY .vl_c
01:2721 200327          	   155:   JSR VT_STR
01:2724 98              	   156:   TYA
01:2725 18              	   157:   CLC
01:2726 6D3D27          	   158:   ADC .vl_c
01:2729 8D3D27          	   159:   STA .vl_c
01:272C A928            	   160:   LDA #40
01:272E 38              	   161:   SEC
01:272F ED3D27          	   162:   SBC .vl_c
01:2732 9008            	   163:   BCC .vl_x
01:2734 AA              	   164:   TAX
01:2735 A920            	   165:   LDA #' '
01:2737 05A4            	   166:   ORA VT_INV
01:2739 4CEE26          	   167:   JMP VT_REP
                        	   168: .vl_x:
01:273C 60              	   169:   RTS
                        	   170: .vl_c:
01:273D 00              	   171:   .byte 0
                        	   172: 
                        	   173: ; VT_CLS: whole screen blank
                        	   174: VT_CLS:
01:273E A900            	   175:   LDA #<VRAM_NAME
01:2740 A208            	   176:   LDX #>VRAM_NAME
01:2742 20BE26          	   177:   JSR VT_WADDR
01:2745 A004            	   178:   LDY #4                 ; 4 x 240 = 960
                        	   179: .vc_l:
01:2747 A920            	   180:   LDA #' '
01:2749 A2F0            	   181:   LDX #240
01:274B 20EE26          	   182:   JSR VT_REP
01:274E 88              	   183:   DEY
01:274F D0F6            	   184:   BNE .vc_l
01:2751 60              	   185:   RTS
                        	   186: 
                        	   187: VT_ROWLO:
01:2752 00              	   188:   .byte <(VRAM_NAME+0*40),<(VRAM_NAME+1*40),<(VRAM_NAME+2*40),<(VRAM_NAME+3*40)
01:2753 28
01:2754 50
01:2755 78
01:2756 A0              	   189:   .byte <(VRAM_NAME+4*40),<(VRAM_NAME+5*40),<(VRAM_NAME+6*40),<(VRAM_NAME+7*40)
01:2757 C8
01:2758 F0
01:2759 18
01:275A 40              	   190:   .byte <(VRAM_NAME+8*40),<(VRAM_NAME+9*40),<(VRAM_NAME+10*40),<(VRAM_NAME+11*40)
01:275B 68
01:275C 90
01:275D B8
01:275E E0              	   191:   .byte <(VRAM_NAME+12*40),<(VRAM_NAME+13*40),<(VRAM_NAME+14*40),<(VRAM_NAME+15*40)
01:275F 08
01:2760 30
01:2761 58
01:2762 80              	   192:   .byte <(VRAM_NAME+16*40),<(VRAM_NAME+17*40),<(VRAM_NAME+18*40),<(VRAM_NAME+19*40)
01:2763 A8
01:2764 D0
01:2765 F8
01:2766 20              	   193:   .byte <(VRAM_NAME+20*40),<(VRAM_NAME+21*40),<(VRAM_NAME+22*40),<(VRAM_NAME+23*40)
01:2767 48
01:2768 70
01:2769 98
                        	   194: VT_ROWHI:
01:276A 08              	   195:   .byte >(VRAM_NAME+0*40),>(VRAM_NAME+1*40),>(VRAM_NAME+2*40),>(VRAM_NAME+3*40)
01:276B 08
01:276C 08
01:276D 08
01:276E 08              	   196:   .byte >(VRAM_NAME+4*40),>(VRAM_NAME+5*40),>(VRAM_NAME+6*40),>(VRAM_NAME+7*40)
01:276F 08
01:2770 08
01:2771 09
01:2772 09              	   197:   .byte >(VRAM_NAME+8*40),>(VRAM_NAME+9*40),>(VRAM_NAME+10*40),>(VRAM_NAME+11*40)
01:2773 09
01:2774 09
01:2775 09
01:2776 09              	   198:   .byte >(VRAM_NAME+12*40),>(VRAM_NAME+13*40),>(VRAM_NAME+14*40),>(VRAM_NAME+15*40)
01:2777 0A
01:2778 0A
01:2779 0A
01:277A 0A              	   199:   .byte >(VRAM_NAME+16*40),>(VRAM_NAME+17*40),>(VRAM_NAME+18*40),>(VRAM_NAME+19*40)
01:277B 0A
01:277C 0A
01:277D 0A
01:277E 0B              	   200:   .byte >(VRAM_NAME+20*40),>(VRAM_NAME+21*40),>(VRAM_NAME+22*40),>(VRAM_NAME+23*40)
01:277F 0B
01:2780 0B
01:2781 0B
