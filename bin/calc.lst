01:2D54 85D0            	   254:   STA FR
01:2D56 E6C8            	   255:   INC FP
                        	   256: .d8_n:
01:2D58 CA              	   257:   DEX
01:2D59 D0DF            	   258:   BNE .d8_l
01:2D5B 60              	   259:   RTS
                        	   260: 
                        	   261: ; DIV64: FP = FP / FB (FB > 0, < 2^31), FR = remainder
                        	   262: DIV64:
01:2D5C 64D0            	   263:   STZ FR
01:2D5E 64D1            	   264:   STZ FR+1
01:2D60 64D2            	   265:   STZ FR+2
01:2D62 64D3            	   266:   STZ FR+3
01:2D64 A240            	   267:   LDX #64
                        	   268: .dv_l:
01:2D66 06C8            	   269:   ASL FP
01:2D68 26C9            	   270:   ROL FP+1
