01: "seg1000" (1000-2FBE)


Source: "apps\calc.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   CALC  -  miniVIC CALC, spreadsheet (VisiCalc style)        ;
                        	     4: ;   65C02 assembly, TMS9918A text mode 40 x 24                 ;
                        	     5: ;   Needs the BIOS 27.10.26 KEYB/SD                            ;
                        	     6: ;                                                              ;
                        	     7: ;   - 26 x 99 cells (A1..Z99); a cell holds a label, a number  ;
                        	     8: ;     or a formula; only the cells in use take memory          ;
                        	     9: ;   - numbers: fixed point, 2 decimals (lib/fix32.asm)         ;
                        	    10: ;   - formulas: + - * / with precedence, ( ), -x, cells (A1,   ;
                        	    11: ;     $A$1), @SUM @AVG @MIN @MAX @COUNT over ranges (A1:B9 or  ;
                        	    12: ;     A1...B9) and lists, @ABS( ) @INT( )                      ;
                        	    13: ;   - an entry that starts with a letter or " is a label,      ;
                        	    14: ;     otherwise a value (so a formula starts with + ( or @)    ;
                        	    15: ;   - recalculation after every change, over the cells in use  ;
                        	    16: ;     (heap order), repeated while values change (8 passes)    ;
                        	    17: ;   - / commands: Blank, Clear, Replicate (relative copy,      ;
                        	    18: ;     $ = absolute), Width, Save, Load, Quit; > go to,         ;
                        	    19: ;     ! recalc; F1 help, F2 edit the cell, Del blanks it       ;
                        	    20: ;   - sheets saved on the SD as text (one cell per line)       ;
                        	    21: ;                                                              ;
                        	    22: ;   MEMORY                                                     ;
                        	    23: ;   $0050-$00FF  zero page (app $50-$9F, lib $A0-$E3)          ;
                        	    24: ;   $0210-$029F  edit buffer, name, line buffers               ;
                        	    25: ;   $0500-$053F  value stack of the formulas                   ;
                        	    26: ;   $0600-$07FF  SD document index                             ;
                        	    27: ;   $0800-$09FF  sector buffer for save / load                 ;
                        	    28: ;   $1000-...    code, then the cell heap up to $6BE3          ;
                        	    29: ;   $6BE4-$7FFF  cell table: 26 x 99 pointers                  ;
                        	    30: ;                                                              ;
                        	    31: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    32: 
                        	    33:  .include "lib/system.inc"

Source: "lib\system.inc"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   SYSTEM.INC  -  miniVIC / BO6502 addresses for the apps     ;
                        	     4: ;   BIOS 27.10.26 KEYB/SD jump table, VDP, key codes           ;
                        	     5: ;                                                              ;
                        	     6: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     7: 
                        	     8: ; ---------------- BIOS jump table ($FD00) ----------------
                        	     9: JT_CHROUT       = $FD00    ; A = char to screen AND serial (not used by the apps)
                        	    10: JT_CHRIN        = $FD03    ; C=1 and A = key, C=0 no key (serial first, then keyboard)
                        	    11: JT_INIT_CRT     = $FD09    ; text mode, VRAM and font of the BIOS
                        	    12: JT_SHOW_MENU    = $FD0F    ; back to the BIOS menu (never returns)
                        	    13: JT_SD_READ      = $FD18    ; sector SD_LBA -> buffer X/Y (lo/hi, 512 bytes), C=1 error
                        	    14: JT_SD_WRITE     = $FD1B    ; buffer X/Y -> sector SD_LBA, C=1 error
                        	    15: JT_SD_INIT      = $FD1E    ; C=0 and A = card type, C=1 no card
                        	    16: JT_KB_MODE      = $FD21    ; A<>0 extended keyboard, A=0 classic
                        	    17: SD_LBA          = $0316    ; 4 bytes, sector number, little endian
                        	    18: 
                        	    19: ; ---------------- RAM vectors (everything is polled) ----------------
                        	    20: IRQ_VEC         = $0FA0    ; JSR $0FA0 from the BIOS IRQ handler
                        	    21: NMI_VEC         = $0FD0    ; JSR $0FD0 from the BIOS NMI handler
                        	    22: 
                        	    23: ; ---------------- VDP TMS9918A ----------------
                        	    24: VDP_DATA        = $B000
                        	    25: VDP_REG         = $B001
                        	    26: VRAM_NAME       = $0800    ; name table of the BIOS text mode (40 x 24)
                        	    27: VRAM_FONT       = $0000    ; patterns 0-127 (BIOS font), 128-255 = inverse (made by VT_INIT)
                        	    28: 
                        	    29: ; ---------------- serial W65C51 ----------------
                        	    30: ACIA_DATA   = $C000
                        	    31: ACIA_STATUS = $C001    ; bit 3 = byte received
                        	    32: ACIA_CMD    = $C002    ; BIOS: $8B (no parity, receive IRQ off, DTR on)
                        	    33: ACIA_CTRL   = $C003    ; BIOS: $1F (19200, 8 bits, 1 stop)
                        	    34: 
                        	    35: ; ---------------- key codes (extended mode) ----------------
                        	    36: K_CR            = $0D
                        	    37: K_BS            = $08
                        	    38: K_TAB           = $09
                        	    39: K_ESC           = $1B
                        	    40: K_UP            = $80
                        	    41: K_DOWN          = $81
                        	    42: K_LEFT          = $82
                        	    43: K_RIGHT         = $83
                        	    44: K_HOME          = $84
                        	    45: K_END           = $85
                        	    46: K_PGUP          = $86
                        	    47: K_PGDN          = $87
                        	    48: K_INS           = $88
                        	    49: K_DEL           = $89
                        	    50: K_F1            = $90      ; F1-F12 = $90-$9B
                        	    51: 

Source: "apps\calc.asm"
                        	    34: 
                        	    35: ; ---------------- parameters ----------------
                        	    36: NCOLS       = 26
                        	    37: NROWS       = 99
                        	    38: TABLE       = $8000-NCOLS*NROWS*2
                        	    39: GROWS       = 20       ; grid rows on the screen (screen rows 3-22)
                        	    40: HDRW        = 3        ; row number column
                        	    41: TXTMAX      = 36       ; longest cell entry
                        	    42: T_LABEL     = 1
                        	    43: T_VAL       = 2        ; a constant number
                        	    44: T_FORM      = 3        ; a formula
                        	    45: T_ERR       = $80
                        	    46: NAMELEN     = 12
                        	    47: CR          = $0D
                        	    48: 
                        	    49: ; ---------------- zero page ----------------
                        	    50: CX          = $50      ; cursor cell
                        	    51: CY          = $51
                        	    52: LCOL        = $52      ; first column / row on the screen
                        	    53: TROW        = $53
                        	    54: CW          = $54      ; column width
                        	    55: NVIS        = $55      ; columns on the screen
                        	    56: HTOP        = $56      ; 2 bytes: end of the cell heap
                        	    57: MODF        = $58
                        	    58: DIRTY       = $59      ; 1 = whole grid to redraw
                        	    59: MSGP        = $5A      ; 2 bytes
                        	    60: EPOS        = $5C      ; formula: position in the text
                        	    61: ESP         = $5D      ; formula: stack pointer to go back to on an error
                        	    62: VSP         = $5E      ; value stack pointer
                        	    63: CELL        = $5F      ; 2 bytes: record of a cell
                        	    64: IDX         = $61      ; 2 bytes: cell index (row * 26 + col)
                        	    65: TP          = $63      ; 2 bytes: its table entry
                        	    66: RC          = $65      ; cell column / row (CELLTP, refs)
                        	    67: RR          = $66
                        	    68: SC0         = $67      ; range
                        	    69: SR0         = $68
                        	    70: SC1         = $69
                        	    71: SR1         = $6A
                        	    72: AGG         = $6B      ; 4 bytes: @function accumulator
                        	    73: ACNT        = $6F      ; 2 bytes: values counted
                        	    74: AFN         = $71      ; @function: 0 SUM 1 AVG 2 MIN 3 MAX 4 COUNT
                        	    75: T0          = $72
                        	    76: T1          = $73
                        	    77: T2          = $74
                        	    78: T3          = $75
                        	    79: P0          = $76      ; 2 bytes
                        	    80: P1          = $78      ; 2 bytes
                        	    81: P2          = $7A      ; 2 bytes
                        	    82: ELEN        = $7C      ; edit buffer length
                        	    83: EDIT        = $7D      ; 1 = typing a cell entry
                        	    84: CHG         = $7E      ; recalculation: a value changed
                        	    85: PASS        = $7F
                        	    86: DOCSLOT     = $80
                        	    87: PCX         = $81      ; cursor drawn last time ($FF = none)
                        	    88: PCY         = $82
                        	    89: DC          = $83      ; replicate: column / row shift
                        	    90: DR          = $84
                        	    91: TC0         = $85      ; replicate: target
                        	    92: TR0         = $86
                        	    93: TC1         = $87
                        	    94: TR1         = $88
                        	    95: GR          = $89      ; grid drawing: row, column
                        	    96: GC          = $8A
                        	    97: SECN        = $8B      ; save / load: sector number
                        	    98: SPOS        = $8C      ; 2 bytes: position in SECBUF
                        	    99: SLEN        = $8E      ; 2 bytes: bytes left to read
                        	   100: LNL         = $90      ; length of the line being loaded
                        	   101: RANGE       = $91      ; 1 = the last reference was a range
                        	   102: INV         = $92      ; $80 = cell drawn in inverse
                        	   103: XC          = $93      ; replicate: target cell
                        	   104: XR          = $94
                        	   105: RREF        = $95      ; MOVEREFS: row being rebuilt
                        	   106: LC          = $96      ; replicate: source cell of the block loop
                        	   107: LR          = $97
                        	   108: KIND        = $98      ; COPYONE: kind of the source cell
                        	   109: DIRC        = $99      ; replicate: 1 = columns backwards
                        	   110: DIRR        = $9A      ;            1 = rows backwards
                        	   111: 
                        	   112: ; ---------------- RAM ----------------
                        	   113: EBUF        = $0210    ; cell entry being typed / built (36 + $00)
                        	   114: DOCNAME     = $0238    ; 12 + $00
                        	   115: LINEB       = $0248    ; line of a loaded sheet (40 + $00)
                        	   116: FIELD       = $0278    ; a cell as it is drawn (up to 20 characters)
                        	   117: VSTK        = $0500    ; value stack: 16 x 4 bytes
                        	   118: VSTK_N      = 16
                        	   119: SECBUF      = $0800    ; sector buffer (after VT_INIT, which uses it only at the start)
                        	   120: 
                        	   121:  .org $0FD0
00:0FD0 60              	   122:   RTS                    ; NMI trampoline (the VDP interrupt is off)
                        	   123:  .org $1000
                        	   124: 
