                        	  1812:  .include "lib/vtext.asm"

Source: "lib\vtext.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   VTEXT.ASM  -  40 x 24 text screen on the TMS9918A          ;
                        	     4: ;                                                              ;
                        	     5: ;   BIOS text mode (VDP interrupt off, so the main loop can    ;
                        	     6: ;   write the VRAM at any time). VT_INIT also builds the       ;
                        	     7: ;   inverse font: codes $80-$FF = codes $00-$7F inverted,      ;
                        	     8: ;   used for the cursor, the status bar and the marked block.  ;
                        	     9: ;   Long loops call KB_POLL (lib/keys.asm).                    ;
                        	    10: ;   Uses: zp $A2-$A4, RAM $0800-$0BFF only inside VT_INIT      ;
                        	    11: ;                                                              ;
                        	    12: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    13: 
                        	    14: VT_P        = $A2      ; 2 bytes: string pointer
                        	    15: VT_INV      = $A4      ; ORed to every character of VT_STR ($80 = inverse)
                        	    16: VT_FONTTMP  = $0800    ; RAM copy of the font (1 KB, only during VT_INIT)
                        	    17: 
                        	    18: ; VT_INIT: text mode of the BIOS, inverse font, empty screen
                        	    19: VT_INIT:
01:1F75 2009FD          	    20:   JSR JT_INIT_CRT
01:1F78 A900            	    21:   LDA #<VRAM_FONT        ; read patterns 0-127 (1 KB)
01:1F7A A200            	    22:   LDX #>VRAM_FONT
01:1F7C 20E91F          	    23:   JSR VT_RADDR
01:1F7F A200            	    24:   LDX #0                 ; (the VRAM address increases by itself)
                        	    25: .vi_r0:
01:1F81 AD00B0          	    26:   LDA VDP_DATA
01:1F84 9D0008          	    27:   STA VT_FONTTMP,X
01:1F87 E8              	    28:   INX
01:1F88 D0F7            	    29:   BNE .vi_r0
                        	    30: .vi_r1:
01:1F8A AD00B0          	    31:   LDA VDP_DATA
01:1F8D 9D0009          	    32:   STA VT_FONTTMP+$100,X
01:1F90 E8              	    33:   INX
01:1F91 D0F7            	    34:   BNE .vi_r1
                        	    35: .vi_r2:
01:1F93 AD00B0          	    36:   LDA VDP_DATA
01:1F96 9D000A          	    37:   STA VT_FONTTMP+$200,X
01:1F99 E8              	    38:   INX
01:1F9A D0F7            	    39:   BNE .vi_r2
                        	    40: .vi_r3:
01:1F9C AD00B0          	    41:   LDA VDP_DATA
01:1F9F 9D000B          	    42:   STA VT_FONTTMP+$300,X
01:1FA2 E8              	    43:   INX
01:1FA3 D0F7            	    44:   BNE .vi_r3
01:1FA5 A900            	    45:   LDA #<(VRAM_FONT+$400) ; inverted copy at pattern 128
01:1FA7 A204            	    46:   LDX #>(VRAM_FONT+$400)
01:1FA9 20DF1F          	    47:   JSR VT_WADDR
01:1FAC A200            	    48:   LDX #0
                        	    49: .vi_w0:
01:1FAE BD0008          	    50:   LDA VT_FONTTMP,X
01:1FB1 49FF            	    51:   EOR #$FF
01:1FB3 8D00B0          	    52:   STA VDP_DATA
01:1FB6 E8              	    53:   INX
01:1FB7 D0F5            	    54:   BNE .vi_w0
                        	    55: .vi_w1:
01:1FB9 BD0009          	    56:   LDA VT_FONTTMP+$100,X
01:1FBC 49FF            	    57:   EOR #$FF
01:1FBE 8D00B0          	    58:   STA VDP_DATA
01:1FC1 E8              	    59:   INX
01:1FC2 D0F5            	    60:   BNE .vi_w1
                        	    61: .vi_w2:
01:1FC4 BD000A          	    62:   LDA VT_FONTTMP+$200,X
01:1FC7 49FF            	    63:   EOR #$FF
01:1FC9 8D00B0          	    64:   STA VDP_DATA
01:1FCC E8              	    65:   INX
01:1FCD D0F5            	    66:   BNE .vi_w2
                        	    67: .vi_w3:
01:1FCF BD000B          	    68:   LDA VT_FONTTMP+$300,X
01:1FD2 49FF            	    69:   EOR #$FF
01:1FD4 8D00B0          	    70:   STA VDP_DATA
01:1FD7 E8              	    71:   INX
01:1FD8 D0F5            	    72:   BNE .vi_w3
01:1FDA 64A4            	    73:   STZ VT_INV
01:1FDC 4C5F20          	    74:   JMP VT_CLS
                        	    75: 
                        	    76: ; VT_WADDR: VRAM write address A (lo) / X (hi)
                        	    77: VT_WADDR:
01:1FDF 8D01B0          	    78:   STA VDP_REG
01:1FE2 8A              	    79:   TXA
01:1FE3 0940            	    80:   ORA #$40
01:1FE5 8D01B0          	    81:   STA VDP_REG
01:1FE8 60              	    82:   RTS
                        	    83: 
                        	    84: ; VT_RADDR: VRAM read address A (lo) / X (hi)
                        	    85: VT_RADDR:
01:1FE9 8D01B0          	    86:   STA VDP_REG
01:1FEC 8E01B0          	    87:   STX VDP_REG
01:1FEF 60              	    88:   RTS
                        	    89: 
                        	    90: ; VT_ROW: write address at column 0 of row A (0-23). Keeps Y
                        	    91: VT_ROW:
01:1FF0 AA              	    92:   TAX
01:1FF1 BD7320          	    93:   LDA VT_ROWLO,X
01:1FF4 48              	    94:   PHA
01:1FF5 BD8B20          	    95:   LDA VT_ROWHI,X
01:1FF8 AA              	    96:   TAX
01:1FF9 68              	    97:   PLA
01:1FFA 4CDF1F          	    98:   JMP VT_WADDR
                        	    99: 
                        	   100: ; VT_AT: write address at row A, column X. Keeps Y
                        	   101: VT_AT:
01:1FFD DA              	   102:   PHX
01:1FFE AA              	   103:   TAX
01:1FFF 68              	   104:   PLA
01:2000 18              	   105:   CLC
01:2001 7D7320          	   106:   ADC VT_ROWLO,X
01:2004 48              	   107:   PHA
01:2005 BD8B20          	   108:   LDA VT_ROWHI,X
01:2008 6900            	   109:   ADC #0
01:200A AA              	   110:   TAX
01:200B 68              	   111:   PLA
01:200C 4CDF1F          	   112:   JMP VT_WADDR
                        	   113: 
                        	   114: ; VT_REP: writes X times the character A
                        	   115: VT_REP:
01:200F E000            	   116:   CPX #0
01:2011 F010            	   117:   BEQ .vr_x
                        	   118: .vr_l:
01:2013 8D00B0          	   119:   STA VDP_DATA
01:2016 48              	   120:   PHA
01:2017 8A              	   121:   TXA
01:2018 290F            	   122:   AND #$0F
01:201A D003            	   123:   BNE .vr_n
01:201C 20261F          	   124:   JSR KB_POLL
                        	   125: .vr_n:
01:201F 68              	   126:   PLA
01:2020 CA              	   127:   DEX
01:2021 D0F0            	   128:   BNE .vr_l
                        	   129: .vr_x:
01:2023 60              	   130:   RTS
                        	   131: 
                        	   132: ; VT_STR: writes the $00-terminated string at VT_P (ORA VT_INV). Y = characters written
                        	   133: VT_STR:
01:2024 A000            	   134:   LDY #0
                        	   135: .vs_l:
01:2026 B1A2            	   136:   LDA (VT_P),Y
01:2028 F010            	   137:   BEQ .vs_x
01:202A 05A4            	   138:   ORA VT_INV
01:202C 8D00B0          	   139:   STA VDP_DATA
01:202F C8              	   140:   INY
01:2030 98              	   141:   TYA
01:2031 290F            	   142:   AND #$0F
01:2033 D0F1            	   143:   BNE .vs_l
01:2035 20261F          	   144:   JSR KB_POLL
01:2038 80EC            	   145:   BRA .vs_l
                        	   146: .vs_x:
01:203A 60              	   147:   RTS
                        	   148: 
                        	   149: ; VT_LINE: string A/X (lo/hi) at the current address, then spaces (ORA VT_INV) up to
                        	   150: ; column 40 of the row. Y = start column on entry
                        	   151: VT_LINE:
01:203B 85A2            	   152:   STA VT_P
01:203D 86A3            	   153:   STX VT_P+1
01:203F 8C5E20          	   154:   STY .vl_c
01:2042 202420          	   155:   JSR VT_STR
01:2045 98              	   156:   TYA
01:2046 18              	   157:   CLC
01:2047 6D5E20          	   158:   ADC .vl_c
01:204A 8D5E20          	   159:   STA .vl_c
01:204D A928            	   160:   LDA #40
01:204F 38              	   161:   SEC
01:2050 ED5E20          	   162:   SBC .vl_c
01:2053 9008            	   163:   BCC .vl_x
01:2055 AA              	   164:   TAX
01:2056 A920            	   165:   LDA #' '
01:2058 05A4            	   166:   ORA VT_INV
01:205A 4C0F20          	   167:   JMP VT_REP
                        	   168: .vl_x:
01:205D 60              	   169:   RTS
                        	   170: .vl_c:
01:205E 00              	   171:   .byte 0
                        	   172: 
                        	   173: ; VT_CLS: whole screen blank
                        	   174: VT_CLS:
01:205F A900            	   175:   LDA #<VRAM_NAME
01:2061 A208            	   176:   LDX #>VRAM_NAME
01:2063 20DF1F          	   177:   JSR VT_WADDR
01:2066 A004            	   178:   LDY #4                 ; 4 x 240 = 960
                        	   179: .vc_l:
01:2068 A920            	   180:   LDA #' '
01:206A A2F0            	   181:   LDX #240
01:206C 200F20          	   182:   JSR VT_REP
01:206F 88              	   183:   DEY
01:2070 D0F6            	   184:   BNE .vc_l
01:2072 60              	   185:   RTS
                        	   186: 
                        	   187: VT_ROWLO:
01:2073 00              	   188:   .byte <(VRAM_NAME+0*40),<(VRAM_NAME+1*40),<(VRAM_NAME+2*40),<(VRAM_NAME+3*40)
01:2074 28
01:2075 50
01:2076 78
01:2077 A0              	   189:   .byte <(VRAM_NAME+4*40),<(VRAM_NAME+5*40),<(VRAM_NAME+6*40),<(VRAM_NAME+7*40)
01:2078 C8
01:2079 F0
01:207A 18
01:207B 40              	   190:   .byte <(VRAM_NAME+8*40),<(VRAM_NAME+9*40),<(VRAM_NAME+10*40),<(VRAM_NAME+11*40)
01:207C 68
01:207D 90
01:207E B8
01:207F E0              	   191:   .byte <(VRAM_NAME+12*40),<(VRAM_NAME+13*40),<(VRAM_NAME+14*40),<(VRAM_NAME+15*40)
01:2080 08
01:2081 30
01:2082 58
01:2083 80              	   192:   .byte <(VRAM_NAME+16*40),<(VRAM_NAME+17*40),<(VRAM_NAME+18*40),<(VRAM_NAME+19*40)
01:2084 A8
01:2085 D0
01:2086 F8
01:2087 20              	   193:   .byte <(VRAM_NAME+20*40),<(VRAM_NAME+21*40),<(VRAM_NAME+22*40),<(VRAM_NAME+23*40)
01:2088 48
01:2089 70
01:208A 98
                        	   194: VT_ROWHI:
01:208B 08              	   195:   .byte >(VRAM_NAME+0*40),>(VRAM_NAME+1*40),>(VRAM_NAME+2*40),>(VRAM_NAME+3*40)
01:208C 08
01:208D 08
01:208E 08
01:208F 08              	   196:   .byte >(VRAM_NAME+4*40),>(VRAM_NAME+5*40),>(VRAM_NAME+6*40),>(VRAM_NAME+7*40)
01:2090 08
01:2091 08
01:2092 09
01:2093 09              	   197:   .byte >(VRAM_NAME+8*40),>(VRAM_NAME+9*40),>(VRAM_NAME+10*40),>(VRAM_NAME+11*40)
01:2094 09
01:2095 09
01:2096 09
01:2097 09              	   198:   .byte >(VRAM_NAME+12*40),>(VRAM_NAME+13*40),>(VRAM_NAME+14*40),>(VRAM_NAME+15*40)
01:2098 0A
01:2099 0A
01:209A 0A
01:209B 0A              	   199:   .byte >(VRAM_NAME+16*40),>(VRAM_NAME+17*40),>(VRAM_NAME+18*40),>(VRAM_NAME+19*40)
01:209C 0A
01:209D 0A
01:209E 0A
01:209F 0B              	   200:   .byte >(VRAM_NAME+20*40),>(VRAM_NAME+21*40),>(VRAM_NAME+22*40),>(VRAM_NAME+23*40)
01:20A0 0B
01:20A1 0B
01:20A2 0B
                        	   201: 

Source: "apps\desk.asm"
                        	  1813:  .include "lib/num.asm"

Source: "lib\num.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   NUM.ASM  -  16-bit numbers to decimal text                 ;
                        	     4: ;   Uses: zp $A5-$A9                                           ;
                        	     5: ;                                                              ;
                        	     6: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     7: 
                        	     8: NUM         = $A5      ; 2 bytes: number to convert (destroyed)
                        	     9: BCD         = $A7      ; 3 bytes: BCD result, $A7 = lowest 2 digits
                        	    10: 
                        	    11: ; BIN2BCD: NUM -> BCD (double dabble with decimal mode)
                        	    12: BIN2BCD:
01:20A3 20261F          	    13:   JSR KB_POLL
01:20A6 64A7            	    14:   STZ BCD
01:20A8 64A8            	    15:   STZ BCD+1
01:20AA 64A9            	    16:   STZ BCD+2
01:20AC A210            	    17:   LDX #16
01:20AE F8              	    18:   SED
                        	    19: .bb_l:
01:20AF 06A5            	    20:   ASL NUM
01:20B1 26A6            	    21:   ROL NUM+1
01:20B3 A5A7            	    22:   LDA BCD
01:20B5 65A7            	    23:   ADC BCD
01:20B7 85A7            	    24:   STA BCD
01:20B9 A5A8            	    25:   LDA BCD+1
01:20BB 65A8            	    26:   ADC BCD+1
01:20BD 85A8            	    27:   STA BCD+1
01:20BF A5A9            	    28:   LDA BCD+2
01:20C1 65A9            	    29:   ADC BCD+2
01:20C3 85A9            	    30:   STA BCD+2
01:20C5 CA              	    31:   DEX
01:20C6 D0E7            	    32:   BNE .bb_l
01:20C8 D8              	    33:   CLD
01:20C9 60              	    34:   RTS
                        	    35: 
                        	    36: ; NUMSTR: NUM -> 5 characters at (VT_P),Y.. with leading spaces (last digit always shown)
                        	    37: ; Y = first position; on exit Y = position after the number
                        	    38: NUMSTR:
01:20CA 20A320          	    39:   JSR BIN2BCD
01:20CD 20261F          	    40:   JSR KB_POLL            ; (BIN2BCD takes ~600 cycles)
01:20D0 A200            	    41:   LDX #0                 ; X = 1 once a digit is not zero
01:20D2 A5A9            	    42:   LDA BCD+2
01:20D4 20F220          	    43:   JSR .ns_dig            ; ten thousands
01:20D7 A5A8            	    44:   LDA BCD+1
01:20D9 4A              	    45:   LSR
01:20DA 4A              	    46:   LSR
01:20DB 4A              	    47:   LSR
01:20DC 4A              	    48:   LSR
01:20DD 20F220          	    49:   JSR .ns_dig
01:20E0 A5A8            	    50:   LDA BCD+1
01:20E2 20F220          	    51:   JSR .ns_dig
01:20E5 A5A7            	    52:   LDA BCD
01:20E7 4A              	    53:   LSR
01:20E8 4A              	    54:   LSR
01:20E9 4A              	    55:   LSR
01:20EA 4A              	    56:   LSR
01:20EB 20F220          	    57:   JSR .ns_dig
01:20EE A5A7            	    58:   LDA BCD
01:20F0 A201            	    59:   LDX #1                 ; the last digit is always written
                        	    60: .ns_dig:
01:20F2 290F            	    61:   AND #$0F
01:20F4 D008            	    62:   BNE .ns_nz
01:20F6 E000            	    63:   CPX #0
01:20F8 D004            	    64:   BNE .ns_nz
01:20FA A920            	    65:   LDA #' '
01:20FC 8004            	    66:   BRA .ns_put
                        	    67: .ns_nz:
01:20FE A201            	    68:   LDX #1
01:2100 0930            	    69:   ORA #'0'
                        	    70: .ns_put:
01:2102 91A2            	    71:   STA (VT_P),Y
01:2104 C8              	    72:   INY
01:2105 60              	    73:   RTS
                        	    74: 

Source: "apps\desk.asm"
                        	  1814:  .include "lib/fix32.asm"

Source: "lib\fix32.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   FIX32.ASM  -  fixed point numbers: 32-bit signed x 100     ;
                        	     4: ;                                                              ;
                        	     5: ;   A number is an integer of hundredths: 1234 = 12.34, range  ;
                        	     6: ;   -21474836.47 .. 21474836.47. No floating point: + - * /    ;
                        	     7: ;   with shift and add, results truncated. Every routine that  ;
                        	     8: ;   can fail returns C=1 (overflow, division by zero, bad      ;
                        	     9: ;   number). The accumulator is FA, the operand FB.            ;
                        	    10: ;   Uses: zp $C0-$E3, RAM $05F0-$05FF (F_OUT)                  ;
                        	    11: ;                                                              ;
                        	    12: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    13: 
                        	    14: FA          = $C0      ; 4 bytes, little endian
                        	    15: FB          = $C4      ; 4 bytes
                        	    16: FP          = $C8      ; 8 bytes: product / dividend, then quotient
                        	    17: FR          = $D0      ; 4 bytes: remainder
                        	    18: FS          = $D4      ; sign of the result (1 = negative)
                        	    19: FD          = $D5      ; decimals read by F_PARSE ($FF = no point)
                        	    20: FT          = $D6      ; 8-bit divisor
                        	    21: F_PTR       = $D7      ; 2 bytes: text read by F_PARSE
                        	    22: FX          = $D9      ; 4 bytes: temporary
                        	    23: FBCD        = $DD      ; 5 bytes: BCD digits of F_FMT ($DD = lowest 2)
                        	    24: FY          = $E2      ; 2 bytes (plus FX): saved divisor
                        	    25: F_OUT       = $05F0    ; F_FMT result (up to 13 characters + $00)
                        	    26: 
                        	    27: ; F_ZERO: FA = 0
                        	    28: F_ZERO:
01:2106 64C0            	    29:   STZ FA
01:2108 64C1            	    30:   STZ FA+1
