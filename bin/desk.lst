Source: "lib\docs.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   DOCS.ASM  -  documents in the SD document area             ;
                        	     4: ;                                                              ;
                        	     5: ;   Sector 16384 ($00800000, after the 255 program blocks)     ;
                        	     6: ;   is the index: +0 "DOCS", +4 version 1, +5 slots (15);      ;
                        	     7: ;   entry k (1-15) at k*32: +0 type (0 free, 1 text,           ;
                        	     8: ;   2 sheet, 3 card file),                                     ;
                        	     9: ;   +1/+2 length, +4..+15 name (12 chars, $00 padded).         ;
                        	    10: ;   Document k = 40 sectors (20 KB) from sector 16384 + k*40.  ;
                        	    11: ;   Sectors go through the BIOS (JT_SD_READ / JT_SD_WRITE).    ;
                        	    12: ;   Uses: zp $AA-$AF, $B8-$BA, RAM $0600-$07FF (index sector)  ;
                        	    13: ;                                                              ;
                        	    14: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    15: 
                        	    16: DOC_IDX     = $0600    ; index sector (512 bytes)
                        	    17: DOC_BASE    = $4000    ; sector 16384
                        	    18: DOC_SLOTS   = 15
                        	    19: DOC_SECTS   = 40       ; sectors per document
                        	    20: DOC_NAMELEN = 12
                        	    21: DOC_E       = $AA      ; 2 bytes: pointer to the index entry
                        	    22: DOC_K       = $AC      ; slot
                        	    23: DOC_I       = $AD      ; sector inside the document
                        	    24: DOC_N       = $AE      ; sectors to transfer
                        	    25: DOC_PG      = $AF      ; RAM page of the transfer
                        	    26: DOC_T       = $B8      ; document type of the application (1 text, 2 sheet, 3 card file)
                        	    27: DOC_LEN     = $B9      ; 2 bytes: length for DOC_SETENT
                        	    28: 
                        	    29: ; DOC_RDIDX: reads the index; a sector without "DOCS" becomes an empty index. C=1 SD error
                        	    30: DOC_RDIDX:
01:24D0 20E825          	    31:   JSR DOC_LBA0
01:24D3 A200            	    32:   LDX #<DOC_IDX
01:24D5 A006            	    33:   LDY #>DOC_IDX
01:24D7 2018FD          	    34:   JSR JT_SD_READ
01:24DA B00E            	    35:   BCS .dr_x
01:24DC A203            	    36:   LDX #3
                        	    37: .dr_m:
01:24DE BD0006          	    38:   LDA DOC_IDX,X
01:24E1 DD4226          	    39:   CMP DOC_MAGIC,X
01:24E4 D005            	    40:   BNE .dr_new
01:24E6 CA              	    41:   DEX
01:24E7 10F5            	    42:   BPL .dr_m
01:24E9 18              	    43:   CLC
                        	    44: .dr_x:
01:24EA 60              	    45:   RTS
                        	    46: .dr_new:
01:24EB A200            	    47:   LDX #0
                        	    48: .dr_z:
01:24ED 9E0006          	    49:   STZ DOC_IDX,X
01:24F0 9E0007          	    50:   STZ DOC_IDX+$100,X
01:24F3 E8              	    51:   INX
01:24F4 D0F7            	    52:   BNE .dr_z
01:24F6 A205            	    53:   LDX #5
                        	    54: .dr_h:
01:24F8 BD4226          	    55:   LDA DOC_MAGIC,X
01:24FB 9D0006          	    56:   STA DOC_IDX,X
01:24FE CA              	    57:   DEX
01:24FF 10F7            	    58:   BPL .dr_h
01:2501 18              	    59:   CLC
01:2502 60              	    60:   RTS
                        	    61: 
                        	    62: ; DOC_WRIDX: writes the index. C=1 SD error
                        	    63: DOC_WRIDX:
01:2503 20E825          	    64:   JSR DOC_LBA0
01:2506 A200            	    65:   LDX #<DOC_IDX
01:2508 A006            	    66:   LDY #>DOC_IDX
01:250A 4C1BFD          	    67:   JMP JT_SD_WRITE
                        	    68: 
                        	    69: ; DOC_ENTRY: A = slot (1-15) -> DOC_E = its index entry. Keeps X, Y
                        	    70: DOC_ENTRY:
01:250D 85AC            	    71:   STA DOC_K
01:250F 4A              	    72:   LSR
01:2510 4A              	    73:   LSR
01:2511 4A              	    74:   LSR
01:2512 18              	    75:   CLC
01:2513 6906            	    76:   ADC #>DOC_IDX
01:2515 85AB            	    77:   STA DOC_E+1
01:2517 A5AC            	    78:   LDA DOC_K
01:2519 0A              	    79:   ASL
01:251A 0A              	    80:   ASL
01:251B 0A              	    81:   ASL
01:251C 0A              	    82:   ASL
01:251D 0A              	    83:   ASL
01:251E 85AA            	    84:   STA DOC_E              ; (DOC_IDX is page aligned)
01:2520 60              	    85:   RTS
                        	    86: 
                        	    87: ; DOC_FIND: name of 12 bytes at (DOC_P) and type DOC_T -> C=0 and A = slot, C=1 not found
                        	    88: DOC_P       = VT_P     ; (shares the string pointer)
                        	    89: DOC_FIND:
01:2521 A901            	    90:   LDA #1
                        	    91: .df_k:
01:2523 48              	    92:   PHA
01:2524 200D25          	    93:   JSR DOC_ENTRY
01:2527 A000            	    94:   LDY #0
01:2529 B1AA            	    95:   LDA (DOC_E),Y
01:252B C5B8            	    96:   CMP DOC_T
01:252D D01A            	    97:   BNE .df_n              ; free or another type
01:252F A00B            	    98:   LDY #DOC_NAMELEN-1
                        	    99: .df_c:
01:2531 B1A2            	   100:   LDA (DOC_P),Y
01:2533 85AD            	   101:   STA DOC_I              ; (temporary)
01:2535 C8              	   102:   INY                    ; name in the entry at +4
01:2536 C8              	   103:   INY
01:2537 C8              	   104:   INY
01:2538 C8              	   105:   INY
01:2539 B1AA            	   106:   LDA (DOC_E),Y
01:253B C5AD            	   107:   CMP DOC_I
01:253D D00A            	   108:   BNE .df_n
01:253F 88              	   109:   DEY                    ; back to the previous character
01:2540 88              	   110:   DEY
01:2541 88              	   111:   DEY
01:2542 88              	   112:   DEY
01:2543 88              	   113:   DEY
01:2544 10EB            	   114:   BPL .df_c
01:2546 68              	   115:   PLA
01:2547 18              	   116:   CLC
01:2548 60              	   117:   RTS
                        	   118: .df_n:
01:2549 68              	   119:   PLA
01:254A 1A              	   120:   INC A
01:254B C910            	   121:   CMP #DOC_SLOTS+1
01:254D D0D4            	   122:   BNE .df_k
01:254F 38              	   123:   SEC
01:2550 60              	   124:   RTS
                        	   125: 
                        	   126: ; DOC_FREE: C=0 and A = first free slot, C=1 index full
                        	   127: DOC_FREE:
01:2551 A901            	   128:   LDA #1
                        	   129: .dfr_k:
01:2553 200D25          	   130:   JSR DOC_ENTRY
01:2556 A000            	   131:   LDY #0
01:2558 B1AA            	   132:   LDA (DOC_E),Y
01:255A F009            	   133:   BEQ .dfr_y
01:255C A5AC            	   134:   LDA DOC_K
01:255E 1A              	   135:   INC A
01:255F C910            	   136:   CMP #DOC_SLOTS+1
01:2561 D0F0            	   137:   BNE .dfr_k
01:2563 38              	   138:   SEC
01:2564 60              	   139:   RTS
                        	   140: .dfr_y:
01:2565 A5AC            	   141:   LDA DOC_K
01:2567 18              	   142:   CLC
01:2568 60              	   143:   RTS
                        	   144: 
                        	   145: ; DOC_SETENT: entry of slot A = type DOC_T, length DOC_LEN, name (DOC_P) (12 bytes)
                        	   146: DOC_SETENT:
01:2569 200D25          	   147:   JSR DOC_ENTRY
01:256C A000            	   148:   LDY #0
01:256E A5B8            	   149:   LDA DOC_T
01:2570 91AA            	   150:   STA (DOC_E),Y
01:2572 C8              	   151:   INY
01:2573 A5B9            	   152:   LDA DOC_LEN
01:2575 91AA            	   153:   STA (DOC_E),Y
01:2577 C8              	   154:   INY
01:2578 A5BA            	   155:   LDA DOC_LEN+1
01:257A 91AA            	   156:   STA (DOC_E),Y
01:257C C8              	   157:   INY
01:257D A900            	   158:   LDA #0
01:257F 91AA            	   159:   STA (DOC_E),Y
01:2581 A000            	   160:   LDY #0                 ; name: (DOC_P)+0..11 -> entry +4..15
                        	   161: .dse_n:
01:2583 B1A2            	   162:   LDA (DOC_P),Y
01:2585 C8              	   163:   INY
01:2586 C8              	   164:   INY
01:2587 C8              	   165:   INY
01:2588 C8              	   166:   INY
01:2589 91AA            	   167:   STA (DOC_E),Y
01:258B 88              	   168:   DEY
01:258C 88              	   169:   DEY
01:258D 88              	   170:   DEY
01:258E C00C            	   171:   CPY #DOC_NAMELEN
01:2590 D0F1            	   172:   BNE .dse_n
01:2592 60              	   173:   RTS
                        	   174: 
                        	   175: ; DOC_SECT: SD_LBA = DOC_BASE + DOC_K*40 + DOC_I
                        	   176: DOC_SECT:
01:2593 9C1803          	   177:   STZ SD_LBA+2
01:2596 9C1903          	   178:   STZ SD_LBA+3
01:2599 A5AC            	   179:   LDA DOC_K
01:259B 8D1603          	   180:   STA SD_LBA
01:259E 9C1703          	   181:   STZ SD_LBA+1
01:25A1 0E1603          	   182:   ASL SD_LBA             ; k*8
01:25A4 2E1703          	   183:   ROL SD_LBA+1
01:25A7 0E1603          	   184:   ASL SD_LBA
01:25AA 2E1703          	   185:   ROL SD_LBA+1
01:25AD 0E1603          	   186:   ASL SD_LBA
01:25B0 2E1703          	   187:   ROL SD_LBA+1
01:25B3 AD1703          	   188:   LDA SD_LBA+1           ; + k*32 = 4 * (k*8)
01:25B6 48              	   189:   PHA
01:25B7 AD1603          	   190:   LDA SD_LBA
01:25BA 48              	   191:   PHA
01:25BB 0E1603          	   192:   ASL SD_LBA
01:25BE 2E1703          	   193:   ROL SD_LBA+1
01:25C1 0E1603          	   194:   ASL SD_LBA
01:25C4 2E1703          	   195:   ROL SD_LBA+1
01:25C7 18              	   196:   CLC
01:25C8 68              	   197:   PLA
01:25C9 6D1603          	   198:   ADC SD_LBA
01:25CC 8D1603          	   199:   STA SD_LBA
01:25CF 68              	   200:   PLA
01:25D0 6D1703          	   201:   ADC SD_LBA+1
01:25D3 8D1703          	   202:   STA SD_LBA+1
01:25D6 18              	   203:   CLC
01:25D7 AD1603          	   204:   LDA SD_LBA
01:25DA 65AD            	   205:   ADC DOC_I
01:25DC 8D1603          	   206:   STA SD_LBA
01:25DF AD1703          	   207:   LDA SD_LBA+1
01:25E2 6940            	   208:   ADC #>DOC_BASE
01:25E4 8D1703          	   209:   STA SD_LBA+1
01:25E7 60              	   210:   RTS
                        	   211: 
                        	   212: DOC_LBA0:
01:25E8 9C1603          	   213:   STZ SD_LBA
01:25EB A940            	   214:   LDA #>DOC_BASE
01:25ED 8D1703          	   215:   STA SD_LBA+1
01:25F0 9C1803          	   216:   STZ SD_LBA+2
01:25F3 9C1903          	   217:   STZ SD_LBA+3
01:25F6 60              	   218:   RTS
                        	   219: 
                        	   220: ; DOC_XFER: DOC_K = slot, A = RAM page of the data, X/Y = length (lo/hi), C=0 read, C=1 write
                        	   221: ; Transfers ceil(length / 512) sectors. C=1 SD error
                        	   222: DOC_XFER:
01:25F7 85AF            	   223:   STA DOC_PG
01:25F9 08              	   224:   PHP
01:25FA 8A              	   225:   TXA                    ; sectors = (length + 511) / 512
01:25FB 18              	   226:   CLC
01:25FC 69FF            	   227:   ADC #$FF
01:25FE 98              	   228:   TYA
01:25FF 6901            	   229:   ADC #$01
01:2601 4A              	   230:   LSR
01:2602 85AE            	   231:   STA DOC_N
01:2604 64AD            	   232:   STZ DOC_I
01:2606 28              	   233:   PLP
01:2607 B017            	   234:   BCS .dx_w
                        	   235: .dx_r:
01:2609 A5AD            	   236:   LDA DOC_I
01:260B C5AE            	   237:   CMP DOC_N
01:260D B028            	   238:   BCS .dx_ok
01:260F 209325          	   239:   JSR DOC_SECT
01:2612 A200            	   240:   LDX #0
01:2614 A4AF            	   241:   LDY DOC_PG
01:2616 2018FD          	   242:   JSR JT_SD_READ
01:2619 B01D            	   243:   BCS .dx_x
01:261B 203926          	   244:   JSR .dx_next
01:261E 80E9            	   245:   BRA .dx_r
                        	   246: .dx_w:
01:2620 A5AD            	   247:   LDA DOC_I
01:2622 C5AE            	   248:   CMP DOC_N
01:2624 B011            	   249:   BCS .dx_ok
01:2626 209325          	   250:   JSR DOC_SECT
01:2629 A200            	   251:   LDX #0
01:262B A4AF            	   252:   LDY DOC_PG
01:262D 201BFD          	   253:   JSR JT_SD_WRITE
01:2630 B006            	   254:   BCS .dx_x
01:2632 203926          	   255:   JSR .dx_next
01:2635 80E9            	   256:   BRA .dx_w
                        	   257: .dx_ok:
01:2637 18              	   258:   CLC
                        	   259: .dx_x:
01:2638 60              	   260:   RTS
                        	   261: .dx_next:
01:2639 E6AD            	   262:   INC DOC_I
01:263B E6AF            	   263:   INC DOC_PG
01:263D E6AF            	   264:   INC DOC_PG
01:263F 4C261F          	   265:   JMP KB_POLL
                        	   266: 
                        	   267: DOC_MAGIC:
01:2642 444F4353        	   268:   .byte "DOCS",1,DOC_SLOTS
01:2646 01
01:2647 0F
                        	   269: 

