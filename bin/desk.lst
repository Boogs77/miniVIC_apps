01:23E0 D004            	   471:   BNE .fp_d
01:23E2 E6C3            	   472:   INC FA+3
01:23E4 302C            	   473:   BMI .fp_o
                        	   474: .fp_d:
01:23E6 A6D5            	   475:   LDX FD
01:23E8 3002            	   476:   BMI .fp_n
01:23EA E6D5            	   477:   INC FD
                        	   478: .fp_n:
01:23EC C8              	   479:   INY
01:23ED 80C5            	   480:   BRA .fp_l
                        	   481: .fp_pt:
01:23EF A6D5            	   482:   LDX FD
01:23F1 1005            	   483:   BPL .fp_e              ; a second point ends the number
01:23F3 64D5            	   484:   STZ FD
01:23F5 C8              	   485:   INY
01:23F6 80BC            	   486:   BRA .fp_l
                        	   487: .fp_e:
01:23F8 A5D4            	   488:   LDA FS
01:23FA F016            	   489:   BEQ .fp_o
01:23FC A5D5            	   490:   LDA FD                 ; scale to hundredths
01:23FE C902            	   491:   CMP #2
01:2400 F00E            	   492:   BEQ .fp_ok
01:2402 C901            	   493:   CMP #1
01:2404 F005            	   494:   BEQ .fp_1
01:2406 205E23          	   495:   JSR MUL10
01:2409 B006            	   496:   BCS .fp_x
                        	   497: .fp_1:
01:240B 205E23          	   498:   JSR MUL10
01:240E B001            	   499:   BCS .fp_x
                        	   500: .fp_ok:
01:2410 18              	   501:   CLC
                        	   502: .fp_x:
01:2411 60              	   503:   RTS
                        	   504: .fp_o:
01:2412 38              	   505:   SEC
01:2413 60              	   506:   RTS
                        	   507: 
                        	   508: ; F_FMT: FA -> F_OUT (text, $00 at the end), A = length. "1234", "-12.5" is "-12.50"
                        	   509: F_FMT:
01:2414 64D4            	   510:   STZ FS
01:2416 A5C3            	   511:   LDA FA+3
01:2418 1005            	   512:   BPL .ff_p
01:241A 201821          	   513:   JSR F_NEG
01:241D E6D4            	   514:   INC FS
                        	   515: .ff_p:
01:241F 204523          	   516:   JSR F_TOFP
01:2422 A5D4            	   517:   LDA FS
01:2424 F003            	   518:   BEQ .ff_a
01:2426 201821          	   519:   JSR F_NEG              ; FA back as it was
                        	   520: .ff_a:
01:2429 A964            	   521:   LDA #100
01:242B 85D6            	   522:   STA FT
01:242D 204822          	   523:   JSR DIVP8              ; FP = integer part, FR = hundredths
01:2430 64DD            	   524:   STZ FBCD
01:2432 64DE            	   525:   STZ FBCD+1
01:2434 64DF            	   526:   STZ FBCD+2
01:2436 64E0            	   527:   STZ FBCD+3
01:2438 64E1            	   528:   STZ FBCD+4
01:243A A220            	   529:   LDX #32
01:243C F8              	   530:   SED
                        	   531: .ff_b:
01:243D 06C8            	   532:   ASL FP
01:243F 26C9            	   533:   ROL FP+1
01:2441 26CA            	   534:   ROL FP+2
01:2443 26CB            	   535:   ROL FP+3
01:2445 A5DD            	   536:   LDA FBCD
01:2447 65DD            	   537:   ADC FBCD
01:2449 85DD            	   538:   STA FBCD
01:244B A5DE            	   539:   LDA FBCD+1
01:244D 65DE            	   540:   ADC FBCD+1
01:244F 85DE            	   541:   STA FBCD+1
01:2451 A5DF            	   542:   LDA FBCD+2
01:2453 65DF            	   543:   ADC FBCD+2
01:2455 85DF            	   544:   STA FBCD+2
01:2457 A5E0            	   545:   LDA FBCD+3
01:2459 65E0            	   546:   ADC FBCD+3
01:245B 85E0            	   547:   STA FBCD+3
01:245D A5E1            	   548:   LDA FBCD+4
01:245F 65E1            	   549:   ADC FBCD+4
01:2461 85E1            	   550:   STA FBCD+4
01:2463 CA              	   551:   DEX
01:2464 D0D7            	   552:   BNE .ff_b
01:2466 D8              	   553:   CLD
01:2467 A000            	   554:   LDY #0
01:2469 A5D4            	   555:   LDA FS
01:246B F006            	   556:   BEQ .ff_d
01:246D A92D            	   557:   LDA #'-'
01:246F 8DF005          	   558:   STA F_OUT
01:2472 C8              	   559:   INY
                        	   560: .ff_d:
01:2473 64D5            	   561:   STZ FD                 ; 1 once a digit is written
01:2475 A204            	   562:   LDX #4
                        	   563: .ff_dl:
01:2477 B5DD            	   564:   LDA FBCD,X
01:2479 4A              	   565:   LSR
01:247A 4A              	   566:   LSR
01:247B 4A              	   567:   LSR
01:247C 4A              	   568:   LSR
01:247D 20BB24          	   569:   JSR .ff_dig
01:2480 B5DD            	   570:   LDA FBCD,X
01:2482 290F            	   571:   AND #$0F
01:2484 E000            	   572:   CPX #0
