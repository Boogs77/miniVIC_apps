Sections:
00: "segfd0" (FD0-FD1)
01: "seg1000" (1000-28DF)


Source: "apps\desk.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   DESK  -  miniVIC DESK: calculator, calendar, clock         ;
                        	     4: ;   65C02 assembly, TMS9918A text mode 40 x 24                 ;
                        	     5: ;   Needs the BIOS 27.10.26 KEYB/SD                            ;
                        	     6: ;                                                              ;
                        	     7: ;   - three pages: F2 calculator, F3 calendar, F4 clock (Tab   ;
                        	     8: ;     goes to the next one), F1 help, Q or F10 back to the menu;
                        	     9: ;   - CALCULATOR: an adding machine with a paper tape;         ;
                        	    10: ;     + - * / = (Enter), Esc clears, Del clears the entry,     ;
                        	    11: ;     S changes the sign, M M+  N M-  R MR  K MC; numbers in   ;
                        	    12: ;     fixed point with 2 decimals (lib/fix32.asm)              ;
                        	    13: ;   - CALENDAR: one month, Monday first; arrows change month   ;
                        	    14: ;     (left / right) and year (up / down), Home = this month   ;
                        	    15: ;   - CLOCK: big digits, date, alarm. There is no clock chip:  ;
                        	    16: ;     the time is counted with the frame flag of the VDP       ;
                        	    17: ;     (status bit 7, 60 per second, set even with the VDP      ;
                        	    18: ;     interrupt off) and runs only while DESK runs. S sets     ;
                        	    19: ;     date and time, A the alarm, O switches it off           ;
                        	    20: ;                                                              ;
                        	    21: ;   MEMORY                                                     ;
                        	    22: ;   $0050-$007F  zero page (lib $A0-$E3)                       ;
                        	    23: ;   $0210-$024F  entry, accumulator, memory                    ;
                        	    24: ;   $3000-$30EF  paper tape: 15 rows of 16 characters          ;
                        	    25: ;                                                              ;
                        	    26: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    27: 
                        	    28:  .include "lib/system.inc"

Source: "lib\system.inc"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   SYSTEM.INC  -  miniVIC / BO6502 addresses for the apps     ;
                        	     4: ;   BIOS 27.10.26 KEYB/SD jump table, VDP, key codes           ;
                        	     5: ;                                                              ;
                        	     6: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     7: 
                        	     8: ; ---------------- BIOS jump table ($FD00) ----------------
                        	     9: JT_CHROUT       = $FD00    ; A = char to screen AND serial (not used by the apps)
                        	    10: JT_CHRIN        = $FD03    ; C=1 and A = key, C=0 no key (serial first, then keyboard)
                        	    11: JT_INIT_CRT     = $FD09    ; text mode, VRAM and font of the BIOS
                        	    12: JT_SHOW_MENU    = $FD0F    ; back to the BIOS menu (never returns)
                        	    13: JT_SD_READ      = $FD18    ; sector SD_LBA -> buffer X/Y (lo/hi, 512 bytes), C=1 error
                        	    14: JT_SD_WRITE     = $FD1B    ; buffer X/Y -> sector SD_LBA, C=1 error
                        	    15: JT_SD_INIT      = $FD1E    ; C=0 and A = card type, C=1 no card
                        	    16: JT_KB_MODE      = $FD21    ; A<>0 extended keyboard, A=0 classic
                        	    17: SD_LBA          = $0316    ; 4 bytes, sector number, little endian
                        	    18: 
                        	    19: ; ---------------- RAM vectors (everything is polled) ----------------
                        	    20: IRQ_VEC         = $0FA0    ; JSR $0FA0 from the BIOS IRQ handler
                        	    21: NMI_VEC         = $0FD0    ; JSR $0FD0 from the BIOS NMI handler
                        	    22: 
                        	    23: ; ---------------- VDP TMS9918A ----------------
                        	    24: VDP_DATA        = $B000
                        	    25: VDP_REG         = $B001
                        	    26: VRAM_NAME       = $0800    ; name table of the BIOS text mode (40 x 24)
                        	    27: VRAM_FONT       = $0000    ; patterns 0-127 (BIOS font), 128-255 = inverse (made by VT_INIT)
                        	    28: 
                        	    29: ; ---------------- serial W65C51 ----------------
                        	    30: ACIA_DATA   = $C000
                        	    31: ACIA_STATUS = $C001    ; bit 3 = byte received
                        	    32: ACIA_CMD    = $C002    ; BIOS: $8B (no parity, receive IRQ off, DTR on)
                        	    33: ACIA_CTRL   = $C003    ; BIOS: $1F (19200, 8 bits, 1 stop)
                        	    34: 
                        	    35: ; ---------------- key codes (extended mode) ----------------
                        	    36: K_CR            = $0D
                        	    37: K_BS            = $08
                        	    38: K_TAB           = $09
                        	    39: K_ESC           = $1B
                        	    40: K_UP            = $80
                        	    41: K_DOWN          = $81
                        	    42: K_LEFT          = $82
                        	    43: K_RIGHT         = $83
                        	    44: K_HOME          = $84
                        	    45: K_END           = $85
                        	    46: K_PGUP          = $86
                        	    47: K_PGDN          = $87
                        	    48: K_INS           = $88
                        	    49: K_DEL           = $89
                        	    50: K_F1            = $90      ; F1-F12 = $90-$9B
                        	    51: 

Source: "apps\desk.asm"
                        	    29: 
                        	    30: ; ---------------- parameters ----------------
                        	    31: FPS         = 60       ; VDP frames per second (TMS9918A)
                        	    32: ENTMAX      = 11
                        	    33: TAPEN       = 15       ; tape rows (screen rows 3-17)
                        	    34: TAPEW       = 16       ; (TAPEN * TAPEW < 256: one index register)
                        	    35: TAPECOL     = 12
                        	    36: 
                        	    37: ; ---------------- zero page ----------------
                        	    38: PAGE        = $50      ; 0 calculator, 1 calendar, 2 clock
                        	    39: MSGP        = $51      ; 2 bytes
                        	    40: DIRTY       = $53      ; 1 = page to redraw
                        	    41: FRM         = $54      ; frames in this second
                        	    42: HH          = $55      ; time
                        	    43: MM          = $56
                        	    44: SS          = $57
                        	    45: DY          = $58      ; 2 bytes: date (year, month, day)
                        	    46: DMO         = $5A
                        	    47: DDA         = $5B
                        	    48: DSET        = $5C      ; 1 = date and time were set
                        	    49: AH          = $5D      ; alarm
                        	    50: AM          = $5E
                        	    51: AON         = $5F
                        	    52: RING        = $60      ; 1 = the alarm rings
                        	    53: CYR         = $61      ; 2 bytes: calendar month shown
                        	    54: CMO         = $63
                        	    55: OPP         = $64      ; pending operation (0 none, + - * /)
                        	    56: ELEN        = $65      ; entry length
                        	    57: NEWE        = $66      ; 1 = an entry is being typed
                        	    58: T0          = $67
                        	    59: T1          = $68
                        	    60: T2          = $69
                        	    61: T3          = $6A
                        	    62: P0          = $6B      ; 2 bytes
                        	    63: ROWI        = $6D
                        	    64: COLI        = $6E
                        	    65: TICK        = $6F      ; 1 = a second went by
                        	    66: CERR        = $70      ; 1 = the calculator shows ERROR
                        	    67: YT          = $71      ; 2 bytes: year for the day of the week
                        	    68: NDAYS       = $73
                        	    69: FRESH       = $74      ; 1 = the entry shown is done (after M+ M-): a digit starts a new one
                        	    70: 
                        	    71: ; ---------------- RAM ----------------
                        	    72: ENT         = $0210    ; entry text (11 + $00)
                        	    73: ACC         = $0220    ; 4 bytes: running total
                        	    74: MEMV        = $0224    ; 4 bytes: memory
                        	    75: TAPE        = $3000    ; 16 x 24
                        	    76: 
                        	    77:  .org $0FD0
00:0FD0 60              	    78:   RTS                    ; NMI trampoline (the VDP interrupt is off)
                        	    79:  .org $1000
                        	    80: 
                        	    81: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; start and main loop
                        	    82: 
                        	    83: RESET:
01:1000 78              	    84:   SEI
01:1001 D8              	    85:   CLD
01:1002 A2FF            	    86:   LDX #$FF
01:1004 9A              	    87:   TXS
01:1005 A960            	    88:   LDA #$60
01:1007 8DA00F          	    89:   STA IRQ_VEC
01:100A 20751F          	    90:   JSR VT_INIT
01:100D 20EB1E          	    91:   JSR KB_INIT
01:1010 6450            	    92:   STZ PAGE
01:1012 6454            	    93:   STZ FRM
01:1014 6455            	    94:   STZ HH
01:1016 6456            	    95:   STZ MM
01:1018 6457            	    96:   STZ SS
01:101A 645C            	    97:   STZ DSET
01:101C 645F            	    98:   STZ AON
01:101E 6460            	    99:   STZ RING
01:1020 A9EA            	   100:   LDA #<2026             ; until it is set: 1 January 2026
01:1022 8558            	   101:   STA DY
01:1024 8561            	   102:   STA CYR
01:1026 A907            	   103:   LDA #>2026
01:1028 8559            	   104:   STA DY+1
01:102A 8562            	   105:   STA CYR+1
01:102C A901            	   106:   LDA #1
01:102E 855A            	   107:   STA DMO
01:1030 855B            	   108:   STA DDA
01:1032 8563            	   109:   STA CMO
01:1034 20D611          	   110:   JSR CALCCLR
01:1037 20EC11          	   111:   JSR TAPECLR
01:103A A901            	   112:   LDA #1
01:103C 8553            	   113:   STA DIRTY
                        	   114: MAIN:
01:103E A553            	   115:   LDA DIRTY
01:1040 F005            	   116:   BEQ .mn_t
01:1042 6453            	   117:   STZ DIRTY
01:1044 204311          	   118:   JSR DRAWPAGE
                        	   119: .mn_t:
01:1047 A56F            	   120:   LDA TICK
01:1049 F00B            	   121:   BEQ .mn_m
01:104B 646F            	   122:   STZ TICK
01:104D A550            	   123:   LDA PAGE
01:104F C902            	   124:   CMP #2
01:1051 D003            	   125:   BNE .mn_m
01:1053 209717          	   126:   JSR CLOCKBODY
                        	   127: .mn_m:
01:1056 208611          	   128:   JSR MSGLINE
                        	   129: IDLE:
01:1059 207410          	   130:   JSR FRAME              ; time
01:105C A56F            	   131:   LDA TICK
01:105E D0DE            	   132:   BNE MAIN
01:1060 20481F          	   133:   JSR GETKEY
01:1063 90F4            	   134:   BCC IDLE
01:1065 6452            	   135:   STZ MSGP+1
01:1067 A660            	   136:   LDX RING               ; a ringing alarm stops with any key
01:1069 F004            	   137:   BEQ .mn_k
01:106B 6460            	   138:   STZ RING
01:106D 80CF            	   139:   BRA MAIN
                        	   140: .mn_k:
01:106F 20EB10          	   141:   JSR DOKEY
01:1072 80CA            	   142:   BRA MAIN
                        	   143: 
                        	   144: ; FRAME: one VDP frame more (status bit 7) -> the seconds, the date, the alarm
                        	   145: FRAME:
01:1074 AD01B0          	   146:   LDA VDP_REG
01:1077 1043            	   147:   BPL .fr_x
01:1079 E654            	   148:   INC FRM
01:107B A554            	   149:   LDA FRM
01:107D C93C            	   150:   CMP #FPS
01:107F 903B            	   151:   BCC .fr_x
01:1081 6454            	   152:   STZ FRM
01:1083 A901            	   153:   LDA #1
01:1085 856F            	   154:   STA TICK
01:1087 E657            	   155:   INC SS
01:1089 A557            	   156:   LDA SS
01:108B C93C            	   157:   CMP #60
01:108D 902D            	   158:   BCC .fr_x
01:108F 6457            	   159:   STZ SS
01:1091 E656            	   160:   INC MM
01:1093 A556            	   161:   LDA MM
01:1095 C93C            	   162:   CMP #60
01:1097 900F            	   163:   BCC .fr_al
01:1099 6456            	   164:   STZ MM
01:109B E655            	   165:   INC HH
01:109D A555            	   166:   LDA HH
01:109F C918            	   167:   CMP #24
01:10A1 9005            	   168:   BCC .fr_al
01:10A3 6455            	   169:   STZ HH
01:10A5 20BD10          	   170:   JSR NEXTDAY
                        	   171: .fr_al:
01:10A8 A55F            	   172:   LDA AON                ; alarm at hh:mm:00
01:10AA F010            	   173:   BEQ .fr_x
01:10AC A555            	   174:   LDA HH
01:10AE C55D            	   175:   CMP AH
01:10B0 D00A            	   176:   BNE .fr_x
01:10B2 A556            	   177:   LDA MM
01:10B4 C55E            	   178:   CMP AM
01:10B6 D004            	   179:   BNE .fr_x
01:10B8 A901            	   180:   LDA #1
01:10BA 8560            	   181:   STA RING
                        	   182: .fr_x:
01:10BC 60              	   183:   RTS
                        	   184: 
                        	   185: ; NEXTDAY: the date one day on
                        	   186: NEXTDAY:
01:10BD A558            	   187:   LDA DY
01:10BF 8571            	   188:   STA YT
01:10C1 A559            	   189:   LDA DY+1
01:10C3 8572            	   190:   STA YT+1
01:10C5 A55A            	   191:   LDA DMO
01:10C7 203A16          	   192:   JSR MDAYS
01:10CA E65B            	   193:   INC DDA
01:10CC A55B            	   194:   LDA DDA
01:10CE C573            	   195:   CMP NDAYS
01:10D0 F018            	   196:   BEQ .nd_x
01:10D2 9016            	   197:   BCC .nd_x
01:10D4 A901            	   198:   LDA #1
01:10D6 855B            	   199:   STA DDA
01:10D8 E65A            	   200:   INC DMO
01:10DA A55A            	   201:   LDA DMO
01:10DC C90D            	   202:   CMP #13
01:10DE 900A            	   203:   BCC .nd_x
01:10E0 A901            	   204:   LDA #1
01:10E2 855A            	   205:   STA DMO
01:10E4 E658            	   206:   INC DY
01:10E6 D002            	   207:   BNE .nd_x
01:10E8 E659            	   208:   INC DY+1
                        	   209: .nd_x:
01:10EA 60              	   210:   RTS
                        	   211: 
                        	   212: ; DOKEY: the keys of every page, then those of the page
                        	   213: DOKEY:
01:10EB C991            	   214:   CMP #K_F1+1
01:10ED F043            	   215:   BEQ .dk_p0
01:10EF C992            	   216:   CMP #K_F1+2
01:10F1 F043            	   217:   BEQ .dk_p1
01:10F3 C993            	   218:   CMP #K_F1+3
01:10F5 F043            	   219:   BEQ .dk_p2
01:10F7 C909            	   220:   CMP #K_TAB
01:10F9 F02C            	   221:   BEQ .dk_tab
01:10FB C990            	   222:   CMP #K_F1
01:10FD D003            	   223:   BNE .dk_q
01:10FF 4C881A          	   224:   JMP HELP
                        	   225: .dk_q:
01:1102 C999            	   226:   CMP #K_F1+9            ; F10
01:1104 F01B            	   227:   BEQ .dk_exit
01:1106 48              	   228:   PHA
01:1107 20D426          	   229:   JSR UI_UPC
01:110A C951            	   230:   CMP #'Q'
01:110C F012            	   231:   BEQ .dk_qq
01:110E 68              	   232:   PLA
01:110F A650            	   233:   LDX PAGE
01:1111 F007            	   234:   BEQ .dk_c
01:1113 E001            	   235:   CPX #1
01:1115 F006            	   236:   BEQ .dk_cal
01:1117 4CFE18          	   237:   JMP CLOCKKEY
                        	   238: .dk_c:
01:111A 4CC612          	   239:   JMP CALCKEY
                        	   240: .dk_cal:
01:111D 4C2817          	   241:   JMP CALKEY
                        	   242: .dk_qq:
01:1120 68              	   243:   PLA
                        	   244: .dk_exit:
01:1121 200F1F          	   245:   JSR KB_EXIT
01:1124 4C0FFD          	   246:   JMP JT_SHOW_MENU
                        	   247: .dk_tab:
01:1127 A550            	   248:   LDA PAGE
01:1129 1A              	   249:   INC A
01:112A C903            	   250:   CMP #3
01:112C 900E            	   251:   BCC .dk_set
01:112E A900            	   252:   LDA #0
01:1130 800A            	   253:   BRA .dk_set
                        	   254: .dk_p0:
01:1132 A900            	   255:   LDA #0
01:1134 8006            	   256:   BRA .dk_set
                        	   257: .dk_p1:
01:1136 A901            	   258:   LDA #1
01:1138 8002            	   259:   BRA .dk_set
                        	   260: .dk_p2:
01:113A A902            	   261:   LDA #2
                        	   262: .dk_set:
01:113C 8550            	   263:   STA PAGE
01:113E A901            	   264:   LDA #1
01:1140 8553            	   265:   STA DIRTY
01:1142 60              	   266:   RTS
                        	   267: 
                        	   268: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; screen
                        	   269: 
                        	   270: ; DRAWPAGE: the page tabs (row 0), the page, the hint (row 22)
                        	   271: DRAWPAGE:
01:1143 205F20          	   272:   JSR VT_CLS
01:1146 A900            	   273:   LDA #0
01:1148 20F01F          	   274:   JSR VT_ROW
01:114B A200            	   275:   LDX #0
                        	   276: .dp_t:
01:114D BDDA1B          	   277:   LDA M_TABS,X           ; the tab of the page in normal video, the others in inverse
01:1150 F016            	   278:   BEQ .dp_b
01:1152 8568            	   279:   STA T1
01:1154 8A              	   280:   TXA
01:1155 207911          	   281:   JSR TABOF
01:1158 C550            	   282:   CMP PAGE
01:115A 08              	   283:   PHP
01:115B A568            	   284:   LDA T1
01:115D 28              	   285:   PLP
01:115E F002            	   286:   BEQ .dp_n
01:1160 0980            	   287:   ORA #$80
                        	   288: .dp_n:
01:1162 8D00B0          	   289:   STA VDP_DATA
01:1165 E8              	   290:   INX
01:1166 80E5            	   291:   BRA .dp_t
                        	   292: .dp_b:
01:1168 A550            	   293:   LDA PAGE
01:116A F007            	   294:   BEQ .dp_c
01:116C C901            	   295:   CMP #1
01:116E F006            	   296:   BEQ .dp_cal
01:1170 4C9017          	   297:   JMP CLOCKPAGE
                        	   298: .dp_c:
01:1173 4CFA11          	   299:   JMP CALCPAGE
                        	   300: .dp_cal:
01:1176 4C3C15          	   301:   JMP CALPAGE
                        	   302: 
                        	   303: ; TABOF: A = column 0-39 -> A = its tab (13 columns each)
                        	   304: TABOF:
01:1179 A000            	   305:   LDY #0
                        	   306: .tb_l:
01:117B C90D            	   307:   CMP #13
01:117D 9005            	   308:   BCC .tb_x
01:117F E90D            	   309:   SBC #13
01:1181 C8              	   310:   INY
01:1182 80F7            	   311:   BRA .tb_l
                        	   312: .tb_x:
01:1184 98              	   313:   TYA
01:1185 60              	   314:   RTS
                        	   315: 
                        	   316: ; MSGLINE: row 23: the alarm, a message or nothing
                        	   317: MSGLINE:
01:1186 A917            	   318:   LDA #23
01:1188 20F01F          	   319:   JSR VT_ROW
01:118B A560            	   320:   LDA RING
01:118D F00E            	   321:   BEQ .ms_m
01:118F A557            	   322:   LDA SS                 ; flashing: inverse every other second
01:1191 4A              	   323:   LSR
01:1192 A900            	   324:   LDA #0
01:1194 6A              	   325:   ROR
01:1195 85A4            	   326:   STA VT_INV
01:1197 A98E            	   327:   LDA #<M_RING
01:1199 A21C            	   328:   LDX #>M_RING
01:119B 800C            	   329:   BRA .ms_o
                        	   330: .ms_m:
01:119D 64A4            	   331:   STZ VT_INV
01:119F A551            	   332:   LDA MSGP
01:11A1 A652            	   333:   LDX MSGP+1
01:11A3 D004            	   334:   BNE .ms_o
01:11A5 A9B1            	   335:   LDA #<M_EMPTY
01:11A7 A21C            	   336:   LDX #>M_EMPTY
                        	   337: .ms_o:
01:11A9 A000            	   338:   LDY #0
01:11AB 203B20          	   339:   JSR VT_LINE
01:11AE 64A4            	   340:   STZ VT_INV
01:11B0 60              	   341:   RTS
                        	   342: 
                        	   343: SETMSG:
01:11B1 8551            	   344:   STA MSGP
01:11B3 8652            	   345:   STX MSGP+1
01:11B5 60              	   346:   RTS
                        	   347: 
                        	   348: ; HINT: text A/X on row 22
                        	   349: HINT:
01:11B6 DA              	   350:   PHX
01:11B7 48              	   351:   PHA
01:11B8 A916            	   352:   LDA #22
01:11BA 20F01F          	   353:   JSR VT_ROW
01:11BD 68              	   354:   PLA
01:11BE FA              	   355:   PLX
01:11BF A000            	   356:   LDY #0
01:11C1 4C3B20          	   357:   JMP VT_LINE
                        	   358: 
                        	   359: ; PUTS: text A/X at row T0, column T1
                        	   360: PUTS:
01:11C4 DA              	   361:   PHX
01:11C5 48              	   362:   PHA
01:11C6 A567            	   363:   LDA T0
01:11C8 A668            	   364:   LDX T1
01:11CA 20FD1F          	   365:   JSR VT_AT
01:11CD 68              	   366:   PLA
01:11CE FA              	   367:   PLX
01:11CF 85A2            	   368:   STA VT_P
01:11D1 86A3            	   369:   STX VT_P+1
01:11D3 4C2420          	   370:   JMP VT_STR
                        	   371: 
                        	   372: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; calculator
                        	   373: 
                        	   374: CALCCLR:
01:11D6 6474            	   375:   STZ FRESH
01:11D8 A203            	   376:   LDX #3
                        	   377: .cc_l:
01:11DA 9E2002          	   378:   STZ ACC,X
01:11DD CA              	   379:   DEX
01:11DE 10FA            	   380:   BPL .cc_l
01:11E0 6464            	   381:   STZ OPP
01:11E2 6465            	   382:   STZ ELEN
01:11E4 9C1002          	   383:   STZ ENT
01:11E7 6466            	   384:   STZ NEWE
01:11E9 6470            	   385:   STZ CERR
01:11EB 60              	   386:   RTS
                        	   387: 
                        	   388: TAPECLR:
01:11EC A200            	   389:   LDX #0
