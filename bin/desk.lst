                        	  1811:  .include "lib/keys.asm"

Source: "lib\keys.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   KEYS.ASM  -  key queue on top of the BIOS                  ;
                        	     4: ;                                                              ;
                        	     5: ;   The PS/2 board keeps one byte: a byte not read within      ;
                        	     6: ;   ~1 ms is lost (a lost $F0 turns a release into a second    ;
                        	     7: ;   press). Two ways in, both on: the CA1 interrupt of the     ;
                        	     8: ;   keyboard VIA (IRQ -> BIOS -> JMP KB_IRQ at $0FA0) reads    ;
                        	     9: ;   every byte at once; KB_POLL, called by the long loops,     ;
                        	    10: ;   does the same if the IRQ line is not there. Assembled      ;
                        	    11: ;   with -DKB_NOIRQ=1 only the polling is left.                ;
                        	    12: ;   The keys decoded by the BIOS go into a 32-key queue,       ;
                        	    13: ;   GETKEY takes them out. KB_EXIT before leaving the app.     ;
                        	    14: ;   An app that uses the serial line itself defines KB_SERBUF  ;
                        	    15: ;   (256-byte ring): the received bytes go there, not among    ;
                        	    16: ;   the keys (JT_CHRIN reads the serial line first: a byte it  ;
                        	    17: ;   returns while CA1 is still set came from the serial line). ;
                        	    18: ;   Uses: zp $A0-$A1 ($F0-$F1 with KB_SERBUF), RAM $05C0-$05DF ;
                        	    19: ;                                                              ;
                        	    20: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    21: 
                        	    22: KQ          = $05C0    ; 32-key ring
                        	    23: KQ_MASK     = $1F
                        	    24: KQR         = $A0      ; read index
                        	    25: KQW         = $A1      ; write index
                        	    26: KB_IFR      = $D18D    ; keyboard VIA: interrupt flags (bit 1 = CA1)
                        	    27: KB_IER      = $D18E    ;               interrupt enable
                        	    28: KB_SRR      = $F0      ; serial ring (KB_SERBUF): read index
                        	    29: KB_SRW      = $F1      ;                          write index
                        	    30: 
                        	    31: ; KB_INIT: extended keyboard, empty queue, CA1 interrupt on
                        	    32: KB_INIT:
01:1EEB 78              	    33:   SEI
01:1EEC A901            	    34:   LDA #1
01:1EEE 2021FD          	    35:   JSR JT_KB_MODE
01:1EF1 64A0            	    36:   STZ KQR
01:1EF3 64A1            	    37:   STZ KQW
01:1EF5 64F0            	    38:   STZ KB_SRR
01:1EF7 64F1            	    39:   STZ KB_SRW
                        	    40:  .ifndef KB_NOIRQ
01:1EF9 A94C            	    41:   LDA #$4C               ; JMP KB_IRQ in the RAM vector of the BIOS
01:1EFB 8DA00F          	    42:   STA IRQ_VEC
01:1EFE A91B            	    43:   LDA #<KB_IRQ
01:1F00 8DA10F          	    44:   STA IRQ_VEC+1
01:1F03 A91F            	    45:   LDA #>KB_IRQ
01:1F05 8DA20F          	    46:   STA IRQ_VEC+2
01:1F08 A982            	    47:   LDA #$82               ; CA1 interrupt enabled
01:1F0A 8D8ED1          	    48:   STA KB_IER
01:1F0D 58              	    49:   CLI
                        	    50:  .endif
01:1F0E 60              	    51:   RTS
                        	    52: 
                        	    53: ; KB_EXIT: interrupt off again (the BIOS menu works by polling)
                        	    54: KB_EXIT:
01:1F0F 78              	    55:   SEI
01:1F10 A902            	    56:   LDA #$02
01:1F12 8D8ED1          	    57:   STA KB_IER
01:1F15 A960            	    58:   LDA #$60               ; RTS
01:1F17 8DA00F          	    59:   STA IRQ_VEC
01:1F1A 60              	    60:   RTS
                        	    61: 
                        	    62: ; KB_IRQ: called by the BIOS IRQ handler (A, X, Y already saved)
                        	    63: KB_IRQ:
                        	    64:  .ifdef KB_SERBUF
                        	    65:   JMP KB_TAKE            ; the keyboard or the serial line
                        	    66:  .else
01:1F1B AD8DD1          	    67:   LDA KB_IFR
01:1F1E 2902            	    68:   AND #$02
01:1F20 F003            	    69:   BEQ .ki_x
01:1F22 20331F          	    70:   JSR KB_TAKE
                        	    71: .ki_x:
01:1F25 60              	    72:   RTS
                        	    73:  .endif
                        	    74: 
                        	    75: ; KB_POLL: one BIOS poll with the interrupt held off. Keeps A, X, Y and the I flag
                        	    76: KB_POLL:
01:1F26 08              	    77:   PHP
01:1F27 78              	    78:   SEI
01:1F28 48              	    79:   PHA
01:1F29 DA              	    80:   PHX
01:1F2A 5A              	    81:   PHY
01:1F2B 20331F          	    82:   JSR KB_TAKE
01:1F2E 7A              	    83:   PLY
01:1F2F FA              	    84:   PLX
01:1F30 68              	    85:   PLA
01:1F31 28              	    86:   PLP
01:1F32 60              	    87:   RTS
                        	    88: 
                        	    89: ; KB_TAKE: a key from the BIOS goes into the queue (full queue: dropped)
                        	    90: KB_TAKE:
                        	    91:  .ifdef KB_SERBUF
                        	    92: .kt_rx:
                        	    93:   LDA ACIA_STATUS        ; received bytes first, into their ring
                        	    94:   AND #$08
                        	    95:   BEQ .kt_kb
                        	    96:   LDA ACIA_DATA
                        	    97:   JSR KB_SERPUT
                        	    98:   BRA .kt_rx
                        	    99: .kt_kb:
                        	   100:   LDA KB_IFR
                        	   101:   AND #$02
                        	   102:   BEQ .kt_x
                        	   103:   JSR JT_CHRIN
                        	   104:   BCC .kt_x
                        	   105:   PHA
                        	   106:   LDA KB_IFR             ; CA1 still set: the BIOS took a serial byte, not the key
                        	   107:   AND #$02
                        	   108:   BEQ .kt_key
                        	   109:   PLA
                        	   110:   JSR KB_SERPUT
                        	   111:   BRA .kt_rx
                        	   112: .kt_key:
                        	   113:   PLA
                        	   114:  .else
01:1F33 2003FD          	   115:   JSR JT_CHRIN
01:1F36 900F            	   116:   BCC .kt_x
                        	   117:  .endif
01:1F38 A6A1            	   118:   LDX KQW
01:1F3A 9DC005          	   119:   STA KQ,X
01:1F3D 8A              	   120:   TXA
01:1F3E 1A              	   121:   INC A
01:1F3F 291F            	   122:   AND #KQ_MASK
01:1F41 C5A0            	   123:   CMP KQR
01:1F43 F002            	   124:   BEQ .kt_x              ; full
01:1F45 85A1            	   125:   STA KQW
                        	   126: .kt_x:
01:1F47 60              	   127:   RTS
                        	   128: 
                        	   129:  .ifdef KB_SERBUF
                        	   130: ; KB_SERPUT: A into the serial ring (full: dropped)
                        	   131: KB_SERPUT:
                        	   132:   LDX KB_SRW
                        	   133:   STA KB_SERBUF,X
                        	   134:   INX
                        	   135:   CPX KB_SRR
                        	   136:   BEQ .ks_x
                        	   137:   STX KB_SRW
                        	   138: .ks_x:
                        	   139:   RTS
                        	   140: 
                        	   141: ; SERGET: C=1 and A = next received byte, C=0 none
                        	   142: SERGET:
                        	   143:   JSR KB_POLL
                        	   144:   LDX KB_SRR
                        	   145:   CPX KB_SRW
                        	   146:   BEQ .sg_n
                        	   147:   LDA KB_SERBUF,X
                        	   148:   INC KB_SRR
                        	   149:   SEC
                        	   150:   RTS
                        	   151: .sg_n:
                        	   152:   CLC
                        	   153:   RTS
                        	   154:  .endif
                        	   155: 
                        	   156: ; GETKEY: C=1 and A = key, C=0 queue empty (after one poll). Keeps X, Y
                        	   157: GETKEY:
01:1F48 20261F          	   158:   JSR KB_POLL
01:1F4B A5A0            	   159:   LDA KQR
01:1F4D C5A1            	   160:   CMP KQW
01:1F4F F010            	   161:   BEQ .gk_n
01:1F51 DA              	   162:   PHX
01:1F52 AA              	   163:   TAX
01:1F53 BDC005          	   164:   LDA KQ,X
01:1F56 48              	   165:   PHA
01:1F57 8A              	   166:   TXA
01:1F58 1A              	   167:   INC A
01:1F59 291F            	   168:   AND #KQ_MASK
01:1F5B 85A0            	   169:   STA KQR
01:1F5D 68              	   170:   PLA
01:1F5E FA              	   171:   PLX
01:1F5F 38              	   172:   SEC
01:1F60 60              	   173:   RTS
                        	   174: .gk_n:
01:1F61 18              	   175:   CLC
01:1F62 60              	   176:   RTS
                        	   177: 
                        	   178: ; WAITKEY: A = next key
                        	   179: WAITKEY:
01:1F63 20481F          	   180:   JSR GETKEY
01:1F66 90FB            	   181:   BCC WAITKEY
01:1F68 60              	   182:   RTS
                        	   183: 
                        	   184: ; KEYREADY: C=1 if a key is waiting in the queue
                        	   185: KEYREADY:
01:1F69 20261F          	   186:   JSR KB_POLL
01:1F6C A5A0            	   187:   LDA KQR
01:1F6E C5A1            	   188:   CMP KQW
01:1F70 18              	   189:   CLC
01:1F71 F001            	   190:   BEQ .kr_x
01:1F73 38              	   191:   SEC
                        	   192: .kr_x:
01:1F74 60              	   193:   RTS
                        	   194: 

