                        	  2501:  .include "lib/num.asm"

Source: "lib\num.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   NUM.ASM  -  16-bit numbers to decimal text                 ;
                        	     4: ;   Uses: zp $A5-$A9                                           ;
                        	     5: ;                                                              ;
                        	     6: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     7: 
                        	     8: NUM         = $A5      ; 2 bytes: number to convert (destroyed)
                        	     9: BCD         = $A7      ; 3 bytes: BCD result, $A7 = lowest 2 digits
                        	    10: 
                        	    11: ; BIN2BCD: NUM -> BCD (double dabble with decimal mode)
                        	    12: BIN2BCD:
01:24A3 202623          	    13:   JSR KB_POLL
01:24A6 64A7            	    14:   STZ BCD
01:24A8 64A8            	    15:   STZ BCD+1
01:24AA 64A9            	    16:   STZ BCD+2
01:24AC A210            	    17:   LDX #16
01:24AE F8              	    18:   SED
                        	    19: .bb_l:
01:24AF 06A5            	    20:   ASL NUM
01:24B1 26A6            	    21:   ROL NUM+1
01:24B3 A5A7            	    22:   LDA BCD
01:24B5 65A7            	    23:   ADC BCD
01:24B7 85A7            	    24:   STA BCD
01:24B9 A5A8            	    25:   LDA BCD+1
01:24BB 65A8            	    26:   ADC BCD+1
01:24BD 85A8            	    27:   STA BCD+1
01:24BF A5A9            	    28:   LDA BCD+2
01:24C1 65A9            	    29:   ADC BCD+2
01:24C3 85A9            	    30:   STA BCD+2
01:24C5 CA              	    31:   DEX
01:24C6 D0E7            	    32:   BNE .bb_l
01:24C8 D8              	    33:   CLD
01:24C9 60              	    34:   RTS
                        	    35: 
                        	    36: ; NUMSTR: NUM -> 5 characters at (VT_P),Y.. with leading spaces (last digit always shown)
                        	    37: ; Y = first position; on exit Y = position after the number
                        	    38: NUMSTR:
01:24CA 20A324          	    39:   JSR BIN2BCD
01:24CD 202623          	    40:   JSR KB_POLL            ; (BIN2BCD takes ~600 cycles)
01:24D0 A200            	    41:   LDX #0                 ; X = 1 once a digit is not zero
01:24D2 A5A9            	    42:   LDA BCD+2
01:24D4 20F224          	    43:   JSR .ns_dig            ; ten thousands
01:24D7 A5A8            	    44:   LDA BCD+1
01:24D9 4A              	    45:   LSR
01:24DA 4A              	    46:   LSR
01:24DB 4A              	    47:   LSR
01:24DC 4A              	    48:   LSR
01:24DD 20F224          	    49:   JSR .ns_dig
01:24E0 A5A8            	    50:   LDA BCD+1
01:24E2 20F224          	    51:   JSR .ns_dig
01:24E5 A5A7            	    52:   LDA BCD
01:24E7 4A              	    53:   LSR
01:24E8 4A              	    54:   LSR
01:24E9 4A              	    55:   LSR
01:24EA 4A              	    56:   LSR
01:24EB 20F224          	    57:   JSR .ns_dig
01:24EE A5A7            	    58:   LDA BCD
01:24F0 A201            	    59:   LDX #1                 ; the last digit is always written
                        	    60: .ns_dig:
01:24F2 290F            	    61:   AND #$0F
01:24F4 D008            	    62:   BNE .ns_nz
01:24F6 E000            	    63:   CPX #0
01:24F8 D004            	    64:   BNE .ns_nz
01:24FA A920            	    65:   LDA #' '
01:24FC 8004            	    66:   BRA .ns_put
                        	    67: .ns_nz:
01:24FE A201            	    68:   LDX #1
01:2500 0930            	    69:   ORA #'0'
                        	    70: .ns_put:
01:2502 91A2            	    71:   STA (VT_P),Y
01:2504 C8              	    72:   INY
01:2505 60              	    73:   RTS
                        	    74: 

Source: "apps\write.asm"
                        	  2502:  .include "lib/docs.asm"

Source: "lib\docs.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   DOCS.ASM  -  documents in the SD document area             ;
                        	     4: ;                                                              ;
                        	     5: ;   Sector 16384 ($00800000, after the 255 program blocks)     ;
                        	     6: ;   is the index: +0 "DOCS", +4 version 1, +5 slots (15);      ;
                        	     7: ;   entry k (1-15) at k*32: +0 type (0 free, 1 text,           ;
                        	     8: ;   2 sheet, 3 card file),                                     ;
                        	     9: ;   +1/+2 length, +4..+15 name (12 chars, $00 padded).         ;
                        	    10: ;   Document k = 40 sectors (20 KB) from sector 16384 + k*40.  ;
                        	    11: ;   Sectors go through the BIOS (JT_SD_READ / JT_SD_WRITE).    ;
                        	    12: ;   Uses: zp $AA-$AF, $B8-$BA, RAM $0600-$07FF (index sector)  ;
                        	    13: ;                                                              ;
                        	    14: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    15: 
                        	    16: DOC_IDX     = $0600    ; index sector (512 bytes)
                        	    17: DOC_BASE    = $4000    ; sector 16384
                        	    18: DOC_SLOTS   = 15
                        	    19: DOC_SECTS   = 40       ; sectors per document
                        	    20: DOC_NAMELEN = 12
                        	    21: DOC_E       = $AA      ; 2 bytes: pointer to the index entry
                        	    22: DOC_K       = $AC      ; slot
                        	    23: DOC_I       = $AD      ; sector inside the document
                        	    24: DOC_N       = $AE      ; sectors to transfer
                        	    25: DOC_PG      = $AF      ; RAM page of the transfer
                        	    26: DOC_T       = $B8      ; document type of the application (1 text, 2 sheet, 3 card file)
                        	    27: DOC_LEN     = $B9      ; 2 bytes: length for DOC_SETENT
                        	    28: 
                        	    29: ; DOC_RDIDX: reads the index; a sector without "DOCS" becomes an empty index. C=1 SD error
                        	    30: DOC_RDIDX:
01:2506 201E26          	    31:   JSR DOC_LBA0
01:2509 A200            	    32:   LDX #<DOC_IDX
01:250B A006            	    33:   LDY #>DOC_IDX
01:250D 2018FD          	    34:   JSR JT_SD_READ
01:2510 B00E            	    35:   BCS .dr_x
01:2512 A203            	    36:   LDX #3
                        	    37: .dr_m:
01:2514 BD0006          	    38:   LDA DOC_IDX,X
01:2517 DD7826          	    39:   CMP DOC_MAGIC,X
01:251A D005            	    40:   BNE .dr_new
01:251C CA              	    41:   DEX
01:251D 10F5            	    42:   BPL .dr_m
01:251F 18              	    43:   CLC
                        	    44: .dr_x:
01:2520 60              	    45:   RTS
                        	    46: .dr_new:
01:2521 A200            	    47:   LDX #0
                        	    48: .dr_z:
01:2523 9E0006          	    49:   STZ DOC_IDX,X
01:2526 9E0007          	    50:   STZ DOC_IDX+$100,X
01:2529 E8              	    51:   INX
01:252A D0F7            	    52:   BNE .dr_z
01:252C A205            	    53:   LDX #5
                        	    54: .dr_h:
01:252E BD7826          	    55:   LDA DOC_MAGIC,X
01:2531 9D0006          	    56:   STA DOC_IDX,X
01:2534 CA              	    57:   DEX
01:2535 10F7            	    58:   BPL .dr_h
01:2537 18              	    59:   CLC
01:2538 60              	    60:   RTS
                        	    61: 
                        	    62: ; DOC_WRIDX: writes the index. C=1 SD error
                        	    63: DOC_WRIDX:
01:2539 201E26          	    64:   JSR DOC_LBA0
01:253C A200            	    65:   LDX #<DOC_IDX
01:253E A006            	    66:   LDY #>DOC_IDX
01:2540 4C1BFD          	    67:   JMP JT_SD_WRITE
                        	    68: 
                        	    69: ; DOC_ENTRY: A = slot (1-15) -> DOC_E = its index entry. Keeps X, Y
                        	    70: DOC_ENTRY:
01:2543 85AC            	    71:   STA DOC_K
01:2545 4A              	    72:   LSR
01:2546 4A              	    73:   LSR
01:2547 4A              	    74:   LSR
01:2548 18              	    75:   CLC
01:2549 6906            	    76:   ADC #>DOC_IDX
01:254B 85AB            	    77:   STA DOC_E+1
01:254D A5AC            	    78:   LDA DOC_K
01:254F 0A              	    79:   ASL
01:2550 0A              	    80:   ASL
01:2551 0A              	    81:   ASL
01:2552 0A              	    82:   ASL
01:2553 0A              	    83:   ASL
01:2554 85AA            	    84:   STA DOC_E              ; (DOC_IDX is page aligned)
01:2556 60              	    85:   RTS
                        	    86: 
                        	    87: ; DOC_FIND: name of 12 bytes at (DOC_P) and type DOC_T -> C=0 and A = slot, C=1 not found
                        	    88: DOC_P       = VT_P     ; (shares the string pointer)
                        	    89: DOC_FIND:
01:2557 A901            	    90:   LDA #1
                        	    91: .df_k:
01:2559 48              	    92:   PHA
01:255A 204325          	    93:   JSR DOC_ENTRY
01:255D A000            	    94:   LDY #0
01:255F B1AA            	    95:   LDA (DOC_E),Y
01:2561 C5B8            	    96:   CMP DOC_T
01:2563 D01A            	    97:   BNE .df_n              ; free or another type
01:2565 A00B            	    98:   LDY #DOC_NAMELEN-1
                        	    99: .df_c:
01:2567 B1A2            	   100:   LDA (DOC_P),Y
01:2569 85AD            	   101:   STA DOC_I              ; (temporary)
01:256B C8              	   102:   INY                    ; name in the entry at +4
01:256C C8              	   103:   INY
01:256D C8              	   104:   INY
01:256E C8              	   105:   INY
01:256F B1AA            	   106:   LDA (DOC_E),Y
01:2571 C5AD            	   107:   CMP DOC_I
01:2573 D00A            	   108:   BNE .df_n
01:2575 88              	   109:   DEY                    ; back to the previous character
01:2576 88              	   110:   DEY
01:2577 88              	   111:   DEY
01:2578 88              	   112:   DEY
01:2579 88              	   113:   DEY
01:257A 10EB            	   114:   BPL .df_c
01:257C 68              	   115:   PLA
01:257D 18              	   116:   CLC
01:257E 60              	   117:   RTS
                        	   118: .df_n:
01:257F 68              	   119:   PLA
01:2580 1A              	   120:   INC A
01:2581 C910            	   121:   CMP #DOC_SLOTS+1
01:2583 D0D4            	   122:   BNE .df_k
01:2585 38              	   123:   SEC
01:2586 60              	   124:   RTS
                        	   125: 
                        	   126: ; DOC_FREE: C=0 and A = first free slot, C=1 index full
                        	   127: DOC_FREE:
01:2587 A901            	   128:   LDA #1
                        	   129: .dfr_k:
01:2589 204325          	   130:   JSR DOC_ENTRY
01:258C A000            	   131:   LDY #0
01:258E B1AA            	   132:   LDA (DOC_E),Y
01:2590 F009            	   133:   BEQ .dfr_y
01:2592 A5AC            	   134:   LDA DOC_K
01:2594 1A              	   135:   INC A
01:2595 C910            	   136:   CMP #DOC_SLOTS+1
01:2597 D0F0            	   137:   BNE .dfr_k
01:2599 38              	   138:   SEC
01:259A 60              	   139:   RTS
                        	   140: .dfr_y:
01:259B A5AC            	   141:   LDA DOC_K
01:259D 18              	   142:   CLC
01:259E 60              	   143:   RTS
                        	   144: 
                        	   145: ; DOC_SETENT: entry of slot A = type DOC_T, length DOC_LEN, name (DOC_P) (12 bytes)
                        	   146: DOC_SETENT:
01:259F 204325          	   147:   JSR DOC_ENTRY
01:25A2 A000            	   148:   LDY #0
01:25A4 A5B8            	   149:   LDA DOC_T
01:25A6 91AA            	   150:   STA (DOC_E),Y
01:25A8 C8              	   151:   INY
01:25A9 A5B9            	   152:   LDA DOC_LEN
01:25AB 91AA            	   153:   STA (DOC_E),Y
01:25AD C8              	   154:   INY
01:25AE A5BA            	   155:   LDA DOC_LEN+1
01:25B0 91AA            	   156:   STA (DOC_E),Y
01:25B2 C8              	   157:   INY
01:25B3 A900            	   158:   LDA #0
01:25B5 91AA            	   159:   STA (DOC_E),Y
01:25B7 A000            	   160:   LDY #0                 ; name: (DOC_P)+0..11 -> entry +4..15
                        	   161: .dse_n:
01:25B9 B1A2            	   162:   LDA (DOC_P),Y
01:25BB C8              	   163:   INY
01:25BC C8              	   164:   INY
01:25BD C8              	   165:   INY
01:25BE C8              	   166:   INY
01:25BF 91AA            	   167:   STA (DOC_E),Y
01:25C1 88              	   168:   DEY
01:25C2 88              	   169:   DEY
01:25C3 88              	   170:   DEY
01:25C4 C00C            	   171:   CPY #DOC_NAMELEN
01:25C6 D0F1            	   172:   BNE .dse_n
01:25C8 60              	   173:   RTS
                        	   174: 
                        	   175: ; DOC_SECT: SD_LBA = DOC_BASE + DOC_K*40 + DOC_I
                        	   176: DOC_SECT:
01:25C9 9C1803          	   177:   STZ SD_LBA+2
01:25CC 9C1903          	   178:   STZ SD_LBA+3
01:25CF A5AC            	   179:   LDA DOC_K
01:25D1 8D1603          	   180:   STA SD_LBA
01:25D4 9C1703          	   181:   STZ SD_LBA+1
01:25D7 0E1603          	   182:   ASL SD_LBA             ; k*8
01:25DA 2E1703          	   183:   ROL SD_LBA+1
01:25DD 0E1603          	   184:   ASL SD_LBA
01:25E0 2E1703          	   185:   ROL SD_LBA+1
01:25E3 0E1603          	   186:   ASL SD_LBA
01:25E6 2E1703          	   187:   ROL SD_LBA+1
01:25E9 AD1703          	   188:   LDA SD_LBA+1           ; + k*32 = 4 * (k*8)
01:25EC 48              	   189:   PHA
01:25ED AD1603          	   190:   LDA SD_LBA
01:25F0 48              	   191:   PHA
01:25F1 0E1603          	   192:   ASL SD_LBA
01:25F4 2E1703          	   193:   ROL SD_LBA+1
01:25F7 0E1603          	   194:   ASL SD_LBA
01:25FA 2E1703          	   195:   ROL SD_LBA+1
01:25FD 18              	   196:   CLC
01:25FE 68              	   197:   PLA
01:25FF 6D1603          	   198:   ADC SD_LBA
01:2602 8D1603          	   199:   STA SD_LBA
01:2605 68              	   200:   PLA
01:2606 6D1703          	   201:   ADC SD_LBA+1
01:2609 8D1703          	   202:   STA SD_LBA+1
01:260C 18              	   203:   CLC
01:260D AD1603          	   204:   LDA SD_LBA
01:2610 65AD            	   205:   ADC DOC_I
01:2612 8D1603          	   206:   STA SD_LBA
01:2615 AD1703          	   207:   LDA SD_LBA+1
01:2618 6940            	   208:   ADC #>DOC_BASE
01:261A 8D1703          	   209:   STA SD_LBA+1
01:261D 60              	   210:   RTS
                        	   211: 
                        	   212: DOC_LBA0:
01:261E 9C1603          	   213:   STZ SD_LBA
01:2621 A940            	   214:   LDA #>DOC_BASE
01:2623 8D1703          	   215:   STA SD_LBA+1
01:2626 9C1803          	   216:   STZ SD_LBA+2
01:2629 9C1903          	   217:   STZ SD_LBA+3
01:262C 60              	   218:   RTS
                        	   219: 
                        	   220: ; DOC_XFER: DOC_K = slot, A = RAM page of the data, X/Y = length (lo/hi), C=0 read, C=1 write
                        	   221: ; Transfers ceil(length / 512) sectors. C=1 SD error
                        	   222: DOC_XFER:
01:262D 85AF            	   223:   STA DOC_PG
01:262F 08              	   224:   PHP
01:2630 8A              	   225:   TXA                    ; sectors = (length + 511) / 512
01:2631 18              	   226:   CLC
01:2632 69FF            	   227:   ADC #$FF
01:2634 98              	   228:   TYA
01:2635 6901            	   229:   ADC #$01
01:2637 4A              	   230:   LSR
01:2638 85AE            	   231:   STA DOC_N
01:263A 64AD            	   232:   STZ DOC_I
01:263C 28              	   233:   PLP
01:263D B017            	   234:   BCS .dx_w
                        	   235: .dx_r:
01:263F A5AD            	   236:   LDA DOC_I
01:2641 C5AE            	   237:   CMP DOC_N
01:2643 B028            	   238:   BCS .dx_ok
01:2645 20C925          	   239:   JSR DOC_SECT
01:2648 A200            	   240:   LDX #0
01:264A A4AF            	   241:   LDY DOC_PG
01:264C 2018FD          	   242:   JSR JT_SD_READ
01:264F B01D            	   243:   BCS .dx_x
01:2651 206F26          	   244:   JSR .dx_next
01:2654 80E9            	   245:   BRA .dx_r
                        	   246: .dx_w:
01:2656 A5AD            	   247:   LDA DOC_I
01:2658 C5AE            	   248:   CMP DOC_N
01:265A B011            	   249:   BCS .dx_ok
01:265C 20C925          	   250:   JSR DOC_SECT
01:265F A200            	   251:   LDX #0
01:2661 A4AF            	   252:   LDY DOC_PG
01:2663 201BFD          	   253:   JSR JT_SD_WRITE
01:2666 B006            	   254:   BCS .dx_x
01:2668 206F26          	   255:   JSR .dx_next
01:266B 80E9            	   256:   BRA .dx_w
