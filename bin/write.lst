Source: "lib\keys.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   KEYS.ASM  -  key queue on top of the BIOS                  ;
                        	     4: ;                                                              ;
                        	     5: ;   The PS/2 board keeps one byte: a byte not read within      ;
                        	     6: ;   ~1 ms is lost (a lost $F0 turns a release into a second    ;
                        	     7: ;   press). Two ways in, both on: the CA1 interrupt of the     ;
                        	     8: ;   keyboard VIA (IRQ -> BIOS -> JMP KB_IRQ at $0FA0) reads    ;
                        	     9: ;   every byte at once; KB_POLL, called by the long loops,     ;
                        	    10: ;   does the same if the IRQ line is not there. Assembled      ;
                        	    11: ;   with -DKB_NOIRQ=1 only the polling is left.                ;
                        	    12: ;   The keys decoded by the BIOS go into a 32-key queue,       ;
                        	    13: ;   GETKEY takes them out. KB_EXIT before leaving the app.     ;
                        	    14: ;   An app that uses the serial line itself defines KB_SERBUF  ;
                        	    15: ;   (256-byte ring): the received bytes go there, not among    ;
                        	    16: ;   the keys (JT_CHRIN reads the serial line first: a byte it  ;
                        	    17: ;   returns while CA1 is still set came from the serial line). ;
                        	    18: ;   Uses: zp $A0-$A1 ($F0-$F1 with KB_SERBUF), RAM $05C0-$05DF ;
                        	    19: ;                                                              ;
                        	    20: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    21: 
                        	    22: KQ          = $05C0    ; 32-key ring
                        	    23: KQ_MASK     = $1F
                        	    24: KQR         = $A0      ; read index
                        	    25: KQW         = $A1      ; write index
                        	    26: KB_IFR      = $D18D    ; keyboard VIA: interrupt flags (bit 1 = CA1)
                        	    27: KB_IER      = $D18E    ;               interrupt enable
                        	    28: KB_SRR      = $F0      ; serial ring (KB_SERBUF): read index
                        	    29: KB_SRW      = $F1      ;                          write index
                        	    30: 
                        	    31: ; KB_INIT: extended keyboard, empty queue, CA1 interrupt on
                        	    32: KB_INIT:
01:22EB 78              	    33:   SEI
01:22EC A901            	    34:   LDA #1
01:22EE 2021FD          	    35:   JSR JT_KB_MODE
01:22F1 64A0            	    36:   STZ KQR
01:22F3 64A1            	    37:   STZ KQW
01:22F5 64F0            	    38:   STZ KB_SRR
01:22F7 64F1            	    39:   STZ KB_SRW
                        	    40:  .ifndef KB_NOIRQ
01:22F9 A94C            	    41:   LDA #$4C               ; JMP KB_IRQ in the RAM vector of the BIOS
01:22FB 8DA00F          	    42:   STA IRQ_VEC
01:22FE A91B            	    43:   LDA #<KB_IRQ
01:2300 8DA10F          	    44:   STA IRQ_VEC+1
01:2303 A923            	    45:   LDA #>KB_IRQ
01:2305 8DA20F          	    46:   STA IRQ_VEC+2
01:2308 A982            	    47:   LDA #$82               ; CA1 interrupt enabled
01:230A 8D8ED1          	    48:   STA KB_IER
01:230D 58              	    49:   CLI
                        	    50:  .endif
01:230E 60              	    51:   RTS
                        	    52: 
                        	    53: ; KB_EXIT: interrupt off again (the BIOS menu works by polling)
                        	    54: KB_EXIT:
01:230F 78              	    55:   SEI
01:2310 A902            	    56:   LDA #$02
01:2312 8D8ED1          	    57:   STA KB_IER
01:2315 A960            	    58:   LDA #$60               ; RTS
01:2317 8DA00F          	    59:   STA IRQ_VEC
01:231A 60              	    60:   RTS
                        	    61: 
                        	    62: ; KB_IRQ: called by the BIOS IRQ handler (A, X, Y already saved)
                        	    63: KB_IRQ:
                        	    64:  .ifdef KB_SERBUF
                        	    65:   JMP KB_TAKE            ; the keyboard or the serial line
                        	    66:  .else
01:231B AD8DD1          	    67:   LDA KB_IFR
01:231E 2902            	    68:   AND #$02
01:2320 F003            	    69:   BEQ .ki_x
01:2322 203323          	    70:   JSR KB_TAKE
                        	    71: .ki_x:
01:2325 60              	    72:   RTS
                        	    73:  .endif
                        	    74: 
                        	    75: ; KB_POLL: one BIOS poll with the interrupt held off. Keeps A, X, Y and the I flag
                        	    76: KB_POLL:
01:2326 08              	    77:   PHP
01:2327 78              	    78:   SEI
01:2328 48              	    79:   PHA
01:2329 DA              	    80:   PHX
01:232A 5A              	    81:   PHY
01:232B 203323          	    82:   JSR KB_TAKE
01:232E 7A              	    83:   PLY
01:232F FA              	    84:   PLX
01:2330 68              	    85:   PLA
01:2331 28              	    86:   PLP
01:2332 60              	    87:   RTS
                        	    88: 
                        	    89: ; KB_TAKE: a key from the BIOS goes into the queue (full queue: dropped)
                        	    90: KB_TAKE:
                        	    91:  .ifdef KB_SERBUF
                        	    92: .kt_rx:
                        	    93:   LDA ACIA_STATUS        ; received bytes first, into their ring
                        	    94:   AND #$08
                        	    95:   BEQ .kt_kb
                        	    96:   LDA ACIA_DATA
                        	    97:   JSR KB_SERPUT
                        	    98:   BRA .kt_rx
                        	    99: .kt_kb:
                        	   100:   LDA KB_IFR
                        	   101:   AND #$02
                        	   102:   BEQ .kt_x
                        	   103:   JSR JT_CHRIN
                        	   104:   BCC .kt_x
                        	   105:   PHA
                        	   106:   LDA KB_IFR             ; CA1 still set: the BIOS took a serial byte, not the key
                        	   107:   AND #$02
                        	   108:   BEQ .kt_key
                        	   109:   PLA
                        	   110:   JSR KB_SERPUT
                        	   111:   BRA .kt_rx
                        	   112: .kt_key:
                        	   113:   PLA
                        	   114:  .else
01:2333 2003FD          	   115:   JSR JT_CHRIN
01:2336 900F            	   116:   BCC .kt_x
                        	   117:  .endif
01:2338 A6A1            	   118:   LDX KQW
01:233A 9DC005          	   119:   STA KQ,X
01:233D 8A              	   120:   TXA
01:233E 1A              	   121:   INC A
01:233F 291F            	   122:   AND #KQ_MASK
01:2341 C5A0            	   123:   CMP KQR
01:2343 F002            	   124:   BEQ .kt_x              ; full
01:2345 85A1            	   125:   STA KQW
                        	   126: .kt_x:
01:2347 60              	   127:   RTS
                        	   128: 
                        	   129:  .ifdef KB_SERBUF
                        	   130: ; KB_SERPUT: A into the serial ring (full: dropped)
                        	   131: KB_SERPUT:
                        	   132:   LDX KB_SRW
                        	   133:   STA KB_SERBUF,X
                        	   134:   INX
                        	   135:   CPX KB_SRR
                        	   136:   BEQ .ks_x
                        	   137:   STX KB_SRW
                        	   138: .ks_x:
                        	   139:   RTS
                        	   140: 
                        	   141: ; SERGET: C=1 and A = next received byte, C=0 none
                        	   142: SERGET:
                        	   143:   JSR KB_POLL
                        	   144:   LDX KB_SRR
                        	   145:   CPX KB_SRW
                        	   146:   BEQ .sg_n
                        	   147:   LDA KB_SERBUF,X
                        	   148:   INC KB_SRR
                        	   149:   SEC
                        	   150:   RTS
                        	   151: .sg_n:
                        	   152:   CLC
                        	   153:   RTS
                        	   154:  .endif
                        	   155: 
                        	   156: ; GETKEY: C=1 and A = key, C=0 queue empty (after one poll). Keeps X, Y
                        	   157: GETKEY:
01:2348 202623          	   158:   JSR KB_POLL
01:234B A5A0            	   159:   LDA KQR
01:234D C5A1            	   160:   CMP KQW
01:234F F010            	   161:   BEQ .gk_n
01:2351 DA              	   162:   PHX
01:2352 AA              	   163:   TAX
01:2353 BDC005          	   164:   LDA KQ,X
01:2356 48              	   165:   PHA
01:2357 8A              	   166:   TXA
01:2358 1A              	   167:   INC A
01:2359 291F            	   168:   AND #KQ_MASK
01:235B 85A0            	   169:   STA KQR
01:235D 68              	   170:   PLA
01:235E FA              	   171:   PLX
01:235F 38              	   172:   SEC
01:2360 60              	   173:   RTS
                        	   174: .gk_n:
01:2361 18              	   175:   CLC
01:2362 60              	   176:   RTS
                        	   177: 
                        	   178: ; WAITKEY: A = next key
                        	   179: WAITKEY:
01:2363 204823          	   180:   JSR GETKEY
01:2366 90FB            	   181:   BCC WAITKEY
01:2368 60              	   182:   RTS
                        	   183: 
                        	   184: ; KEYREADY: C=1 if a key is waiting in the queue
                        	   185: KEYREADY:
01:2369 202623          	   186:   JSR KB_POLL
01:236C A5A0            	   187:   LDA KQR
01:236E C5A1            	   188:   CMP KQW
01:2370 18              	   189:   CLC
01:2371 F001            	   190:   BEQ .kr_x
01:2373 38              	   191:   SEC
                        	   192: .kr_x:
01:2374 60              	   193:   RTS
                        	   194: 

Source: "apps\write.asm"
                        	  2500:  .include "lib/vtext.asm"

Source: "lib\vtext.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   VTEXT.ASM  -  40 x 24 text screen on the TMS9918A          ;
                        	     4: ;                                                              ;
                        	     5: ;   BIOS text mode (VDP interrupt off, so the main loop can    ;
                        	     6: ;   write the VRAM at any time). VT_INIT also builds the       ;
                        	     7: ;   inverse font: codes $80-$FF = codes $00-$7F inverted,      ;
                        	     8: ;   used for the cursor, the status bar and the marked block.  ;
                        	     9: ;   Long loops call KB_POLL (lib/keys.asm).                    ;
                        	    10: ;   Uses: zp $A2-$A4, RAM $0800-$0BFF only inside VT_INIT      ;
                        	    11: ;                                                              ;
                        	    12: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    13: 
                        	    14: VT_P        = $A2      ; 2 bytes: string pointer
                        	    15: VT_INV      = $A4      ; ORed to every character of VT_STR ($80 = inverse)
                        	    16: VT_FONTTMP  = $0800    ; RAM copy of the font (1 KB, only during VT_INIT)
                        	    17: 
                        	    18: ; VT_INIT: text mode of the BIOS, inverse font, empty screen
                        	    19: VT_INIT:
01:2375 2009FD          	    20:   JSR JT_INIT_CRT
01:2378 A900            	    21:   LDA #<VRAM_FONT        ; read patterns 0-127 (1 KB)
01:237A A200            	    22:   LDX #>VRAM_FONT
01:237C 20E923          	    23:   JSR VT_RADDR
01:237F A200            	    24:   LDX #0                 ; (the VRAM address increases by itself)
                        	    25: .vi_r0:
01:2381 AD00B0          	    26:   LDA VDP_DATA
01:2384 9D0008          	    27:   STA VT_FONTTMP,X
01:2387 E8              	    28:   INX
01:2388 D0F7            	    29:   BNE .vi_r0
                        	    30: .vi_r1:
01:238A AD00B0          	    31:   LDA VDP_DATA
01:238D 9D0009          	    32:   STA VT_FONTTMP+$100,X
01:2390 E8              	    33:   INX
01:2391 D0F7            	    34:   BNE .vi_r1
                        	    35: .vi_r2:
01:2393 AD00B0          	    36:   LDA VDP_DATA
01:2396 9D000A          	    37:   STA VT_FONTTMP+$200,X
01:2399 E8              	    38:   INX
01:239A D0F7            	    39:   BNE .vi_r2
                        	    40: .vi_r3:
01:239C AD00B0          	    41:   LDA VDP_DATA
01:239F 9D000B          	    42:   STA VT_FONTTMP+$300,X
01:23A2 E8              	    43:   INX
01:23A3 D0F7            	    44:   BNE .vi_r3
01:23A5 A900            	    45:   LDA #<(VRAM_FONT+$400) ; inverted copy at pattern 128
01:23A7 A204            	    46:   LDX #>(VRAM_FONT+$400)
01:23A9 20DF23          	    47:   JSR VT_WADDR
01:23AC A200            	    48:   LDX #0
                        	    49: .vi_w0:
01:23AE BD0008          	    50:   LDA VT_FONTTMP,X
01:23B1 49FF            	    51:   EOR #$FF
01:23B3 8D00B0          	    52:   STA VDP_DATA
01:23B6 E8              	    53:   INX
01:23B7 D0F5            	    54:   BNE .vi_w0
                        	    55: .vi_w1:
01:23B9 BD0009          	    56:   LDA VT_FONTTMP+$100,X
01:23BC 49FF            	    57:   EOR #$FF
01:23BE 8D00B0          	    58:   STA VDP_DATA
01:23C1 E8              	    59:   INX
01:23C2 D0F5            	    60:   BNE .vi_w1
                        	    61: .vi_w2:
01:23C4 BD000A          	    62:   LDA VT_FONTTMP+$200,X
01:23C7 49FF            	    63:   EOR #$FF
01:23C9 8D00B0          	    64:   STA VDP_DATA
01:23CC E8              	    65:   INX
01:23CD D0F5            	    66:   BNE .vi_w2
                        	    67: .vi_w3:
01:23CF BD000B          	    68:   LDA VT_FONTTMP+$300,X
01:23D2 49FF            	    69:   EOR #$FF
01:23D4 8D00B0          	    70:   STA VDP_DATA
01:23D7 E8              	    71:   INX
01:23D8 D0F5            	    72:   BNE .vi_w3
01:23DA 64A4            	    73:   STZ VT_INV
01:23DC 4C5F24          	    74:   JMP VT_CLS
                        	    75: 
                        	    76: ; VT_WADDR: VRAM write address A (lo) / X (hi)
                        	    77: VT_WADDR:
01:23DF 8D01B0          	    78:   STA VDP_REG
01:23E2 8A              	    79:   TXA
01:23E3 0940            	    80:   ORA #$40
01:23E5 8D01B0          	    81:   STA VDP_REG
01:23E8 60              	    82:   RTS
                        	    83: 
                        	    84: ; VT_RADDR: VRAM read address A (lo) / X (hi)
                        	    85: VT_RADDR:
01:23E9 8D01B0          	    86:   STA VDP_REG
01:23EC 8E01B0          	    87:   STX VDP_REG
01:23EF 60              	    88:   RTS
                        	    89: 
                        	    90: ; VT_ROW: write address at column 0 of row A (0-23). Keeps Y
                        	    91: VT_ROW:
01:23F0 AA              	    92:   TAX
01:23F1 BD7324          	    93:   LDA VT_ROWLO,X
01:23F4 48              	    94:   PHA
01:23F5 BD8B24          	    95:   LDA VT_ROWHI,X
01:23F8 AA              	    96:   TAX
01:23F9 68              	    97:   PLA
01:23FA 4CDF23          	    98:   JMP VT_WADDR
                        	    99: 
                        	   100: ; VT_AT: write address at row A, column X. Keeps Y
                        	   101: VT_AT:
01:23FD DA              	   102:   PHX
01:23FE AA              	   103:   TAX
01:23FF 68              	   104:   PLA
01:2400 18              	   105:   CLC
01:2401 7D7324          	   106:   ADC VT_ROWLO,X
01:2404 48              	   107:   PHA
01:2405 BD8B24          	   108:   LDA VT_ROWHI,X
01:2408 6900            	   109:   ADC #0
01:240A AA              	   110:   TAX
01:240B 68              	   111:   PLA
01:240C 4CDF23          	   112:   JMP VT_WADDR
                        	   113: 
                        	   114: ; VT_REP: writes X times the character A
                        	   115: VT_REP:
01:240F E000            	   116:   CPX #0
01:2411 F010            	   117:   BEQ .vr_x
                        	   118: .vr_l:
01:2413 8D00B0          	   119:   STA VDP_DATA
01:2416 48              	   120:   PHA
01:2417 8A              	   121:   TXA
01:2418 290F            	   122:   AND #$0F
01:241A D003            	   123:   BNE .vr_n
01:241C 202623          	   124:   JSR KB_POLL
                        	   125: .vr_n:
01:241F 68              	   126:   PLA
01:2420 CA              	   127:   DEX
01:2421 D0F0            	   128:   BNE .vr_l
                        	   129: .vr_x:
01:2423 60              	   130:   RTS
                        	   131: 
                        	   132: ; VT_STR: writes the $00-terminated string at VT_P (ORA VT_INV). Y = characters written
                        	   133: VT_STR:
01:2424 A000            	   134:   LDY #0
                        	   135: .vs_l:
01:2426 B1A2            	   136:   LDA (VT_P),Y
01:2428 F010            	   137:   BEQ .vs_x
01:242A 05A4            	   138:   ORA VT_INV
01:242C 8D00B0          	   139:   STA VDP_DATA
01:242F C8              	   140:   INY
01:2430 98              	   141:   TYA
01:2431 290F            	   142:   AND #$0F
01:2433 D0F1            	   143:   BNE .vs_l
01:2435 202623          	   144:   JSR KB_POLL
01:2438 80EC            	   145:   BRA .vs_l
                        	   146: .vs_x:
01:243A 60              	   147:   RTS
                        	   148: 
                        	   149: ; VT_LINE: string A/X (lo/hi) at the current address, then spaces (ORA VT_INV) up to
                        	   150: ; column 40 of the row. Y = start column on entry
                        	   151: VT_LINE:
01:243B 85A2            	   152:   STA VT_P
01:243D 86A3            	   153:   STX VT_P+1
01:243F 8C5E24          	   154:   STY .vl_c
01:2442 202424          	   155:   JSR VT_STR
01:2445 98              	   156:   TYA
01:2446 18              	   157:   CLC
01:2447 6D5E24          	   158:   ADC .vl_c
01:244A 8D5E24          	   159:   STA .vl_c
01:244D A928            	   160:   LDA #40
01:244F 38              	   161:   SEC
01:2450 ED5E24          	   162:   SBC .vl_c
01:2453 9008            	   163:   BCC .vl_x
01:2455 AA              	   164:   TAX
01:2456 A920            	   165:   LDA #' '
01:2458 05A4            	   166:   ORA VT_INV
01:245A 4C0F24          	   167:   JMP VT_REP
                        	   168: .vl_x:
01:245D 60              	   169:   RTS
                        	   170: .vl_c:
01:245E 00              	   171:   .byte 0
                        	   172: 
                        	   173: ; VT_CLS: whole screen blank
                        	   174: VT_CLS:
01:245F A900            	   175:   LDA #<VRAM_NAME
01:2461 A208            	   176:   LDX #>VRAM_NAME
01:2463 20DF23          	   177:   JSR VT_WADDR
01:2466 A004            	   178:   LDY #4                 ; 4 x 240 = 960
                        	   179: .vc_l:
01:2468 A920            	   180:   LDA #' '
01:246A A2F0            	   181:   LDX #240
01:246C 200F24          	   182:   JSR VT_REP
01:246F 88              	   183:   DEY
01:2470 D0F6            	   184:   BNE .vc_l
01:2472 60              	   185:   RTS
                        	   186: 
                        	   187: VT_ROWLO:
01:2473 00              	   188:   .byte <(VRAM_NAME+0*40),<(VRAM_NAME+1*40),<(VRAM_NAME+2*40),<(VRAM_NAME+3*40)
01:2474 28
01:2475 50
01:2476 78
01:2477 A0              	   189:   .byte <(VRAM_NAME+4*40),<(VRAM_NAME+5*40),<(VRAM_NAME+6*40),<(VRAM_NAME+7*40)
01:2478 C8
01:2479 F0
01:247A 18
01:247B 40              	   190:   .byte <(VRAM_NAME+8*40),<(VRAM_NAME+9*40),<(VRAM_NAME+10*40),<(VRAM_NAME+11*40)
01:247C 68
01:247D 90
01:247E B8
01:247F E0              	   191:   .byte <(VRAM_NAME+12*40),<(VRAM_NAME+13*40),<(VRAM_NAME+14*40),<(VRAM_NAME+15*40)
01:2480 08
01:2481 30
01:2482 58
01:2483 80              	   192:   .byte <(VRAM_NAME+16*40),<(VRAM_NAME+17*40),<(VRAM_NAME+18*40),<(VRAM_NAME+19*40)
01:2484 A8
01:2485 D0
01:2486 F8
01:2487 20              	   193:   .byte <(VRAM_NAME+20*40),<(VRAM_NAME+21*40),<(VRAM_NAME+22*40),<(VRAM_NAME+23*40)
01:2488 48
01:2489 70
01:248A 98
                        	   194: VT_ROWHI:
01:248B 08              	   195:   .byte >(VRAM_NAME+0*40),>(VRAM_NAME+1*40),>(VRAM_NAME+2*40),>(VRAM_NAME+3*40)
01:248C 08
01:248D 08
01:248E 08
01:248F 08              	   196:   .byte >(VRAM_NAME+4*40),>(VRAM_NAME+5*40),>(VRAM_NAME+6*40),>(VRAM_NAME+7*40)
01:2490 08
01:2491 08
01:2492 09
01:2493 09              	   197:   .byte >(VRAM_NAME+8*40),>(VRAM_NAME+9*40),>(VRAM_NAME+10*40),>(VRAM_NAME+11*40)
01:2494 09
01:2495 09
01:2496 09
01:2497 09              	   198:   .byte >(VRAM_NAME+12*40),>(VRAM_NAME+13*40),>(VRAM_NAME+14*40),>(VRAM_NAME+15*40)
01:2498 0A
01:2499 0A
01:249A 0A
01:249B 0A              	   199:   .byte >(VRAM_NAME+16*40),>(VRAM_NAME+17*40),>(VRAM_NAME+18*40),>(VRAM_NAME+19*40)
01:249C 0A
01:249D 0A
01:249E 0A
01:249F 0B              	   200:   .byte >(VRAM_NAME+20*40),>(VRAM_NAME+21*40),>(VRAM_NAME+22*40),>(VRAM_NAME+23*40)
