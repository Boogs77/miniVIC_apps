00: "segfd0" (FD0-FD1)
01: "seg1000" (1000-2915)


Source: "apps\write.asm"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   WRITE  -  miniVIC WRITE, text editor (WordStar style)      ;
                        	     4: ;   65C02 assembly, TMS9918A text mode 40 x 24                 ;
                        	     5: ;   Needs the BIOS 27.10.26 KEYB/SD (extended keyboard,        ;
                        	     6: ;   SD sector write)                                           ;
                        	     7: ;                                                              ;
                        	     8: ;   - gap buffer of 20480 bytes ($3000-$7FFF), the cursor is   ;
                        	     9: ;     the start of the gap; CR ($0D) ends a paragraph and the  ;
                        	    10: ;     screen wraps the words at 40 columns                     ;
                        	    11: ;   - WordStar keys: ^E ^X ^S ^D cursor, ^A ^F word, ^R ^C     ;
                        	    12: ;     page, ^G ^H ^T ^Y delete, ^V insert/overwrite, ^N split, ;
                        	    13: ;     ^K block and file commands, ^Q quick commands, ^J help;  ;
                        	    14: ;     arrows, Home, End, PgUp, PgDn, Ins, Del and F1-F10 too   ;
                        	    15: ;   - block: begin, end, hide, copy, move, delete (shown in    ;
                        	    16: ;     inverse); find, find again, replace all                  ;
                        	    17: ;   - up to 15 documents on the SD (lib/docs.asm), 20 KB each  ;
                        	    18: ;   - keys (lib/keys.asm): keyboard CA1 interrupt, and every   ;
                        	    19: ;     long loop calls KB_POLL too; the screen is redrawn only  ;
                        	    20: ;     when no key waits                                        ;
                        	    21: ;                                                              ;
                        	    22: ;   MEMORY                                                     ;
                        	    23: ;   $0050-$00AF  zero page (editor $50-$9F, lib $A0-$AF)       ;
                        	    24: ;   $0210-$02FF  line buffer, row starts, status, name,        ;
                        	    25: ;                prompt (lib/ui: $02A0-$02C7, $02D8-)          ;
                        	    26: ;   $0500-$0569  find and replace strings, message             ;
                        	    27: ;   $05C0-$05DF  key queue (lib/keys)                          ;
                        	    28: ;   $0600-$07FF  SD document index                             ;
                        	    29: ;   $0800-$0BFF  font copy (start only)                        ;
                        	    30: ;   $1000-$2FFF  code (8 KB at most)                           ;
                        	    31: ;   $3000-$7FFF  text (gap buffer, 20480 bytes)                ;
                        	    32: ;                                                              ;
                        	    33: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	    34: 
                        	    35:  .include "lib/system.inc"

Source: "lib\system.inc"
                        	     1: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     2: ;                                                              ;
                        	     3: ;   SYSTEM.INC  -  miniVIC / BO6502 addresses for the apps     ;
                        	     4: ;   BIOS 27.10.26 KEYB/SD jump table, VDP, key codes           ;
                        	     5: ;                                                              ;
                        	     6: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
                        	     7: 
                        	     8: ; ---------------- BIOS jump table ($FD00) ----------------
                        	     9: JT_CHROUT       = $FD00    ; A = char to screen AND serial (not used by the apps)
                        	    10: JT_CHRIN        = $FD03    ; C=1 and A = key, C=0 no key (serial first, then keyboard)
                        	    11: JT_INIT_CRT     = $FD09    ; text mode, VRAM and font of the BIOS
                        	    12: JT_SHOW_MENU    = $FD0F    ; back to the BIOS menu (never returns)
                        	    13: JT_SD_READ      = $FD18    ; sector SD_LBA -> buffer X/Y (lo/hi, 512 bytes), C=1 error
                        	    14: JT_SD_WRITE     = $FD1B    ; buffer X/Y -> sector SD_LBA, C=1 error
                        	    15: JT_SD_INIT      = $FD1E    ; C=0 and A = card type, C=1 no card
                        	    16: JT_KB_MODE      = $FD21    ; A<>0 extended keyboard, A=0 classic
                        	    17: SD_LBA          = $0316    ; 4 bytes, sector number, little endian
                        	    18: 
                        	    19: ; ---------------- RAM vectors (everything is polled) ----------------
                        	    20: IRQ_VEC         = $0FA0    ; JSR $0FA0 from the BIOS IRQ handler
                        	    21: NMI_VEC         = $0FD0    ; JSR $0FD0 from the BIOS NMI handler
                        	    22: 
                        	    23: ; ---------------- VDP TMS9918A ----------------
                        	    24: VDP_DATA        = $B000
                        	    25: VDP_REG         = $B001
                        	    26: VRAM_NAME       = $0800    ; name table of the BIOS text mode (40 x 24)
                        	    27: VRAM_FONT       = $0000    ; patterns 0-127 (BIOS font), 128-255 = inverse (made by VT_INIT)
                        	    28: 
                        	    29: ; ---------------- serial W65C51 ----------------
                        	    30: ACIA_DATA   = $C000
                        	    31: ACIA_STATUS = $C001    ; bit 3 = byte received
                        	    32: ACIA_CMD    = $C002    ; BIOS: $8B (no parity, receive IRQ off, DTR on)
                        	    33: ACIA_CTRL   = $C003    ; BIOS: $1F (19200, 8 bits, 1 stop)
                        	    34: 
                        	    35: ; ---------------- key codes (extended mode) ----------------
                        	    36: K_CR            = $0D
                        	    37: K_BS            = $08
                        	    38: K_TAB           = $09
                        	    39: K_ESC           = $1B
                        	    40: K_UP            = $80
                        	    41: K_DOWN          = $81
                        	    42: K_LEFT          = $82
                        	    43: K_RIGHT         = $83
                        	    44: K_HOME          = $84
                        	    45: K_END           = $85
                        	    46: K_PGUP          = $86
                        	    47: K_PGDN          = $87
                        	    48: K_INS           = $88
                        	    49: K_DEL           = $89
                        	    50: K_F1            = $90      ; F1-F12 = $90-$9B
                        	    51: 

Source: "apps\write.asm"
                        	    36: 
                        	    37: ; ---------------- parameters ----------------
                        	    38: BUF         = $3000    ; text buffer
                        	    39: BUF_END     = $8000    ; (first byte after it)
                        	    40: TROWS       = 22       ; text rows (screen rows 1-22)
                        	    41: TCOLS       = 40
                        	    42: CR          = $0D
                        	    43: NAMELEN     = 12
                        	    44: FINDMAX     = 24       ; (the longest prompt + 24 + cursor fit in 40 columns)
                        	    45: 
                        	    46: ; ---------------- zero page ----------------
                        	    47: GS          = $50      ; 2 bytes: gap start (= cursor), physical
                        	    48: GE          = $52      ; 2 bytes: gap end, physical
                        	    49: TOP         = $54      ; 2 bytes: logical position of the first screen row
                        	    50: BB          = $56      ; 2 bytes: block begin (logical)
                        	    51: BK          = $58      ; 2 bytes: block end (BK = BB+2: indexed with X)
                        	    52: BFLAG       = $5A      ; bit 0 begin set, bit 1 end set, bit 7 hidden
                        	    53: LINE        = $5B      ; 2 bytes: paragraph of the cursor (0-based)
                        	    54: MODF        = $5D      ; 1 = changed since the last save
                        	    55: INSM        = $5E      ; 1 = insert, 0 = overwrite
                        	    56: PREFIX      = $5F      ; 0, 'K' or 'Q' after ^K / ^Q
                        	    57: RP          = $60      ; 2 bytes: text reader, physical
                        	    58: Q           = $62      ; 2 bytes: logical position for RD_SET
                        	    59: LS          = $64      ; 2 bytes: start of the screen line being scanned
                        	    60: LLEN        = $66      ; characters of that line (with its CR or wrap space)
                        	    61: LAST        = $67      ; 1 = the line ends at the end of the text
                        	    62: LSP         = $68      ; last space of the line ($FF none)
                        	    63: CC          = $69      ; cursor column in the line ($FF = not in this line)
                        	    64: B0          = $6A      ; block columns [B0, B1) in the line
                        	    65: B1          = $6B
                        	    66: CURL        = $6C      ; 2 bytes: logical cursor
                        	    67: TARGET      = $6E      ; 2 bytes: where MOVETO takes the cursor
                        	    68: CNT         = $70      ; 2 bytes
                        	    69: P0          = $72      ; 2 bytes: logical cursor (CURPOS)
                        	    70: P1          = $74      ; 2 bytes: text length (TXTLEN), VSTART counter
                        	    71: P2          = $76      ; 2 bytes
                        	    72: T0          = $78
                        	    73: T1          = $79
                        	    74: T2          = $7A
                        	    75: T3          = $7B
                        	    76: VX          = $7C      ; 2 bytes: VSTART argument
                        	    77: ROWI        = $7E
                        	    78: DONE        = $7F
                        	    79: CCOL        = $80      ; cursor column on the screen
                        	    80: PGCNT       = $81
                        	    81: DIRTY       = $82      ; 1 = the text rows must be redrawn
                        	    82: MSGP        = $83      ; 2 bytes: message of row 23 (hi = 0: none)
                        	    83: ISVERT      = $85      ; 1 = this command was a vertical move
                        	    84: PREVV       = $86      ; the same for the command before
                        	    85: WANT        = $87      ; column kept by consecutive vertical moves
                        	    86: FLEN        = $88      ; length of the find string
                        	    87: RLEN        = $89      ; length of the replace string
                        	    88: DOCSLOT     = $8A
                        	    89: RCNT        = $8C      ; 2 bytes: replacements
                        	    90: BN          = $91      ; 2 bytes: block length
                        	    91: BO          = $93      ; 2 bytes: block begin before a move
                        	    92: BP          = $95      ; 2 bytes: where the copy of a block starts
                        	    93: SAVECUR     = $99      ; 2 bytes
                        	    94: 
                        	    95: ; ---------------- RAM ----------------
                        	    96: LINEBUF     = $0210    ; 40 characters of the line being scanned
                        	    97: ROWSL       = $0240    ; starts of the screen lines (FIT), 44 + 4
                        	    98: ROWSH       = $0270
                        	    99: STATBUF     = UI_LINE  ; 40 characters: the status bar
                        	   100: DOCNAME     = $02C8    ; 12 characters + $00
                        	   101: FINDBUF     = $0500    ; find string (upper case)
                        	   102: REPLBUF     = $0520    ; replace string
                        	   103: MSGBUF      = $0540    ; message built at run time (40 + $00)
                        	   104: 
                        	   105:  .org $0FD0
00:0FD0 60              	   106:   RTS                    ; NMI trampoline (the VDP interrupt is off)
                        	   107:  .org $1000
                        	   108: 
                        	   109: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; start and main loop
                        	   110: 
                        	   111: RESET:
01:1000 78              	   112:   SEI
01:1001 D8              	   113:   CLD
01:1002 A2FF            	   114:   LDX #$FF
01:1004 9A              	   115:   TXS
01:1005 A960            	   116:   LDA #$60               ; RTS: no IRQ handler, everything is polled
01:1007 8DA00F          	   117:   STA IRQ_VEC
01:100A 207523          	   118:   JSR VT_INIT
01:100D 20EB22          	   119:   JSR KB_INIT
01:1010 A901            	   120:   LDA #1
01:1012 855E            	   121:   STA INSM
01:1014 6488            	   122:   STZ FLEN
01:1016 6489            	   123:   STZ RLEN
01:1018 645F            	   124:   STZ PREFIX
01:101A 6486            	   125:   STZ PREVV
01:101C 6485            	   126:   STZ ISVERT
01:101E 6480            	   127:   STZ CCOL
01:1020 205C1C          	   128:   JSR DOCNEW
01:1023 A902            	   129:   LDA #<M_HELLO
01:1025 A21F            	   130:   LDX #>M_HELLO
01:1027 203B16          	   131:   JSR SETMSG
                        	   132: MAIN:
01:102A A582            	   133:   LDA DIRTY
01:102C F008            	   134:   BEQ .mn_s
01:102E 6482            	   135:   STZ DIRTY
01:1030 205E14          	   136:   JSR FIT
01:1033 20CF14          	   137:   JSR REDRAW
                        	   138: .mn_s:
01:1036 205615          	   139:   JSR STATUS
01:1039 201116          	   140:   JSR MSGLINE
                        	   141: IDLE:
01:103C 204823          	   142:   JSR GETKEY
01:103F 90FB            	   143:   BCC IDLE
                        	   144: .mn_k:
01:1041 204E10          	   145:   JSR DOKEY
01:1044 206923          	   146:   JSR KEYREADY           ; more keys: no redraw in between
01:1047 90E1            	   147:   BCC MAIN
01:1049 204823          	   148:   JSR GETKEY
01:104C 80F3            	   149:   BRA .mn_k
                        	   150: 
                        	   151: ; DOKEY: runs the command of key A
                        	   152: DOKEY:
01:104E 6484            	   153:   STZ MSGP+1
01:1050 A685            	   154:   LDX ISVERT
01:1052 8686            	   155:   STX PREVV
01:1054 6485            	   156:   STZ ISVERT
01:1056 A65F            	   157:   LDX PREFIX
01:1058 F037            	   158:   BEQ .dk_n
01:105A 645F            	   159:   STZ PREFIX
01:105C 20B210          	   160:   JSR KEYLETTER
01:105F 8578            	   161:   STA T0
01:1061 A9BE            	   162:   LDA #<KTAB
01:1063 8576            	   163:   STA P2
01:1065 A91E            	   164:   LDA #>KTAB
01:1067 8577            	   165:   STA P2+1
01:1069 E04B            	   166:   CPX #'K'
01:106B F008            	   167:   BEQ .dk_t
01:106D A9E6            	   168:   LDA #<QTAB
01:106F 8576            	   169:   STA P2
01:1071 A91E            	   170:   LDA #>QTAB
01:1073 8577            	   171:   STA P2+1
                        	   172: .dk_t:
01:1075 A000            	   173:   LDY #0
                        	   174: .dk_tl:
01:1077 B176            	   175:   LDA (P2),Y
01:1079 F036            	   176:   BEQ .dk_x
01:107B C578            	   177:   CMP T0
01:107D F005            	   178:   BEQ .dk_tf
01:107F C8              	   179:   INY
01:1080 C8              	   180:   INY
01:1081 C8              	   181:   INY
01:1082 80F3            	   182:   BRA .dk_tl
                        	   183: .dk_tf:
01:1084 C8              	   184:   INY
01:1085 B176            	   185:   LDA (P2),Y
01:1087 8572            	   186:   STA P0
01:1089 C8              	   187:   INY
01:108A B176            	   188:   LDA (P2),Y
01:108C 8573            	   189:   STA P0+1
01:108E 6C7200          	   190:   JMP (P0)
                        	   191: .dk_n:
01:1091 C920            	   192:   CMP #$20
01:1093 9014            	   193:   BCC .dk_c
01:1095 C97F            	   194:   CMP #$7F
01:1097 9015            	   195:   BCC .dk_p
01:1099 C980            	   196:   CMP #K_UP
01:109B 9014            	   197:   BCC .dk_x
01:109D C99C            	   198:   CMP #K_F1+12
01:109F B010            	   199:   BCS .dk_x
01:10A1 38              	   200:   SEC
01:10A2 E980            	   201:   SBC #K_UP
01:10A4 0A              	   202:   ASL
01:10A5 AA              	   203:   TAX
01:10A6 7C861E          	   204:   JMP (EXTTAB,X)
                        	   205: .dk_c:
01:10A9 0A              	   206:   ASL
01:10AA AA              	   207:   TAX
01:10AB 7C461E          	   208:   JMP (CTRLTAB,X)
                        	   209: .dk_p:
01:10AE 4CD817          	   210:   JMP TYPECH
                        	   211: .dk_x:
01:10B1 60              	   212:   RTS
                        	   213: 
                        	   214: ; KEYLETTER: Ctrl+letter and lower case -> upper case letter
                        	   215: KEYLETTER:
01:10B2 C901            	   216:   CMP #1
01:10B4 9011            	   217:   BCC .kl_x
01:10B6 C91B            	   218:   CMP #27
01:10B8 B003            	   219:   BCS .kl_lc
01:10BA 0940            	   220:   ORA #$40
01:10BC 60              	   221:   RTS
                        	   222: .kl_lc:
01:10BD C961            	   223:   CMP #'a'
01:10BF 9006            	   224:   BCC .kl_x
01:10C1 C97B            	   225:   CMP #'z'+1
01:10C3 B002            	   226:   BCS .kl_x
01:10C5 29DF            	   227:   AND #$DF
                        	   228: .kl_x:
01:10C7 60              	   229:   RTS
                        	   230: 
                        	   231: NOP_CMD:
01:10C8 60              	   232:   RTS
                        	   233: 
                        	   234: CMD_PFXK:
01:10C9 A94B            	   235:   LDA #'K'
01:10CB 855F            	   236:   STA PREFIX
01:10CD 60              	   237:   RTS
                        	   238: CMD_PFXQ:
01:10CE A951            	   239:   LDA #'Q'
01:10D0 855F            	   240:   STA PREFIX
01:10D2 60              	   241:   RTS
                        	   242: 
                        	   243: ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;; gap buffer
                        	   244: 
                        	   245: ; CURPOS: P0 = logical cursor. Keeps X, Y
                        	   246: CURPOS:
01:10D3 38              	   247:   SEC
01:10D4 A550            	   248:   LDA GS
01:10D6 E900            	   249:   SBC #<BUF
01:10D8 8572            	   250:   STA P0
01:10DA A551            	   251:   LDA GS+1
01:10DC E930            	   252:   SBC #>BUF
01:10DE 8573            	   253:   STA P0+1
01:10E0 60              	   254:   RTS
                        	   255: 
                        	   256: ; TXTLEN: P0 = cursor, P1 = text length
                        	   257: TXTLEN:
01:10E1 20D310          	   258:   JSR CURPOS
01:10E4 38              	   259:   SEC
01:10E5 A900            	   260:   LDA #<BUF_END
01:10E7 E552            	   261:   SBC GE
01:10E9 8574            	   262:   STA P1
01:10EB A980            	   263:   LDA #>BUF_END
01:10ED E553            	   264:   SBC GE+1
01:10EF 8575            	   265:   STA P1+1
01:10F1 18              	   266:   CLC
01:10F2 A574            	   267:   LDA P1
01:10F4 6572            	   268:   ADC P0
01:10F6 8574            	   269:   STA P1
01:10F8 A575            	   270:   LDA P1+1
01:10FA 6573            	   271:   ADC P0+1
01:10FC 8575            	   272:   STA P1+1
01:10FE 60              	   273:   RTS
                        	   274: 
                        	   275: ; ATEND: Z=1 if the cursor is at the end of the text
                        	   276: ATEND:
01:10FF A552            	   277:   LDA GE
01:1101 C900            	   278:   CMP #<BUF_END
01:1103 D004            	   279:   BNE .ae_x
01:1105 A553            	   280:   LDA GE+1
01:1107 C980            	   281:   CMP #>BUF_END
                        	   282: .ae_x:
01:1109 60              	   283:   RTS
                        	   284: 
                        	   285: ; INSRAW: A at the cursor (no checks)
                        	   286: INSRAW:
01:110A 9250            	   287:   STA (GS)
01:110C C90D            	   288:   CMP #CR
01:110E D006            	   289:   BNE .ir_n
01:1110 E65B            	   290:   INC LINE
01:1112 D002            	   291:   BNE .ir_n
01:1114 E65C            	   292:   INC LINE+1
                        	   293: .ir_n:
01:1116 E650            	   294:   INC GS
01:1118 D002            	   295:   BNE .ir_d
01:111A E651            	   296:   INC GS+1
                        	   297: .ir_d:
01:111C A901            	   298:   LDA #1
01:111E 855D            	   299:   STA MODF
01:1120 8582            	   300:   STA DIRTY
01:1122 60              	   301:   RTS
                        	   302: 
                        	   303: ; INSCH: inserts A at the cursor. C=1 memory full
                        	   304: INSCH:
01:1123 48              	   305:   PHA
01:1124 A550            	   306:   LDA GS
01:1126 C552            	   307:   CMP GE
01:1128 D010            	   308:   BNE .ic_ok
01:112A A551            	   309:   LDA GS+1
01:112C C553            	   310:   CMP GE+1
01:112E D00A            	   311:   BNE .ic_ok
01:1130 68              	   312:   PLA
01:1131 A99B            	   313:   LDA #<M_FULL
01:1133 A21F            	   314:   LDX #>M_FULL
01:1135 203B16          	   315:   JSR SETMSG
01:1138 38              	   316:   SEC
01:1139 60              	   317:   RTS
                        	   318: .ic_ok:
01:113A 20D310          	   319:   JSR CURPOS
01:113D A200            	   320:   LDX #0
01:113F 204D11          	   321:   JSR ADJINS
01:1142 A202            	   322:   LDX #2
01:1144 204D11          	   323:   JSR ADJINS
01:1147 68              	   324:   PLA
01:1148 200A11          	   325:   JSR INSRAW
01:114B 18              	   326:   CLC
01:114C 60              	   327:   RTS
                        	   328: 
                        	   329: ; ADJINS: mark BB+X moves on if it is after the cursor P0
                        	   330: ADJINS:
01:114D A572            	   331:   LDA P0
01:114F D556            	   332:   CMP BB,X
01:1151 A573            	   333:   LDA P0+1
01:1153 F557            	   334:   SBC BB+1,X
01:1155 B006            	   335:   BCS .ai_x
01:1157 F656            	   336:   INC BB,X
01:1159 D002            	   337:   BNE .ai_x
01:115B F657            	   338:   INC BB+1,X
                        	   339: .ai_x:
01:115D 60              	   340:   RTS
                        	   341: 
                        	   342: ; ADJDEL: mark BB+X moves back if it is after P0 (a character at P0 was deleted)
                        	   343: ADJDEL:
01:115E A572            	   344:   LDA P0
01:1160 D556            	   345:   CMP BB,X
01:1162 A573            	   346:   LDA P0+1
01:1164 F557            	   347:   SBC BB+1,X
01:1166 B008            	   348:   BCS .ad_x
01:1168 B556            	   349:   LDA BB,X
01:116A D002            	   350:   BNE .ad_d
01:116C D657            	   351:   DEC BB+1,X
                        	   352: .ad_d:
01:116E D656            	   353:   DEC BB,X
                        	   354: .ad_x:
01:1170 60              	   355:   RTS
                        	   356: 
                        	   357: ; BSRAW: deletes the character before the cursor. C=1 at the start
                        	   358: BSRAW:
01:1171 A550            	   359:   LDA GS
01:1173 C900            	   360:   CMP #<BUF
01:1175 D008            	   361:   BNE .bs_ok
01:1177 A551            	   362:   LDA GS+1
01:1179 C930            	   363:   CMP #>BUF
01:117B D002            	   364:   BNE .bs_ok
01:117D 38              	   365:   SEC
01:117E 60              	   366:   RTS
                        	   367: .bs_ok:
01:117F A550            	   368:   LDA GS
01:1181 D002            	   369:   BNE .bs_d
01:1183 C651            	   370:   DEC GS+1
                        	   371: .bs_d:
01:1185 C650            	   372:   DEC GS
01:1187 B250            	   373:   LDA (GS)
01:1189 C90D            	   374:   CMP #CR
01:118B D008            	   375:   BNE .bs_n
01:118D A55B            	   376:   LDA LINE
01:118F D002            	   377:   BNE .bs_l
01:1191 C65C            	   378:   DEC LINE+1
                        	   379: .bs_l:
01:1193 C65B            	   380:   DEC LINE
